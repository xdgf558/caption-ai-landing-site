---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ContentPillars from '../components/ContentPillars.astro';
import AppCard from '../components/AppCard.astro';
import CreatorNote from '../components/CreatorNote.astro';
import CTASection from '../components/CTASection.astro';
import XWorkCard from '../components/XWorkCard.astro';

const xUrl = 'https://x.com/bketck';
const allWorks = await getCollection('xworks');
const featuredWorks = allWorks
  .filter((work) => work.data.status === 'published' && work.data.featured)
  .sort((a, b) => {
    const orderDiff = a.data.sortOrder - b.data.sortOrder;
    if (orderDiff !== 0) return orderDiff;
    return new Date(b.data.publishedAt ?? 0).getTime() - new Date(a.data.publishedAt ?? 0).getTime();
  })
  .slice(0, 3);

const heroCards = [
  { icon: 'cat', title: 'Cat log', text: '窗邊、沙發和一些很有主見的小動靜。' },
  { icon: 'meal', title: 'Table notes', text: '早餐、咖啡、飯桌，以及每天值得記下的一口。' },
  { icon: 'AI', title: 'Tool bench', text: '把 AI 做成更輕、更日常的創作工具。' },
  { icon: 'idea', title: 'Odd signals', text: '資訊、靈感和暫時看起來有點奇怪的想法。' }
];

const pillars = [
  { icon: 'cat', title: 'Cats', description: '記錄貓咪和日常裡的小陪伴。' },
  { icon: 'meal', title: 'Meals', description: '早餐、飯桌、咖啡和生活裡的小片段。' },
  { icon: 'signal', title: 'Signals', description: '關注科技、資訊、市場和 AI 變化裡的信號。' },
  { icon: 'spark', title: 'Odd Ideas', description: '一些奇怪想法、產品實驗和突然冒出來的靈感。' }
];

const experiments = [
  { icon: 'AI', title: 'AI caption generation', description: '讓日常照片更快變成適合分享的文字。' },
  { icon: 'local', title: 'On-device AI experiments', description: '優先探索更私密、更輕量的本地 AI 流程。' },
  { icon: 'photo', title: 'Photo understanding', description: '理解早餐、貓、咖啡、散步和旅途裡的情緒。' },
  { icon: 'voice', title: 'Personal style learning', description: '讓生成結果慢慢靠近自己的語氣。' },
  { icon: 'lang', title: 'Multi-language sharing', description: '支援跨語言分享，不把靈感卡在一種語言裡。' }
];
---

<BaseLayout
  title="Station Cat"
  description="Station Cat 是一個記錄貓咪、飯桌、資訊、AI 創作和奇怪想法的個人創作小站。"
  lang="zh-Hant"
  canonicalPath="/"
  bodyClass="station-home"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/' },
    { hrefLang: 'en', href: '/en/' },
    { hrefLang: 'ja', href: '/ja/' },
    { hrefLang: 'x-default', href: '/' }
  ]}
>
  <HeroSection
    eyebrow="Station Cat"
    title="一個記錄貓咪、飯桌、資訊和奇怪想法的小站。"
    subtitle="這裡會放我的 AI 創作、生活記錄、產品實驗和正在開發的 App。如果你也喜歡貓、日常分享、AI 工具和一點點奇怪的靈感，歡迎常來看看。"
    ctas={[
      { label: '查看正在開發的 App', href: '/zh-hant/apps/caption-ai/', variant: 'primary' },
      { label: '關注我的 X', href: xUrl, variant: 'secondary' },
      { label: '參與測試', href: '/zh-hant/apps/caption-ai/download/', variant: 'ghost' }
    ]}
    cards={heroCards}
    tags={['Cats', 'Meals', 'AI Tools', 'Strange Ideas']}
  />

  <section id="about" class="station-section station-about">
    <div class="station-section__heading">
      <p class="station-kicker">What is Station Cat?</p>
      <h2>不是冷冰冰的產品官網，更像一個個人創作小站。</h2>
    </div>
    <div class="station-about__copy">
      <p>
        Station Cat 會記錄貓咪、飯桌、資訊、AI 創作，以及一些暫時看起來奇怪但可能有趣的想法。
      </p>
      <p>
        這裡也會發布我自己做的小工具。它們不一定很大，但會圍繞日常表達、分享和創作慢慢長出來。
      </p>
    </div>
  </section>

  <ContentPillars
    eyebrow="Content pillars"
    title="這個小站會持續收集什麼？"
    description="貓、飯桌、資訊信號和 AI 工具會在這裡交會，像夜間車站裡一盞還亮著的小燈。"
    items={pillars}
  />

  <section id="apps" class="station-section">
    <div class="station-section__heading">
      <p class="station-kicker">Apps from Station Cat</p>
      <h2>圍繞日常創作做的小 AI 工具。</h2>
      <p>
        首個產品是 SnapCopy。首頁只放入口和方向，真正的功能、場景、隱私和第一輪測試資訊會留在產品頁。
      </p>
    </div>
    <AppCard
      eyebrow="Current app"
      title="SnapCopy"
      subtitle="Turn everyday photos into shareable captions."
      description="拍下早餐、咖啡、散步、寵物或旅行場景，生成適合社交平台分享的文案，並逐漸學習你的表達偏好。"
      href="/zh-hant/apps/caption-ai/"
      waitlistHref="/zh-hant/apps/caption-ai/download/"
      ctaLabel="查看 App"
      waitlistLabel="參與測試"
      status="第一輪封閉測試中"
    />
  </section>

  <CreatorNote
    eyebrow="A note from Station Cat"
    title="小東西也值得被好好表達。"
    paragraphs={[
      '我喜歡記錄一些很小但真實的東西：一頓早餐，一隻貓，一個散步時看到的場景，一條突然冒出來的想法。',
      '如果 AI 能幫人更輕鬆地表達這些瞬間，那它就不只是工具，也可以變成一種創作陪伴。'
    ]}
  />

  <section id="works" class="station-section station-x-latest">
    <div class="station-section__heading">
      <p class="station-kicker">Latest from X</p>
      <h2>來自 X 的近期作品和想法。</h2>
      <p>A few recent posts, videos, AI experiments, cats, meals, and strange ideas from Station Cat.</p>
    </div>
    {featuredWorks.length > 0 ? (
      <div class="x-work-grid x-work-grid--featured">
        {featuredWorks.map((work) => (
          <XWorkCard
            title={work.data.title}
            description={work.data.description}
            xUrl={work.data.xUrl}
            type={work.data.type}
            tags={work.data.tags}
            publishedAt={work.data.publishedAt}
            compact
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">New works will appear here soon.</p>
    )}
    <div class="button-row">
      <a class="button button-primary" href="/works/">View all works</a>
      <a class="button button-secondary" href={xUrl} target="_blank" rel="noopener noreferrer">Follow on X</a>
    </div>
  </section>

  <ContentPillars
    id="experiments"
    eyebrow="Latest experiments"
    title="正在實驗的方向"
    description="目前不做複雜博客系統，先把正在長出來的想法放在這裡。"
    items={experiments}
  />

  <CTASection
    eyebrow="Follow the build"
    title="跟著這個小站一起長大。"
    description="Station Cat 還在演化。這裡會繼續出現貓、App、AI 實驗、飯桌和一些奇怪但有趣的想法。"
    ctas={[
      { label: 'Follow on X', href: xUrl, variant: 'primary' },
      { label: 'View SnapCopy', href: '/zh-hant/apps/caption-ai/', variant: 'secondary' },
      { label: 'Join Android Waitlist', href: '/android/', variant: 'ghost' }
    ]}
  />
</BaseLayout>
