---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy"
  description="Privacy entry point for Everyday AI Apps products."
  lang="en"
  canonicalPath="/privacy/"
>
  <section class="page-shell">
    <p class="section-kicker">Privacy</p>
    <h1>Product privacy policies.</h1>
    <p>
      Each app has its own privacy policy because future products may handle different data. The current product is SnapCopy.
    </p>
    <h2>Third-party embedded content</h2>
    <p>
      This website may include embedded content from X, such as posts, videos, images, or timelines. Embedded content from X behaves as if the visitor has visited X directly. X may collect data, use cookies, pixels, local storage, or similar technologies according to its own policies. Visitors can open the original post on X to interact with the content.
    </p>
    <div class="link-panel">
      <a href="/apps/caption-ai/privacy/">SnapCopy Privacy Policy</a>
    </div>
  </section>
</BaseLayout>
