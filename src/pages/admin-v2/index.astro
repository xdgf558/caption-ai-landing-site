    const loadAccountDetail = async (accountId) => {
      state.selectedAccountId = Number(accountId) || 0;
      elements.accountDetail.innerHTML = '<p class="admin-empty-list">正在读取账户详情。</p>';
      const payload = await apiJson(`/admin/api/novels/readers/account?id=${encodeURIComponent(state.selectedAccountId)}`);
      renderAccountDetail(payload);
      await loadAccounts();
    };

    const adjustCredits = async (event, account) => {
      event.preventDefault();
      const payload = {
        accountId: account.id,
        creditsDelta: Number($('#credit-adjust-delta').value || 0),
        seriesSlug: $('#credit-adjust-series').value.trim(),
        chapterSlug: $('#credit-adjust-chapter').value.trim(),
        sourceRef: $('#credit-adjust-source').value.trim(),
        note: $('#credit-adjust-note').value.trim(),
        reason: 'admin-v2-manual-adjustment'
      };
      const result = await apiJson('/admin/api/novels/readers/credits/adjust', {
        method: 'POST',
        body: JSON.stringify(payload)
      });
      renderAccountDetail(result);
      await Promise.all([loadAccounts(), loadAuditLogs()]);
      setStatus('阅读点余额已调整。', 'success');
    };

    const currentAnalyticsWindowDays = () => Number(elements.filters.analyticsDays.value || 30);

    const analyticsKey = (stat) => `${stat.seriesSlug || ''}/${stat.chapterSlug || ''}/${stat.locale || ''}/${stat.windowDays || currentAnalyticsWindowDays()}`;

    const getAnalyticsInsightForStat = (stat) =>
      state.analyticsInsights.find((insight) => analyticsKey(insight) === analyticsKey(stat));

    const renderInsightItems = (items) => {
      const list = Array.isArray(items) ? items : [];
      return list.length
        ? `<ul class="admin-v2-clean-list">${list.map((item) => `<li>${escapeHtml(item)}</li>`).join('')}</ul>`
        : '<p class="admin-empty-list">暂无数据。</p>';
