---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Station Cat Admin 2.0"
  description="Station Cat backend content platform for serial fiction, devlog publishing, pricing, orders, entitlements, and audit logs."
  lang="zh-Hant"
  canonicalPath="/admin-v2/"
  bodyClass="station-home admin-v2-page"
>
  <section class="admin-v2-shell">
    <header class="admin-v2-heading">
      <div>
        <p class="station-kicker">Station Cat Admin</p>
        <h1>内容工作台</h1>
        <div class="admin-v2-status" id="admin-v2-status" role="status" aria-live="polite">
          正在连接后端内容平台。
        </div>
      </div>
      <div class="admin-v2-heading__actions">
        <a class="button button-secondary" href="/admin/waitlist/">等待名单</a>
        <a class="button button-secondary" href="/novel/">小说页</a>
        <a class="button button-secondary" href="/devlog/">博客页</a>
      </div>
    </header>

    <div class="admin-v2-grid">
      <aside class="admin-v2-panel admin-v2-sidebar" data-admin-v2-scroll-panel>
        <nav class="admin-v2-tabs" aria-label="后台模块">
          <div class="admin-v2-nav-group" role="group" aria-labelledby="admin-nav-publish">
            <span class="admin-v2-nav-label" id="admin-nav-publish">发布</span>
            <button class="admin-v2-tab is-active" type="button" aria-pressed="true" data-admin-v2-tab="content">内容</button>
            <button class="admin-v2-tab" type="button" aria-pressed="false" data-admin-v2-tab="imports">导入审核</button>
            <button class="admin-v2-tab" type="button" aria-pressed="false" data-admin-v2-tab="signal">每日简报</button>
          </div>
          <div class="admin-v2-nav-group" role="group" aria-labelledby="admin-nav-operations">
            <span class="admin-v2-nav-label" id="admin-nav-operations">运营</span>
            <button class="admin-v2-tab" type="button" aria-pressed="false" data-admin-v2-tab="commerce">订单</button>
            <button class="admin-v2-tab" type="button" aria-pressed="false" data-admin-v2-tab="accounts">账户</button>
            <button class="admin-v2-tab" type="button" aria-pressed="false" data-admin-v2-tab="access">读者授权</button>
          </div>
          <div class="admin-v2-nav-group" role="group" aria-labelledby="admin-nav-response">
            <span class="admin-v2-nav-label" id="admin-nav-response">反馈</span>
            <button class="admin-v2-tab" type="button" aria-pressed="false" data-admin-v2-tab="comments">评论审核</button>
            <button class="admin-v2-tab" type="button" aria-pressed="false" data-admin-v2-tab="feedback">产品反馈</button>
          </div>
          <div class="admin-v2-nav-group" role="group" aria-labelledby="admin-nav-data">
            <span class="admin-v2-nav-label" id="admin-nav-data">数据</span>
            <button class="admin-v2-tab" type="button" aria-pressed="false" data-admin-v2-tab="analytics">阅读统计</button>
            <button class="admin-v2-tab" type="button" aria-pressed="false" data-admin-v2-tab="audit">审计日志</button>
          </div>
        </nav>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="content-sidebar">
          <details class="admin-template-panel admin-global-pricing-panel">
            <summary class="admin-disclosure-summary">
              <span>
                <small>全站设置</small>
                <strong id="pricing-defaults-title">全局收费规则</strong>
              </span>
              <span id="pricing-defaults-summary">正在读取默认收费规则。</span>
            </summary>
            <div class="admin-disclosure-body">
              <div class="admin-global-pricing-grid">
              <label>
                访问级别
                <select id="global-access-level">
                  <option value="free">免费</option>
                  <option value="paid">付费</option>
                  <option value="member">会员</option>
                </select>
              </label>
              <label>
                收费模式
                <select id="global-pricing-mode">
                  <option value="free">免费阅读</option>
                  <option value="tip-optional">免费 + 打赏</option>
                  <option value="chapter-paid">阅读点解锁</option>
                  <option value="member">会员阅读</option>
                </select>
              </label>
              <label>
                免费章节数
                <input id="global-pricing-free-chapters" type="number" min="0" step="1" value="20" />
              </label>
              <label>
                每章阅读点
                <input id="global-pricing-chapter-credits" type="number" min="1" step="1" value="1" />
              </label>
              <label class="admin-global-pricing-wide">
                点数包
                <input id="global-pricing-credit-packs" placeholder="10:1, 50:5, 100:10" />
              </label>
              <label class="admin-checkbox">
                <input id="global-subscription-enabled" type="checkbox" checked />
                开启会员兑换
              </label>
              <label>
                会员点数/月
                <input id="global-membership-credit-cost" type="number" min="1" step="1" value="10" />
              </label>
              <label>
                兑换月数
                <input id="global-membership-months" type="number" min="1" step="1" value="1" />
              </label>
              <label class="admin-checkbox">
                <input id="global-membership-covers-paid" type="checkbox" checked />
                会员免费看收费内容
              </label>
              <label class="admin-checkbox">
                <input id="global-tips-enabled" type="checkbox" />
                开启打赏
              </label>
              <label class="admin-global-pricing-wide">
                打赏金额 USD
                <input id="global-pricing-tip-amounts" placeholder="1, 3, 5" />
              </label>
              </div>
              <div class="button-row">
                <button class="button button-primary" id="pricing-defaults-save" type="button">保存全局收费</button>
                <button class="button button-secondary" id="pricing-defaults-apply" type="button">套用到当前编辑</button>
                <button class="button button-secondary" id="pricing-defaults-refresh" type="button">刷新</button>
              </div>
              <div class="admin-inline-status" id="pricing-defaults-status" role="status" aria-live="polite" hidden></div>
            </div>
          </details>

          <div class="admin-v2-filter-grid">
            <label>
              类型
              <select id="content-filter-type">
                <option value="">全部</option>
                <option value="blog_post">Blog / Devlog</option>
                <option value="signal_brief">Signal 简报</option>
                <option value="novel_series">小说作品</option>
                <option value="novel_chapter">小说章节</option>
              </select>
            </label>
            <label>
              状态
              <select id="content-filter-status">
                <option value="">全部</option>
                <option value="draft">草稿</option>
                <option value="scheduled">定时</option>
                <option value="published">已发布</option>
                <option value="archived">归档</option>
              </select>
            </label>
          </div>
          <div class="button-row">
            <button class="button button-primary" id="content-refresh" type="button">刷新内容</button>
          </div>
          <div class="button-row">
            <button class="button button-secondary" type="button" data-new-entry="blog_post">新 Blog</button>
            <button class="button button-secondary" type="button" data-new-entry="signal_brief">新简报</button>
            <button class="button button-secondary" type="button" data-new-entry="novel_series">新作品</button>
            <button class="button button-secondary" type="button" data-new-entry="novel_chapter">新章节</button>
          </div>
          <div class="admin-v2-list" id="content-list" aria-label="Backend content entries"></div>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="imports-sidebar" hidden>
          <div class="button-row">
            <button class="button button-primary" id="imports-refresh" type="button">刷新审核</button>
          </div>
          <section class="admin-template-panel" aria-labelledby="import-review-help-title">
            <div>
              <p class="station-kicker">Review queue</p>
              <h3 id="import-review-help-title">导入与发布审核</h3>
              <p>统一审核 NovelForge 导入批次和 Signal 简报草稿。内容核对完成后，再从这里批准发布。</p>
            </div>
          </section>
          <div class="admin-v2-list" id="imports-list" aria-label="NovelForge imports"></div>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="signal-sidebar" hidden>
          <section class="admin-template-panel" aria-labelledby="signal-help-title">
            <div>
              <p class="station-kicker">Signal strip</p>
              <h3 id="signal-help-title">每日简报导入</h3>
              <p>保留人工发布，同时从免费白名单来源采集候选资讯。候选内容需要人工审核，不会自动发布。</p>
            </div>
          </section>
          <div class="button-row">
            <button class="button button-primary" id="signal-refresh" type="button">刷新简报</button>
            <button class="button button-secondary" id="signal-source-manage" type="button">管理来源</button>
          </div>
          <div class="admin-v2-list" id="signal-list" aria-label="Signal strip briefs"></div>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="commerce-sidebar" hidden>
          <div class="admin-v2-filter-grid">
            <label>
              订单状态
              <select id="orders-status">
                <option value="">全部</option>
                <option value="draft">draft</option>
                <option value="waiting">waiting</option>
                <option value="confirming">confirming</option>
                <option value="confirmed">confirmed</option>
                <option value="finished">finished</option>
                <option value="failed">failed</option>
                <option value="expired">expired</option>
                <option value="refunded">refunded</option>
                <option value="unknown">unknown</option>
              </select>
            </label>
            <label>
              订单类型
              <select id="orders-type">
                <option value="">全部</option>
                <option value="chapter">chapter</option>
                <option value="chapter-bundle">chapter-bundle</option>
                <option value="supporter">supporter</option>
                <option value="credit-pack">credit-pack</option>
                <option value="tip">tip</option>
              </select>
            </label>
          </div>
          <label>
            读者 Email
            <input id="orders-email" type="email" placeholder="reader@example.com" />
          </label>
          <label>
            seriesSlug
            <input id="orders-series" placeholder="deng-hai-liang-zhe" />
          </label>
          <button class="button button-primary" id="orders-refresh" type="button">刷新订单</button>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="accounts-sidebar" hidden>
          <label>
            读者 Email
            <input id="accounts-email-filter" type="email" placeholder="reader@example.com" />
          </label>
          <label>
            账户状态
            <select id="accounts-status">
              <option value="">全部</option>
              <option value="active">active</option>
              <option value="disabled">disabled</option>
            </select>
          </label>
          <button class="button button-primary" id="accounts-refresh" type="button">刷新账户</button>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="analytics-sidebar" hidden>
          <label>
            seriesSlug
            <input id="analytics-series" placeholder="cmqjfju1300008z3wyh66ynvw" />
          </label>
          <label>
            chapterSlug
            <input id="analytics-chapter" placeholder="可选，留空聚合全部章节" />
          </label>
          <label>
            统计窗口
            <select id="analytics-days">
              <option value="7">最近 7 天</option>
              <option value="30" selected>最近 30 天</option>
              <option value="90">最近 90 天</option>
              <option value="365">最近 365 天</option>
            </select>
          </label>
          <div class="button-row">
            <button class="button button-primary" id="analytics-aggregate" type="button">重新聚合</button>
            <button class="button button-secondary" id="analytics-generate-insights" type="button">生成洞察</button>
            <button class="button button-secondary" id="analytics-refresh" type="button">刷新统计</button>
          </div>
          <section class="admin-template-panel" aria-labelledby="analytics-help-title">
            <div>
              <p class="station-kicker">Reader Analytics</p>
              <h3 id="analytics-help-title">阅读统计</h3>
              <p>聚合 Novel V2 阅读事件，查看章节完成率、平均阅读时间、流失位置和互动分，并生成章节 AI Insight。</p>
            </div>
          </section>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="comments-sidebar" hidden>
          <label>
            评论状态
            <select id="comments-status">
              <option value="pending" selected>待审核</option>
              <option value="approved">已通过</option>
              <option value="hidden">已隐藏</option>
              <option value="deleted">已删除</option>
              <option value="">全部未删除</option>
            </select>
          </label>
          <label>
            seriesSlug
            <input id="comments-series" placeholder="cmqjfju1300008z3wyh66ynvw" />
          </label>
          <label>
            chapterSlug
            <input id="comments-chapter" placeholder="可选" />
          </label>
          <label>
            读者 Email
            <input id="comments-email" type="email" placeholder="reader@example.com" />
          </label>
          <button class="button button-primary" id="comments-refresh" type="button">刷新评论</button>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="feedback-sidebar" hidden>
          <label>
            处理状态
            <select id="feedback-status">
              <option value="new" selected>新反馈</option>
              <option value="in_progress">处理中</option>
              <option value="resolved">已解决</option>
              <option value="closed">已关闭</option>
              <option value="">全部</option>
            </select>
          </label>
          <label>
            系统平台
            <select id="feedback-platform">
              <option value="">全部</option>
              <option value="macos">macOS</option>
              <option value="windows">Windows</option>
              <option value="ios">iOS</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label>
            问题类型
            <select id="feedback-issue-type">
              <option value="">全部</option>
              <option value="install">安装问题</option>
              <option value="activation">启用问题</option>
              <option value="typing">输入异常</option>
              <option value="candidates">候选词问题</option>
              <option value="performance">闪退或性能</option>
              <option value="other">其他</option>
            </select>
          </label>
          <label>
            搜索
            <input id="feedback-query" placeholder="摘要、正文或 Email" />
          </label>
          <button class="button button-primary" id="feedback-refresh" type="button">刷新反馈</button>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="access-sidebar" hidden>
          <label>
            读者 Email
            <input id="access-email-filter" type="email" placeholder="reader@example.com" />
          </label>
          <button class="button button-primary" id="access-refresh" type="button">查询授权</button>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="audit-sidebar" hidden>
          <label>
            目标类型
            <input id="audit-target-type" placeholder="blog_post / novel_chapter" />
          </label>
          <label>
            目标 Slug
            <input id="audit-target-slug" placeholder="series/chapter 或 slug" />
          </label>
          <button class="button button-primary" id="audit-refresh" type="button">刷新审计</button>
        </section>

      </aside>

      <div class="admin-v2-main">
        <section class="admin-v2-panel admin-v2-workspace" data-admin-v2-panel="content-main">
          <div class="admin-v2-section-heading">
            <div>
              <p class="station-kicker">Content Editor</p>
              <h2 id="editor-heading">创建后端内容</h2>
            </div>
            <div class="admin-v2-badges">
              <span id="schema-stage">Stage 7C</span>
              <span id="storage-badge">R2 未确认</span>
            </div>
          </div>

          <div class="admin-v2-editor-toolbar">
            <div class="admin-inline-status" id="content-save-status" role="status" aria-live="polite" hidden></div>
            <div class="button-row">
              <button class="button button-secondary" id="content-reset" type="button">清空</button>
              <button class="button button-primary" id="content-save" type="submit" form="content-form" data-content-save-button>保存内容</button>
            </div>
          </div>

          <form id="content-form" class="admin-v2-form" novalidate>
            <input id="content-entry-id" type="hidden" />
            <section class="admin-v2-subpanel admin-v2-editor-primary">
              <div class="admin-v2-section-heading">
                <div>
                  <p class="station-kicker">Basic</p>
                  <h3>基础信息</h3>
                </div>
              </div>
              <div class="admin-v2-form-grid">
                <label>
                  内容类型
                  <select id="content-entry-type" required>
                    <option value="blog_post">Blog / Devlog</option>
                    <option value="signal_brief">Signal 简报</option>
                    <option value="novel_series">小说作品</option>
                    <option value="novel_chapter">小说章节</option>
                  </select>
                </label>
                <label>
                  状态
                  <select id="content-status">
                    <option value="draft">草稿</option>
                    <option value="scheduled">定时</option>
                    <option value="published">发布</option>
                    <option value="archived">归档</option>
                  </select>
                </label>
                <label>
                  语言
                  <select id="content-locale" required>
                    <option value="zh-Hant">繁中</option>
                    <option value="zh-Hans">简中</option>
                    <option value="en">English</option>
                    <option value="ja">日本語</option>
                  </select>
                </label>
                <label>
                  Slug
                  <input id="content-slug" required placeholder="post-or-chapter-slug" />
                </label>
                <label hidden>
                  父级 seriesSlug
                  <input id="content-parent-slug" placeholder="novel-series-slug" />
                </label>
                <label hidden>
                  章节序号
                  <input id="content-chapter-number" type="number" min="1" step="1" />
                </label>
                <label class="admin-v2-field--wide">
                  标题
                  <input id="content-title" required placeholder="内容标题" />
                </label>
                <label class="admin-v2-field--wide">
                  描述
                  <textarea id="content-description" rows="3"></textarea>
                </label>
                <label class="admin-v2-field--wide">
                  摘要
                  <textarea id="content-excerpt" rows="2"></textarea>
                </label>
              </div>
            </section>

            <section class="admin-v2-subpanel admin-v2-editor-body">
              <div class="admin-v2-section-heading">
                <div>
                  <p class="station-kicker">Markdown</p>
                  <h3>正文</h3>
                </div>
                <div class="button-row">
                  <label class="button button-secondary admin-file-button" for="content-file">导入 Markdown</label>
                  <input class="admin-file-input" id="content-file" type="file" accept=".md,.markdown,text/markdown,text/plain" />
                  <button class="button button-secondary" id="content-preview-button" type="button">预览</button>
                  <button class="button button-secondary" id="content-worker-preview-button" type="button">Worker 预览</button>
                  <button class="button button-primary" type="submit" data-content-save-button>保存</button>
                </div>
              </div>
              <textarea id="content-markdown" rows="22" spellcheck="false" placeholder="这里写正文 Markdown。"></textarea>
              <details class="admin-v2-inline-disclosure" id="content-preview-disclosure">
                <summary>正文预览</summary>
                <div class="admin-v2-preview" id="content-preview">等待输入正文。</div>
              </details>
            </section>

            <details class="admin-v2-disclosure">
              <summary class="admin-disclosure-summary">
                <span>
                  <small>Publish</small>
                  <strong>发布设置</strong>
                </span>
              </summary>
              <div class="admin-disclosure-body admin-v2-form-grid">
                <label>
                  可见性
                  <select id="content-visibility">
                    <option value="public">公开</option>
                    <option value="unlisted">隐藏链接</option>
                    <option value="private">私有</option>
                  </select>
                </label>
                <label>
                  副标题
                  <input id="content-subtitle" />
                </label>
                <label>
                  作者
                  <input id="content-author" placeholder="Station Cat" />
                </label>
                <label>
                  Tags
                  <input id="content-tags" />
                </label>
                <label>
                  分卷标题
                  <input id="content-volume-title" />
                </label>
                <label>
                  发布时间
                  <input id="content-published-at" type="datetime-local" />
                </label>
                <label>
                  排序
                  <input id="content-sort-order" type="number" min="0" step="1" value="0" />
                </label>
                <label class="admin-checkbox">
                  <input id="content-featured" type="checkbox" />
                  首页或书架精选
                </label>
              </div>
            </details>

            <details class="admin-v2-disclosure" id="entry-pricing-panel">
              <summary class="admin-disclosure-summary">
                <span>
                  <small>Pricing</small>
                  <strong>单篇收费覆盖</strong>
                </span>
              </summary>
              <div class="admin-disclosure-body">
                <div class="admin-v2-form-grid">
                  <label>
                    访问级别
                    <select id="content-access-level">
                      <option value="free">免费</option>
                      <option value="paid">付费</option>
                      <option value="supporter">支持者</option>
                      <option value="member">会员</option>
                    </select>
                  </label>
                  <label>
                    收费模式
                    <select id="pricing-mode">
                      <option value="free">免费阅读</option>
                      <option value="tip-optional">免费 + 打赏</option>
                      <option value="chapter-paid">单章购买</option>
                      <option value="volume-paid">分卷购买</option>
                      <option value="member">会员阅读</option>
                    </select>
                  </label>
                  <label>
                    免费章节数
                    <input id="pricing-free-chapters" type="number" min="0" step="1" value="0" />
                  </label>
                  <label>
                    单章价格 USD（已停用）
                    <input id="pricing-chapter-price" type="number" min="0" step="0.01" placeholder="已停用" disabled />
                  </label>
                  <label>
                    支持者价格 USD（已停用）
                    <input id="pricing-supporter-price" type="number" min="0" step="0.01" placeholder="已停用" disabled />
                  </label>
                  <label>
                    单章阅读点
                    <input id="pricing-chapter-credits" type="number" min="1" step="1" placeholder="1" />
                  </label>
                  <label>
                    阅读点包
                    <input id="pricing-credit-packs" placeholder="10:1, 50:5, 100:10" />
                  </label>
                  <label class="admin-checkbox">
