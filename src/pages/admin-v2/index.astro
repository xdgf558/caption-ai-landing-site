        membershipCreditCost: $('#global-membership-credit-cost'),
        membershipMonths: $('#global-membership-months'),
        membershipCoversPaid: $('#global-membership-covers-paid'),
        tipsEnabled: $('#global-tips-enabled'),
        tipAmounts: $('#global-pricing-tip-amounts')
      },
      coverOpen: $('#content-cover-open'),
      coverPreview: $('#content-cover-preview'),
      coverStatus: $('#content-cover-status'),
      coverUpload: $('#content-cover-upload'),
      editorHeading: $('#editor-heading'),
      preview: $('#content-preview'),
      fields: {
        id: $('#content-entry-id'),
        entryType: $('#content-entry-type'),
        locale: $('#content-locale'),
        status: $('#content-status'),
        visibility: $('#content-visibility'),
        slug: $('#content-slug'),
        parentSlug: $('#content-parent-slug'),
        title: $('#content-title'),
        subtitle: $('#content-subtitle'),
        author: $('#content-author'),
        tags: $('#content-tags'),
        chapterNumber: $('#content-chapter-number'),
        volumeTitle: $('#content-volume-title'),
        publishedAt: $('#content-published-at'),
        sortOrder: $('#content-sort-order'),
        featured: $('#content-featured'),
        description: $('#content-description'),
        excerpt: $('#content-excerpt'),
        accessLevel: $('#content-access-level'),
        pricingMode: $('#pricing-mode'),
        freeChapters: $('#pricing-free-chapters'),
        chapterPrice: $('#pricing-chapter-price'),
        supporterPrice: $('#pricing-supporter-price'),
        chapterCredits: $('#pricing-chapter-credits'),
        creditPacks: $('#pricing-credit-packs'),
        tipsEnabled: $('#pricing-tips-enabled'),
        tipAmounts: $('#pricing-tip-amounts'),
        bundlesEnabled: $('#pricing-bundles-enabled'),
        bundles: $('#pricing-bundles'),
        coverFile: $('#content-cover-file'),
        coverR2Key: $('#content-cover-r2-key'),
        coverAlt: $('#content-cover-alt'),
        sourceRef: $('#content-source-ref'),
        revisionSummary: $('#content-revision-summary'),
        markdown: $('#content-markdown'),
        file: $('#content-file')
      },
      filters: {
        type: $('#content-filter-type'),
        status: $('#content-filter-status'),
        orderStatus: $('#orders-status'),
        orderType: $('#orders-type'),
        orderEmail: $('#orders-email'),
        orderSeries: $('#orders-series'),
        accountEmail: $('#accounts-email-filter'),
        accountStatus: $('#accounts-status'),
        accessEmail: $('#access-email-filter'),
        auditTargetType: $('#audit-target-type'),
        auditTargetSlug: $('#audit-target-slug')
      },
      access: {
        email: $('#access-email'),
        seriesSlug: $('#access-series-slug'),
        scope: $('#access-scope'),
        chapterSlug: $('#access-chapter-slug'),
        accessLevel: $('#access-level'),
        expiresAt: $('#access-expires-at'),
        note: $('#access-note')
      }
    };

    const state = {
      entries: [],
      imports: [],
      orders: [],
      accounts: [],
      selectedEntryId: 0,
      selectedImportId: 0,
      selectedOrderToken: '',
      selectedAccountId: 0,
      pricingDefaults: null,
      pricingDefaultsSetupRequired: false,
      schema: null
    };

    const setupDragScroll = (panel) => {
      if (!panel) return;

      const interactiveSelector = 'a, button, input, select, textarea, label, summary, [role="button"], [contenteditable="true"]';
      let isDragging = false;
      let startY = 0;
      let startScrollTop = 0;

      const stopDragging = (event) => {
        if (!isDragging) return;
        isDragging = false;
        panel.classList.remove('is-dragging');
        if (event?.pointerId !== undefined && panel.hasPointerCapture?.(event.pointerId)) {
          panel.releasePointerCapture(event.pointerId);
        }
      };

      panel.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        if (event.target.closest(interactiveSelector)) return;
        if (panel.scrollHeight <= panel.clientHeight) return;

        isDragging = true;
        startY = event.clientY;
        startScrollTop = panel.scrollTop;
        panel.classList.add('is-dragging');
        panel.setPointerCapture?.(event.pointerId);
      });

      panel.addEventListener('pointermove', (event) => {
        if (!isDragging) return;
        const deltaY = event.clientY - startY;
        if (Math.abs(deltaY) > 2) {
          event.preventDefault();
        }
        panel.scrollTop = startScrollTop - deltaY;
      });

      panel.addEventListener('pointerup', stopDragging);
      panel.addEventListener('pointercancel', stopDragging);
      panel.addEventListener('lostpointercapture', stopDragging);
    };

    setupDragScroll(elements.sidebar);

    const setStatus = (message, tone = 'neutral') => {
      elements.status.textContent = message;
      elements.status.dataset.tone = tone;
    };

    const setSaveStatus = (message, tone = 'neutral') => {
      elements.saveStatus.textContent = message;
      elements.saveStatus.dataset.tone = tone;
      elements.saveStatus.hidden = !message;
    };

    const setEffectivePricingStatus = (message, tone = 'neutral') => {
      elements.effectivePricingStatus.textContent = message;
      elements.effectivePricingStatus.dataset.tone = tone;
      elements.effectivePricingStatus.hidden = !message;
    };

    const setPricingDefaultsStatus = (message, tone = 'neutral') => {
      elements.pricingDefaultsStatus.textContent = message;
      elements.pricingDefaultsStatus.dataset.tone = tone;
      elements.pricingDefaultsStatus.hidden = !message;
    };

    const setCoverStatus = (message, tone = 'neutral') => {
      elements.coverStatus.textContent = message;
      elements.coverStatus.dataset.tone = tone;
      elements.coverStatus.hidden = !message;
    };

    const apiJson = async (path, options = {}) => {
      const response = await fetch(path, {
        ...options,
        headers: {
          'content-type': 'application/json',
          ...(options.headers || {})
        }
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload.ok === false) {
        throw new Error(payload.message || `Request failed: ${response.status}`);
      }
      return payload;
    };

    const apiFormData = async (path, formData, options = {}) => {
      const response = await fetch(path, {
        method: 'POST',
        ...options,
        body: formData
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload.ok === false) {
        throw new Error(payload.message || `Request failed: ${response.status}`);
      }
      return payload;
    };

    const escapeHtml = (value) =>
      String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');

    const splitTags = (value) =>
      String(value || '')
        .split(',')
        .map((item) => item.trim())
        .filter(Boolean);

    const slugify = (value, fallback = 'entry') => {
      const slug = String(value || '')
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      return slug || `${fallback}-${Date.now()}`;
    };

    const toDatetimeLocal = (value) => {
      if (!value) return '';
      const date = new Date(value.includes('T') ? value : value.replace(' ', 'T'));
      if (Number.isNaN(date.getTime())) return '';
      const offset = date.getTimezoneOffset() * 60000;
      return new Date(date.getTime() - offset).toISOString().slice(0, 16);
    };

    const parseYamlScalar = (value) => {
      const trimmed = String(value || '').trim();
      if (!trimmed) return '';
      if (trimmed === 'true') return true;
      if (trimmed === 'false') return false;
      if (/^-?\d+(\.\d+)?$/.test(trimmed)) return Number(trimmed);
      return trimmed.replace(/^['"]|['"]$/g, '');
    };

    const parseMarkdownDocument = (markdown) => {
      const normalized = String(markdown || '').replace(/\r\n/g, '\n');
      const match = normalized.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
      if (!match) return { frontmatter: {}, body: normalized.trim() };

      const frontmatter = {};
      const lines = match[1].split('\n');
      for (let index = 0; index < lines.length; index += 1) {
        const line = lines[index];
        if (!line || line.startsWith('  ')) continue;
        const separator = line.indexOf(':');
        if (separator === -1) continue;
        const key = line.slice(0, separator).trim();
        const value = line.slice(separator + 1).trim();

        if (value) {
          frontmatter[key] = parseYamlScalar(value);
          continue;
        }

        const items = [];
        while (lines[index + 1]?.startsWith('  - ')) {
          index += 1;
          items.push(parseYamlScalar(lines[index].replace(/^  - /, '')));
        }
        frontmatter[key] = items;
      }

      return { frontmatter, body: match[2].trim() };
    };

    const detectEntryType = (frontmatter) => {
      if (frontmatter.chapterSlug || frontmatter.chapterNumber || frontmatter.number) return 'novel_chapter';
      if (frontmatter.seriesSlug || frontmatter.updateSchedule || frontmatter.latestChapterSlug) return 'novel_series';
      return 'blog_post';
    };

    const normalizeBackendStatus = (frontmatter) => {
      if (frontmatter.draft === true) return 'draft';
      if (['draft', 'scheduled', 'published', 'archived'].includes(frontmatter.status)) return frontmatter.status;
      return 'published';
    };

    const formatBundleRules = (value) =>
      String(value || '')
        .split(/[,\s]+/)
        .map((part) => part.trim())
        .filter(Boolean)
        .map((part) => {
          const [minimumChapters, discountPercent] = part.split(':').map((item) => Number.parseInt(item.trim(), 10));
          return Number.isFinite(minimumChapters) && Number.isFinite(discountPercent)
            ? { minimumChapters, discountPercent }
            : null;
        })
        .filter(Boolean);

    const bundleRulesToInput = (rules) =>
      Array.isArray(rules)
        ? rules.map((rule) => `${rule.minimumChapters}:${rule.discountPercent}`).join(', ')
        : '';

    const formatCreditPacks = (value) =>
      String(value || '')
        .split(',')
        .map((part) => part.trim())
        .filter(Boolean)
        .map((part) => {
          const [credits, priceAmount, label] = part.split(':').map((item) => item.trim());
          const normalizedCredits = Number.parseInt(credits, 10);
          const normalizedPrice = Number.parseFloat(priceAmount);
          return Number.isFinite(normalizedCredits) && Number.isFinite(normalizedPrice)
            ? { credits: normalizedCredits, priceAmount: normalizedPrice, priceCurrency: 'USD', label: label || `${normalizedCredits} SC Credits` }
            : null;
        })
        .filter(Boolean);

    const creditPacksToInput = (packs) =>
      Array.isArray(packs)
        ? packs.map((pack) => `${pack.credits}:${pack.priceAmount}${pack.label ? `:${pack.label}` : ''}`).join(', ')
        : '';

    const emptyPricingDefaults = () => ({
      accessLevel: 'paid',
      pricing: {
        mode: 'chapter-paid',
        freeChapters: 20,
        chapterPriceAmount: 0,
        chapterPriceCurrency: 'USD',
        chapterCredits: 1,
        supporterPriceAmount: 0,
        supporterPriceCurrency: 'USD',
        tipsEnabled: false,
        tipAmounts: [],
        tipCurrency: 'USD',
        bundlePurchasesEnabled: false,
        chapterBundleDiscounts: [],
        creditPacks: [
          { credits: 10, priceAmount: 1, priceCurrency: 'USD', label: '10 SC Credits' },
          { credits: 50, priceAmount: 5, priceCurrency: 'USD', label: '50 SC Credits' },
          { credits: 100, priceAmount: 10, priceCurrency: 'USD', label: '100 SC Credits' }
        ],
        directChapterCheckoutEnabled: false,
        subscriptionEnabled: true,
        membershipCreditCost: 10,
        membershipDurationMonths: 1,
        membershipCoversPaidContent: true
      }
    });

    const buildPricingPayload = () => ({
      mode: elements.fields.pricingMode.value,
      freeChapters: Number(elements.fields.freeChapters.value || 0),
      chapterPriceAmount: 0,
      chapterPriceCurrency: 'USD',
      chapterCredits: elements.fields.chapterCredits.value ? Number(elements.fields.chapterCredits.value) : 1,
      supporterPriceAmount: 0,
      supporterPriceCurrency: 'USD',
      tipsEnabled: elements.fields.tipsEnabled.checked,
      tipAmounts: splitTags(elements.fields.tipAmounts.value).map(Number).filter(Number.isFinite),
      tipCurrency: 'USD',
      bundlePurchasesEnabled: elements.fields.bundlesEnabled.checked,
      chapterBundleDiscounts: formatBundleRules(elements.fields.bundles.value),
      creditPacks: formatCreditPacks(elements.fields.creditPacks.value),
      directChapterCheckoutEnabled: false,
      subscriptionEnabled: true,
      membershipCreditCost: 10,
      membershipDurationMonths: 1,
      membershipCoversPaidContent: true
    });

    const buildGlobalPricingPayload = () => ({
      mode: elements.globalPricing.pricingMode.value,
      freeChapters: Number(elements.globalPricing.freeChapters.value || 0),
      chapterPriceAmount: 0,
      chapterPriceCurrency: 'USD',
      chapterCredits: Math.max(1, Number(elements.globalPricing.chapterCredits.value || 1)),
      supporterPriceAmount: 0,
      supporterPriceCurrency: 'USD',
      tipsEnabled: elements.globalPricing.tipsEnabled.checked,
      tipAmounts: splitTags(elements.globalPricing.tipAmounts.value).map(Number).filter(Number.isFinite),
      tipCurrency: 'USD',
      bundlePurchasesEnabled: false,
      chapterBundleDiscounts: [],
      creditPacks: formatCreditPacks(elements.globalPricing.creditPacks.value),
      directChapterCheckoutEnabled: false,
      subscriptionEnabled: elements.globalPricing.subscriptionEnabled.checked,
      membershipCreditCost: Math.max(1, Number(elements.globalPricing.membershipCreditCost.value || 10)),
      membershipDurationMonths: Math.max(1, Number(elements.globalPricing.membershipMonths.value || 1)),
      membershipCoversPaidContent: elements.globalPricing.membershipCoversPaid.checked
    });

    const applyPricingToFields = (pricing = {}, accessLevel = 'free') => {
      elements.fields.accessLevel.value = accessLevel || 'free';
      elements.fields.pricingMode.value = pricing.mode || 'free';
      elements.fields.freeChapters.value = pricing.freeChapters || 0;
      elements.fields.chapterPrice.value = '';
      elements.fields.supporterPrice.value = '';
      elements.fields.chapterCredits.value = pricing.chapterCredits || 1;
      elements.fields.creditPacks.value = creditPacksToInput(pricing.creditPacks);
      elements.fields.tipsEnabled.checked = Boolean(pricing.tipsEnabled);
      elements.fields.tipAmounts.value = Array.isArray(pricing.tipAmounts) ? pricing.tipAmounts.join(', ') : '';
      elements.fields.bundlesEnabled.checked = Boolean(pricing.bundlePurchasesEnabled);
      elements.fields.bundles.value = bundleRulesToInput(pricing.chapterBundleDiscounts);
    };

    const applyPricingToGlobalControls = (template = getPricingDefaults()) => {
      const pricing = template.pricing || {};
      elements.globalPricing.accessLevel.value = template.accessLevel || 'paid';
      elements.globalPricing.pricingMode.value = pricing.mode || 'chapter-paid';
      elements.globalPricing.freeChapters.value = pricing.freeChapters ?? 20;
      elements.globalPricing.chapterCredits.value = pricing.chapterCredits || 1;
      elements.globalPricing.creditPacks.value = creditPacksToInput(pricing.creditPacks?.length ? pricing.creditPacks : emptyPricingDefaults().pricing.creditPacks);
      elements.globalPricing.subscriptionEnabled.checked = pricing.subscriptionEnabled !== false;
      elements.globalPricing.membershipCreditCost.value = pricing.membershipCreditCost || 10;
      elements.globalPricing.membershipMonths.value = pricing.membershipDurationMonths || 1;
      elements.globalPricing.membershipCoversPaid.checked = pricing.membershipCoversPaidContent !== false;
      elements.globalPricing.tipsEnabled.checked = Boolean(pricing.tipsEnabled);
      elements.globalPricing.tipAmounts.value = Array.isArray(pricing.tipAmounts) ? pricing.tipAmounts.join(', ') : '';
    };

    const getPricingDefaults = () => state.pricingDefaults || emptyPricingDefaults();

    const pricingTemplateSummary = (template = getPricingDefaults()) => {
      const pricing = template.pricing || {};
      const tips = pricing.tipsEnabled
        ? `打赏 ${Array.isArray(pricing.tipAmounts) && pricing.tipAmounts.length ? pricing.tipAmounts.join(' / ') : '未设金额'} USD`
        : '打赏关闭';
      const bundles = pricing.bundlePurchasesEnabled && Array.isArray(pricing.chapterBundleDiscounts) && pricing.chapterBundleDiscounts.length
        ? pricing.chapterBundleDiscounts.map((rule) => `${rule.minimumChapters}章-${rule.discountPercent}%`).join('，')
        : '多章折扣关闭';
      const packs = Array.isArray(pricing.creditPacks) && pricing.creditPacks.length
        ? pricing.creditPacks.map((pack) => `${pack.credits}点=${pack.priceAmount}${pack.priceCurrency || 'USD'}`).join('，')
        : '未设置点数包';
      const membership = pricing.subscriptionEnabled !== false
        ? `会员 ${pricing.membershipCreditCost || 10} 点 / ${pricing.membershipDurationMonths || 1} 个月`
        : '会员关闭';
      return `${template.accessLevel || 'paid'} · ${pricing.mode || 'chapter-paid'} · 免费 ${pricing.freeChapters || 0} 章 · 每章 ${pricing.chapterCredits || 1} 点 · ${packs} · ${membership} · ${tips} · ${bundles}`;
    };

    const renderPricingDefaults = () => {
      const template = getPricingDefaults();
      const prefix = template.isConfigured ? '当前全局：' : '尚未保存全局规则，当前使用推荐默认：';
      elements.pricingDefaultsSummary.textContent = `${prefix}${pricingTemplateSummary(template)}`;
      applyPricingToGlobalControls(template);
    };

    const formatMoney = (amount, currency = 'USD') => {
      const parsedAmount = Number.parseFloat(String(amount || ''));
      if (!Number.isFinite(parsedAmount)) return '未设置';
      try {
        return new Intl.NumberFormat(elements.fields.locale.value || 'zh-Hant', { style: 'currency', currency }).format(parsedAmount);
      } catch {
        return `${parsedAmount.toFixed(2)} ${currency}`;
      }
    };

    const formatDate = (value) => {
      if (!value) return '';
      const date = new Date(String(value).includes('T') ? value : String(value).replace(' ', 'T'));
      if (Number.isNaN(date.getTime())) return String(value);
      return date.toLocaleString('zh-Hant', { hour12: false });
    };

    const formatCredits = (value) => {
      const number = Number.parseInt(value || 0, 10);
      if (!Number.isFinite(number)) return '0';
      return number > 0 ? `+${number}` : String(number);
    };

    const statusTone = (status) => {
      if (['finished', 'confirmed', 'active'].includes(status)) return 'success';
      if (['failed', 'expired', 'refunded', 'disabled'].includes(status)) return 'error';
      return 'neutral';
    };

    const orderTitle = (order) => order.orderToken || order.providerPaymentId || `#${order.id}`;

    const pricingSourceLabel = (source) => ({
      'global-pricing-defaults': '全局收费规则',
      'backend-pricing-rules': 'D1 规则表',
      'backend-pricing-json': 'D1 内容 JSON',
      'serial-config': '旧 Markdown 生成配置',
      'env-default': '环境默认值'
    })[source] || source || '未知';

    const getEffectivePricingContext = () => {
      const entryType = elements.fields.entryType.value;
      const seriesSlug = entryType === 'novel_chapter'
        ? elements.fields.parentSlug.value.trim()
        : entryType === 'novel_series'
          ? elements.fields.slug.value.trim()
          : '';
      const chapterSlug = entryType === 'novel_chapter' ? elements.fields.slug.value.trim() : '';
      return {
        chapterSlug,
        entryType,
        locale: elements.fields.locale.value,
        seriesSlug,
        status: elements.fields.status.value,
        visibility: elements.fields.visibility.value
      };
    };

    const renderEffectivePricing = (pricing, context) => {
      const tips = Array.isArray(pricing.tipAmounts) && pricing.tipAmounts.length
        ? `${pricing.tipAmounts.map((amount) => formatMoney(amount, pricing.tipCurrency)).join(' / ')}`
        : pricing.tipsEnabled ? '已开启，但未配置金额' : '关闭';
      const bundles = Array.isArray(pricing.bundleOptions) && pricing.bundleOptions.length
        ? pricing.bundleOptions.map((option) => `${option.chapterCount} 章 ${formatMoney(option.priceAmount, option.priceCurrency)}，${option.discountPercent}% 折扣`).join('；')
        : Array.isArray(pricing.chapterBundleDiscounts) && pricing.chapterBundleDiscounts.length
          ? pricing.chapterBundleDiscounts.map((rule) => `${rule.chapters} 章 ${rule.discountPercent}% 折扣`).join('；')
          : '未开启';
      const creditPacks = Array.isArray(pricing.creditPacks) && pricing.creditPacks.length
        ? pricing.creditPacks.map((pack) => `${pack.label || `${pack.credits} 点`} ${formatMoney(pack.priceAmount, pack.priceCurrency)}`).join('；')
        : '未配置';
      const membership = pricing.subscriptionEnabled !== false
        ? `${pricing.membershipCreditCost || 10} 点兑换 ${pricing.membershipDurationMonths || 1} 个月，${pricing.membershipCoversPaidContent === false ? '不覆盖收费章节' : '覆盖收费章节'}`
        : '未开启';
      const warnings = [];
      if (context.status !== 'published' || context.visibility === 'private') {
        warnings.push('公共 API 只读取已发布且非私有内容；当前内容未发布或私有时，预览可能显示旧规则或降级规则。');
      }
      if (!['backend-pricing-rules', 'global-pricing-defaults'].includes(pricing.source)) {
        warnings.push(`当前未命中 D1 规则表，实际来源为：${pricingSourceLabel(pricing.source)}。`);
      }

      elements.effectivePricingPreview.innerHTML = `
        <div class="admin-pricing-summary">
          <article>
            <span>规则来源</span>
            <strong>${escapeHtml(pricingSourceLabel(pricing.source))}</strong>
            <small>${escapeHtml(context.seriesSlug)}${context.chapterSlug ? ` / ${escapeHtml(context.chapterSlug)}` : ''}</small>
          </article>
          <article>
            <span>收费模式</span>
            <strong>${escapeHtml(pricing.priceMode || 'free')}</strong>
            <small>免费章节：${escapeHtml(String(pricing.freeChapters ?? 0))}</small>
          </article>
          <article>
            <span>收费章节</span>
            <strong>${escapeHtml(String(pricing.chapterCredits || 1))} 点 / 章</strong>
            <small>直接 USD 解锁已停用</small>
          </article>
          <article>
            <span>会员</span>
            <strong>${escapeHtml(pricing.subscriptionEnabled === false ? '关闭' : `${pricing.membershipCreditCost || 10} 点`)}</strong>
            <small>${escapeHtml(pricing.subscriptionEnabled === false ? '不开放兑换' : `${pricing.membershipDurationMonths || 1} 个月会员`)}</small>
          </article>
        </div>
        <div class="admin-pricing-lines">
          <p><strong>打赏：</strong>${escapeHtml(tips)}</p>
          <p><strong>多章折扣：</strong>${escapeHtml(bundles)}</p>
          <p><strong>阅读点包：</strong>${escapeHtml(creditPacks)}</p>
          <p><strong>会员兑换：</strong>${escapeHtml(membership)}</p>
          ${warnings.map((warning) => `<p class="admin-pricing-warning">${escapeHtml(warning)}</p>`).join('')}
        </div>
      `;
    };

    const resetEffectivePricingPreview = (message = '保存或载入小说作品 / 章节后，这里会读取公共 pricing API 的最终返回结果。') => {
      elements.effectivePricingPreview.textContent = message;
      setEffectivePricingStatus('');
    };

    const refreshEffectivePricingPreview = async ({ silent = false } = {}) => {
      const context = getEffectivePricingContext();
      if (!context.seriesSlug) {
        resetEffectivePricingPreview('Blog / Devlog 不使用小说收费规则。');
        return;
      }

      const params = new URLSearchParams({
        series: context.seriesSlug,
        locale: context.locale
      });
      if (context.chapterSlug) params.set('chapter', context.chapterSlug);
      if (!silent) setEffectivePricingStatus('正在读取公共 pricing API。');

      try {
        const payload = await apiJson(`/api/novels/pricing?${params.toString()}`);
        renderEffectivePricing(payload.pricing || {}, context);
        setEffectivePricingStatus(`已读取公共 API：${pricingSourceLabel(payload.pricing?.source)}。`, 'success');
      } catch (error) {
        elements.effectivePricingPreview.textContent = '公共 pricing API 读取失败。';
        setEffectivePricingStatus(error.message, 'error');
      }
    };

    const renderMarkdownToHtml = (markdown) => {
      const lines = String(markdown || '').replace(/\r\n/g, '\n').split('\n');
      const html = [];
      let listOpen = false;

      const closeList = () => {
        if (listOpen) {
          html.push('</ul>');
          listOpen = false;
        }
      };

      lines.forEach((line) => {
        const trimmed = line.trim();
        if (!trimmed) {
          closeList();
          return;
        }
        if (trimmed.startsWith('### ')) {
          closeList();
          html.push(`<h3>${escapeHtml(trimmed.slice(4))}</h3>`);
          return;
        }
        if (trimmed.startsWith('## ')) {
          closeList();
          html.push(`<h2>${escapeHtml(trimmed.slice(3))}</h2>`);
          return;
        }
        if (trimmed.startsWith('# ')) {
          closeList();
          html.push(`<h1>${escapeHtml(trimmed.slice(2))}</h1>`);
          return;
        }
        if (/^[-*]\s+/.test(trimmed)) {
          if (!listOpen) {
            html.push('<ul>');
            listOpen = true;
          }
          html.push(`<li>${escapeHtml(trimmed.replace(/^[-*]\s+/, ''))}</li>`);
          return;
        }
        closeList();
        html.push(`<p>${escapeHtml(trimmed)}</p>`);
      });

      closeList();
      return html.join('\n');
    };

    const renderPreview = () => {
      const markdown = elements.fields.markdown.value.trim();
      if (!markdown) {
        elements.preview.textContent = '等待输入正文。';
        return '';
      }
      const html = renderMarkdownToHtml(markdown);
      elements.preview.innerHTML = html;
      return html;
    };

    const countWords = (value) => {
      const text = String(value || '').trim();
      if (!text) return 0;
      const latin = text.match(/[A-Za-z0-9]+/g) || [];
      const cjk = text.match(/[\u3400-\u9fff]/g) || [];
      return latin.length + cjk.length;
    };

    const mediaUrlFromKey = (value) => {
      const key = String(value || '').trim();
      if (!key) return '';
      if (/^https?:\/\//i.test(key) || key.startsWith('/')) return key;
      return `/api/content/media?key=${encodeURIComponent(key)}`;
    };

    const renderCoverPreview = () => {
      const key = elements.fields.coverR2Key.value.trim();
      const url = mediaUrlFromKey(key);
      elements.coverOpen.hidden = !url;
      elements.coverOpen.href = url || '#';
      if (!url) {
        elements.coverPreview.hidden = true;
        elements.coverPreview.innerHTML = '';
        return;
      }

      const alt = elements.fields.coverAlt.value.trim() || elements.fields.title.value.trim() || 'Content cover';
      elements.coverPreview.innerHTML = `
        <img src="${escapeHtml(url)}" alt="${escapeHtml(alt)}" loading="lazy" />
        <figcaption>${escapeHtml(key)}</figcaption>
      `;
      elements.coverPreview.hidden = false;
    };

    const uploadCoverImage = async () => {
      const [file] = elements.fields.coverFile.files || [];
      if (!file) {
        setCoverStatus('请先选择一张封面图片。', 'error');
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        setCoverStatus('封面图片不能超过 5MB。', 'error');
        return;
      }

      const formData = new FormData();
      const entryType = elements.fields.entryType.value;
      const title = elements.fields.title.value.trim();
      const slug = elements.fields.slug.value.trim() || slugify(title || file.name, entryType);
      formData.append('file', file);
      formData.append('mediaKind', 'covers');
      formData.append('slug', slug);
      formData.append('title', title);

      elements.coverUpload.disabled = true;
      setCoverStatus('正在上传封面到 R2。');
      try {
        const payload = await apiFormData('/admin/api/content/media', formData);
        elements.fields.coverR2Key.value = payload.media?.key || '';
        if (!elements.fields.coverAlt.value.trim()) {
          elements.fields.coverAlt.value = title ? `${title} 封面` : file.name;
        }
        elements.fields.coverFile.value = '';
        renderCoverPreview();
        setCoverStatus('封面已上传，保存内容后生效。', 'success');
      } catch (error) {
        setCoverStatus(error.message, 'error');
      } finally {
        elements.coverUpload.disabled = false;
      }
    };

    const fillFormFromEntry = (entry, body = {}) => {
      state.selectedEntryId = entry?.id || 0;
      elements.editorHeading.textContent = entry?.id ? `编辑：${entry.title}` : '创建后端内容';
      elements.fields.id.value = entry?.id || '';
      elements.fields.entryType.value = entry?.entryType || 'blog_post';
      elements.fields.locale.value = entry?.locale || 'zh-Hant';
      elements.fields.status.value = entry?.status || 'draft';
      elements.fields.visibility.value = entry?.visibility || 'public';
      elements.fields.slug.value = entry?.slug || '';
      elements.fields.parentSlug.value = entry?.parentSlug || '';
      elements.fields.title.value = entry?.title || '';
      elements.fields.subtitle.value = entry?.subtitle || '';
      elements.fields.author.value = entry?.authorName || 'Station Cat';
      elements.fields.tags.value = (entry?.tags || []).join(', ');
      elements.fields.chapterNumber.value = entry?.chapterNumber || '';
      elements.fields.volumeTitle.value = entry?.volumeTitle || '';
      elements.fields.publishedAt.value = toDatetimeLocal(entry?.publishedAt);
      elements.fields.sortOrder.value = entry?.sortOrder || 0;
      elements.fields.featured.checked = Boolean(entry?.featured);
      elements.fields.description.value = entry?.description || '';
      elements.fields.excerpt.value = entry?.excerpt || '';
      elements.fields.accessLevel.value = entry?.accessLevel || 'free';
      elements.fields.coverR2Key.value = entry?.coverR2Key || '';
      elements.fields.coverAlt.value = entry?.coverAlt || '';
      elements.fields.sourceRef.value = entry?.sourceRef || '';
      elements.fields.revisionSummary.value = '';
      elements.fields.markdown.value = body.markdown || '';
      elements.fields.coverFile.value = '';

      applyPricingToFields(entry?.pricing || {}, entry?.accessLevel || 'free');

      renderPreview();
      renderCoverPreview();
      setCoverStatus('');
      updateConditionalFields();
      resetEffectivePricingPreview();
    };

    const resetForm = (entryType = 'blog_post') => {
      const pricingDefaults = entryType === 'novel_series' || entryType === 'novel_chapter'
        ? getPricingDefaults()
        : emptyPricingDefaults();
      fillFormFromEntry({
        entryType,
        locale: 'zh-Hant',
        status: 'draft',
        visibility: 'public',
        accessLevel: pricingDefaults.accessLevel,
        authorName: 'Station Cat',
        tags: [],
        pricing: pricingDefaults.pricing,
        sortOrder: 0
      });
      setSaveStatus('');
      resetEffectivePricingPreview();
    };

    const updateConditionalFields = () => {
      const isChapter = elements.fields.entryType.value === 'novel_chapter';
      elements.fields.parentSlug.closest('label').hidden = !isChapter;
      elements.fields.chapterNumber.closest('label').hidden = !isChapter;
      elements.fields.volumeTitle.closest('label').hidden = !isChapter;
      elements.fields.parentSlug.required = isChapter;
      elements.fields.chapterNumber.required = isChapter;
    };

    const entryTypeLabel = (type) => ({
      blog_post: 'Blog',
      novel_series: '作品',
      novel_chapter: '章节'
    })[type] || type;

    const renderEmpty = (target, message) => {
      target.innerHTML = `<p class="admin-empty-list">${escapeHtml(message)}</p>`;
    };

    const renderContentList = () => {
      if (!state.entries.length) {
        renderEmpty(elements.contentList, '还没有后端内容记录。');
        return;
      }

      elements.contentList.innerHTML = '';
      state.entries.forEach((entry) => {
        const button = document.createElement('button');
        button.className = `admin-v2-entry${entry.id === state.selectedEntryId ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(entry.title)}</span>
          <small>${entryTypeLabel(entry.entryType)} · ${entry.locale} · ${entry.status} · ${entry.accessLevel}</small>
          <small>${escapeHtml(entry.parentSlug ? `${entry.parentSlug}/${entry.slug}` : entry.slug)}</small>
        `;
        button.addEventListener('click', () => loadEntryForEdit(entry.id));
        elements.contentList.append(button);
      });
    };

    const importStatusTone = (status) => {
      if (['completed', 'completed_with_warnings', 'reviewed'].includes(status)) return 'success';
      if (['failed'].includes(status)) return 'error';
      return 'neutral';
    };

    const importTitle = (item) => item?.summary?.seriesTitle || item?.requestId || `Import #${item?.id || ''}`;

    const importPricingSummary = (item) => {
      const pricing = item?.summary?.pricing || {};
      const bundles = pricing.bundlePurchasesEnabled && Array.isArray(pricing.chapterBundleDiscounts) && pricing.chapterBundleDiscounts.length
        ? pricing.chapterBundleDiscounts.map((rule) => `${rule.minimumChapters}章 ${rule.discountPercent}% off`).join('，')
        : '多章折扣未开启';
      const creditPacks = Array.isArray(pricing.creditPacks) && pricing.creditPacks.length
        ? pricing.creditPacks.map((pack) => `${pack.credits}点/${formatMoney(pack.priceAmount, pack.priceCurrency || 'USD')}`).join('，')
        : '阅读点包未配置';
      const membership = pricing.subscriptionEnabled !== false
        ? `会员 ${pricing.membershipCreditCost || 10} 点/${pricing.membershipDurationMonths || 1}个月`
        : '会员关闭';
      return `${pricing.mode || 'free'} · 免费 ${pricing.freeChapters || 0} 章 · ${pricing.chapterCredits || 1} 点/章 · ${membership} · ${bundles} · ${creditPacks}`;
    };

    const renderImportList = () => {
      if (!state.imports.length) {
        renderEmpty(elements.importsList, '暂无 NovelForge 导入记录。');
        elements.importDetail.innerHTML = '<p class="admin-empty-list">NovelForge 软件导入后，这里会出现可审核批次。</p>';
        return;
      }

      elements.importsList.innerHTML = '';
      state.imports.forEach((item) => {
        const button = document.createElement('button');
        button.className = `admin-v2-entry${item.id === state.selectedImportId ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(importTitle(item))}</span>
          <small>${escapeHtml(item.status)} · ${escapeHtml(formatDate(item.updatedAt))}</small>
          <small>${escapeHtml(String(item.summary?.entryCount || 0))} 条内容 · 草稿 ${escapeHtml(String(item.summary?.draftCount || 0))} · 警告 ${escapeHtml(String(item.warnings?.length || 0))}</small>
        `;
        button.addEventListener('click', () => {
          state.selectedImportId = item.id;
          renderImportList();
          renderImportDetail();
        });
        elements.importsList.append(button);
      });
    };

    const renderImportDetail = () => {
      const item = state.imports.find((entry) => entry.id === state.selectedImportId) || state.imports[0];
      if (!item) {
        elements.importDetail.innerHTML = '<p class="admin-empty-list">选择一个 NovelForge 导入批次查看详情。</p>';
        return;
      }
      state.selectedImportId = item.id;
      const entries = item.entries || [];
      const warnings = item.warnings || [];
      const errors = item.errors || [];
      const canPublish = (item.summary?.draftCount || 0) > 0;
      elements.importDetail.innerHTML = `
        <div class="admin-v2-section-heading">
          <div>
            <p class="station-kicker">Import #${escapeHtml(String(item.id))}</p>
            <h3>${escapeHtml(importTitle(item))}</h3>
          </div>
          <span class="admin-status-pill" data-tone="${importStatusTone(item.status)}">${escapeHtml(item.status)}</span>
        </div>
        <div class="admin-detail-grid">
          <article><span>内容</span><strong>${escapeHtml(String(item.summary?.entryCount || 0))}</strong><small>章节 ${escapeHtml(String(item.summary?.chapterCount || 0))}</small></article>
          <article><span>草稿</span><strong>${escapeHtml(String(item.summary?.draftCount || 0))}</strong><small>可批量发布</small></article>
          <article><span>更新</span><strong>${escapeHtml(String(item.entriesUpdated || 0))}</strong><small>创建 ${escapeHtml(String(item.entriesCreated || 0))}</small></article>
          <article><span>时间</span><strong>${escapeHtml(formatDate(item.updatedAt) || '-')}</strong><small>${escapeHtml(formatDate(item.createdAt) || '')}</small></article>
        </div>
        <div class="admin-pricing-lines">
          <p><strong>Request ID：</strong><code class="admin-import-code">${escapeHtml(item.requestId || '')}</code></p>
          <p><strong>导入备份：</strong><code class="admin-import-code">${escapeHtml(item.r2Key || '未写入 R2 备份')}</code></p>
          <p><strong>收费摘要：</strong>${escapeHtml(importPricingSummary(item))}</p>
          ${warnings.map((warning) => `<p class="admin-pricing-warning"><strong>Warning：</strong>${escapeHtml(warning.message || warning)}</p>`).join('')}
          ${errors.map((error) => `<p class="admin-pricing-warning"><strong>Error：</strong>${escapeHtml(error.message || error)}</p>`).join('')}
        </div>
        <div class="button-row">
          <button class="button button-primary" id="import-publish-drafts" type="button" ${canPublish ? '' : 'disabled'}>发布本批草稿</button>
          <button class="button button-secondary" id="import-detail-refresh" type="button">刷新本批次</button>
        </div>
        <section class="admin-detail-section">
          <h4>关联内容</h4>
          ${entries.length ? entries.map((entry) => `
            <article class="admin-v2-row admin-import-entry">
              <strong>${escapeHtml(entry.title || entry.slug)}</strong>
              <span>${escapeHtml(entryTypeLabel(entry.entryType))} · ${escapeHtml(entry.locale)} · ${escapeHtml(entry.status)} · ${escapeHtml(entry.accessLevel)}</span>
              <small>${escapeHtml(entry.parentSlug ? `${entry.parentSlug}/${entry.slug}` : entry.slug)} · ${escapeHtml(entry.remoteId || '')}${entry.coverRemoteId ? ` · ${escapeHtml(entry.coverRemoteId)}` : ''}</small>
              <div class="button-row admin-import-actions">
                <button class="button button-secondary" type="button" data-import-edit-id="${escapeHtml(String(entry.id))}">编辑</button>
                <a class="button button-secondary" href="${escapeHtml(entry.adminUrl)}">后台链接</a>
                ${entry.publicUrl ? `<a class="button button-secondary" href="${escapeHtml(entry.publicUrl)}" target="_blank" rel="noreferrer">公开页</a>` : ''}
              </div>
            </article>
          `).join('') : '<p class="admin-empty-list">这条导入记录没有找到关联内容。</p>'}
        </section>
      `;

      $('#import-publish-drafts')?.addEventListener('click', publishSelectedImport);
      $('#import-detail-refresh')?.addEventListener('click', () => loadImportReviews({ importId: item.id }));
      $$('[data-import-edit-id]').forEach((button) => {
        button.addEventListener('click', () => openImportEntryForEdit(button.dataset.importEditId));
      });
    };

    const loadImportReviews = async ({ importId = 0 } = {}) => {
      const params = new URLSearchParams({ type: 'novelforge', limit: '50' });
      if (importId) params.set('id', String(importId));
      const payload = await apiJson(`/admin/api/content/imports?${params.toString()}`);
      if (importId) {
        const [updatedImport] = payload.imports || [];
        if (updatedImport) {
          state.imports = state.imports.map((item) => (item.id === updatedImport.id ? updatedImport : item));
          if (!state.imports.find((item) => item.id === updatedImport.id)) state.imports.unshift(updatedImport);
        }
      } else {
        state.imports = payload.imports || [];
        if (!state.imports.find((item) => item.id === state.selectedImportId)) {
          state.selectedImportId = state.imports[0]?.id || 0;
        }
      }
      renderImportList();
      renderImportDetail();
      setStatus(`已载入 ${state.imports.length} 个 NovelForge 导入批次。`, 'success');
    };

    const publishSelectedImport = async () => {
      if (!state.selectedImportId) return;
      const button = $('#import-publish-drafts');
      if (button) button.disabled = true;
      setStatus('正在发布这批 NovelForge 草稿。');
      try {
        const payload = await apiJson('/admin/api/content/imports/review', {
          method: 'POST',
          body: JSON.stringify({ action: 'publish', importId: state.selectedImportId })
        });
        if (payload.import) {
          state.imports = state.imports.map((item) => (item.id === payload.import.id ? payload.import : item));
        }
        renderImportList();
        renderImportDetail();
        await Promise.all([loadEntries(), loadAuditLogs()]);
        setStatus(payload.message || '导入草稿已发布。', 'success');
      } catch (error) {
        setStatus(error.message, 'error');
      } finally {
        if (button) button.disabled = false;
      }
    };

    const openImportEntryForEdit = async (entryId) => {
      const id = Number.parseInt(entryId || '', 10);
      if (!Number.isFinite(id) || id <= 0) return;
      await switchTab('content');
      await loadEntryForEdit(id);
    };

    const loadSchema = async () => {
      const schema = await apiJson('/admin/api/content/schema');
      state.schema = schema;
      elements.stage.textContent = `Stage ${schema.stage}`;
      elements.storageBadge.textContent = schema.storage?.contentBucketConfigured ? 'R2 已连接' : 'R2 未配置';
      elements.storageBadge.dataset.tone = schema.storage?.contentBucketConfigured ? 'success' : 'error';
    };

    const loadPricingDefaults = async ({ silent = false } = {}) => {
      if (!silent) setPricingDefaultsStatus('正在读取收费模板。');
      try {
        const payload = await apiJson('/admin/api/content/pricing-defaults');
        state.pricingDefaults = payload.template || emptyPricingDefaults();
        state.pricingDefaultsSetupRequired = Boolean(payload.setupRequired);
        renderPricingDefaults();
        if (payload.setupRequired) {
          setPricingDefaultsStatus(payload.message || '需要先应用 0008_admin_content_settings.sql。', 'error');
        } else if (!silent) {
          setPricingDefaultsStatus('收费模板已刷新。', 'success');
        }
      } catch (error) {
        state.pricingDefaults = emptyPricingDefaults();
        renderPricingDefaults();
        setPricingDefaultsStatus(error.message, 'error');
      }
    };

    const savePricingDefaults = async () => {
      elements.pricingDefaultsSave.disabled = true;
      setPricingDefaultsStatus('正在保存全局收费规则。');
      try {
        const payload = await apiJson('/admin/api/content/pricing-defaults', {
          method: 'POST',
          body: JSON.stringify({
            accessLevel: elements.globalPricing.accessLevel.value,
            pricing: buildGlobalPricingPayload()
          })
        });
        state.pricingDefaults = payload.template || emptyPricingDefaults();
        state.pricingDefaultsSetupRequired = false;
        renderPricingDefaults();
        applyPricingDefaults();
        setPricingDefaultsStatus('全局收费规则已保存，并会对全部书籍生效。', 'success');
      } catch (error) {
        setPricingDefaultsStatus(error.message, 'error');
      } finally {
        elements.pricingDefaultsSave.disabled = false;
      }
    };

    const applyPricingDefaults = () => {
      const template = getPricingDefaults();
      applyPricingToFields(template.pricing, template.accessLevel);
      resetEffectivePricingPreview('已套用全局收费规则到当前编辑表单。全局规则保存后会直接影响所有书籍。');
      setPricingDefaultsStatus('已套用全局规则到当前表单。', 'success');
    };

    const loadEntries = async ({ autoSelect = false } = {}) => {
      const params = new URLSearchParams();
      if (elements.filters.type.value) params.set('type', elements.filters.type.value);
      if (elements.filters.status.value) params.set('status', elements.filters.status.value);
      const payload = await apiJson(`/admin/api/content/entries?${params.toString()}`);
      state.entries = payload.entries || [];
      const selectedEntryStillVisible = state.entries.some((entry) => entry.id === state.selectedEntryId);
      renderContentList();
      if (autoSelect && state.entries.length) {
        const entryId = selectedEntryStillVisible && state.selectedEntryId ? state.selectedEntryId : state.entries[0].id;
        await loadEntryForEdit(entryId);
        return;
      }
      setStatus(`已载入 ${state.entries.length} 条后端内容。`, 'success');
    };

    const loadEntryForEdit = async (id) => {
      setStatus('正在读取正文。');
      const payload = await apiJson(`/admin/api/content/body?id=${encodeURIComponent(id)}`);
      fillFormFromEntry(payload.entry, payload.body);
      await loadRevisions(id);
      renderContentList();
      const pricingRules = Array.isArray(payload.pricingRules) ? payload.pricingRules.length : 0;
      setStatus(`已载入：${payload.entry.title}，收费规则 ${pricingRules} 条。`, 'success');
      await refreshEffectivePricingPreview({ silent: true });
    };

    const loadRevisions = async (id = state.selectedEntryId) => {
      if (!id) {
        renderEmpty(elements.revisionList, '保存后会显示修订记录。');
        return;
      }
      const payload = await apiJson(`/admin/api/content/revisions?id=${encodeURIComponent(id)}`);
      const revisions = payload.revisions || [];
      if (!revisions.length) {
        renderEmpty(elements.revisionList, '暂无修订记录。');
        return;
      }
      elements.revisionList.innerHTML = revisions.map((revision) => `
        <article class="admin-v2-row">
          <strong>#${revision.revisionNumber} · ${escapeHtml(revision.status)}</strong>
          <span>${escapeHtml(revision.summary || '未填写修订说明')}</span>
          <small>${escapeHtml(revision.createdBy || 'admin')} · ${escapeHtml(revision.createdAt || '')}</small>
        </article>
      `).join('');
    };

    const buildPayload = () => {
      const markdown = elements.fields.markdown.value.trim();
      const html = renderPreview();
      const wordCount = countWords(markdown);
      const entryType = elements.fields.entryType.value;
      const slug = elements.fields.slug.value.trim() || slugify(elements.fields.title.value, entryType);

      return {
        id: elements.fields.id.value || undefined,
        entryType,
        locale: elements.fields.locale.value,
        status: elements.fields.status.value,
        visibility: elements.fields.visibility.value,
        accessLevel: elements.fields.accessLevel.value,
        slug,
        parentSlug: entryType === 'novel_chapter' ? elements.fields.parentSlug.value.trim() : '',
        title: elements.fields.title.value.trim(),
        subtitle: elements.fields.subtitle.value.trim(),
        authorName: elements.fields.author.value.trim() || 'Station Cat',
        tags: splitTags(elements.fields.tags.value),
        chapterNumber: elements.fields.chapterNumber.value ? Number(elements.fields.chapterNumber.value) : undefined,
        volumeTitle: elements.fields.volumeTitle.value.trim(),
        publishedAt: elements.fields.publishedAt.value,
        sortOrder: Number(elements.fields.sortOrder.value || 0),
        featured: elements.fields.featured.checked,
        description: elements.fields.description.value.trim(),
        excerpt: elements.fields.excerpt.value.trim(),
        coverR2Key: elements.fields.coverR2Key.value.trim(),
        coverAlt: elements.fields.coverAlt.value.trim(),
        sourceRef: elements.fields.sourceRef.value.trim(),
        revisionSummary: elements.fields.revisionSummary.value.trim(),
        markdown,
        html,
        wordCount,
        readingMinutes: Math.max(1, Math.ceil(wordCount / 450)),
        pricing: buildPricingPayload(),
        metadata: {
          adminVersion: '8C',
          importedFromAdminV2: true
        }
      };
    };

    const saveContent = async (event) => {
      event.preventDefault();
      const payload = buildPayload();
      if (!payload.title || !payload.slug) {
        setSaveStatus('标题和 Slug 必填。', 'error');
        return;
      }
      if (payload.entryType === 'novel_chapter' && (!payload.parentSlug || !payload.chapterNumber)) {
        setSaveStatus('小说章节需要 seriesSlug 和章节序号。', 'error');
        return;
      }

      $('#content-save').disabled = true;
      setSaveStatus('正在保存到 D1 / R2。');
      try {
        const result = await apiJson('/admin/api/content/entries', {
          method: 'POST',
          body: JSON.stringify(payload)
        });
        const pricingRules = Array.isArray(result.pricingRules) ? result.pricingRules.length : 0;
        setSaveStatus(`保存成功，修订 #${result.revisionNumber}，同步 ${pricingRules} 条收费规则。`, 'success');
        fillFormFromEntry(result.entry, { markdown: payload.markdown, html: payload.html });
        await refreshEffectivePricingPreview({ silent: true });
        await Promise.all([loadEntries(), loadRevisions(result.entry.id), loadAuditLogs()]);
      } catch (error) {
        setSaveStatus(error.message, 'error');
      } finally {
        $('#content-save').disabled = false;
      }
    };

    const openWorkerPreview = async () => {
      const payload = buildPayload();
      if (!payload.title || !payload.slug) {
        setSaveStatus('标题和 Slug 必填，才能打开 Worker 预览。', 'error');
        return;
      }
      if (payload.entryType === 'novel_chapter' && (!payload.parentSlug || !payload.chapterNumber)) {
        setSaveStatus('小说章节预览需要 seriesSlug 和章节序号。', 'error');
        return;
      }

      const previewWindow = window.open('', '_blank');
      if (!previewWindow) {
        setSaveStatus('浏览器阻止了预览窗口，请允许弹窗后重试。', 'error');
        return;
      }
      previewWindow.document.write('<!doctype html><title>Station Cat Preview</title><p style="font-family: system-ui; padding: 24px;">正在生成 Worker 预览...</p>');
      previewWindow.document.close();

      const button = $('#content-worker-preview-button');
      button.disabled = true;
      setSaveStatus('正在生成 Worker 预览。');
      try {
        const response = await fetch('/admin/api/content/preview', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const contentType = response.headers.get('content-type') || '';
        const text = await response.text();
        if (!response.ok) {
          let message = `Preview failed: ${response.status}`;
          if (contentType.includes('application/json')) {
            try {
              message = JSON.parse(text).message || message;
            } catch {}
          }
          throw new Error(message);
        }
        previewWindow.document.open();
        previewWindow.document.write(text);
        previewWindow.document.close();
        setSaveStatus('Worker 预览已打开。', 'success');
      } catch (error) {
        previewWindow.document.open();
        previewWindow.document.write(`<!doctype html><title>Preview Error</title><p style="font-family: system-ui; padding: 24px;">${escapeHtml(error.message)}</p>`);
        previewWindow.document.close();
        setSaveStatus(error.message, 'error');
      } finally {
        button.disabled = false;
      }
    };

    const applyImportedMarkdown = (markdown) => {
      const parsed = parseMarkdownDocument(markdown);
      const frontmatter = parsed.frontmatter;
      const entryType = detectEntryType(frontmatter);
      resetForm(entryType);

      elements.fields.entryType.value = entryType;
      elements.fields.locale.value = frontmatter.language || frontmatter.locale || 'zh-Hant';
      elements.fields.status.value = normalizeBackendStatus(frontmatter);
      elements.fields.title.value = frontmatter.title || '';
      elements.fields.subtitle.value = frontmatter.subtitle || frontmatter.tagline || '';
      elements.fields.description.value = frontmatter.description || '';
      elements.fields.excerpt.value = frontmatter.excerpt || '';
      elements.fields.author.value = frontmatter.author || 'Station Cat';
      elements.fields.tags.value = Array.isArray(frontmatter.tags) ? frontmatter.tags.join(', ') : '';
      elements.fields.slug.value = frontmatter.chapterSlug || frontmatter.slug || frontmatter.seriesSlug || slugify(frontmatter.title, entryType);
      elements.fields.parentSlug.value = frontmatter.seriesSlug || frontmatter.parentSlug || '';
      elements.fields.chapterNumber.value = frontmatter.chapterNumber || frontmatter.number || '';
      elements.fields.publishedAt.value = toDatetimeLocal(frontmatter.publishedAt || frontmatter.pubDate || '');
      elements.fields.coverR2Key.value = frontmatter.coverImage || '';
      elements.fields.coverAlt.value = frontmatter.coverAlt || '';
      elements.fields.accessLevel.value = frontmatter.access || frontmatter.accessLevel || 'free';
      elements.fields.pricingMode.value = frontmatter.priceMode || 'free';
      elements.fields.freeChapters.value = frontmatter.freeChapters || 0;
      elements.fields.chapterPrice.value = frontmatter.chapterPriceAmount || '';
      elements.fields.supporterPrice.value = frontmatter.supporterPriceAmount || '';
      elements.fields.chapterCredits.value = frontmatter.chapterCredits || '';
      elements.fields.tipsEnabled.checked = Boolean(frontmatter.tipsEnabled);
      elements.fields.tipAmounts.value = Array.isArray(frontmatter.tipAmounts) ? frontmatter.tipAmounts.join(', ') : '';
      elements.fields.bundlesEnabled.checked = Boolean(frontmatter.bundlePurchasesEnabled);
      elements.fields.bundles.value = bundleRulesToInput(frontmatter.chapterBundleDiscounts);
      elements.fields.creditPacks.value = creditPacksToInput(frontmatter.creditPacks || frontmatter.readerCreditPacks);
      elements.fields.markdown.value = parsed.body;
      elements.fields.sourceRef.value = 'markdown-import';
      elements.fields.revisionSummary.value = 'Imported from Markdown file';

      updateConditionalFields();
      renderPreview();
      renderCoverPreview();
      setSaveStatus('Markdown 已导入，检查字段后即可保存。', 'success');
    };

    const loadOrders = async () => {
      const params = new URLSearchParams({ limit: '80' });
      if (elements.filters.orderStatus.value) params.set('status', elements.filters.orderStatus.value);
      if (elements.filters.orderType.value) params.set('orderType', elements.filters.orderType.value);
      if (elements.filters.orderEmail.value.trim()) params.set('email', elements.filters.orderEmail.value.trim());
      if (elements.filters.orderSeries.value.trim()) params.set('series', elements.filters.orderSeries.value.trim());
      const payload = await apiJson(`/admin/api/novels/payments/orders?${params.toString()}`);
      const orders = payload.orders || [];
      state.orders = orders;
      if (!orders.length) {
        renderEmpty(elements.ordersList, '暂无订单。');
        elements.orderDetail.innerHTML = '<p class="admin-empty-list">没有可查看的订单详情。</p>';
        return;
      }
      elements.ordersList.innerHTML = '';
      orders.forEach((order) => {
        const button = document.createElement('button');
        button.className = `admin-v2-entry${order.orderToken === state.selectedOrderToken ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(orderTitle(order))}</span>
          <small>${escapeHtml(order.status)} · ${escapeHtml(order.orderType)} · ${escapeHtml(formatMoney(order.priceAmount, order.priceCurrency))}</small>
          <small>${escapeHtml(order.accountEmail || order.customerEmail || '无账户')} · ${escapeHtml(order.seriesSlug || '')}${order.chapterSlug ? `/${escapeHtml(order.chapterSlug)}` : ''}</small>
        `;
        button.addEventListener('click', () => loadOrderDetail(order.orderToken || order.id));
        elements.ordersList.append(button);
      });
      setStatus(`已载入 ${orders.length} 笔订单。`, 'success');
    };

    const renderOrderDetail = (detail) => {
      const order = detail.order;
      const fulfillment = detail.fulfillment || {};
      const events = detail.events || [];
      const canFulfill = ['confirmed', 'finished'].includes(order.status) && !fulfillment.complete && order.orderType !== 'tip';
      elements.orderDetail.innerHTML = `
        <div class="admin-v2-section-heading">
          <div>
            <p class="station-kicker">Order Detail</p>
            <h3>${escapeHtml(orderTitle(order))}</h3>
          </div>
          <span class="admin-status-pill" data-tone="${statusTone(order.status)}">${escapeHtml(order.status)}</span>
        </div>
        <div class="admin-detail-grid">
          <article><span>类型</span><strong>${escapeHtml(order.orderType)}</strong></article>
          <article><span>金额</span><strong>${escapeHtml(formatMoney(order.priceAmount, order.priceCurrency))}</strong></article>
          <article><span>支付</span><strong>${escapeHtml(order.payAmount || '-')} ${escapeHtml(order.payCurrency || '')}</strong></article>
          <article><span>履约</span><strong>${fulfillment.complete ? '已完成' : fulfillment.needsReview ? '需排查' : fulfillment.pending ? '等待中' : '未完成'}</strong></article>
        </div>
        <div class="admin-pricing-lines">
          <p><strong>读者：</strong>${escapeHtml(order.accountEmail || order.customerEmail || '无账户')}</p>
          <p><strong>内容：</strong>${escapeHtml(order.seriesSlug || '-')}${order.chapterSlug ? ` / ${escapeHtml(order.chapterSlug)}` : ''}</p>
          <p><strong>Provider：</strong>${escapeHtml(order.providerStatus || '-')} · ${escapeHtml(order.providerPaymentId || order.providerInvoiceId || '-')}</p>
          <p><strong>创建 / 更新：</strong>${escapeHtml(formatDate(order.createdAt))} / ${escapeHtml(formatDate(order.updatedAt))}</p>
          <p><strong>履约原因：</strong>${escapeHtml(fulfillment.reason || '-')}</p>
        </div>
        <div class="button-row">
          ${canFulfill ? '<button class="button button-primary" id="order-fulfill" type="button">重跑履约</button>' : ''}
          ${order.paymentUrl ? `<a class="button button-secondary" href="${escapeHtml(order.paymentUrl)}" target="_blank" rel="noreferrer">打开支付页</a>` : ''}
        </div>
        <section class="admin-detail-section">
          <h4>支付事件</h4>
          ${events.length ? events.map((event) => `
            <article class="admin-v2-row">
              <strong>${escapeHtml(event.status || event.eventType)}</strong>
              <span>${event.signatureValid ? '签名有效' : '签名未确认'} · ${escapeHtml(event.providerPaymentId || '')}</span>
              <small>${escapeHtml(formatDate(event.receivedAt))}</small>
            </article>
          `).join('') : '<p class="admin-empty-list">暂无 IPN 事件。</p>'}
        </section>
      `;
      const fulfillButton = $('#order-fulfill');
      if (fulfillButton) fulfillButton.addEventListener('click', () => fulfillOrder(order));
    };

    const loadOrderDetail = async (orderTokenOrId) => {
      const value = String(orderTokenOrId || '');
      if (!value) return;
      const params = new URLSearchParams(Number.isFinite(Number(value)) ? { id: value } : { order: value });
      state.selectedOrderToken = value;
      elements.orderDetail.innerHTML = '<p class="admin-empty-list">正在读取订单详情。</p>';
      const detail = await apiJson(`/admin/api/novels/payments/order?${params.toString()}`);
      renderOrderDetail(detail);
      await loadOrders();
    };

    const fulfillOrder = async (order) => {
      const result = await apiJson('/admin/api/novels/payments/orders/fulfill', {
        method: 'POST',
        body: JSON.stringify({ id: order.id, orderToken: order.orderToken })
      });
      renderOrderDetail(result);
      await Promise.all([loadOrders(), loadAuditLogs()]);
      setStatus('订单履约已重跑。', 'success');
    };

    const loadAccounts = async () => {
      const params = new URLSearchParams({ limit: '80' });
      if (elements.filters.accountEmail.value.trim()) params.set('email', elements.filters.accountEmail.value.trim());
      if (elements.filters.accountStatus.value) params.set('status', elements.filters.accountStatus.value);
      const payload = await apiJson(`/admin/api/novels/readers/accounts?${params.toString()}`);
      const accounts = payload.accounts || [];
      state.accounts = accounts;
      if (!accounts.length) {
        renderEmpty(elements.accountsList, '暂无读者账户。');
        elements.accountDetail.innerHTML = '<p class="admin-empty-list">没有可查看的账户详情。</p>';
        return;
      }
      elements.accountsList.innerHTML = '';
      accounts.forEach((account) => {
        const button = document.createElement('button');
        button.className = `admin-v2-entry${account.id === state.selectedAccountId ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(account.email)}</span>
          <small>${escapeHtml(account.status)} · 余额 ${escapeHtml(String(account.creditAccount?.balanceCredits || 0))} ${escapeHtml(account.creditAccount?.unitLabel || 'SC Credits')}</small>
          <small>订单 ${escapeHtml(String(account.stats?.orderCount || 0))} · 授权 ${escapeHtml(String(account.stats?.activeEntitlementCount || 0))} · 最近订单 ${escapeHtml(formatDate(account.stats?.latestOrderAt) || '-')}</small>
        `;
        button.addEventListener('click', () => loadAccountDetail(account.id));
        elements.accountsList.append(button);
      });
      setStatus(`已载入 ${accounts.length} 个读者账户。`, 'success');
    };

    const renderAccountDetail = (detail) => {
      const account = detail.account || {};
      const credits = detail.credits || account.creditAccount || {};
      const membership = detail.membership || null;
      const membershipSettings = detail.membershipSettings || {};
      const ledger = detail.creditLedger || [];
      const entitlements = detail.entitlements || [];
      const orders = detail.orders || [];
      elements.accountDetail.innerHTML = `
        <div class="admin-v2-section-heading">
          <div>
            <p class="station-kicker">Reader Detail</p>
            <h3>${escapeHtml(account.email || '')}</h3>
          </div>
          <span class="admin-status-pill" data-tone="${statusTone(account.status)}">${escapeHtml(account.status || '')}</span>
        </div>
        <div class="admin-detail-grid">
          <article><span>余额</span><strong>${escapeHtml(String(credits.balanceCredits || 0))}</strong></article>
          <article><span>累计购买</span><strong>${escapeHtml(String(credits.lifetimePurchasedCredits || 0))}</strong></article>
          <article><span>累计消耗</span><strong>${escapeHtml(String(credits.lifetimeSpentCredits || 0))}</strong></article>
          <article><span>会员</span><strong>${escapeHtml(membership?.active ? '有效' : '未开通')}</strong><small>${escapeHtml(membership?.expiresAt ? `至 ${formatDate(membership.expiresAt)}` : `${membershipSettings.membershipCreditCost || 10} 点/月`)}</small></article>
          <article><span>有效授权</span><strong>${escapeHtml(String(account.stats?.activeEntitlementCount || entitlements.filter((item) => !item.revokedAt).length))}</strong></article>
        </div>
        <form class="admin-v2-form admin-credit-form" id="credit-adjust-form">
          <div class="admin-v2-form-grid">
            <label>
              调整点数
              <input id="credit-adjust-delta" type="number" step="1" placeholder="例如 10 或 -3" required />
            </label>
            <label>
              关联 seriesSlug
              <input id="credit-adjust-series" placeholder="可选" />
            </label>
            <label>
              关联 chapterSlug
              <input id="credit-adjust-chapter" placeholder="可选" />
            </label>
            <label>
              来源备注
              <input id="credit-adjust-source" placeholder="manual-support-case" />
