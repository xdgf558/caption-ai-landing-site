      }
    });

    const buildPricingPayload = () => ({
      mode: elements.fields.pricingMode.value,
      freeChapters: Number(elements.fields.freeChapters.value || 0),
      chapterPriceAmount: 0,
      chapterPriceCurrency: 'USD',
      chapterCredits: elements.fields.chapterCredits.value ? Number(elements.fields.chapterCredits.value) : 1,
      supporterPriceAmount: 0,
      supporterPriceCurrency: 'USD',
      tipsEnabled: elements.fields.tipsEnabled.checked,
      tipAmounts: splitTags(elements.fields.tipAmounts.value).map(Number).filter(Number.isFinite),
      tipCurrency: 'USD',
      bundlePurchasesEnabled: elements.fields.bundlesEnabled.checked,
      chapterBundleDiscounts: formatBundleRules(elements.fields.bundles.value),
      creditPacks: formatCreditPacks(elements.fields.creditPacks.value),
      directChapterCheckoutEnabled: false,
      subscriptionEnabled: true,
      membershipCreditCost: 10,
      membershipDurationMonths: 1,
      membershipCoversPaidContent: true
    });

    const buildGlobalPricingPayload = () => ({
      mode: elements.globalPricing.pricingMode.value,
      freeChapters: Number(elements.globalPricing.freeChapters.value || 0),
      chapterPriceAmount: 0,
      chapterPriceCurrency: 'USD',
      chapterCredits: Math.max(1, Number(elements.globalPricing.chapterCredits.value || 1)),
      supporterPriceAmount: 0,
      supporterPriceCurrency: 'USD',
      tipsEnabled: elements.globalPricing.tipsEnabled.checked,
      tipAmounts: splitTags(elements.globalPricing.tipAmounts.value).map(Number).filter(Number.isFinite),
      tipCurrency: 'USD',
      bundlePurchasesEnabled: false,
      chapterBundleDiscounts: [],
      creditPacks: formatCreditPacks(elements.globalPricing.creditPacks.value),
      directChapterCheckoutEnabled: false,
      subscriptionEnabled: elements.globalPricing.subscriptionEnabled.checked,
      membershipCreditCost: Math.max(1, Number(elements.globalPricing.membershipCreditCost.value || 10)),
      membershipDurationMonths: Math.max(1, Number(elements.globalPricing.membershipMonths.value || 1)),
      membershipCoversPaidContent: elements.globalPricing.membershipCoversPaid.checked
    });

    const applyPricingToFields = (pricing = {}, accessLevel = 'free') => {
      elements.fields.accessLevel.value = accessLevel || 'free';
      elements.fields.pricingMode.value = pricing.mode || 'free';
      elements.fields.freeChapters.value = pricing.freeChapters || 0;
      elements.fields.chapterPrice.value = '';
      elements.fields.supporterPrice.value = '';
      elements.fields.chapterCredits.value = pricing.chapterCredits || 1;
      elements.fields.creditPacks.value = creditPacksToInput(pricing.creditPacks);
      elements.fields.tipsEnabled.checked = Boolean(pricing.tipsEnabled);
      elements.fields.tipAmounts.value = Array.isArray(pricing.tipAmounts) ? pricing.tipAmounts.join(', ') : '';
      elements.fields.bundlesEnabled.checked = Boolean(pricing.bundlePurchasesEnabled);
      elements.fields.bundles.value = bundleRulesToInput(pricing.chapterBundleDiscounts);
    };

    const applyPricingToGlobalControls = (template = getPricingDefaults()) => {
      const pricing = template.pricing || {};
      elements.globalPricing.accessLevel.value = template.accessLevel || 'paid';
      elements.globalPricing.pricingMode.value = pricing.mode || 'chapter-paid';
      elements.globalPricing.freeChapters.value = pricing.freeChapters ?? 20;
      elements.globalPricing.chapterCredits.value = pricing.chapterCredits || 1;
      elements.globalPricing.creditPacks.value = creditPacksToInput(pricing.creditPacks?.length ? pricing.creditPacks : emptyPricingDefaults().pricing.creditPacks);
      elements.globalPricing.subscriptionEnabled.checked = pricing.subscriptionEnabled !== false;
      elements.globalPricing.membershipCreditCost.value = pricing.membershipCreditCost || 10;
      elements.globalPricing.membershipMonths.value = pricing.membershipDurationMonths || 1;
      elements.globalPricing.membershipCoversPaid.checked = pricing.membershipCoversPaidContent !== false;
      elements.globalPricing.tipsEnabled.checked = Boolean(pricing.tipsEnabled);
      elements.globalPricing.tipAmounts.value = Array.isArray(pricing.tipAmounts) ? pricing.tipAmounts.join(', ') : '';
    };

    const getPricingDefaults = () => state.pricingDefaults || emptyPricingDefaults();

    const pricingTemplateSummary = (template = getPricingDefaults()) => {
      const pricing = template.pricing || {};
      const tips = pricing.tipsEnabled
        ? `打赏 ${Array.isArray(pricing.tipAmounts) && pricing.tipAmounts.length ? pricing.tipAmounts.join(' / ') : '未设金额'} USD`
        : '打赏关闭';
      const bundles = pricing.bundlePurchasesEnabled && Array.isArray(pricing.chapterBundleDiscounts) && pricing.chapterBundleDiscounts.length
        ? pricing.chapterBundleDiscounts.map((rule) => `${rule.minimumChapters}章-${rule.discountPercent}%`).join('，')
        : '多章折扣关闭';
      const packs = Array.isArray(pricing.creditPacks) && pricing.creditPacks.length
        ? pricing.creditPacks.map((pack) => `${pack.credits}点=${pack.priceAmount}${pack.priceCurrency || 'USD'}`).join('，')
        : '未设置点数包';
      const membership = pricing.subscriptionEnabled !== false
        ? `会员 ${pricing.membershipCreditCost || 10} 点 / ${pricing.membershipDurationMonths || 1} 个月`
        : '会员关闭';
      return `${template.accessLevel || 'paid'} · ${pricing.mode || 'chapter-paid'} · 免费 ${pricing.freeChapters || 0} 章 · 每章 ${pricing.chapterCredits || 1} 点 · ${packs} · ${membership} · ${tips} · ${bundles}`;
    };

    const renderPricingDefaults = () => {
      const template = getPricingDefaults();
      const prefix = template.isConfigured ? '当前全局：' : '尚未保存全局规则，当前使用推荐默认：';
      elements.pricingDefaultsSummary.textContent = `${prefix}${pricingTemplateSummary(template)}`;
      applyPricingToGlobalControls(template);
    };

    const formatMoney = (amount, currency = 'USD') => {
      const parsedAmount = Number.parseFloat(String(amount || ''));
      if (!Number.isFinite(parsedAmount)) return '未设置';
      try {
        return new Intl.NumberFormat(elements.fields.locale.value || 'zh-Hant', { style: 'currency', currency }).format(parsedAmount);
      } catch {
        return `${parsedAmount.toFixed(2)} ${currency}`;
      }
    };

    const formatDate = (value) => {
      if (!value) return '';
      const date = new Date(String(value).includes('T') ? value : String(value).replace(' ', 'T'));
      if (Number.isNaN(date.getTime())) return String(value);
      return date.toLocaleString('zh-Hant', { hour12: false });
    };

    const formatCredits = (value) => {
      const number = Number.parseInt(value || 0, 10);
      if (!Number.isFinite(number)) return '0';
      return number > 0 ? `+${number}` : String(number);
    };

    const formatPercent = (value) => {
      const number = Number(value || 0);
      if (!Number.isFinite(number)) return '0%';
      return `${Math.round(number * 100)}%`;
    };

    const formatSeconds = (value) => {
      const seconds = Math.max(0, Math.round(Number(value || 0)));
      if (seconds < 60) return `${seconds}s`;
      const minutes = Math.floor(seconds / 60);
      const rest = seconds % 60;
      if (minutes < 60) return rest ? `${minutes}m ${rest}s` : `${minutes}m`;
      const hours = Math.floor(minutes / 60);
      const minuteRest = minutes % 60;
      return minuteRest ? `${hours}h ${minuteRest}m` : `${hours}h`;
    };

    const statusTone = (status) => {
      if (['finished', 'confirmed', 'active'].includes(status)) return 'success';
      if (['failed', 'expired', 'refunded', 'disabled'].includes(status)) return 'error';
      return 'neutral';
    };

    const orderTitle = (order) => order.orderToken || order.providerPaymentId || `#${order.id}`;

    const pricingSourceLabel = (source) => ({
      'global-pricing-defaults': '全局收费规则',
      'backend-pricing-rules': 'D1 规则表',
      'backend-pricing-json': 'D1 内容 JSON',
      'serial-config': '旧 Markdown 生成配置',
      'env-default': '环境默认值'
    })[source] || source || '未知';

    const getEffectivePricingContext = () => {
      const entryType = elements.fields.entryType.value;
      const seriesSlug = entryType === 'novel_chapter'
        ? elements.fields.parentSlug.value.trim()
        : entryType === 'novel_series'
          ? elements.fields.slug.value.trim()
          : '';
      const chapterSlug = entryType === 'novel_chapter' ? elements.fields.slug.value.trim() : '';
      return {
        chapterSlug,
        entryType,
        locale: elements.fields.locale.value,
        seriesSlug,
        status: elements.fields.status.value,
        visibility: elements.fields.visibility.value
      };
    };

    const renderEffectivePricing = (pricing, context) => {
      const tips = Array.isArray(pricing.tipAmounts) && pricing.tipAmounts.length
        ? `${pricing.tipAmounts.map((amount) => formatMoney(amount, pricing.tipCurrency)).join(' / ')}`
        : pricing.tipsEnabled ? '已开启，但未配置金额' : '关闭';
      const bundles = Array.isArray(pricing.bundleOptions) && pricing.bundleOptions.length
        ? pricing.bundleOptions.map((option) => `${option.chapterCount} 章 ${formatMoney(option.priceAmount, option.priceCurrency)}，${option.discountPercent}% 折扣`).join('；')
        : Array.isArray(pricing.chapterBundleDiscounts) && pricing.chapterBundleDiscounts.length
          ? pricing.chapterBundleDiscounts.map((rule) => `${rule.chapters} 章 ${rule.discountPercent}% 折扣`).join('；')
          : '未开启';
      const creditPacks = Array.isArray(pricing.creditPacks) && pricing.creditPacks.length
        ? pricing.creditPacks.map((pack) => `${pack.label || `${pack.credits} 点`} ${formatMoney(pack.priceAmount, pack.priceCurrency)}`).join('；')
        : '未配置';
      const membership = pricing.subscriptionEnabled !== false
        ? `${pricing.membershipCreditCost || 10} 点兑换 ${pricing.membershipDurationMonths || 1} 个月，${pricing.membershipCoversPaidContent === false ? '不覆盖收费章节' : '覆盖收费章节'}`
        : '未开启';
      const warnings = [];
      if (context.status !== 'published' || context.visibility === 'private') {
        warnings.push('公共 API 只读取已发布且非私有内容；当前内容未发布或私有时，预览可能显示旧规则或降级规则。');
      }
      if (!['backend-pricing-rules', 'global-pricing-defaults'].includes(pricing.source)) {
        warnings.push(`当前未命中 D1 规则表，实际来源为：${pricingSourceLabel(pricing.source)}。`);
      }

      elements.effectivePricingPreview.innerHTML = `
        <div class="admin-pricing-summary">
          <article>
            <span>规则来源</span>
            <strong>${escapeHtml(pricingSourceLabel(pricing.source))}</strong>
            <small>${escapeHtml(context.seriesSlug)}${context.chapterSlug ? ` / ${escapeHtml(context.chapterSlug)}` : ''}</small>
          </article>
          <article>
            <span>收费模式</span>
            <strong>${escapeHtml(pricing.priceMode || 'free')}</strong>
            <small>免费章节：${escapeHtml(String(pricing.freeChapters ?? 0))}</small>
          </article>
          <article>
            <span>收费章节</span>
            <strong>${escapeHtml(String(pricing.chapterCredits || 1))} 点 / 章</strong>
            <small>直接 USD 解锁已停用</small>
          </article>
          <article>
            <span>会员</span>
            <strong>${escapeHtml(pricing.subscriptionEnabled === false ? '关闭' : `${pricing.membershipCreditCost || 10} 点`)}</strong>
            <small>${escapeHtml(pricing.subscriptionEnabled === false ? '不开放兑换' : `${pricing.membershipDurationMonths || 1} 个月会员`)}</small>
          </article>
        </div>
        <div class="admin-pricing-lines">
          <p><strong>打赏：</strong>${escapeHtml(tips)}</p>
          <p><strong>多章折扣：</strong>${escapeHtml(bundles)}</p>
          <p><strong>阅读点包：</strong>${escapeHtml(creditPacks)}</p>
          <p><strong>会员兑换：</strong>${escapeHtml(membership)}</p>
          ${warnings.map((warning) => `<p class="admin-pricing-warning">${escapeHtml(warning)}</p>`).join('')}
        </div>
      `;
    };

    const resetEffectivePricingPreview = (message = '保存或载入小说作品 / 章节后，这里会读取公共 pricing API 的最终返回结果。') => {
      elements.effectivePricingPreview.textContent = message;
      setEffectivePricingStatus('');
    };

    const refreshEffectivePricingPreview = async ({ silent = false } = {}) => {
      const context = getEffectivePricingContext();
      if (!context.seriesSlug) {
        resetEffectivePricingPreview('Blog / Devlog 不使用小说收费规则。');
        return;
      }

      const params = new URLSearchParams({
        series: context.seriesSlug,
        locale: context.locale
      });
      if (context.chapterSlug) params.set('chapter', context.chapterSlug);
      if (!silent) setEffectivePricingStatus('正在读取公共 pricing API。');

      try {
        const payload = await apiJson(`/api/novels/pricing?${params.toString()}`);
        renderEffectivePricing(payload.pricing || {}, context);
        setEffectivePricingStatus(`已读取公共 API：${pricingSourceLabel(payload.pricing?.source)}。`, 'success');
      } catch (error) {
        elements.effectivePricingPreview.textContent = '公共 pricing API 读取失败。';
        setEffectivePricingStatus(error.message, 'error');
      }
    };

    const renderMarkdownToHtml = (markdown) => {
      const lines = String(markdown || '').replace(/\r\n/g, '\n').split('\n');
      const html = [];
      let listOpen = false;

      const closeList = () => {
        if (listOpen) {
          html.push('</ul>');
          listOpen = false;
        }
      };

      lines.forEach((line) => {
        const trimmed = line.trim();
        if (!trimmed) {
          closeList();
          return;
        }
        if (trimmed.startsWith('### ')) {
          closeList();
          html.push(`<h3>${escapeHtml(trimmed.slice(4))}</h3>`);
          return;
        }
        if (trimmed.startsWith('## ')) {
          closeList();
          html.push(`<h2>${escapeHtml(trimmed.slice(3))}</h2>`);
          return;
        }
        if (trimmed.startsWith('# ')) {
          closeList();
          html.push(`<h1>${escapeHtml(trimmed.slice(2))}</h1>`);
          return;
        }
        if (/^[-*]\s+/.test(trimmed)) {
          if (!listOpen) {
            html.push('<ul>');
            listOpen = true;
          }
          html.push(`<li>${escapeHtml(trimmed.replace(/^[-*]\s+/, ''))}</li>`);
          return;
        }
        closeList();
        html.push(`<p>${escapeHtml(trimmed)}</p>`);
      });

      closeList();
      return html.join('\n');
    };

    const renderPreview = () => {
      const markdown = elements.fields.markdown.value.trim();
      if (!markdown) {
        elements.preview.textContent = '等待输入正文。';
        return '';
      }
      const html = renderMarkdownToHtml(markdown);
      elements.preview.innerHTML = html;
      return html;
    };

    const countWords = (value) => {
      const text = String(value || '').trim();
      if (!text) return 0;
      const latin = text.match(/[A-Za-z0-9]+/g) || [];
      const cjk = text.match(/[\u3400-\u9fff]/g) || [];
      return latin.length + cjk.length;
    };

    const mediaUrlFromKey = (value) => {
      const key = String(value || '').trim();
      if (!key) return '';
      if (/^https?:\/\//i.test(key) || key.startsWith('/')) return key;
      return `/api/content/media?key=${encodeURIComponent(key)}`;
    };

    const renderCoverPreview = () => {
      const key = elements.fields.coverR2Key.value.trim();
      const url = mediaUrlFromKey(key);
      elements.coverOpen.hidden = !url;
      elements.coverOpen.href = url || '#';
      if (!url) {
        elements.coverPreview.hidden = true;
        elements.coverPreview.innerHTML = '';
        return;
      }

      const alt = elements.fields.coverAlt.value.trim() || elements.fields.title.value.trim() || 'Content cover';
      elements.coverPreview.innerHTML = `
        <img src="${escapeHtml(url)}" alt="${escapeHtml(alt)}" loading="lazy" />
        <figcaption>${escapeHtml(key)}</figcaption>
      `;
      elements.coverPreview.hidden = false;
    };

    const uploadCoverImage = async () => {
      const [file] = elements.fields.coverFile.files || [];
      if (!file) {
        setCoverStatus('请先选择一张封面图片。', 'error');
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        setCoverStatus('封面图片不能超过 5MB。', 'error');
        return;
      }

      const formData = new FormData();
      const entryType = elements.fields.entryType.value;
      const title = elements.fields.title.value.trim();
      const slug = elements.fields.slug.value.trim() || slugify(title || file.name, entryType);
      formData.append('file', file);
      formData.append('mediaKind', 'covers');
      formData.append('slug', slug);
      formData.append('title', title);

      elements.coverUpload.disabled = true;
      setCoverStatus('正在上传封面到 R2。');
      try {
        const payload = await apiFormData('/admin/api/content/media', formData);
        elements.fields.coverR2Key.value = payload.media?.key || '';
        if (!elements.fields.coverAlt.value.trim()) {
          elements.fields.coverAlt.value = title ? `${title} 封面` : file.name;
        }
        elements.fields.coverFile.value = '';
        renderCoverPreview();
        setCoverStatus('封面已上传，保存内容后生效。', 'success');
      } catch (error) {
        setCoverStatus(error.message, 'error');
      } finally {
        elements.coverUpload.disabled = false;
      }
    };

    const fillFormFromEntry = (entry, body = {}) => {
      state.selectedEntryId = entry?.id || 0;
      elements.editorHeading.textContent = entry?.id ? `编辑：${entry.title}` : '创建后端内容';
      elements.fields.id.value = entry?.id || '';
      elements.fields.entryType.value = entry?.entryType || 'blog_post';
      elements.fields.locale.value = entry?.locale || 'zh-Hant';
      elements.fields.status.value = entry?.status || 'draft';
      elements.fields.visibility.value = entry?.visibility || 'public';
      elements.fields.slug.value = entry?.slug || '';
      elements.fields.parentSlug.value = entry?.parentSlug || '';
      elements.fields.title.value = entry?.title || '';
      elements.fields.subtitle.value = entry?.subtitle || '';
      elements.fields.author.value = entry?.authorName || 'Station Cat';
      elements.fields.tags.value = (entry?.tags || []).join(', ');
      elements.fields.chapterNumber.value = entry?.chapterNumber || '';
      elements.fields.volumeTitle.value = entry?.volumeTitle || '';
      elements.fields.publishedAt.value = toDatetimeLocal(entry?.publishedAt);
      elements.fields.sortOrder.value = entry?.sortOrder || 0;
      elements.fields.featured.checked = Boolean(entry?.featured);
      elements.fields.description.value = entry?.description || '';
      elements.fields.excerpt.value = entry?.excerpt || '';
      elements.fields.accessLevel.value = entry?.accessLevel || 'free';
      elements.fields.coverR2Key.value = entry?.coverR2Key || '';
      elements.fields.coverAlt.value = entry?.coverAlt || '';
      elements.fields.sourceRef.value = entry?.sourceRef || '';
      elements.fields.revisionSummary.value = '';
      elements.fields.markdown.value = body.markdown || '';
      elements.fields.coverFile.value = '';

      applyPricingToFields(entry?.pricing || {}, entry?.accessLevel || 'free');

      renderPreview();
      renderCoverPreview();
      setCoverStatus('');
      updateConditionalFields();
      resetEffectivePricingPreview();
    };

    const resetForm = (entryType = 'blog_post') => {
      const pricingDefaults = entryType === 'novel_series' || entryType === 'novel_chapter'
        ? getPricingDefaults()
        : emptyPricingDefaults();
      fillFormFromEntry({
        entryType,
        locale: 'zh-Hant',
        status: 'draft',
        visibility: 'public',
        accessLevel: pricingDefaults.accessLevel,
        authorName: 'Station Cat',
        tags: [],
        pricing: pricingDefaults.pricing,
        sortOrder: 0
      });
      setSaveStatus('');
      resetEffectivePricingPreview();
    };

    const updateConditionalFields = () => {
      const isChapter = elements.fields.entryType.value === 'novel_chapter';
      const isNovel = elements.fields.entryType.value === 'novel_chapter' || elements.fields.entryType.value === 'novel_series';
      elements.fields.parentSlug.closest('label').hidden = !isChapter;
      elements.fields.chapterNumber.closest('label').hidden = !isChapter;
      elements.fields.volumeTitle.closest('label').hidden = !isChapter;
      elements.fields.parentSlug.required = isChapter;
      elements.fields.chapterNumber.required = isChapter;
      elements.entryPricingPanel.hidden = !isNovel;
    };

    const entryTypeLabel = (type) => ({
      blog_post: 'Blog',
      signal_brief: '简报',
      novel_series: '作品',
      novel_chapter: '章节'
    })[type] || type;

    const renderEmpty = (target, message) => {
      target.innerHTML = `<p class="admin-empty-list">${escapeHtml(message)}</p>`;
    };

    const renderContentList = () => {
      if (!state.entries.length) {
        renderEmpty(elements.contentList, '还没有后端内容记录。');
        return;
      }

      elements.contentList.innerHTML = '';
      state.entries.forEach((entry) => {
        const button = document.createElement('button');
        button.className = `admin-v2-entry${entry.id === state.selectedEntryId ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(entry.title)}</span>
          <small>${entryTypeLabel(entry.entryType)} · ${entry.locale} · ${entry.status} · ${entry.accessLevel}</small>
          <small>${escapeHtml(entry.parentSlug ? `${entry.parentSlug}/${entry.slug}` : entry.slug)}</small>
        `;
        button.addEventListener('click', () => loadEntryForEdit(entry.id));
        elements.contentList.append(button);
      });
    };

    const signalCategoryLabel = (value) => ({
      ai: 'AI',
      economy: '经济',
      general: '综合',
      market: '市场',
      research: '研究',
      tech: '科技'
    })[value] || value || '综合';

    const signalSourceTypeLabel = (value) => ({
      api: 'API',
      page: '网页',
      rss: 'RSS / Atom'
    })[value] || value;

    const signalSourceTrustLabel = (value) => ({
      community: '社区线索',
      established: '成熟媒体',
      primary: '一手来源'
    })[value] || value;

    const signalSourceHealthLabel = (value) => ({
      error: '有错误',
      healthy: '正常',
      not_checked: '待首检',
      paused: '已暂停'
    })[value] || value;

    const signalCandidateStatusLabel = (value) => ({
      new: '待审核',
      shortlisted: '已入选',
      rejected: '已淘汰',
      used: '已采用'
    })[value] || value;

    const signalCandidatePriorityLabel = (value) => ({
      high: '高优先',
      low: '低优先',
      medium: '可关注',
      unscored: '未评分'
    })[value] || value;

    const resetSignalSourceForm = () => {
      state.selectedSignalSourceId = '';
      elements.signalSource.id.value = '';
      elements.signalSource.name.value = '';
      elements.signalSource.publisher.value = '';
      elements.signalSource.endpointUrl.value = '';
      elements.signalSource.homepageUrl.value = '';
      elements.signalSource.sourceType.value = 'rss';
      elements.signalSource.category.value = 'tech';
      elements.signalSource.trustTier.value = 'primary';
      elements.signalSource.language.value = 'en';
      elements.signalSource.fetchIntervalMinutes.value = '360';
      elements.signalSource.maxItemsPerRun.value = '30';
      elements.signalSource.isEnabled.checked = true;
