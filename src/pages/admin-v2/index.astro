    const setupDragScroll = (panel) => {
      if (!panel) return;

      const interactiveSelector = 'a, button, input, select, textarea, label, summary, [role="button"], [contenteditable="true"]';
      let isDragging = false;
      let startY = 0;
      let startScrollTop = 0;

      const stopDragging = (event) => {
        if (!isDragging) return;
        isDragging = false;
        panel.classList.remove('is-dragging');
        if (event?.pointerId !== undefined && panel.hasPointerCapture?.(event.pointerId)) {
          panel.releasePointerCapture(event.pointerId);
        }
      };

      panel.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        if (event.target.closest(interactiveSelector)) return;
        if (panel.scrollHeight <= panel.clientHeight) return;

        isDragging = true;
        startY = event.clientY;
        startScrollTop = panel.scrollTop;
        panel.classList.add('is-dragging');
        panel.setPointerCapture?.(event.pointerId);
      });

      panel.addEventListener('pointermove', (event) => {
        if (!isDragging) return;
        const deltaY = event.clientY - startY;
        if (Math.abs(deltaY) > 2) {
          event.preventDefault();
        }
        panel.scrollTop = startScrollTop - deltaY;
      });

      panel.addEventListener('pointerup', stopDragging);
      panel.addEventListener('pointercancel', stopDragging);
      panel.addEventListener('lostpointercapture', stopDragging);
    };

