    };

    const editSignalSource = (source) => {
      state.selectedSignalSourceId = source.id;
      elements.signalSource.id.value = source.id;
      elements.signalSource.name.value = source.name || '';
      elements.signalSource.publisher.value = source.publisher || '';
      elements.signalSource.endpointUrl.value = source.endpointUrl || '';
      elements.signalSource.homepageUrl.value = source.homepageUrl || '';
      elements.signalSource.sourceType.value = source.sourceType || 'rss';
      elements.signalSource.category.value = source.category || 'general';
      elements.signalSource.trustTier.value = source.trustTier || 'primary';
      elements.signalSource.language.value = source.language || 'en';
      elements.signalSource.fetchIntervalMinutes.value = String(source.fetchIntervalMinutes || 360);
      elements.signalSource.maxItemsPerRun.value = String(source.maxItemsPerRun || 30);
      elements.signalSource.isEnabled.checked = Boolean(source.isEnabled);
      elements.signalSource.requiresApiKey.checked = Boolean(source.requiresApiKey);
      elements.signalSource.notes.value = source.notes || '';
      elements.signalSourceFormTitle.textContent = `编辑：${source.name}`;
      setSignalSourceStatus('');
      elements.signalSourceForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const buildSignalSourcePayload = () => {
      const selectedSource = state.signalSources.find((source) => source.id === state.selectedSignalSourceId);
      return {
        action: 'save',
        id: elements.signalSource.id.value.trim(),
        name: elements.signalSource.name.value.trim(),
        publisher: elements.signalSource.publisher.value.trim(),
        endpointUrl: elements.signalSource.endpointUrl.value.trim(),
        homepageUrl: elements.signalSource.homepageUrl.value.trim(),
        sourceType: elements.signalSource.sourceType.value,
        category: elements.signalSource.category.value,
        trustTier: elements.signalSource.trustTier.value,
        language: elements.signalSource.language.value.trim(),
        fetchIntervalMinutes: Number.parseInt(elements.signalSource.fetchIntervalMinutes.value, 10),
        maxItemsPerRun: Number.parseInt(elements.signalSource.maxItemsPerRun.value, 10),
        isEnabled: elements.signalSource.isEnabled.checked,
        requiresApiKey: elements.signalSource.requiresApiKey.checked,
        config: selectedSource?.config || {},
        notes: elements.signalSource.notes.value.trim()
      };
    };

    const renderSignalSources = () => {
      if (!state.signalSources.length) {
        renderEmpty(elements.signalSourcesList, '还没有来源白名单。');
        return;
      }

      elements.signalSourcesList.innerHTML = '';
      state.signalSources.forEach((source) => {
        const row = document.createElement('article');
        const collectionLabel = !source.collectionSupported
          ? '暂未适配'
          : source.collectionConfigured
            ? '可采集'
            : `待配置 ${source.missingSecretBinding || 'API Key'}`;
        row.className = 'admin-v2-row admin-signal-source-row';
        row.innerHTML = `
          <div class="admin-signal-source-row__heading">
            <strong>${escapeHtml(source.name)}</strong>
            <span class="admin-signal-source-state" data-state="${escapeHtml(source.health)}">${escapeHtml(signalSourceHealthLabel(source.health))}</span>
          </div>
          <div class="admin-signal-source-row__meta">
            <span>${escapeHtml(signalSourceTypeLabel(source.sourceType))}</span>
            <span>${escapeHtml(signalCategoryLabel(source.category))}</span>
            <span>${escapeHtml(signalSourceTrustLabel(source.trustTier))}</span>
            <span>${escapeHtml(String(source.fetchIntervalMinutes))} 分钟</span>
            <span>${escapeHtml(collectionLabel)}</span>
            ${source.requiresApiKey ? '<span>需 API Key</span>' : ''}
          </div>
          <div class="admin-signal-source-row__url">${escapeHtml(source.endpointUrl)}</div>
          ${source.notes ? `<small>${escapeHtml(source.notes)}</small>` : ''}
          ${source.lastFetchedAt ? `<small>最近采集：${escapeHtml(formatDate(source.lastFetchedAt))} · ${escapeHtml(String(source.lastItemCount || 0))} 条${source.lastHttpStatus ? ` · HTTP ${escapeHtml(String(source.lastHttpStatus))}` : ''}</small>` : ''}
          <div class="admin-signal-source-row__actions"></div>
        `;
        const actions = row.querySelector('.admin-signal-source-row__actions');
        const editButton = document.createElement('button');
        editButton.className = 'button button-secondary';
        editButton.type = 'button';
        editButton.textContent = '编辑';
        editButton.addEventListener('click', () => editSignalSource(source));
        const toggleButton = document.createElement('button');
        toggleButton.className = 'button button-secondary';
        toggleButton.type = 'button';
        toggleButton.textContent = source.isEnabled ? '暂停' : '启用';
        toggleButton.addEventListener('click', () => toggleSignalSource(source));
        actions.append(editButton, toggleButton);
        elements.signalSourcesList.append(row);
      });
    };

    const signalHealthLabel = (stateName) => ({
      critical: '严重异常',
      degraded: '需要检查',
      healthy: '运行正常',
      running: '正在采集',
      waiting: '等待首次运行'
    }[stateName] || '待初始化');

    const signalAlertSeverityLabel = (severity) => ({
      critical: '严重',
      warning: '警告',
      info: '提示'
    }[severity] || '警告');

    const renderSignalAlerts = () => {
      const openAlerts = state.signalAlerts.filter((alert) => alert.status === 'open');
      if (!openAlerts.length) {
        renderEmpty(elements.signalAlertsList, state.signalOperations?.setupRequired ? '应用 0024 后会在这里显示运行告警。' : '当前没有待处理告警。');
        return;
      }
      elements.signalAlertsList.innerHTML = '';
      openAlerts.slice(0, 12).forEach((alert) => {
        const row = document.createElement('article');
        row.className = 'admin-v2-row admin-signal-alert-row';
        row.innerHTML = `
          <div class="admin-signal-alert-row__heading">
            <strong>${escapeHtml(alert.title)}</strong>
            <span class="admin-signal-alert-severity" data-severity="${escapeHtml(alert.severity)}">${escapeHtml(signalAlertSeverityLabel(alert.severity))}</span>
          </div>
          <p>${escapeHtml(alert.message)}</p>
          <div class="admin-signal-alert-row__meta">
            <span>最近 ${escapeHtml(formatDate(alert.lastSeenAt))}</span>
            <span>出现 ${escapeHtml(String(alert.occurrenceCount || 1))} 次</span>
            ${alert.notificationCount ? `<span>已邮件通知 ${escapeHtml(String(alert.notificationCount))} 次</span>` : ''}
          </div>
          <div class="button-row admin-signal-alert-row__actions"></div>
        `;
        const button = document.createElement('button');
        button.className = 'button button-secondary';
        button.type = 'button';
        button.textContent = '标记已处理';
        button.addEventListener('click', () => resolveSignalAlert(alert, button));
        row.querySelector('.admin-signal-alert-row__actions').append(button);
        elements.signalAlertsList.append(row);
      });
    };

    const renderSignalOperations = () => {
      const payload = state.signalOperations;
      if (!payload || payload.setupRequired) {
        elements.signalOperationsHealth.dataset.state = 'setup';
        elements.signalOperationsHealth.textContent = '待初始化';
        elements.signalOperationsSummary.textContent = '应用 migrations/0024_signal_operations.sql 后启用心跳、告警与失败重试。';
        elements.signalOperationsCron.textContent = '待应用 0024';
        elements.signalOperationsRun.textContent = '—';
        elements.signalOperationsAlertCount.textContent = '—';
        elements.signalOperationsSourceErrors.textContent = '—';
        elements.signalOperationsNotification.textContent = '阶段六尚未初始化。';
        renderSignalAlerts();
        return;
      }
      const health = payload.health || {};
      const runtime = payload.runtime || {};
      const latestRun = payload.latestRun;
      elements.signalOperationsHealth.dataset.state = health.state || 'waiting';
      elements.signalOperationsHealth.textContent = signalHealthLabel(health.state);
      elements.signalOperationsSummary.textContent = health.message || '自动化运行状态已更新。';
      elements.signalOperationsCron.textContent = runtime.lastCronStartedAt
        ? `${formatDate(runtime.lastCronStartedAt)} · ${runtime.lastCronStatus || 'unknown'}`
        : '等待首次运行';
      elements.signalOperationsRun.textContent = latestRun
        ? `${latestRun.status} · ${latestRun.processedSourceCount || 0}/${latestRun.sourceCount || 0} 来源`
        : '尚无运行记录';
      elements.signalOperationsAlertCount.textContent = `${health.openAlertCount || 0} 条`;
      elements.signalOperationsSourceErrors.textContent = `${state.signalSourceErrors.length} 个`;
      elements.signalOperationsNotification.textContent = payload.notification?.configured
        ? `严重告警会发送给 ${payload.notification.recipientCount || 0} 个管理员邮箱。`
        : '严重告警邮件尚未配置，后台仍会保留记录。';
      renderSignalAlerts();
    };

    const renderSignalModelPreview = () => {
      const preview = state.signalModelPreview;
      elements.signalModelPreview.hidden = !preview;
      if (!preview) {
        elements.signalModelPreview.open = false;
        elements.signalModelPreviewBody.replaceChildren();
        return;
      }
      elements.signalModelPreviewBody.innerHTML = `
        <h4>${escapeHtml(preview.title || '未命名预览')}</h4>
        ${preview.description ? `<p>${escapeHtml(preview.description)}</p>` : ''}
        <ol>
          ${(preview.items || []).map((item) => `
            <li>
              <strong>${escapeHtml(item.headline || '')}</strong>
              <p>${escapeHtml(item.summary || '')}</p>
              <small><b>信号：</b>${escapeHtml(item.signal || '')}</small>
              <small><b>噪音：</b>${escapeHtml(item.noise || '')}</small>
            </li>
          `).join('')}
        </ol>
      `;
    };

    const updateSignalModelControls = () => {
      const rollout = state.signalModelRollout;
      const selectedCount = state.signalSelectedCandidateIds.size;
      const selectionReady = selectedCount >= 3 && selectedCount <= 10;
      const setupReady = Boolean(rollout && !rollout.setupRequired && !rollout.unavailable);
      elements.signalModelDeepSeekModel.disabled = !setupReady || rollout?.rolloutMode === 'live';
      elements.signalModelSave.disabled = !setupReady || rollout?.rolloutMode === 'live';
      elements.signalModelSmoke.disabled = !setupReady || !rollout?.canSmoke || !selectionReady;
      elements.signalModelEnable.disabled = !setupReady || !rollout?.canEnableLive || rollout?.rolloutMode === 'live';
      elements.signalModelDisable.disabled = !setupReady || rollout?.rolloutMode !== 'live';
      elements.signalModelSmoke.title = !selectionReady
        ? '请先在今日候选中选择 3–10 条已入选资讯'
        : rollout?.canSmoke
          ? '只生成临时预览，不保存、不发布'
          : '需要部署许可和 DeepSeek Secret';
    };

    const renderSignalModelRollout = () => {
      const rollout = state.signalModelRollout;
      if (!rollout || rollout.setupRequired || rollout.unavailable) {
        elements.signalModelRolloutHealth.dataset.state = 'setup';
        elements.signalModelRolloutHealth.textContent = rollout?.unavailable ? '读取失败' : '待初始化';
        elements.signalModelRolloutSummary.textContent = rollout?.message || '应用 migrations/0025_signal_model_rollout.sql 后启用模型发布闸门。';
        elements.signalModelMasterGate.textContent = '—';
        elements.signalModelSecret.textContent = '—';
        elements.signalModelFallback.textContent = '—';
        elements.signalModelLastSmoke.textContent = '—';
        updateSignalModelControls();
        return;
      }
      const live = rollout.rolloutMode === 'live';
      elements.signalModelRolloutHealth.dataset.state = rollout.liveEffective ? 'healthy' : live ? 'critical' : 'waiting';
      elements.signalModelRolloutHealth.textContent = rollout.liveEffective ? 'DeepSeek 主用' : live ? '配置失效' : 'Workers AI 主用';
      elements.signalModelRolloutSummary.textContent = rollout.liveEffective
        ? `${rollout.deepSeekModel} 正在生成简报；Workers AI 保持自动回退。`
        : live
          ? '数据库要求启用 DeepSeek，但部署许可或 Secret 不完整，当前生成会安全回退。'
          : rollout.canEnableLive
            ? '冒烟已通过，可以手动启用 DeepSeek 主路径。'
            : 'DeepSeek 尚未启用，正式草稿继续使用 Workers AI。';
      elements.signalModelMasterGate.textContent = rollout.masterGateEnabled ? '已开启' : '未开启';
      elements.signalModelSecret.textContent = rollout.secretConfigured ? '已配置' : '未配置';
      elements.signalModelFallback.textContent = rollout.fallbackConfigured ? '已配置' : '不可用';
      const smoke = rollout.lastSmoke || {};
      elements.signalModelLastSmoke.textContent = smoke.status === 'never'
        ? '尚未测试'
        : `${smoke.status === 'passed' ? '通过' : smoke.status === 'running' ? '运行中' : '失败'} · ${formatDate(smoke.at)}${rollout.smokeFresh ? '' : ' · 已过期'}`;
      elements.signalModelDeepSeekModel.value = rollout.deepSeekModel || 'deepseek-v4-pro';
      updateSignalModelControls();
    };

    const loadSignalModelRollout = async () => {
      try {
        const payload = await apiJson('/admin/api/signal/model-rollout');
        state.signalModelRollout = payload.rollout || null;
      } catch (error) {
        state.signalModelRollout = {
          message: error.message,
          setupRequired: error.code === 'SIGNAL_MODEL_ROLLOUT_NOT_READY',
          unavailable: error.code !== 'SIGNAL_MODEL_ROLLOUT_NOT_READY'
        };
      }
      renderSignalModelRollout();
      return state.signalModelRollout;
    };

    const saveSignalModel = async () => {
      elements.signalModelSave.disabled = true;
      setSignalModelStatus('正在保存模型设置。', 'pending');
      try {
        const payload = await apiJson('/admin/api/signal/model-rollout', {
          method: 'POST',
          body: JSON.stringify({ action: 'save_model', model: elements.signalModelDeepSeekModel.value })
        });
        state.signalModelRollout = payload.rollout;
        state.signalModelPreview = null;
        renderSignalModelPreview();
        renderSignalModelRollout();
        setSignalModelStatus(payload.message, 'success');
        await loadAuditLogs();
      } catch (error) {
        setSignalModelStatus(error.message, 'error');
        updateSignalModelControls();
      }
    };

    const smokeTestSignalModel = async () => {
      const candidateIds = [...state.signalSelectedCandidateIds];
      if (candidateIds.length < 3 || candidateIds.length > 10) {
        setSignalModelStatus('请先选择 3 至 10 条已入选候选。', 'error');
        return;
      }
      elements.signalModelSmoke.disabled = true;
      elements.signalModelSmoke.textContent = '正在测试';
      setSignalModelStatus('正在调用 DeepSeek 生成临时预览，不会保存或发布。', 'pending');
      try {
        const payload = await apiJson('/admin/api/signal/model-rollout', {
          method: 'POST',
          body: JSON.stringify({
            action: 'smoke_test',
            briefDate: elements.signalDraftDate.value || todayDateInput(),
            candidateIds,
            category: elements.signalDraftCategory.value
          })
        });
        state.signalModelRollout = payload.rollout;
        state.signalModelPreview = payload.preview || null;
        renderSignalModelPreview();
        renderSignalModelRollout();
        setSignalModelStatus(payload.message, 'success');
        if (state.signalModelPreview) elements.signalModelPreview.open = true;
        await loadAuditLogs();
      } catch (error) {
        setSignalModelStatus(error.message, 'error');
        await loadSignalModelRollout();
      } finally {
        elements.signalModelSmoke.textContent = '测试所选候选';
        updateSignalModelControls();
      }
    };

    const setSignalModelMode = async (mode) => {
      if (mode === 'live' && !window.confirm('确认让 DeepSeek 成为简报主模型？Workers AI 会继续作为自动回退。')) return;
      elements.signalModelEnable.disabled = true;
      elements.signalModelDisable.disabled = true;
      setSignalModelStatus(mode === 'live' ? '正在启用 DeepSeek 主路径。' : '正在关闭 DeepSeek 主路径。', 'pending');
      try {
        const payload = await apiJson('/admin/api/signal/model-rollout', {
          method: 'POST',
          body: JSON.stringify({
            action: 'set_mode',
            confirmation: mode === 'live' ? 'ENABLE_DEEPSEEK_PRIMARY' : '',
            mode
          })
        });
        state.signalModelRollout = payload.rollout;
        renderSignalModelRollout();
        setSignalModelStatus(payload.message, 'success');
        await loadAuditLogs();
      } catch (error) {
        setSignalModelStatus(error.message, 'error');
        await loadSignalModelRollout();
      }
    };

    const renderSignalRuns = () => {
      if (!state.signalRuns.length) {
        renderEmpty(elements.signalRunsList, '尚未运行采集。点击“立即采集”后，免费来源会逐个进入队列。');
        return;
      }
      elements.signalRunsList.innerHTML = '';
      state.signalRuns.forEach((run) => {
        const row = document.createElement('article');
        row.className = 'admin-v2-row admin-signal-run-row';
        row.innerHTML = `
          <div class="admin-signal-run-row__heading">
            <strong>${escapeHtml(run.status)} · ${escapeHtml(run.triggerType)}</strong>
            <small>${escapeHtml(formatDate(run.startedAt || run.createdAt))}</small>
          </div>
          <span>${escapeHtml(String(run.processedSourceCount || 0))}/${escapeHtml(String(run.sourceCount || 0))} 来源 · ${escapeHtml(String(run.acceptedCount))} 候选 · ${escapeHtml(String(run.duplicateCount))} 重复 · ${escapeHtml(String(run.failedCount))} 失败</span>
          ${Array.isArray(run.errors) && run.errors.length ? `<p>${run.errors.slice(0, 3).map((item) => escapeHtml(item.message || item.sourceId)).join(' · ')}</p>` : ''}
          <div class="button-row admin-signal-run-row__actions"></div>
        `;
        if (['partial', 'failed'].includes(run.status) && Number(run.failedCount) > 0) {
          const button = document.createElement('button');
          button.className = 'button button-secondary';
          button.type = 'button';
          button.textContent = '重试失败来源';
          button.addEventListener('click', () => retrySignalRun(run, button));
          row.querySelector('.admin-signal-run-row__actions').append(button);
        }
        elements.signalRunsList.append(row);
      });
    };

    const renderSignalCandidateSourceOptions = () => {
      const selected = elements.signalCandidate.sourceId.value;
      elements.signalCandidate.sourceId.innerHTML = '<option value="">全部来源</option>';
      state.signalSources.forEach((source) => {
        const option = document.createElement('option');
        option.value = source.id;
        option.textContent = source.name;
        elements.signalCandidate.sourceId.append(option);
      });
      if (state.signalSources.some((source) => source.id === selected)) {
        elements.signalCandidate.sourceId.value = selected;
      }
    };

    const renderSignalCandidateSummary = () => {
      if (!state.signalTriageReady) {
        elements.signalCandidatesSummary.textContent = '待应用 migrations/0021_signal_candidate_triage.sql 后启用评分与审核。';
        elements.signalCandidatesSummary.dataset.state = 'setup';
        return;
      }
      delete elements.signalCandidatesSummary.dataset.state;
      const summary = state.signalCandidateSummary || {};
      const average = summary.averageScore === null || summary.averageScore === undefined
        ? '暂无评分'
        : `平均 ${summary.averageScore} 分`;
      const merged = state.signalDedupReady
        ? ` · 已合并重复 ${summary.mergedDuplicates || 0} 条`
        : ' · 待应用 0023 后合并重复报道';
      elements.signalCandidatesSummary.textContent = `${summary.total || 0} 条 · 待审 ${summary.new || 0} · 入选 ${summary.shortlisted || 0} · 淘汰 ${summary.rejected || 0} · ${average}${merged}`;
    };

    const candidateScoreDetails = (candidate) => {
      const breakdown = candidate.scoreBreakdown || {};
      const reasons = Array.isArray(breakdown.reasons) ? breakdown.reasons : [];
      if (!reasons.length) return '';
      return `
        <details class="admin-signal-score-details">
          <summary>查看评分依据</summary>
          <ul>${reasons.map((reason) => `<li>${escapeHtml(reason)}</li>`).join('')}</ul>
        </details>
      `;
    };

    const candidateActions = (candidate) => {
      if (!state.signalTriageReady || candidate.status === 'used') return [];
      if (candidate.status === 'new') return [['shortlist', '入选'], ['reject', '淘汰']];
      if (candidate.status === 'shortlisted') return [['restore', '恢复待审'], ['reject', '淘汰']];
      if (candidate.status === 'rejected') return [['shortlist', '重新入选'], ['restore', '恢复待审']];
      return [];
    };

    const updateSignalDraftSelection = () => {
      const count = state.signalSelectedCandidateIds.size;
      const remaining = Math.max(0, 3 - count);
      elements.signalDraftSelection.textContent = remaining
        ? `已选 ${count} / 10 · 还需 ${remaining} 条`
        : `已选 ${count} / 10 · 可以生成`;
      elements.signalDraftGenerate.disabled = !state.signalTriageReady || count < 3 || count > 10;
      elements.signalDraftGenerate.title = remaining
        ? `请再入选 ${remaining} 条候选资讯`
        : '使用当前选中的候选生成简报草稿';
      updateSignalModelControls();
    };

    const toggleSignalDraftCandidate = (candidate, checked) => {
      if (candidate.status !== 'shortlisted') return;
      if (checked && state.signalSelectedCandidateIds.size >= 10) {
        setSignalCandidateStatus('每份草稿最多选择 10 条候选资讯。', 'error');
        renderSignalCandidates();
        return;
      }
      if (checked) state.signalSelectedCandidateIds.add(candidate.id);
      else state.signalSelectedCandidateIds.delete(candidate.id);
      updateSignalDraftSelection();
    };

    const renderSignalCandidates = () => {
      renderSignalCandidateSummary();
      updateSignalDraftSelection();
      if (!state.signalCandidates.length) {
        renderEmpty(elements.signalCandidatesList, '当前筛选下没有候选资讯。采集到的资讯会先进入这里，不会直接发布。');
        return;
      }
      elements.signalCandidatesList.innerHTML = '';
      state.signalCandidates.forEach((candidate) => {
        const row = document.createElement('article');
        row.className = 'admin-v2-row admin-signal-candidate-row';
        row.dataset.candidateId = candidate.id;
        const score = candidate.relevanceScore === null || candidate.relevanceScore === undefined
          ? '—'
          : String(candidate.relevanceScore);
        const mergedLabel = candidate.occurrenceCount > 1
          ? `<span>已合并 ${escapeHtml(String(candidate.occurrenceCount))} 条 · ${escapeHtml(String(candidate.sourceCount))} 来源</span>`
          : '';
        const clusterLabel = candidate.clusterSize > 1 ? `<span>近似同题 ${escapeHtml(String(candidate.clusterSize))} 条</span>` : '';
        const draftSelector = candidate.status === 'shortlisted'
          ? `<label class="admin-signal-candidate-select">
              <input type="checkbox" data-signal-candidate-select ${state.signalSelectedCandidateIds.has(candidate.id) ? 'checked' : ''} />
              <span class="sr-only">选择 ${escapeHtml(candidate.title)} 生成草稿</span>
            </label>`
          : '';
        row.innerHTML = `
          <div class="admin-signal-candidate-row__heading">
            ${draftSelector}
            <strong>${candidate.canonicalUrl ? `<a href="${escapeHtml(candidate.canonicalUrl)}" target="_blank" rel="noreferrer">${escapeHtml(candidate.title)}</a>` : escapeHtml(candidate.title)}</strong>
            <span class="admin-signal-score" data-priority="${escapeHtml(candidate.scorePriority)}">
              <b>${escapeHtml(score)}</b>
              ${escapeHtml(signalCandidatePriorityLabel(candidate.scorePriority))}
            </span>
          </div>
          <div class="admin-signal-candidate-row__meta">
            <span>${escapeHtml(candidate.sourceName || candidate.sourceId)}</span>
            <span>${escapeHtml(signalCategoryLabel(candidate.category))}</span>
            <span data-status="${escapeHtml(candidate.status)}">${escapeHtml(signalCandidateStatusLabel(candidate.status))}</span>
            ${mergedLabel}
            ${clusterLabel}
          </div>
          ${candidate.summary ? `<p>${escapeHtml(candidate.summary)}</p>` : ''}
          <small>${escapeHtml(formatDate(candidate.publishedAt || candidate.createdAt))}${candidate.scoredAt ? ` · 评分 ${escapeHtml(formatDate(candidate.scoredAt))}` : ''}</small>
          ${candidateScoreDetails(candidate)}
          ${candidate.decisionNote ? `<p class="admin-signal-candidate-note"><strong>审核备注：</strong>${escapeHtml(candidate.decisionNote)}</p>` : ''}
          <div class="admin-signal-candidate-review" ${candidate.status === 'used' || !state.signalTriageReady ? 'hidden' : ''}>
            <label>
              审核备注（可选）
              <input type="text" maxlength="500" placeholder="记录入选或淘汰原因" />
            </label>
            <div class="button-row"></div>
          </div>
        `;
        const actionList = candidateActions(candidate);
        row.querySelector('[data-signal-candidate-select]')?.addEventListener('change', (event) => {
          toggleSignalDraftCandidate(candidate, event.currentTarget.checked);
        });
        const actions = row.querySelector('.admin-signal-candidate-review .button-row');
        const noteInput = row.querySelector('.admin-signal-candidate-review input');
        actionList.forEach(([action, label]) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = action === 'reject' ? 'button button-danger' : action === 'shortlist' ? 'button button-primary' : 'button button-secondary';
          button.textContent = label;
          button.addEventListener('click', () => reviewSignalCandidate(candidate, action, noteInput.value));
          actions.append(button);
        });
        elements.signalCandidatesList.append(row);
      });
      updateSignalDraftSelection();
    };

    const signalCandidateQueryString = () => {
      const params = new URLSearchParams({ limit: '50' });
      if (elements.signalCandidate.status.value) params.set('status', elements.signalCandidate.status.value);
      if (elements.signalCandidate.window.value !== '0') params.set('sinceHours', elements.signalCandidate.window.value);
      if (elements.signalCandidate.sourceId.value) params.set('sourceId', elements.signalCandidate.sourceId.value);
      if (elements.signalCandidate.category.value) params.set('category', elements.signalCandidate.category.value);
      if (elements.signalCandidate.minScore.value !== '0') params.set('minScore', elements.signalCandidate.minScore.value);
      if (elements.signalCandidate.query.value.trim()) params.set('query', elements.signalCandidate.query.value.trim());
      return params.toString();
    };

    const loadSignalCandidates = async () => {
      const payload = await apiJson(`/admin/api/signal/candidates?${signalCandidateQueryString()}`);
      state.signalCandidates = payload.candidates || [];
      state.signalCandidateSummary = payload.summary || null;
      state.signalTriageReady = Boolean(payload.triageReady);
      state.signalDedupReady = Boolean(payload.dedupReady);
      elements.signalCandidatesRescore.disabled = !state.signalTriageReady;
      renderSignalCandidates();
      return payload;
    };

    const refreshSignalCandidates = async () => {
      setSignalCandidateStatus('正在读取候选资讯。', 'pending');
      try {
        await loadSignalCandidates();
        setSignalCandidateStatus('', 'neutral');
      } catch (error) {
        setSignalCandidateStatus(error.message, 'error');
      }
    };

    const reviewSignalCandidate = async (candidate, action, note) => {
      const row = elements.signalCandidatesList.querySelector(`[data-candidate-id="${CSS.escape(candidate.id)}"]`);
      row?.querySelectorAll('button').forEach((button) => { button.disabled = true; });
      setSignalCandidateStatus('正在保存审核结果。', 'pending');
      try {
        await apiJson('/admin/api/signal/candidates', {
          method: 'POST',
          body: JSON.stringify({ action, candidateId: candidate.id, note })
        });
        if (action === 'shortlist' && state.signalSelectedCandidateIds.size < 10) {
          state.signalSelectedCandidateIds.add(candidate.id);
          setSignalCandidateStatus(
            `已入选并加入本次草稿，当前已选 ${state.signalSelectedCandidateIds.size} / 10。`,
            'success'
          );
        } else {
          if (action !== 'shortlist') state.signalSelectedCandidateIds.delete(candidate.id);
          setSignalCandidateStatus('审核结果已保存。', 'success');
        }
        await Promise.all([loadSignalCandidates(), loadAuditLogs()]);
      } catch (error) {
        setSignalCandidateStatus(error.message, 'error');
        row?.querySelectorAll('button').forEach((button) => { button.disabled = false; });
      }
    };

    const rescoreSignalCandidateQueue = async () => {
      elements.signalCandidatesRescore.disabled = true;
      setSignalCandidateStatus('正在按来源可信度、时效、站点相关性和内容完整度重新评分。', 'pending');
      try {
        const payload = await apiJson('/admin/api/signal/candidates', {
          method: 'POST',
          body: JSON.stringify({ action: 'rescore' })
        });
        setSignalCandidateStatus(
          `已重新评分最近 ${payload.rescored || 0} 条候选资讯；更早记录保留原评分，聚类仅作为审核辅助。`,
          'success'
        );
        await Promise.all([loadSignalCandidates(), loadAuditLogs()]);
      } catch (error) {
        setSignalCandidateStatus(error.message, 'error');
      } finally {
        elements.signalCandidatesRescore.disabled = !state.signalTriageReady;
      }
    };

    const loadSignalAutomation = async () => {
      elements.signalAutomationSummary.textContent = '正在读取来源白名单。';
      delete elements.signalAutomationSummary.dataset.state;
      try {
        const [sourcesPayload, runsPayload, draftsPayload, operationsPayload] = await Promise.all([
          apiJson('/admin/api/signal/sources'),
          apiJson('/admin/api/signal/runs?limit=20'),
          apiJson('/admin/api/signal/drafts?status=draft&limit=30'),
          apiJson('/admin/api/signal/operations'),
          loadSignalModelRollout()
        ]);
        state.signalOperations = operationsPayload;
        state.signalAlerts = operationsPayload.alerts || [];
        state.signalSourceErrors = operationsPayload.sourceErrors || [];
        renderSignalOperations();
        state.signalDrafts = draftsPayload.drafts || [];
        state.signalDraftSummary = draftsPayload.summary || null;
        renderSignalDrafts();
        const setupRequired = sourcesPayload.setupRequired || runsPayload.setupRequired;
        if (setupRequired) {
          state.signalSources = [];
          state.signalRuns = [];
          state.signalCandidates = [];
          state.signalCollectionReady = false;
          state.signalTriageReady = false;
          state.signalDedupReady = false;
          state.signalCandidateSummary = null;
          elements.signalCollectionStart.disabled = true;
          elements.signalCandidatesRescore.disabled = true;
          elements.signalAutomationSummary.textContent = '待应用 migrations/0019_signal_automation.sql';
          renderEmpty(elements.signalSourcesList, '请先对生产 D1 应用 0019_signal_automation.sql。');
          renderEmpty(elements.signalRunsList, '数据表尚未初始化。');
          renderEmpty(elements.signalCandidatesList, '数据表尚未初始化。');
          renderSignalOperations();
          renderSignalCandidateSummary();
          return;
        }
        state.signalSources = sourcesPayload.sources || [];
        state.signalRuns = runsPayload.runs || [];
        state.signalCollectionReady = Boolean(sourcesPayload.collectionReady);
        renderSignalCandidateSourceOptions();
        await loadSignalCandidates();
        const sourceSummary = sourcesPayload.summary || {};
        const activeRun = state.signalRuns.find((run) => ['queued', 'running'].includes(run.status));
        elements.signalAutomationSummary.textContent = sourcesPayload.collectionReady
          ? activeRun
            ? `${sourceSummary.enabled || 0} 个来源启用 · 正在采集 ${activeRun.processedSourceCount || 0}/${activeRun.sourceCount || 0}`
            : `${sourceSummary.total || 0} 个来源 · ${sourceSummary.enabled || 0} 启用 · 每小时检查 · ${signalHealthLabel(operationsPayload.health?.state)}`
          : '待应用 migrations/0020_signal_collection.sql';
        elements.signalCollectionStart.disabled = !state.signalCollectionReady || Boolean(activeRun);
        renderSignalSources();
        renderSignalRuns();
        renderSignalOperations();
      } catch (error) {
        state.signalSources = [];
        state.signalRuns = [];
        state.signalCandidates = [];
        state.signalDrafts = [];
        state.signalDraftSummary = null;
        state.signalOperations = null;
        state.signalAlerts = [];
        state.signalSourceErrors = [];
        state.signalCollectionReady = false;
        state.signalTriageReady = false;
        state.signalDedupReady = false;
        state.signalCandidateSummary = null;
        elements.signalCollectionStart.disabled = true;
        elements.signalCandidatesRescore.disabled = true;
        elements.signalAutomationSummary.dataset.state = 'error';
        elements.signalAutomationSummary.textContent = `读取失败：${error.message}`;
        renderEmpty(elements.signalSourcesList, '来源白名单读取失败，请稍后重试。');
        renderEmpty(elements.signalRunsList, '采集运行记录暂时不可用。');
        renderEmpty(elements.signalCandidatesList, '候选资讯暂时不可用。');
        renderEmpty(elements.signalDraftsList, '简报草稿暂时不可用。');
        renderSignalOperations();
        elements.signalDraftsSummary.textContent = '草稿读取失败。';
        renderSignalCandidateSummary();
      }
    };

    const resolveSignalAlert = async (alert, button) => {
      button.disabled = true;
      elements.signalOperationsSummary.textContent = '正在更新告警状态。';
      try {
        const payload = await apiJson('/admin/api/signal/operations', {
          method: 'POST',
          body: JSON.stringify({ action: 'resolve_alert', alertId: alert.id })
        });
        elements.signalOperationsSummary.textContent = payload.message || '告警已标记为已处理。';
        await Promise.all([loadSignalAutomation(), loadAuditLogs()]);
      } catch (error) {
        elements.signalOperationsSummary.textContent = error.message;
        button.disabled = false;
      }
    };

    const retrySignalRun = async (run, button) => {
      button.disabled = true;
      elements.signalCollectionStatus.hidden = false;
      elements.signalCollectionStatus.dataset.tone = 'pending';
      elements.signalCollectionStatus.textContent = '正在重新加入失败来源。';
      try {
        const payload = await apiJson('/admin/api/signal/operations', {
          method: 'POST',
          body: JSON.stringify({ action: 'retry_run', runId: run.id })
        });
        elements.signalCollectionStatus.dataset.tone = payload.alreadyRunning ? 'pending' : 'success';
        elements.signalCollectionStatus.textContent = payload.message || '失败来源已重新加入队列。';
        await Promise.all([loadSignalAutomation(), loadAuditLogs()]);
        window.setTimeout(loadSignalAutomation, 1800);
        window.setTimeout(loadSignalAutomation, 5000);
      } catch (error) {
        elements.signalCollectionStatus.dataset.tone = 'error';
        elements.signalCollectionStatus.textContent = error.message;
        button.disabled = false;
      }
    };

    const startSignalCollection = async () => {
      elements.signalCollectionStart.disabled = true;
      elements.signalCollectionStatus.hidden = false;
      elements.signalCollectionStatus.dataset.tone = 'pending';
      elements.signalCollectionStatus.textContent = '正在把免费来源加入采集队列。';
      try {
        const payload = await apiJson('/admin/api/signal/collect', {
          method: 'POST',
          body: JSON.stringify({})
        });
        elements.signalCollectionStatus.dataset.tone = payload.alreadyRunning ? 'pending' : 'success';
        elements.signalCollectionStatus.textContent = payload.message || '采集已启动。';
        await Promise.all([loadSignalAutomation(), loadAuditLogs()]);
        window.setTimeout(loadSignalAutomation, 1800);
        window.setTimeout(loadSignalAutomation, 5000);
      } catch (error) {
        elements.signalCollectionStatus.dataset.tone = 'error';
        elements.signalCollectionStatus.textContent = error.message;
      } finally {
        elements.signalCollectionStart.disabled =
          !state.signalCollectionReady || state.signalRuns.some((run) => ['queued', 'running'].includes(run.status));
      }
    };

    const saveSignalSource = async (event) => {
      event.preventDefault();
      const payload = buildSignalSourcePayload();
      if (!payload.name || !payload.endpointUrl) {
        setSignalSourceStatus('来源名称和采集地址必填。', 'error');
        return;
      }
      const submitButton = elements.signalSourceForm.querySelector('[type="submit"]');
      submitButton.disabled = true;
      setSignalSourceStatus('正在保存来源。');
      try {
        await apiJson('/admin/api/signal/sources', {
          method: 'POST',
          body: JSON.stringify(payload)
        });
        resetSignalSourceForm();
        await loadSignalAutomation();
        await loadAuditLogs();
        setSignalSourceStatus('来源已保存。', 'success');
      } catch (error) {
        setSignalSourceStatus(error.message, 'error');
      } finally {
        submitButton.disabled = false;
      }
    };

    const toggleSignalSource = async (source) => {
      setSignalSourceStatus(`正在${source.isEnabled ? '暂停' : '启用'} ${source.name}。`);
      try {
        await apiJson('/admin/api/signal/sources', {
          method: 'POST',
          body: JSON.stringify({ action: 'toggle', id: source.id, isEnabled: !source.isEnabled })
        });
        await loadSignalAutomation();
        await loadAuditLogs();
        setSignalSourceStatus(`${source.name} 已${source.isEnabled ? '暂停' : '启用'}。`, 'success');
      } catch (error) {
        setSignalSourceStatus(error.message, 'error');
      }
    };

    const todayDateInput = () => new Date().toISOString().slice(0, 10);

    const resetSignalForm = () => {
      state.selectedSignalId = 0;
      state.signalDraftAutomation = null;
      elements.signal.title.value = '';
      elements.signal.slug.value = '';
      elements.signal.date.value = todayDateInput();
      elements.signalDraftDate.value = todayDateInput();
      elements.signal.category.value = 'tech';
      elements.signal.status.value = 'published';
      elements.signal.tags.value = '科技, 经济, AI';
      elements.signal.description.value = '';
      elements.signal.bullets.value = '';
      elements.signal.sources.value = '';
      elements.signal.markdown.value = '';
      elements.signalOpenPage.href = '/signal/';
      renderSignalBriefList();
      setSignalStatus('');
    };

    const signalSourcesToText = (sources) => (Array.isArray(sources) ? sources : [])
      .map((source) => [source?.label, source?.url, source?.note].map((value) => String(value || '').trim()).join(' | '))
      .filter((line) => line.replaceAll('|', '').trim())
      .join('\n');

    const fillSignalFormFromEntry = (entry, body = {}, automationOverride = null) => {
      const metadata = entry?.metadata || {};
      const briefDate = metadata.briefDate || String(entry?.publishedAt || '').slice(0, 10) || todayDateInput();
      const automation = automationOverride || metadata.automation || null;
      state.selectedSignalId = Number(entry?.id) || 0;
      state.signalDraftAutomation = automation
        ? { ...automation, sourceEntryId: Number(entry?.id) || Number(automation.sourceEntryId) || 0 }
        : null;
      elements.signal.title.value = entry?.title || '';
      elements.signal.slug.value = entry?.slug || '';
      elements.signal.date.value = briefDate;
      elements.signal.category.value = metadata.category || 'general';
      elements.signal.status.value = entry?.status || 'draft';
      elements.signal.tags.value = Array.isArray(entry?.tags) ? entry.tags.join(', ') : '';
      elements.signal.description.value = entry?.description || '';
      elements.signal.bullets.value = Array.isArray(metadata.summaryBullets) ? metadata.summaryBullets.join('\n') : '';
      elements.signal.sources.value = signalSourcesToText(metadata.sources);
      elements.signal.markdown.value = body?.markdown || '';
      elements.signalOpenPage.href = entry?.status === 'published' ? `/signal/${encodeURIComponent(entry.slug)}/` : '/signal/';
      renderSignalBriefList();
    };

    const buildSignalImportPayload = () => {
      const title = elements.signal.title.value.trim();
      const briefDate = elements.signal.date.value || todayDateInput();
      return {
        briefDate,
        bullets: elements.signal.bullets.value.split(/\n+/).map((line) => line.trim()).filter(Boolean),
        category: elements.signal.category.value,
        description: elements.signal.description.value.trim(),
        locale: 'zh-Hant',
        markdown: elements.signal.markdown.value.trim(),
        requestId: `signal-${briefDate}-${Date.now()}`,
        slug: elements.signal.slug.value.trim() || slugify(`${briefDate}-${title}`, 'daily-brief'),
        sourcesText: elements.signal.sources.value.trim(),
        status: elements.signal.status.value,
        tags: splitTags(elements.signal.tags.value),
        title,
        ...(state.signalDraftAutomation ? { automation: state.signalDraftAutomation } : {})
      };
    };

    const renderSignalBriefList = () => {
      if (!state.signalBriefs.length) {
        renderEmpty(elements.signalList, '还没有 Signal 简报。');
        return;
      }

      elements.signalList.innerHTML = '';
      state.signalBriefs.forEach((entry) => {
        const category = entry.metadata?.category || 'general';
        const button = document.createElement('button');
        button.className = `admin-v2-entry${entry.id === state.selectedSignalId ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(entry.title)}</span>
          <small>${escapeHtml(signalCategoryLabel(category))} · ${escapeHtml(entry.status)} · ${escapeHtml(formatDate(entry.publishedAt || entry.updatedAt))}</small>
          <small>${escapeHtml(entry.slug)}</small>
        `;
        button.addEventListener('click', () => loadSignalBriefForEdit(entry.id));
        elements.signalList.append(button);
      });
    };

    const loadSignalBriefForEdit = async (entryId) => {
      setSignalStatus('正在读取简报正文。', 'pending');
      try {
        const payload = await apiJson(`/admin/api/content/body?id=${encodeURIComponent(entryId)}`);
        fillSignalFormFromEntry(payload.entry, payload.body);
        setSignalStatus(
          payload.entry.status === 'draft' ? '草稿已载入，确认内容后再手动发布。' : '简报已载入。',
          'success'
        );
      } catch (error) {
        setSignalStatus(error.message, 'error');
      }
    };

    const loadSignalBriefs = async () => {
      const payload = await apiJson('/admin/api/content/entries?type=signal_brief&locale=zh-Hant');
      state.signalBriefs = (payload.entries || []).filter((entry) => entry.status !== 'archived');
      if (!state.signalBriefs.find((entry) => entry.id === state.selectedSignalId)) {
        state.selectedSignalId = state.signalBriefs[0]?.id || 0;
      }
      renderSignalBriefList();
      setStatus(`已载入 ${state.signalBriefs.length} 篇 Signal 简报。`, 'success');
    };

    const renderSignalDraftSummary = () => {
      const summary = state.signalDraftSummary || {};
      const summaryText = `${summary.draft || 0} 份待审核 · ${summary.published || 0} 份已发布 · ${summary.archived || 0} 份已归档`;
      elements.signalDraftsSummary.textContent = summaryText;
      elements.signalApprovalsSummary.textContent = summaryText;
    };

    const openSignalDraftForEdit = async (draft) => {
      const signalTab = elements.tabs.find((tab) => tab.dataset.adminV2Tab === 'signal');
      if (!signalTab?.classList.contains('is-active')) await switchTab('signal');
      await loadSignalBriefForEdit(draft.id);
      elements.signalForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => elements.signal.title.focus(), 350);
    };

    const createSignalDraftRow = (draft, { approval = false } = {}) => {
      const candidateCount = draft.automation?.candidateIds?.length || 0;
      const metadata = draft.metadata || {};
      const providerLabel = draft.automation?.provider === 'deepseek'
        ? 'DeepSeek'
        : draft.automation?.provider === 'workers-ai'
          ? 'Workers AI'
          : 'AI';
      const row = document.createElement('article');
      row.className = 'admin-v2-row admin-signal-draft-row';
      row.dataset.draftId = String(draft.id);
      row.innerHTML = `
        <div class="admin-signal-draft-row__heading">
          <strong>${escapeHtml(draft.title)}</strong>
          <span class="admin-signal-source-state" data-state="${draft.automationInvalid ? 'error' : 'healthy'}">
            ${draft.automationInvalid ? '关联异常' : '待审核'}
          </span>
        </div>
        <div class="admin-signal-draft-row__meta">
          <span>${escapeHtml(metadata.briefDate || String(draft.updatedAt || '').slice(0, 10))}</span>
          <span>${escapeHtml(signalCategoryLabel(metadata.category || 'general'))}</span>
          <span>${escapeHtml(String(candidateCount))} 条候选</span>
          <span>${escapeHtml(providerLabel)}${draft.automation?.fallbackUsed ? ' · 已回退' : ''}</span>
          <span>${escapeHtml(draft.automation?.model || 'AI draft')}</span>
        </div>
        ${draft.description ? `<p>${escapeHtml(draft.description)}</p>` : ''}
        <small>更新于 ${escapeHtml(formatDate(draft.updatedAt))}</small>
        <div class="button-row admin-signal-draft-row__actions"></div>
      `;
      const actions = row.querySelector('.admin-signal-draft-row__actions');
      const editButton = document.createElement('button');
      editButton.className = 'button button-secondary';
      editButton.type = 'button';
      editButton.textContent = approval ? '返回编辑' : '编辑';
      editButton.addEventListener('click', () => openSignalDraftForEdit(draft));
      actions.append(editButton);

      if (approval) {
        const approveButton = document.createElement('button');
        approveButton.className = 'button button-primary';
        approveButton.type = 'button';
        approveButton.textContent = '批准发布';
        approveButton.title = '发布最近一次已保存的版本';
        approveButton.disabled = draft.automationInvalid;
        approveButton.addEventListener('click', () => approveSignalBriefDraft(draft));
        actions.append(approveButton);
        return row;
      }

      const regenerateButton = document.createElement('button');
      regenerateButton.className = 'button button-secondary';
      regenerateButton.type = 'button';
      regenerateButton.textContent = '重新生成';
      regenerateButton.disabled = draft.automationInvalid;
      regenerateButton.addEventListener('click', () => regenerateSignalBriefDraft(draft));
      const archiveButton = document.createElement('button');
      archiveButton.className = 'button button-danger';
      archiveButton.type = 'button';
      archiveButton.textContent = '删除';
      archiveButton.addEventListener('click', () => archiveSignalBriefDraft(draft));
      actions.append(regenerateButton, archiveButton);
      return row;
    };

    const renderSignalApprovals = () => {
      if (!state.signalDrafts.length) {
        renderEmpty(elements.signalApprovalsList, '目前没有等待批准发布的简报。');
        return;
      }
      elements.signalApprovalsList.replaceChildren(
        ...state.signalDrafts.map((draft) => createSignalDraftRow(draft, { approval: true }))
      );
    };

    const renderSignalDrafts = () => {
      renderSignalDraftSummary();
      renderSignalApprovals();
      if (!state.signalDrafts.length) {
        renderEmpty(elements.signalDraftsList, '目前没有待审核草稿。入选 3–10 条候选后可生成一份新草稿。');
        return;
      }
      elements.signalDraftsList.replaceChildren(...state.signalDrafts.map((draft) => createSignalDraftRow(draft)));
    };

    const loadSignalDrafts = async () => {
      const payload = await apiJson('/admin/api/signal/drafts?status=draft&limit=30');
      state.signalDrafts = payload.drafts || [];
      state.signalDraftSummary = payload.summary || null;
      renderSignalDrafts();
      return payload;
    };

    const refreshSignalDrafts = async () => {
      setSignalDraftStatus('正在读取简报草稿。', 'pending');
      try {
        await loadSignalDrafts();
        setSignalDraftStatus('', 'neutral');
      } catch (error) {
        setSignalDraftStatus(error.message, 'error');
      }
    };

    const refreshSignalApprovals = async () => {
      setSignalApprovalStatus('正在读取待发布简报。', 'pending');
      try {
        await loadSignalDrafts();
        setSignalApprovalStatus('', 'neutral');
      } catch (error) {
        setSignalApprovalStatus(error.message, 'error');
      }
    };

    const applyGeneratedSignalDraft = async (payload) => {
      fillSignalFormFromEntry(payload.entry, payload.body, payload.automation);
      elements.signal.status.value = 'draft';
      const providerLabel = payload.automation?.provider === 'deepseek' ? 'DeepSeek' : 'Workers AI';
      const fallbackLabel = payload.automation?.fallbackUsed ? '（主模型失败后已自动回退）' : '';
      setSignalCandidateStatus(`草稿已由 ${providerLabel} 生成并保存${fallbackLabel}，候选仍保持“已入选”。`, 'success');
      setSignalDraftStatus('草稿已进入审核队列。请编辑并保存后，再点击“批准发布”。', 'success');
      setSignalStatus('AI 草稿已载入。请核对事实、来源和措辞，保存后回到草稿区批准发布。', 'success');
      await Promise.all([loadSignalDrafts(), loadSignalBriefs(), loadEntries(), loadAuditLogs()]);
      elements.signalForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => elements.signal.title.focus(), 350);
    };

    const requestSignalBriefDraft = async (draftRequest, options = {}) => {
      try {
        return await apiJson('/admin/api/signal/drafts/generate', {
          method: 'POST',
          body: JSON.stringify({ ...draftRequest, confirmOverwrite: options.confirmOverwrite === true })
        });
      } catch (error) {
        if (error.code !== 'SIGNAL_DRAFT_OVERWRITE_CONFIRMATION_REQUIRED' || options.confirmOverwrite) throw error;
        const confirmed = window.confirm(
          '这个日期已有自动化草稿。重新生成会覆盖当前编辑版本，但修订记录仍可找回。继续吗？'
        );
        if (!confirmed) return null;
        return apiJson('/admin/api/signal/drafts/generate', {
          method: 'POST',
          body: JSON.stringify({ ...draftRequest, confirmOverwrite: true })
        });
      }
    };

    const generateSignalBriefDraft = async () => {
      const candidateIds = [...state.signalSelectedCandidateIds];
      if (candidateIds.length < 3 || candidateIds.length > 10) {
        setSignalCandidateStatus('请选择 3 至 10 条已入选候选资讯。', 'error');
        return;
      }
      elements.signalDraftGenerate.disabled = true;
      elements.signalDraftGenerate.textContent = '正在生成';
      setSignalCandidateStatus('正在生成可编辑草稿，完成后会载入下方人工发布表单。', 'pending');
      try {
        const draftRequest = {
          briefDate: elements.signalDraftDate.value || todayDateInput(),
          candidateIds,
          category: elements.signalDraftCategory.value
        };
        const payload = await requestSignalBriefDraft(draftRequest);
        if (!payload) {
          setSignalCandidateStatus('已取消重新生成，当前草稿保持不变。');
          return;
        }
        await applyGeneratedSignalDraft(payload);
      } catch (error) {
        setSignalCandidateStatus(error.message, 'error');
      } finally {
        elements.signalDraftGenerate.textContent = '生成草稿';
        updateSignalDraftSelection();
      }
    };

    const regenerateSignalBriefDraft = async (draft) => {
      const candidateIds = draft.automation?.candidateIds || [];
      if (candidateIds.length < 3 || candidateIds.length > 10) {
        setSignalDraftStatus('草稿关联的候选数量无效，请删除后重新选择候选。', 'error');
        return;
      }
      const confirmed = window.confirm('重新生成会覆盖当前编辑内容，但修订记录仍可找回。继续吗？');
      if (!confirmed) return;
      setSignalDraftStatus('正在重新生成草稿。', 'pending');
      try {
        const payload = await requestSignalBriefDraft(
          {
            briefDate: draft.metadata?.briefDate || todayDateInput(),
            candidateIds,
            category: draft.metadata?.category || 'auto'
          },
          { confirmOverwrite: true }
        );
        await applyGeneratedSignalDraft(payload);
      } catch (error) {
        setSignalDraftStatus(error.message, 'error');
      }
    };

    const archiveSignalBriefDraft = async (draft) => {
      if (!window.confirm(`删除草稿“${draft.title}”？系统会归档并保留修订记录。`)) return;
      setSignalDraftStatus('正在删除草稿。', 'pending');
      try {
        await apiJson('/admin/api/signal/drafts', {
          method: 'POST',
          body: JSON.stringify({ action: 'archive', entryId: draft.id })
        });
        if (state.selectedSignalId === draft.id) resetSignalForm();
        setSignalDraftStatus('草稿已归档，候选审核状态没有变化。', 'success');
        await Promise.all([loadSignalDrafts(), loadSignalBriefs(), loadEntries(), loadAuditLogs()]);
      } catch (error) {
        setSignalDraftStatus(error.message, 'error');
      }
    };

    const approveSignalBriefDraft = async (draft) => {
      setSignalDraftStatus('正在批准并发布简报。', 'pending');
      setSignalApprovalStatus('正在批准并发布简报。', 'pending');
      const submit = async (allowCandidateExclusions = false) => apiJson('/admin/api/signal/drafts', {
        method: 'POST',
        body: JSON.stringify({ action: 'approve', entryId: draft.id, allowCandidateExclusions })
      });
      try {
        let result;
        try {
          result = await submit();
        } catch (error) {
          if (error.code !== 'SIGNAL_DRAFT_CANDIDATE_EXCLUSION_CONFIRMATION_REQUIRED') throw error;
          const excludedCount = error.payload?.excludedCandidateIds?.length || 0;
          const confirmed = window.confirm(
            `有 ${excludedCount} 条候选已不再入选。继续会把它们从本次发布关联中移除，是否发布？`
          );
          if (!confirmed) {
            setSignalDraftStatus('已取消发布，草稿和候选状态都没有变化。');
            setSignalApprovalStatus('已取消发布，草稿和候选状态都没有变化。');
            return;
          }
          result = await submit(true);
        }
        (result.usedCandidateIds || []).forEach((candidateId) => state.signalSelectedCandidateIds.delete(candidateId));
        elements.signalOpenPage.href = result.publicPath || `/signal/${encodeURIComponent(draft.slug)}/`;
        if (result.candidateUsageConflictIds?.length) {
          setSignalDraftStatus(
            `简报已发布，但 ${result.candidateUsageConflictIds.length} 条候选状态发生并发变化，请刷新核对。`,
            'error'
          );
          setSignalApprovalStatus(
            `简报已发布，但 ${result.candidateUsageConflictIds.length} 条候选状态发生并发变化，请刷新核对。`,
            'error'
          );
        } else {
          const successMessage = `简报已批准发布：${result.publicPath || `/signal/${draft.slug}/`}`;
          setSignalDraftStatus(successMessage, 'success');
          setSignalApprovalStatus(successMessage, 'success');
        }
        await Promise.all([
          loadSignalDrafts(),
          loadSignalBriefs(),
          loadSignalCandidates(),
          loadEntries(),
          loadAuditLogs()
        ]);
      } catch (error) {
        setSignalDraftStatus(error.message, 'error');
        setSignalApprovalStatus(error.message, 'error');
      }
    };

    const importSignalBrief = async (event) => {
      event.preventDefault();
      const payload = buildSignalImportPayload();
      if (!payload.title || !payload.markdown) {
        setSignalStatus('标题和简报正文必填。', 'error');
        return;
      }

      const submitButton = elements.signalForm.querySelector('[type="submit"]');
      submitButton.disabled = true;
      setSignalStatus('正在导入 Signal 简报。');
      try {
        let result;
        try {
          result = await apiJson('/admin/api/signal/import', {
            method: 'POST',
            body: JSON.stringify(payload)
          });
        } catch (error) {
          if (error.code !== 'SIGNAL_DRAFT_CANDIDATE_EXCLUSION_CONFIRMATION_REQUIRED') throw error;
          const excludedCount = Array.isArray(error.payload?.excludedCandidateIds)
            ? error.payload.excludedCandidateIds.length
            : 0;
          const confirmed = window.confirm(
            `有 ${excludedCount} 条关联候选已被淘汰或移出入选队列。继续发布会放弃这些候选的自动化关联，继续吗？`
          );
          if (!confirmed) {
            setSignalStatus('已取消发布，草稿和候选状态都没有变化。');
            return;
          }
          result = await apiJson('/admin/api/signal/import', {
            method: 'POST',
            body: JSON.stringify({
              ...payload,
              allowCandidateExclusions: true
            })
          });
        }
        const publicPath = result.publicPath || `/signal/${payload.slug}/`;
        elements.signalOpenPage.href = payload.status === 'published' ? publicPath : '/signal/';
        const usedCandidateIds = Array.isArray(result.usedCandidateIds) ? result.usedCandidateIds : [];
        const excludedCandidateIds = Array.isArray(result.excludedCandidateIds) ? result.excludedCandidateIds : [];
        const candidateUsageConflictIds = Array.isArray(result.candidateUsageConflictIds)
          ? result.candidateUsageConflictIds
          : [];
        usedCandidateIds.forEach((candidateId) => state.signalSelectedCandidateIds.delete(candidateId));
        if (payload.status === 'published' && candidateUsageConflictIds.length) {
          setSignalStatus(
            `简报已发布，但 ${candidateUsageConflictIds.length} 条候选的状态同时被其他操作修改，请刷新候选队列确认。`,
            'error'
          );
        } else if (payload.status === 'published' && excludedCandidateIds.length) {
          setSignalStatus(
            `发布成功：${publicPath}。已从自动化关联中移除 ${excludedCandidateIds.length} 条不再入选的候选。`,
            'success'
          );
        } else if (payload.status === 'published') {
          setSignalStatus(`发布成功：${publicPath}，分享卡片 ${result.shareCardPath || `${publicPath}card.svg`}`, 'success');
        } else {
          setSignalStatus('草稿已保存到内容平台，尚未公开。', 'success');
        }
        await Promise.all([loadSignalDrafts(), loadSignalBriefs(), loadEntries(), loadAuditLogs(), loadSignalCandidates()]);
      } catch (error) {
        setSignalStatus(error.message, 'error');
      } finally {
        submitButton.disabled = false;
      }
    };

    const importStatusTone = (status) => {
      if (['completed', 'completed_with_warnings', 'reviewed'].includes(status)) return 'success';
      if (['failed'].includes(status)) return 'error';
      return 'neutral';
    };

    const importTitle = (item) => item?.summary?.seriesTitle || item?.requestId || `Import #${item?.id || ''}`;

    const importPricingSummary = (item) => {
      const pricing = item?.summary?.pricing || {};
      const bundles = pricing.bundlePurchasesEnabled && Array.isArray(pricing.chapterBundleDiscounts) && pricing.chapterBundleDiscounts.length
        ? pricing.chapterBundleDiscounts.map((rule) => `${rule.minimumChapters}章 ${rule.discountPercent}% off`).join('，')
        : '多章折扣未开启';
      const creditPacks = Array.isArray(pricing.creditPacks) && pricing.creditPacks.length
        ? pricing.creditPacks.map((pack) => `${pack.credits}点/${formatMoney(pack.priceAmount, pack.priceCurrency || 'USD')}`).join('，')
        : '阅读点包未配置';
      const membership = pricing.subscriptionEnabled !== false
        ? `会员 ${pricing.membershipCreditCost || 10} 点/${pricing.membershipDurationMonths || 1}个月`
        : '会员关闭';
      return `${pricing.mode || 'free'} · 免费 ${pricing.freeChapters || 0} 章 · ${pricing.chapterCredits || 1} 点/章 · ${membership} · ${bundles} · ${creditPacks}`;
    };

    const renderImportList = () => {
      if (!state.imports.length) {
        renderEmpty(elements.importsList, '暂无 NovelForge 导入记录。');
        elements.importDetail.innerHTML = '<p class="admin-empty-list">NovelForge 软件导入后，这里会出现可审核批次。</p>';
        return;
      }

      elements.importsList.innerHTML = '';
      state.imports.forEach((item) => {
        const button = document.createElement('button');
        button.className = `admin-v2-entry${item.id === state.selectedImportId ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(importTitle(item))}</span>
          <small>${escapeHtml(item.status)} · ${escapeHtml(formatDate(item.updatedAt))}</small>
          <small>${escapeHtml(String(item.summary?.entryCount || 0))} 条内容 · 草稿 ${escapeHtml(String(item.summary?.draftCount || 0))} · 警告 ${escapeHtml(String(item.warnings?.length || 0))}</small>
        `;
        button.addEventListener('click', () => {
          state.selectedImportId = item.id;
          renderImportList();
          renderImportDetail();
        });
        elements.importsList.append(button);
      });
    };

    const renderImportDetail = () => {
      const item = state.imports.find((entry) => entry.id === state.selectedImportId) || state.imports[0];
      if (!item) {
        elements.importDetail.innerHTML = '<p class="admin-empty-list">选择一个 NovelForge 导入批次查看详情。</p>';
        return;
      }
      state.selectedImportId = item.id;
      const entries = item.entries || [];
      const warnings = item.warnings || [];
      const errors = item.errors || [];
      const canPublish = (item.summary?.draftCount || 0) > 0;
      elements.importDetail.innerHTML = `
        <div class="admin-v2-section-heading">
          <div>
            <p class="station-kicker">Import #${escapeHtml(String(item.id))}</p>
            <h3>${escapeHtml(importTitle(item))}</h3>
          </div>
          <span class="admin-status-pill" data-tone="${importStatusTone(item.status)}">${escapeHtml(item.status)}</span>
        </div>
        <div class="admin-detail-grid">
          <article><span>内容</span><strong>${escapeHtml(String(item.summary?.entryCount || 0))}</strong><small>章节 ${escapeHtml(String(item.summary?.chapterCount || 0))}</small></article>
          <article><span>草稿</span><strong>${escapeHtml(String(item.summary?.draftCount || 0))}</strong><small>可批量发布</small></article>
          <article><span>更新</span><strong>${escapeHtml(String(item.entriesUpdated || 0))}</strong><small>创建 ${escapeHtml(String(item.entriesCreated || 0))}</small></article>
          <article><span>时间</span><strong>${escapeHtml(formatDate(item.updatedAt) || '-')}</strong><small>${escapeHtml(formatDate(item.createdAt) || '')}</small></article>
        </div>
        <div class="admin-pricing-lines">
          <p><strong>Request ID：</strong><code class="admin-import-code">${escapeHtml(item.requestId || '')}</code></p>
          <p><strong>导入备份：</strong><code class="admin-import-code">${escapeHtml(item.r2Key || '未写入 R2 备份')}</code></p>
          <p><strong>收费摘要：</strong>${escapeHtml(importPricingSummary(item))}</p>
          ${warnings.map((warning) => `<p class="admin-pricing-warning"><strong>Warning：</strong>${escapeHtml(warning.message || warning)}</p>`).join('')}
          ${errors.map((error) => `<p class="admin-pricing-warning"><strong>Error：</strong>${escapeHtml(error.message || error)}</p>`).join('')}
        </div>
        <div class="button-row">
          <button class="button button-primary" id="import-publish-drafts" type="button" ${canPublish ? '' : 'disabled'}>发布本批草稿</button>
          <button class="button button-secondary" id="import-detail-refresh" type="button">刷新本批次</button>
          <button class="button button-secondary" id="import-delete-record" type="button">删除导入记录</button>
        </div>
        <section class="admin-detail-section">
          <h4>关联内容</h4>
          ${entries.length ? entries.map((entry) => `
            <article class="admin-v2-row admin-import-entry">
              <strong>${escapeHtml(entry.title || entry.slug)}</strong>
              <span>${escapeHtml(entryTypeLabel(entry.entryType))} · ${escapeHtml(entry.locale)} · ${escapeHtml(entry.status)} · ${escapeHtml(entry.accessLevel)}</span>
              <small>${escapeHtml(entry.parentSlug ? `${entry.parentSlug}/${entry.slug}` : entry.slug)} · ${escapeHtml(entry.remoteId || '')}${entry.coverRemoteId ? ` · ${escapeHtml(entry.coverRemoteId)}` : ''}</small>
              <div class="button-row admin-import-actions">
                <button class="button button-secondary" type="button" data-import-edit-id="${escapeHtml(String(entry.id))}">编辑</button>
                <a class="button button-secondary" href="${escapeHtml(entry.adminUrl)}">后台链接</a>
                ${entry.publicUrl ? `<a class="button button-secondary" href="${escapeHtml(entry.publicUrl)}" target="_blank" rel="noreferrer">公开页</a>` : ''}
              </div>
            </article>
          `).join('') : '<p class="admin-empty-list">这条导入记录没有找到关联内容。</p>'}
        </section>
      `;

      $('#import-publish-drafts')?.addEventListener('click', publishSelectedImport);
      $('#import-detail-refresh')?.addEventListener('click', () => loadImportReviews({ importId: item.id }));
      $('#import-delete-record')?.addEventListener('click', deleteSelectedImport);
      $$('[data-import-edit-id]').forEach((button) => {
        button.addEventListener('click', () => openImportEntryForEdit(button.dataset.importEditId));
      });
    };

    const loadImportReviews = async ({ importId = 0 } = {}) => {
      const params = new URLSearchParams({ type: 'novelforge', limit: '50' });
      if (importId) params.set('id', String(importId));
      const payload = await apiJson(`/admin/api/content/imports?${params.toString()}`);
      if (importId) {
        const [updatedImport] = payload.imports || [];
        if (updatedImport) {
          state.imports = state.imports.map((item) => (item.id === updatedImport.id ? updatedImport : item));
          if (!state.imports.find((item) => item.id === updatedImport.id)) state.imports.unshift(updatedImport);
        }
      } else {
        state.imports = payload.imports || [];
        if (!state.imports.find((item) => item.id === state.selectedImportId)) {
          state.selectedImportId = state.imports[0]?.id || 0;
        }
      }
      renderImportList();
      renderImportDetail();
      setStatus(`已载入 ${state.imports.length} 个 NovelForge 导入批次。`, 'success');
    };

    const publishSelectedImport = async () => {
      if (!state.selectedImportId) return;
      const button = $('#import-publish-drafts');
      if (button) button.disabled = true;
      setStatus('正在发布这批 NovelForge 草稿。');
      try {
        const payload = await apiJson('/admin/api/content/imports/review', {
          method: 'POST',
          body: JSON.stringify({ action: 'publish', importId: state.selectedImportId })
        });
        if (payload.import) {
          state.imports = state.imports.map((item) => (item.id === payload.import.id ? payload.import : item));
        }
        renderImportList();
        renderImportDetail();
        await Promise.all([loadEntries(), loadAuditLogs()]);
        setStatus(payload.message || '导入草稿已发布。', 'success');
      } catch (error) {
        setStatus(error.message, 'error');
      } finally {
        if (button) button.disabled = false;
      }
    };

    const deleteSelectedImport = async () => {
      if (!state.selectedImportId) return;
      const item = state.imports.find((entry) => entry.id === state.selectedImportId);
      const title = importTitle(item);
      const confirmed = window.confirm(`确定删除导入记录「${title}」吗？已导入的作品和章节不会被删除。`);
      if (!confirmed) return;

      const button = $('#import-delete-record');
      if (button) button.disabled = true;
      setStatus('正在删除导入记录。');
      try {
        const payload = await apiJson('/admin/api/content/imports/review', {
          method: 'POST',
          body: JSON.stringify({ action: 'delete', importId: state.selectedImportId })
        });
        const deletedImportId = payload.deletedImportId || state.selectedImportId;
        state.imports = state.imports.filter((entry) => entry.id !== deletedImportId);
        state.selectedImportId = state.imports[0]?.id || 0;
        renderImportList();
        renderImportDetail();
        await loadAuditLogs();
        setStatus(payload.message || '导入记录已删除。', 'success');
      } catch (error) {
        setStatus(error.message, 'error');
      } finally {
        if (button) button.disabled = false;
      }
    };

    const openImportEntryForEdit = async (entryId) => {
      const id = Number.parseInt(entryId || '', 10);
      if (!Number.isFinite(id) || id <= 0) return;
      await switchTab('content');
      await loadEntryForEdit(id);
    };

    const loadSchema = async () => {
      const schema = await apiJson('/admin/api/content/schema');
      state.schema = schema;
      elements.stage.textContent = `Stage ${schema.stage}`;
      elements.storageBadge.textContent = schema.storage?.contentBucketConfigured ? 'R2 已连接' : 'R2 未配置';
      elements.storageBadge.dataset.tone = schema.storage?.contentBucketConfigured ? 'success' : 'error';
    };

    const loadPricingDefaults = async ({ silent = false } = {}) => {
      if (!silent) setPricingDefaultsStatus('正在读取收费模板。');
      try {
        const payload = await apiJson('/admin/api/content/pricing-defaults');
        state.pricingDefaults = payload.template || emptyPricingDefaults();
        state.pricingDefaultsSetupRequired = Boolean(payload.setupRequired);
        renderPricingDefaults();
        if (payload.setupRequired) {
          setPricingDefaultsStatus(payload.message || '需要先应用 0008_admin_content_settings.sql。', 'error');
        } else if (!silent) {
          setPricingDefaultsStatus('收费模板已刷新。', 'success');
        }
      } catch (error) {
        state.pricingDefaults = emptyPricingDefaults();
        renderPricingDefaults();
        setPricingDefaultsStatus(error.message, 'error');
      }
    };

    const savePricingDefaults = async () => {
      elements.pricingDefaultsSave.disabled = true;
      setPricingDefaultsStatus('正在保存全局收费规则。');
      try {
        const payload = await apiJson('/admin/api/content/pricing-defaults', {
          method: 'POST',
          body: JSON.stringify({
            accessLevel: elements.globalPricing.accessLevel.value,
            pricing: buildGlobalPricingPayload()
          })
        });
        state.pricingDefaults = payload.template || emptyPricingDefaults();
        state.pricingDefaultsSetupRequired = false;
        renderPricingDefaults();
        applyPricingDefaults();
        setPricingDefaultsStatus('全局收费规则已保存，并会对全部书籍生效。', 'success');
      } catch (error) {
        setPricingDefaultsStatus(error.message, 'error');
      } finally {
        elements.pricingDefaultsSave.disabled = false;
      }
    };

    const applyPricingDefaults = () => {
      const template = getPricingDefaults();
      applyPricingToFields(template.pricing, template.accessLevel);
      resetEffectivePricingPreview('已套用全局收费规则到当前编辑表单。全局规则保存后会直接影响所有书籍。');
      setPricingDefaultsStatus('已套用全局规则到当前表单。', 'success');
    };

    const loadEntries = async ({ autoSelect = false } = {}) => {
      const params = new URLSearchParams();
      if (elements.filters.type.value) params.set('type', elements.filters.type.value);
      if (elements.filters.status.value) params.set('status', elements.filters.status.value);
      const payload = await apiJson(`/admin/api/content/entries?${params.toString()}`);
      state.entries = payload.entries || [];
      const selectedEntryStillVisible = state.entries.some((entry) => entry.id === state.selectedEntryId);
      renderContentList();
      if (autoSelect && state.entries.length) {
        const entryId = selectedEntryStillVisible && state.selectedEntryId ? state.selectedEntryId : state.entries[0].id;
        await loadEntryForEdit(entryId);
        return;
      }
      setStatus(`已载入 ${state.entries.length} 条后端内容。`, 'success');
    };

    const loadEntryForEdit = async (id) => {
      setStatus('正在读取正文。');
      const payload = await apiJson(`/admin/api/content/body?id=${encodeURIComponent(id)}`);
      fillFormFromEntry(payload.entry, payload.body);
      await loadRevisions(id);
      renderContentList();
      const pricingRules = Array.isArray(payload.pricingRules) ? payload.pricingRules.length : 0;
      setStatus(`已载入：${payload.entry.title}，收费规则 ${pricingRules} 条。`, 'success');
      await refreshEffectivePricingPreview({ silent: true });
    };

    const loadRevisions = async (id = state.selectedEntryId) => {
      if (!id) {
        renderEmpty(elements.revisionList, '保存后会显示修订记录。');
        return;
      }
      const payload = await apiJson(`/admin/api/content/revisions?id=${encodeURIComponent(id)}`);
      const revisions = payload.revisions || [];
      if (!revisions.length) {
        renderEmpty(elements.revisionList, '暂无修订记录。');
        return;
      }
      elements.revisionList.innerHTML = revisions.map((revision) => `
        <article class="admin-v2-row">
          <strong>#${revision.revisionNumber} · ${escapeHtml(revision.status)}</strong>
          <span>${escapeHtml(revision.summary || '未填写修订说明')}</span>
          <small>${escapeHtml(revision.createdBy || 'admin')} · ${escapeHtml(revision.createdAt || '')}</small>
        </article>
      `).join('');
    };

    const buildPayload = () => {
      const markdown = elements.fields.markdown.value.trim();
      const html = renderPreview();
      const wordCount = countWords(markdown);
      const entryType = elements.fields.entryType.value;
      const slug = elements.fields.slug.value.trim() || slugify(elements.fields.title.value, entryType);

      return {
        id: elements.fields.id.value || undefined,
        entryType,
        locale: elements.fields.locale.value,
        status: elements.fields.status.value,
        visibility: elements.fields.visibility.value,
        accessLevel: elements.fields.accessLevel.value,
        slug,
        parentSlug: entryType === 'novel_chapter' ? elements.fields.parentSlug.value.trim() : '',
        title: elements.fields.title.value.trim(),
        subtitle: elements.fields.subtitle.value.trim(),
        authorName: elements.fields.author.value.trim() || 'Station Cat',
        tags: splitTags(elements.fields.tags.value),
        chapterNumber: elements.fields.chapterNumber.value ? Number(elements.fields.chapterNumber.value) : undefined,
        volumeTitle: elements.fields.volumeTitle.value.trim(),
        publishedAt: elements.fields.publishedAt.value,
        sortOrder: Number(elements.fields.sortOrder.value || 0),
        featured: elements.fields.featured.checked,
        description: elements.fields.description.value.trim(),
        excerpt: elements.fields.excerpt.value.trim(),
        coverR2Key: elements.fields.coverR2Key.value.trim(),
        coverAlt: elements.fields.coverAlt.value.trim(),
        sourceRef: elements.fields.sourceRef.value.trim(),
        revisionSummary: elements.fields.revisionSummary.value.trim(),
        markdown,
        html,
        wordCount,
        readingMinutes: Math.max(1, Math.ceil(wordCount / 450)),
        pricing: buildPricingPayload(),
        metadata: {
          adminVersion: '8C',
          importedFromAdminV2: true
        }
      };
    };

    const setContentSaveButtonsDisabled = (disabled) => {
      $$('[data-content-save-button]').forEach((button) => {
        button.disabled = disabled;
        button.setAttribute('aria-busy', disabled ? 'true' : 'false');
      });
    };

    const saveContent = async (event) => {
      event.preventDefault();
      const payload = buildPayload();
      const hasValidChapterNumber = Number.isInteger(payload.chapterNumber) && payload.chapterNumber > 0;
      if (!payload.title || !payload.slug) {
        setSaveStatus('标题和 Slug 必填。', 'error');
        return;
      }
      if (payload.entryType === 'novel_chapter' && (!payload.parentSlug || !hasValidChapterNumber)) {
        setSaveStatus('小说章节需要 seriesSlug 和章节序号。', 'error');
        const missingField = payload.parentSlug ? elements.fields.chapterNumber : elements.fields.parentSlug;
        missingField.focus();
        return;
      }

      setContentSaveButtonsDisabled(true);
      setSaveStatus('正在保存到 D1 / R2。');
      try {
        const result = await apiJson('/admin/api/content/entries', {
          method: 'POST',
          body: JSON.stringify(payload)
        });
        const pricingRules = Array.isArray(result.pricingRules) ? result.pricingRules.length : 0;
        setSaveStatus(`保存成功，修订 #${result.revisionNumber}，同步 ${pricingRules} 条收费规则。`, 'success');
        fillFormFromEntry(result.entry, { markdown: payload.markdown, html: payload.html });
        await refreshEffectivePricingPreview({ silent: true });
        await Promise.all([loadEntries(), loadRevisions(result.entry.id), loadAuditLogs()]);
      } catch (error) {
        setSaveStatus(error.message, 'error');
      } finally {
        setContentSaveButtonsDisabled(false);
      }
    };

    const openWorkerPreview = async () => {
      const payload = buildPayload();
      const hasValidChapterNumber = Number.isInteger(payload.chapterNumber) && payload.chapterNumber > 0;
      if (!payload.title || !payload.slug) {
        setSaveStatus('标题和 Slug 必填，才能打开 Worker 预览。', 'error');
        return;
      }
      if (payload.entryType === 'novel_chapter' && (!payload.parentSlug || !hasValidChapterNumber)) {
        setSaveStatus('小说章节预览需要 seriesSlug 和章节序号。', 'error');
        return;
      }

      const previewWindow = window.open('', '_blank');
      if (!previewWindow) {
        setSaveStatus('浏览器阻止了预览窗口，请允许弹窗后重试。', 'error');
        return;
      }
      previewWindow.document.write('<!doctype html><title>Station Cat Preview</title><p style="font-family: system-ui; padding: 24px;">正在生成 Worker 预览...</p>');
      previewWindow.document.close();

      const button = $('#content-worker-preview-button');
      button.disabled = true;
      setSaveStatus('正在生成 Worker 预览。');
      try {
        const response = await fetch('/admin/api/content/preview', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const contentType = response.headers.get('content-type') || '';
        const text = await response.text();
        if (!response.ok) {
          let message = `Preview failed: ${response.status}`;
          if (contentType.includes('application/json')) {
            try {
              message = JSON.parse(text).message || message;
            } catch {}
          }
          throw new Error(message);
        }
        previewWindow.document.open();
        previewWindow.document.write(text);
        previewWindow.document.close();
        setSaveStatus('Worker 预览已打开。', 'success');
      } catch (error) {
        previewWindow.document.open();
        previewWindow.document.write(`<!doctype html><title>Preview Error</title><p style="font-family: system-ui; padding: 24px;">${escapeHtml(error.message)}</p>`);
        previewWindow.document.close();
        setSaveStatus(error.message, 'error');
      } finally {
        button.disabled = false;
      }
    };

    const applyImportedMarkdown = (markdown) => {
      const parsed = parseMarkdownDocument(markdown);
      const frontmatter = parsed.frontmatter;
      const entryType = detectEntryType(frontmatter);
      resetForm(entryType);

      elements.fields.entryType.value = entryType;
      elements.fields.locale.value = frontmatter.language || frontmatter.locale || 'zh-Hant';
      elements.fields.status.value = normalizeBackendStatus(frontmatter);
      elements.fields.title.value = frontmatter.title || '';
      elements.fields.subtitle.value = frontmatter.subtitle || frontmatter.tagline || '';
      elements.fields.description.value = frontmatter.description || '';
      elements.fields.excerpt.value = frontmatter.excerpt || '';
      elements.fields.author.value = frontmatter.author || 'Station Cat';
      elements.fields.tags.value = Array.isArray(frontmatter.tags) ? frontmatter.tags.join(', ') : '';
      elements.fields.slug.value = frontmatter.chapterSlug || frontmatter.slug || frontmatter.seriesSlug || slugify(frontmatter.title, entryType);
      elements.fields.parentSlug.value = frontmatter.seriesSlug || frontmatter.parentSlug || '';
      elements.fields.chapterNumber.value = frontmatter.chapterNumber || frontmatter.number || '';
      elements.fields.publishedAt.value = toDatetimeLocal(frontmatter.publishedAt || frontmatter.pubDate || '');
      elements.fields.coverR2Key.value = frontmatter.coverImage || '';
      elements.fields.coverAlt.value = frontmatter.coverAlt || '';
      elements.fields.accessLevel.value = frontmatter.access || frontmatter.accessLevel || 'free';
      elements.fields.pricingMode.value = frontmatter.priceMode || 'free';
      elements.fields.freeChapters.value = frontmatter.freeChapters || 0;
      elements.fields.chapterPrice.value = frontmatter.chapterPriceAmount || '';
      elements.fields.supporterPrice.value = frontmatter.supporterPriceAmount || '';
      elements.fields.chapterCredits.value = frontmatter.chapterCredits || '';
      elements.fields.tipsEnabled.checked = Boolean(frontmatter.tipsEnabled);
      elements.fields.tipAmounts.value = Array.isArray(frontmatter.tipAmounts) ? frontmatter.tipAmounts.join(', ') : '';
      elements.fields.bundlesEnabled.checked = Boolean(frontmatter.bundlePurchasesEnabled);
      elements.fields.bundles.value = bundleRulesToInput(frontmatter.chapterBundleDiscounts);
      elements.fields.creditPacks.value = creditPacksToInput(frontmatter.creditPacks || frontmatter.readerCreditPacks);
      elements.fields.markdown.value = parsed.body;
      elements.fields.sourceRef.value = 'markdown-import';
      elements.fields.revisionSummary.value = 'Imported from Markdown file';

      updateConditionalFields();
      renderPreview();
      renderCoverPreview();
      setSaveStatus('Markdown 已导入，检查字段后即可保存。', 'success');
    };

    const loadOrders = async () => {
      const params = new URLSearchParams({ limit: '80' });
      if (elements.filters.orderStatus.value) params.set('status', elements.filters.orderStatus.value);
      if (elements.filters.orderType.value) params.set('orderType', elements.filters.orderType.value);
      if (elements.filters.orderEmail.value.trim()) params.set('email', elements.filters.orderEmail.value.trim());
      if (elements.filters.orderSeries.value.trim()) params.set('series', elements.filters.orderSeries.value.trim());
      const payload = await apiJson(`/admin/api/novels/payments/orders?${params.toString()}`);
      const orders = payload.orders || [];
      const cleanup = payload.cleanup || {};
      const cleanupMessage = cleanup.deleted
        ? `，已自动清理 ${cleanup.deleted} 笔超过 ${cleanup.olderThanHours || 12} 小时的未完成订单。`
        : '';
      state.orders = orders;
      if (!orders.length) {
        renderEmpty(elements.ordersList, '暂无订单。');
        elements.orderDetail.innerHTML = '<p class="admin-empty-list">没有可查看的订单详情。</p>';
        setStatus(`暂无订单${cleanupMessage}`, 'success');
        return;
      }
      elements.ordersList.innerHTML = '';
      orders.forEach((order) => {
        const button = document.createElement('button');
        button.className = `admin-v2-entry${order.orderToken === state.selectedOrderToken ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(orderTitle(order))}</span>
          <small>${escapeHtml(order.status)} · ${escapeHtml(order.orderType)} · ${escapeHtml(formatMoney(order.priceAmount, order.priceCurrency))}</small>
          <small>${escapeHtml(order.accountEmail || order.customerEmail || '无账户')} · ${escapeHtml(order.seriesSlug || '')}${order.chapterSlug ? `/${escapeHtml(order.chapterSlug)}` : ''}</small>
        `;
        button.addEventListener('click', () => loadOrderDetail(order.orderToken || order.id));
        elements.ordersList.append(button);
      });
      setStatus(`已载入 ${orders.length} 笔订单${cleanupMessage}`, 'success');
    };

    const renderOrderDetail = (detail) => {
      const order = detail.order;
      const fulfillment = detail.fulfillment || {};
      const events = detail.events || [];
      const canFulfill = ['confirmed', 'finished'].includes(order.status) && !fulfillment.complete && order.orderType !== 'tip';
      elements.orderDetail.innerHTML = `
        <div class="admin-v2-section-heading">
          <div>
            <p class="station-kicker">Order Detail</p>
            <h3>${escapeHtml(orderTitle(order))}</h3>
          </div>
          <span class="admin-status-pill" data-tone="${statusTone(order.status)}">${escapeHtml(order.status)}</span>
        </div>
        <div class="admin-detail-grid">
          <article><span>类型</span><strong>${escapeHtml(order.orderType)}</strong></article>
          <article><span>金额</span><strong>${escapeHtml(formatMoney(order.priceAmount, order.priceCurrency))}</strong></article>
          <article><span>支付</span><strong>${escapeHtml(order.payAmount || '-')} ${escapeHtml(order.payCurrency || '')}</strong></article>
          <article><span>履约</span><strong>${fulfillment.complete ? '已完成' : fulfillment.needsReview ? '需排查' : fulfillment.pending ? '等待中' : '未完成'}</strong></article>
        </div>
        <div class="admin-pricing-lines">
          <p><strong>读者：</strong>${escapeHtml(order.accountEmail || order.customerEmail || '无账户')}</p>
          <p><strong>内容：</strong>${escapeHtml(order.seriesSlug || '-')}${order.chapterSlug ? ` / ${escapeHtml(order.chapterSlug)}` : ''}</p>
          <p><strong>Provider：</strong>${escapeHtml(order.providerStatus || '-')} · ${escapeHtml(order.providerPaymentId || order.providerInvoiceId || '-')}</p>
          <p><strong>创建 / 更新：</strong>${escapeHtml(formatDate(order.createdAt))} / ${escapeHtml(formatDate(order.updatedAt))}</p>
          <p><strong>履约原因：</strong>${escapeHtml(fulfillment.reason || '-')}</p>
        </div>
        <div class="button-row">
          ${canFulfill ? '<button class="button button-primary" id="order-fulfill" type="button">重跑履约</button>' : ''}
          ${order.paymentUrl ? `<a class="button button-secondary" href="${escapeHtml(order.paymentUrl)}" target="_blank" rel="noreferrer">打开支付页</a>` : ''}
        </div>
        <section class="admin-detail-section">
          <h4>支付事件</h4>
          ${events.length ? events.map((event) => `
            <article class="admin-v2-row">
              <strong>${escapeHtml(event.status || event.eventType)}</strong>
              <span>${event.signatureValid ? '签名有效' : '签名未确认'} · ${escapeHtml(event.providerPaymentId || '')}</span>
              <small>${escapeHtml(formatDate(event.receivedAt))}</small>
            </article>
          `).join('') : '<p class="admin-empty-list">暂无 IPN 事件。</p>'}
        </section>
      `;
      const fulfillButton = $('#order-fulfill');
      if (fulfillButton) fulfillButton.addEventListener('click', () => fulfillOrder(order));
    };

    const loadOrderDetail = async (orderTokenOrId) => {
      const value = String(orderTokenOrId || '');
      if (!value) return;
      const params = new URLSearchParams(Number.isFinite(Number(value)) ? { id: value } : { order: value });
      state.selectedOrderToken = value;
      elements.orderDetail.innerHTML = '<p class="admin-empty-list">正在读取订单详情。</p>';
      const detail = await apiJson(`/admin/api/novels/payments/order?${params.toString()}`);
      renderOrderDetail(detail);
      await loadOrders();
    };

    const fulfillOrder = async (order) => {
      const result = await apiJson('/admin/api/novels/payments/orders/fulfill', {
        method: 'POST',
        body: JSON.stringify({ id: order.id, orderToken: order.orderToken })
      });
      renderOrderDetail(result);
      await Promise.all([loadOrders(), loadAuditLogs()]);
      setStatus('订单履约已重跑。', 'success');
    };

    const loadAccounts = async () => {
      const params = new URLSearchParams({ limit: '80' });
      if (elements.filters.accountEmail.value.trim()) params.set('email', elements.filters.accountEmail.value.trim());
      if (elements.filters.accountStatus.value) params.set('status', elements.filters.accountStatus.value);
      const payload = await apiJson(`/admin/api/novels/readers/accounts?${params.toString()}`);
      const accounts = payload.accounts || [];
      state.accounts = accounts;
      if (!accounts.length) {
        renderEmpty(elements.accountsList, '暂无读者账户。');
        elements.accountDetail.innerHTML = '<p class="admin-empty-list">没有可查看的账户详情。</p>';
        return;
      }
      elements.accountsList.innerHTML = '';
      accounts.forEach((account) => {
        const button = document.createElement('button');
        button.className = `admin-v2-entry${account.id === state.selectedAccountId ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(account.email)}</span>
          <small>${escapeHtml(account.status)} · 余额 ${escapeHtml(String(account.creditAccount?.balanceCredits || 0))} ${escapeHtml(account.creditAccount?.unitLabel || 'SC Credits')}</small>
          <small>订单 ${escapeHtml(String(account.stats?.orderCount || 0))} · 授权 ${escapeHtml(String(account.stats?.activeEntitlementCount || 0))} · 最近订单 ${escapeHtml(formatDate(account.stats?.latestOrderAt) || '-')}</small>
        `;
        button.addEventListener('click', () => loadAccountDetail(account.id));
        elements.accountsList.append(button);
      });
      setStatus(`已载入 ${accounts.length} 个读者账户。`, 'success');
    };

    const renderAccountDetail = (detail) => {
      const account = detail.account || {};
      const credits = detail.credits || account.creditAccount || {};
      const membership = detail.membership || null;
      const membershipSettings = detail.membershipSettings || {};
      const ledger = detail.creditLedger || [];
      const entitlements = detail.entitlements || [];
      const orders = detail.orders || [];
      elements.accountDetail.innerHTML = `
        <div class="admin-v2-section-heading">
          <div>
            <p class="station-kicker">Reader Detail</p>
            <h3>${escapeHtml(account.email || '')}</h3>
          </div>
          <span class="admin-status-pill" data-tone="${statusTone(account.status)}">${escapeHtml(account.status || '')}</span>
        </div>
        <div class="admin-detail-grid">
          <article><span>余额</span><strong>${escapeHtml(String(credits.balanceCredits || 0))}</strong></article>
          <article><span>累计购买</span><strong>${escapeHtml(String(credits.lifetimePurchasedCredits || 0))}</strong></article>
          <article><span>累计消耗</span><strong>${escapeHtml(String(credits.lifetimeSpentCredits || 0))}</strong></article>
          <article><span>会员</span><strong>${escapeHtml(membership?.active ? '有效' : '未开通')}</strong><small>${escapeHtml(membership?.expiresAt ? `至 ${formatDate(membership.expiresAt)}` : `${membershipSettings.membershipCreditCost || 10} 点/月`)}</small></article>
          <article><span>有效授权</span><strong>${escapeHtml(String(account.stats?.activeEntitlementCount || entitlements.filter((item) => !item.revokedAt).length))}</strong></article>
        </div>
        <form class="admin-v2-form admin-credit-form" id="credit-adjust-form">
          <div class="admin-v2-form-grid">
            <label>
              调整点数
              <input id="credit-adjust-delta" type="number" step="1" placeholder="例如 10 或 -3" required />
            </label>
            <label>
              关联 seriesSlug
              <input id="credit-adjust-series" placeholder="可选" />
            </label>
            <label>
              关联 chapterSlug
              <input id="credit-adjust-chapter" placeholder="可选" />
            </label>
            <label>
              来源备注
              <input id="credit-adjust-source" placeholder="manual-support-case" />
            </label>
          </div>
          <label>
            调整说明
            <textarea id="credit-adjust-note" rows="3" required placeholder="必须写清楚补点、扣点或客服处理原因。"></textarea>
          </label>
          <button class="button button-primary" type="submit">保存余额调整</button>
        </form>
        <section class="admin-detail-section">
          <h4>余额流水</h4>
          ${ledger.length ? ledger.map((item) => `
            <article class="admin-v2-row">
              <strong>${escapeHtml(formatCredits(item.creditsDelta))} · ${escapeHtml(item.entryType)}</strong>
              <span>余额 ${escapeHtml(String(item.balanceAfter))} · ${escapeHtml(item.source || '')}</span>
              <small>${escapeHtml(item.note || '')} · ${escapeHtml(formatDate(item.createdAt))}</small>
            </article>
          `).join('') : '<p class="admin-empty-list">暂无余额流水。</p>'}
        </section>
        <section class="admin-detail-section">
          <h4>授权</h4>
          ${entitlements.length ? entitlements.slice(0, 12).map((item) => `
            <article class="admin-v2-row">
              <strong>${escapeHtml(item.seriesSlug)}${item.chapterSlug ? `/${escapeHtml(item.chapterSlug)}` : ''}</strong>
              <span>${escapeHtml(item.scope)} · ${escapeHtml(item.accessLevel)} · ${item.revokedAt ? '已撤销' : '有效'}</span>
              <small>${escapeHtml(item.source || '')} · ${escapeHtml(formatDate(item.grantedAt))}</small>
            </article>
          `).join('') : '<p class="admin-empty-list">暂无授权。</p>'}
        </section>
        <section class="admin-detail-section">
          <h4>最近订单</h4>
          ${orders.length ? orders.slice(0, 12).map((order) => `
            <article class="admin-v2-row">
              <strong>${escapeHtml(orderTitle(order))}</strong>
              <span>${escapeHtml(order.status)} · ${escapeHtml(order.orderType)} · ${escapeHtml(formatMoney(order.priceAmount, order.priceCurrency))}</span>
              <small>${escapeHtml(formatDate(order.updatedAt))}</small>
            </article>
          `).join('') : '<p class="admin-empty-list">暂无订单。</p>'}
        </section>
