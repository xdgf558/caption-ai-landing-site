    const renderAnalyticsSummary = (summary = {}) => {
      elements.analyticsSummary.innerHTML = `
        <article><span>章节</span><strong>${escapeHtml(String(summary.chapterCount || 0))}</strong><small>已聚合章节</small></article>
        <article><span>阅读会话</span><strong>${escapeHtml(String(summary.uniqueSessions || 0))}</strong><small>${escapeHtml(String(summary.totalEvents || 0))} 条事件</small></article>
        <article><span>完成率</span><strong>${escapeHtml(formatPercent(summary.avgCompletionRate))}</strong><small>章节平均完成率</small></article>
        <article><span>互动分</span><strong>${escapeHtml(String(Math.round(Number(summary.avgEngagementScore || 0) * 100)))}</strong><small>章节平均综合分</small></article>
      `;
      const windowDays = Number(summary.windowDays || currentAnalyticsWindowDays());
      elements.analyticsUpdated.textContent = summary.latestUpdatedAt
        ? `${windowDays} 天窗口 · 更新 ${formatDate(summary.latestUpdatedAt)}`
        : `${windowDays} 天窗口 · 等待聚合`;
    };

    const renderAnalyticsDetail = (stat) => {
      if (!stat) {
        elements.analyticsDetail.innerHTML = '<p class="admin-empty-list">选择章节查看统计详情。</p>';
        return;
      }
      const distribution = stat.scrollDepthDistribution || {};
      const buckets = ['0-25', '26-50', '51-75', '76-89', '90-100'];
      const maxBucketCount = Math.max(1, ...buckets.map((bucket) => Number(distribution[bucket] || 0)));
      const dropOffPoints = stat.dropOffPoints || [];
      const title = stat.title || stat.chapterSlug;
      elements.analyticsDetail.innerHTML = `
        <div class="admin-v2-section-heading">
          <div>
            <p class="station-kicker">Chapter Analytics</p>
            <h3>${escapeHtml(title)}</h3>
          </div>
          <span class="admin-status-pill" data-tone="${Number(stat.engagementScore || 0) >= 0.6 ? 'success' : 'neutral'}">${escapeHtml(String(stat.windowDays || currentAnalyticsWindowDays()))} 天 · 互动分 ${escapeHtml(String(Math.round(Number(stat.engagementScore || 0) * 100)))}</span>
        </div>
        <div class="admin-detail-grid">
          <article><span>打开</span><strong>${escapeHtml(String(stat.openCount || 0))}</strong><small>chapter_open</small></article>
          <article><span>完成率</span><strong>${escapeHtml(formatPercent(stat.completionRate))}</strong><small>${escapeHtml(String(stat.completionCount || 0))} 个完成会话</small></article>
          <article><span>平均时长</span><strong>${escapeHtml(formatSeconds(stat.avgReadTimeSeconds))}</strong><small>按会话估算</small></article>
          <article><span>平均深度</span><strong>${escapeHtml(String(Math.round(Number(stat.avgScrollDepth || 0))))}%</strong><small>最大阅读深度</small></article>
        </div>
        <section class="admin-detail-section">
          <h4>滚动深度分布</h4>
          <div class="admin-analytics-bars">
            ${buckets.map((bucket) => {
              const count = Number(distribution[bucket] || 0);
              const width = Math.max(4, Math.round((count / maxBucketCount) * 100));
              return `
                <div class="admin-analytics-bar">
                  <span>${escapeHtml(bucket)}%</span>
                  <div><i style="width: ${width}%"></i></div>
                  <strong>${escapeHtml(String(count))}</strong>
                </div>
              `;
            }).join('')}
          </div>
        </section>
        <section class="admin-detail-section">
          <h4>流失位置</h4>
          ${dropOffPoints.length ? dropOffPoints.map((point) => `
            <article class="admin-v2-row">
              <strong>${escapeHtml(point.label || point.position)} · ${escapeHtml(formatPercent(point.rate))}</strong>
              <span>${escapeHtml(point.severity || 'low')} · ${escapeHtml(String(point.count || 0))} 个会话</span>
            </article>
          `).join('') : '<p class="admin-empty-list">暂无明显流失位置。</p>'}
        </section>
        ${renderAnalyticsInsightSection(stat)}
        <section class="admin-detail-section">
          <h4>互动</h4>
          <div class="admin-pricing-lines">
            <p><strong>喜欢：</strong>${escapeHtml(String(stat.likeCount || 0))}</p>
            <p><strong>书签：</strong>${escapeHtml(String(stat.bookmarkCount || 0))}</p>
            <p><strong>评论提交：</strong>${escapeHtml(String(stat.commentCount || 0))}</p>
            <p><strong>事件窗口：</strong>${escapeHtml(formatDate(stat.eventWindowStart) || '-')} - ${escapeHtml(formatDate(stat.eventWindowEnd) || '-')}</p>
          </div>
          <a class="button button-secondary" href="/novel/${escapeHtml(stat.seriesSlug)}/chapter/${escapeHtml(stat.chapterSlug)}/" target="_blank" rel="noreferrer">打开 V2 阅读页</a>
        </section>
      `;
    };

    const renderAnalyticsList = (stats) => {
      if (!stats.length) {
        renderEmpty(elements.analyticsList, '暂无聚合统计。先点击“重新聚合”。');
        renderAnalyticsDetail(null);
        return;
      }
      elements.analyticsList.innerHTML = '';
      stats.forEach((stat) => {
        const key = analyticsKey(stat);
        const button = document.createElement('button');
        button.className = `admin-v2-entry${key === state.selectedAnalyticsKey ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(stat.chapterNumber ? `第 ${stat.chapterNumber} 章 ` : '')}${escapeHtml(stat.title || stat.chapterSlug)}</span>
          <small>${escapeHtml(stat.seriesTitle || stat.seriesSlug)} · ${escapeHtml(String(stat.windowDays || currentAnalyticsWindowDays()))} 天 · 完成率 ${escapeHtml(formatPercent(stat.completionRate))} · 互动分 ${escapeHtml(String(Math.round(Number(stat.engagementScore || 0) * 100)))}</small>
          <small>${escapeHtml(String(stat.uniqueSessions || 0))} 会话 · ${escapeHtml(formatSeconds(stat.avgReadTimeSeconds))} · ${escapeHtml(formatDate(stat.updatedAt) || '')}</small>
        `;
        button.addEventListener('click', () => {
          state.selectedAnalyticsKey = key;
          renderAnalyticsList(state.analyticsStats);
          renderAnalyticsDetail(stat);
        });
        elements.analyticsList.append(button);
      });
      const selected = stats.find((stat) => analyticsKey(stat) === state.selectedAnalyticsKey) || stats[0];
      state.selectedAnalyticsKey = analyticsKey(selected);
      renderAnalyticsDetail(selected);
    };

    const buildAnalyticsParams = () => {
      const params = new URLSearchParams({ limit: '80' });
      if (elements.filters.analyticsSeries.value.trim()) params.set('seriesSlug', elements.filters.analyticsSeries.value.trim());
      if (elements.filters.analyticsChapter.value.trim()) params.set('chapterSlug', elements.filters.analyticsChapter.value.trim());
      params.set('windowDays', String(currentAnalyticsWindowDays()));
      return params;
    };

    const loadAnalyticsInsights = async ({ silent = false } = {}) => {
      try {
        const payload = await apiJson(`/admin/api/novels/analytics/insights?${buildAnalyticsParams().toString()}`);
        state.analyticsInsights = payload.insights || [];
        return state.analyticsInsights;
      } catch (error) {
        state.analyticsInsights = [];
        if (!silent) throw error;
        return [];
      }
    };

    const loadAnalyticsStats = async () => {
      const params = buildAnalyticsParams();
      const payload = await apiJson(`/admin/api/novels/analytics/stats?${params.toString()}`);
      state.analyticsStats = payload.stats || [];
      await loadAnalyticsInsights({ silent: true });
      renderAnalyticsSummary(payload.summary || {});
      renderAnalyticsList(state.analyticsStats);
      setStatus(`已载入 ${state.analyticsStats.length} 条章节统计。`, 'success');
    };

    const aggregateAnalytics = async () => {
      const payload = {
        chapterSlug: elements.filters.analyticsChapter.value.trim(),
        limit: 80,
        seriesSlug: elements.filters.analyticsSeries.value.trim(),
        sinceDays: currentAnalyticsWindowDays(),
        windowDays: currentAnalyticsWindowDays()
      };
      const result = await apiJson('/admin/api/novels/analytics/aggregate', {
        method: 'POST',
        body: JSON.stringify(payload)
      });
      setStatus(`已聚合 ${result.aggregated || 0} 个章节统计。`, 'success');
      await Promise.all([loadAnalyticsStats(), loadAuditLogs()]);
    };

    const generateAnalyticsInsights = async () => {
      const payload = {
        chapterSlug: elements.filters.analyticsChapter.value.trim(),
        limit: 80,
        seriesSlug: elements.filters.analyticsSeries.value.trim(),
        sinceDays: currentAnalyticsWindowDays(),
        windowDays: currentAnalyticsWindowDays()
      };
      const result = await apiJson('/admin/api/novels/analytics/insights/generate', {
        method: 'POST',
        body: JSON.stringify(payload)
      });
      setStatus(`已生成 ${result.generated || 0} 条 AI Insight。`, 'success');
      await Promise.all([loadAnalyticsStats(), loadAuditLogs()]);
    };

    const commentStatusTone = (status) => {
      if (status === 'approved') return 'success';
      if (status === 'pending') return 'warning';
      if (status === 'hidden' || status === 'deleted') return 'error';
      return 'neutral';
    };

    const buildCommentParams = () => {
      const params = new URLSearchParams({ limit: '80' });
      if (elements.filters.commentsStatus.value) params.set('status', elements.filters.commentsStatus.value);
      if (elements.filters.commentsSeries.value.trim()) params.set('seriesSlug', elements.filters.commentsSeries.value.trim());
      if (elements.filters.commentsChapter.value.trim()) params.set('chapterSlug', elements.filters.commentsChapter.value.trim());
      if (elements.filters.commentsEmail.value.trim()) params.set('email', elements.filters.commentsEmail.value.trim());
      return params;
    };

    const renderCommentDetail = (comment) => {
      if (!comment) {
        elements.commentDetail.innerHTML = '<p class="admin-empty-list">选择一条评论查看正文并进行审核。</p>';
        return;
      }
      const canApprove = comment.status !== 'approved';
      const canHide = comment.status !== 'hidden';
      const canDelete = comment.status !== 'deleted';
      elements.commentDetail.innerHTML = `
        <div class="admin-v2-section-heading">
          <div>
            <p class="station-kicker">Comment Detail</p>
            <h3>${escapeHtml(comment.displayName || comment.email || '读者')}</h3>
          </div>
          <span class="admin-status-pill" data-tone="${commentStatusTone(comment.status)}">${escapeHtml(comment.status || '')}</span>
        </div>
        <div class="admin-detail-grid">
          <article><span>读者</span><strong>${escapeHtml(comment.email || '')}</strong><small>${escapeHtml(comment.username || '')}</small></article>
          <article><span>章节</span><strong>${escapeHtml(comment.chapterSlug || '')}</strong><small>${escapeHtml(comment.seriesSlug || '')}</small></article>
          <article><span>提交</span><strong>${escapeHtml(formatDate(comment.createdAt) || '-')}</strong><small>${escapeHtml(comment.locale || '')}</small></article>
          <article><span>审核</span><strong>${escapeHtml(formatDate(comment.reviewedAt) || '-')}</strong><small>${escapeHtml(comment.reviewedBy || '')}</small></article>
        </div>
        <section class="admin-detail-section">
          <h4>评论正文</h4>
          <p class="admin-empty-list">${escapeHtml(comment.body || '').replace(/\n/g, '<br>')}</p>
        </section>
        ${comment.hiddenReason ? `<section class="admin-detail-section"><h4>处理说明</h4><p class="admin-empty-list">${escapeHtml(comment.hiddenReason)}</p></section>` : ''}
        <section class="admin-detail-section">
          <h4>来源</h4>
          <div class="admin-pricing-lines">
            <p><strong>路径：</strong>${escapeHtml(comment.sourcePath || '')}</p>
            <p><strong>ID：</strong>${escapeHtml(comment.id || '')}</p>
          </div>
        </section>
        <label>
          审核说明
          <textarea id="comment-moderation-note" rows="3" placeholder="隐藏或删除时建议写原因。"></textarea>
        </label>
        <div class="button-row">
          <button class="button button-primary" type="button" data-comment-action="approve" ${canApprove ? '' : 'disabled'}>批准公开</button>
          <button class="button button-secondary" type="button" data-comment-action="hide" ${canHide ? '' : 'disabled'}>隐藏</button>
          <button class="button button-secondary" type="button" data-comment-action="delete" ${canDelete ? '' : 'disabled'}>删除</button>
          <a class="button button-secondary" href="/novel/${escapeHtml(comment.seriesSlug)}/chapter/${escapeHtml(comment.chapterSlug)}/" target="_blank" rel="noreferrer">打开章节</a>
        </div>
      `;
      elements.commentDetail.querySelectorAll('[data-comment-action]').forEach((button) => {
        button.addEventListener('click', () => moderateComment(comment, button.dataset.commentAction));
      });
    };

    const renderComments = (comments) => {
      if (!comments.length) {
        renderEmpty(elements.commentsList, '暂无评论。');
        renderCommentDetail(null);
        return;
      }
      elements.commentsList.innerHTML = '';
      comments.forEach((comment) => {
        const button = document.createElement('button');
        button.className = `admin-v2-entry${comment.id === state.selectedCommentId ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(comment.displayName || comment.email || '读者')}</span>
          <small>${escapeHtml(comment.status)} · ${escapeHtml(comment.seriesSlug || '')}/${escapeHtml(comment.chapterSlug || '')}</small>
          <small>${escapeHtml((comment.body || '').slice(0, 90))}${(comment.body || '').length > 90 ? '...' : ''}</small>
        `;
        button.addEventListener('click', () => {
          state.selectedCommentId = comment.id;
          renderComments(state.comments);
          renderCommentDetail(comment);
        });
        elements.commentsList.append(button);
      });
      const selected = comments.find((comment) => comment.id === state.selectedCommentId) || comments[0];
      state.selectedCommentId = selected.id;
      renderCommentDetail(selected);
    };

    const loadComments = async () => {
      const payload = await apiJson(`/admin/api/novels/comments?${buildCommentParams().toString()}`);
      state.comments = payload.comments || [];
      renderComments(state.comments);
      setStatus(`已载入 ${state.comments.length} 条读者评论。`, 'success');
    };

    const moderateComment = async (comment, action) => {
      const note = $('#comment-moderation-note')?.value.trim() || '';
      const result = await apiJson('/admin/api/novels/comments/moderate', {
        method: 'POST',
        body: JSON.stringify({ id: comment.id, action, note })
      });
      const updated = result.comment;
      state.selectedCommentId = updated?.id || comment.id;
      await Promise.all([loadComments(), loadAuditLogs()]);
      setStatus('评论审核状态已更新。', 'success');
    };

    const feedbackStatusTone = (status) => {
      if (status === 'resolved') return 'success';
      if (status === 'new' || status === 'in_progress') return 'warning';
      if (status === 'closed') return 'error';
      return 'neutral';
    };

    const feedbackStatusLabel = (status) => ({
      new: '新反馈',
      in_progress: '处理中',
      resolved: '已解决',
      closed: '已关闭'
    })[status] || status || '';

    const feedbackIssueLabel = (issueType) => ({
      install: '安装问题',
      activation: '启用问题',
      typing: '输入异常',
      candidates: '候选词问题',
      performance: '闪退或性能',
      other: '其他'
    })[issueType] || issueType || '';

    const feedbackImpactLabel = (impact) => ({
      minor: '轻微',
      normal: '一般',
      blocking: '严重阻断'
    })[impact] || impact || '';

    const buildFeedbackParams = () => {
      const params = new URLSearchParams({ limit: '100', product: 'privatepinyin' });
      if (elements.filters.feedbackStatus.value) params.set('status', elements.filters.feedbackStatus.value);
      if (elements.filters.feedbackPlatform.value) params.set('platform', elements.filters.feedbackPlatform.value);
      if (elements.filters.feedbackIssueType.value) params.set('issueType', elements.filters.feedbackIssueType.value);
      if (elements.filters.feedbackQuery.value.trim()) params.set('query', elements.filters.feedbackQuery.value.trim());
      return params;
    };

    const renderFeedbackDetail = (feedback) => {
      if (!feedback) {
        elements.feedbackDetail.innerHTML = '<p class="admin-empty-list">选择一条反馈查看复现信息并更新处理状态。</p>';
        return;
      }
      elements.feedbackDetail.innerHTML = `
        <div class="admin-v2-section-heading">
          <div>
            <p class="station-kicker">Feedback Detail</p>
            <h3>${escapeHtml(feedback.summary || '')}</h3>
          </div>
          <span class="admin-status-pill" data-tone="${feedbackStatusTone(feedback.status)}">${escapeHtml(feedbackStatusLabel(feedback.status))}</span>
        </div>
        <div class="admin-detail-grid">
          <article><span>产品版本</span><strong>猫栈拼音 ${escapeHtml(feedback.appVersion || '')}</strong><small>${escapeHtml(feedback.product || '')}</small></article>
          <article><span>平台 / 类型</span><strong>${escapeHtml(feedback.platform || '')}</strong><small>${escapeHtml(feedbackIssueLabel(feedback.issueType))}</small></article>
          <article><span>影响程度</span><strong>${escapeHtml(feedbackImpactLabel(feedback.impact))}</strong><small>${escapeHtml(feedback.locale || '')}</small></article>
          <article><span>提交时间</span><strong>${escapeHtml(formatDate(feedback.createdAt) || '-')}</strong><small>更新：${escapeHtml(formatDate(feedback.updatedAt) || '-')}</small></article>
        </div>
        <section class="admin-detail-section">
          <h4>问题描述</h4>
          <p class="admin-empty-list">${escapeHtml(feedback.details || '').replace(/\n/g, '<br>')}</p>
        </section>
        <section class="admin-detail-section">
          <h4>复现步骤</h4>
          <p class="admin-empty-list">${feedback.reproductionSteps ? escapeHtml(feedback.reproductionSteps).replace(/\n/g, '<br>') : '未填写'}</p>
        </section>
        <section class="admin-detail-section">
          <h4>环境与联系</h4>
          <div class="admin-pricing-lines">
            <p><strong>系统环境：</strong>${escapeHtml(feedback.environment || '未填写')}</p>
            <p><strong>联系 Email：</strong>${escapeHtml(feedback.contactEmail || '未填写')}</p>
            <p><strong>来源路径：</strong>${escapeHtml(feedback.sourcePath || '')}</p>
            <p><strong>反馈 ID：</strong>${escapeHtml(feedback.id || '')}</p>
          </div>
        </section>
        <label>
          处理记录
          <textarea id="feedback-admin-note" rows="4" maxlength="2000" placeholder="记录排查结果、修复版本或关闭原因。">${escapeHtml(feedback.adminNote || '')}</textarea>
        </label>
        <div class="button-row">
          <button class="button button-secondary" type="button" data-feedback-next-status="new" ${feedback.status === 'new' ? 'disabled' : ''}>标记新反馈</button>
          <button class="button button-primary" type="button" data-feedback-next-status="in_progress" ${feedback.status === 'in_progress' ? 'disabled' : ''}>开始处理</button>
          <button class="button button-secondary" type="button" data-feedback-next-status="resolved" ${feedback.status === 'resolved' ? 'disabled' : ''}>标记已解决</button>
          <button class="button button-secondary" type="button" data-feedback-next-status="closed" ${feedback.status === 'closed' ? 'disabled' : ''}>关闭</button>
          ${feedback.sourcePath ? `<a class="button button-secondary" href="${escapeHtml(feedback.sourcePath)}" target="_blank" rel="noreferrer">打开产品页</a>` : ''}
        </div>
      `;
      elements.feedbackDetail.querySelectorAll('[data-feedback-next-status]').forEach((button) => {
        button.addEventListener('click', () => updateFeedback(feedback, button.dataset.feedbackNextStatus));
      });
    };

    const renderFeedback = (items) => {
      if (!items.length) {
        renderEmpty(elements.feedbackList, '暂无产品反馈。');
        renderFeedbackDetail(null);
        return;
      }
      elements.feedbackList.innerHTML = '';
      items.forEach((feedback) => {
        const button = document.createElement('button');
        button.className = `admin-v2-entry${feedback.id === state.selectedFeedbackId ? ' is-active' : ''}`;
        button.type = 'button';
        button.innerHTML = `
          <span>${escapeHtml(feedback.summary || '')}</span>
          <small>${escapeHtml(feedbackStatusLabel(feedback.status))} · ${escapeHtml(feedback.platform || '')} · ${escapeHtml(feedback.appVersion || '')}</small>
          <small>${escapeHtml(feedbackIssueLabel(feedback.issueType))} · ${escapeHtml(feedbackImpactLabel(feedback.impact))} · ${escapeHtml(formatDate(feedback.createdAt) || '')}</small>
        `;
        button.addEventListener('click', () => {
          state.selectedFeedbackId = feedback.id;
          renderFeedback(state.feedback);
          renderFeedbackDetail(feedback);
        });
        elements.feedbackList.append(button);
      });
      const selected = items.find((feedback) => feedback.id === state.selectedFeedbackId) || items[0];
      state.selectedFeedbackId = selected.id;
      renderFeedbackDetail(selected);
    };

    const loadFeedback = async () => {
      const payload = await apiJson(`/admin/api/product-feedback?${buildFeedbackParams().toString()}`);
      state.feedback = payload.feedback || [];
      renderFeedback(state.feedback);
      setStatus(`已载入 ${state.feedback.length} 条产品反馈。`, 'success');
    };

    const updateFeedback = async (feedback, nextStatus) => {
      const adminNote = $('#feedback-admin-note')?.value.trim() || '';
      const result = await apiJson('/admin/api/product-feedback/update', {
        method: 'POST',
        body: JSON.stringify({ id: feedback.id, status: nextStatus, adminNote })
      });
      state.selectedFeedbackId = result.feedback?.id || feedback.id;
      await Promise.all([loadFeedback(), loadAuditLogs()]);
      setStatus('反馈处理状态已更新。', 'success');
    };

    const loadEntitlements = async () => {
      const params = new URLSearchParams();
      const email = elements.filters.accessEmail.value.trim();
      if (email) params.set('email', email);
      const payload = await apiJson(`/admin/api/novels/entitlements?${params.toString()}`);
      renderEntitlements(payload.entitlements || []);
    };

    const renderEntitlements = (entitlements) => {
      if (!entitlements.length) {
        renderEmpty(elements.accessList, '暂无授权。');
        return;
      }
      elements.accessList.innerHTML = '';
      entitlements.forEach((entitlement) => {
        const row = document.createElement('article');
        row.className = 'admin-v2-row';
        row.innerHTML = `
          <strong>${escapeHtml(entitlement.email || '')}</strong>
          <span>${escapeHtml(entitlement.seriesSlug)} · ${escapeHtml(entitlement.scope)} · ${escapeHtml(entitlement.accessLevel)}</span>
          <small>${escapeHtml(entitlement.chapterSlug || 'series')} · ${entitlement.revokedAt ? '已撤销' : '有效'} · ${escapeHtml(entitlement.grantedAt || '')}</small>
        `;
        if (!entitlement.revokedAt) {
          const revoke = document.createElement('button');
          revoke.className = 'button button-danger';
          revoke.type = 'button';
          revoke.textContent = '撤销';
          revoke.addEventListener('click', () => revokeEntitlement(entitlement));
          row.append(revoke);
        }
        elements.accessList.append(row);
      });
    };

    const grantEntitlement = async (event) => {
      event.preventDefault();
      const payload = {
        email: elements.access.email.value.trim(),
        seriesSlug: elements.access.seriesSlug.value.trim(),
        scope: elements.access.scope.value,
        chapterSlug: elements.access.chapterSlug.value.trim(),
        accessLevel: elements.access.accessLevel.value,
        expiresAt: elements.access.expiresAt.value,
        note: elements.access.note.value.trim(),
        source: 'admin-v2',
        sourceRef: 'manual-grant',
        grantedBy: 'admin-v2'
      };
      const result = await apiJson('/admin/api/novels/entitlements/grant', {
        method: 'POST',
        body: JSON.stringify(payload)
      });
      elements.filters.accessEmail.value = payload.email;
      renderEntitlements(result.entitlements || []);
      await loadAuditLogs();
      setStatus('授权已发放。', 'success');
    };

    const revokeEntitlement = async (entitlement) => {
      const result = await apiJson('/admin/api/novels/entitlements/revoke', {
        method: 'POST',
        body: JSON.stringify({ id: entitlement.id, email: entitlement.email })
      });
      renderEntitlements(result.entitlements || []);
      await loadAuditLogs();
      setStatus('授权已撤销。', 'success');
    };

    const loadAuditLogs = async () => {
      const params = new URLSearchParams({ limit: '60' });
      if (elements.filters.auditTargetType.value.trim()) params.set('targetType', elements.filters.auditTargetType.value.trim());
      if (elements.filters.auditTargetSlug.value.trim()) params.set('targetSlug', elements.filters.auditTargetSlug.value.trim());
      const payload = await apiJson(`/admin/api/content/audit-logs?${params.toString()}`);
      const logs = payload.logs || [];
      if (!logs.length) {
        renderEmpty(elements.auditList, '暂无审计日志。');
        return;
      }
      elements.auditList.innerHTML = logs.map((log) => `
        <article class="admin-v2-row">
          <strong>${escapeHtml(log.action)}</strong>
          <span>${escapeHtml(log.targetType)} · ${escapeHtml(log.targetSlug)}</span>
          <small>${escapeHtml(log.actorEmail || 'admin')} · ${escapeHtml(log.createdAt || '')}</small>
        </article>
      `).join('');
    };

    const switchTab = async (name) => {
      elements.tabs.forEach((tab) => {
        const isActive = tab.dataset.adminV2Tab === name;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-pressed', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
      });
      elements.panels.forEach((panel) => {
        const expected = panel.dataset.adminV2Panel.startsWith(`${name}-`);
        panel.hidden = !expected;
      });
      if (name === 'imports') {
        await Promise.all([loadImportReviews(), loadSignalDrafts()]);
        setStatus(`已载入 ${state.imports.length} 个 NovelForge 导入批次和 ${state.signalDrafts.length} 份待发布简报。`, 'success');
      }
      if (name === 'signal') {
        await Promise.all([loadSignalBriefs(), loadSignalAutomation()]);
        setStatus(`已载入 ${state.signalBriefs.length} 篇简报和 ${state.signalSources.length} 个采集来源。`, 'success');
      }
      if (name === 'commerce') await loadOrders();
      if (name === 'accounts') await loadAccounts();
      if (name === 'analytics') await loadAnalyticsStats();
      if (name === 'comments') await loadComments();
      if (name === 'feedback') await loadFeedback();
      if (name === 'access') await loadEntitlements();
      if (name === 'audit') await loadAuditLogs();
    };

    elements.tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => switchTab(tab.dataset.adminV2Tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft'].includes(event.key)) return;
        event.preventDefault();
        const direction = ['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : -1;
        const target = elements.tabs[(index + direction + elements.tabs.length) % elements.tabs.length];
        target.focus();
        switchTab(target.dataset.adminV2Tab);
      });
    });
    elements.contentForm.addEventListener('submit', saveContent);
    elements.signalForm.addEventListener('submit', importSignalBrief);
    elements.signalSourceForm.addEventListener('submit', saveSignalSource);
    elements.signalCandidateFilters.addEventListener('submit', (event) => {
      event.preventDefault();
      refreshSignalCandidates();
    });
    elements.accessForm.addEventListener('submit', grantEntitlement);
    $('#content-refresh').addEventListener('click', () => loadEntries({ autoSelect: true }));
    $('#imports-refresh').addEventListener('click', () => Promise.all([loadImportReviews(), refreshSignalApprovals()]));
    $('#signal-refresh').addEventListener('click', () => Promise.all([loadSignalBriefs(), refreshSignalDrafts()]));
    $('#signal-reset').addEventListener('click', resetSignalForm);
    $('#signal-automation-refresh').addEventListener('click', loadSignalAutomation);
    $('#signal-collection-start').addEventListener('click', startSignalCollection);
    elements.signalModelSave.addEventListener('click', saveSignalModel);
    elements.signalModelSmoke.addEventListener('click', smokeTestSignalModel);
    elements.signalModelEnable.addEventListener('click', () => setSignalModelMode('live'));
    elements.signalModelDisable.addEventListener('click', () => setSignalModelMode('off'));
    elements.signalCandidatesRescore.addEventListener('click', rescoreSignalCandidateQueue);
    elements.signalDraftGenerate.addEventListener('click', generateSignalBriefDraft);
    $('#signal-drafts-refresh').addEventListener('click', refreshSignalDrafts);
    $('#signal-approvals-refresh').addEventListener('click', refreshSignalApprovals);
    $('#signal-approvals-open').addEventListener('click', () => switchTab('imports'));
    $('#signal-source-reset').addEventListener('click', resetSignalSourceForm);
    $('#signal-source-manage').addEventListener('click', () => {
      elements.signalAutomationPanel.open = true;
      elements.signalAutomationPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    $('#orders-refresh').addEventListener('click', loadOrders);
    $('#accounts-refresh').addEventListener('click', loadAccounts);
    $('#analytics-refresh').addEventListener('click', loadAnalyticsStats);
    $('#analytics-aggregate').addEventListener('click', aggregateAnalytics);
    $('#analytics-generate-insights').addEventListener('click', generateAnalyticsInsights);
    $('#comments-refresh').addEventListener('click', loadComments);
    $('#feedback-refresh').addEventListener('click', loadFeedback);
    $('#access-refresh').addEventListener('click', loadEntitlements);
    $('#audit-refresh').addEventListener('click', loadAuditLogs);
    $('#content-reset').addEventListener('click', () => resetForm(elements.fields.entryType.value));
    $('#content-preview-button').addEventListener('click', () => {
      renderPreview();
      $('#content-preview-disclosure').open = true;
    });
    $('#content-worker-preview-button').addEventListener('click', openWorkerPreview);
    elements.coverUpload.addEventListener('click', uploadCoverImage);
    elements.effectivePricingRefresh.addEventListener('click', () => refreshEffectivePricingPreview());
    elements.pricingDefaultsApply.addEventListener('click', applyPricingDefaults);
    elements.pricingDefaultsRefresh.addEventListener('click', () => loadPricingDefaults());
    elements.pricingDefaultsSave.addEventListener('click', savePricingDefaults);
    elements.fields.entryType.addEventListener('change', updateConditionalFields);
    elements.fields.title.addEventListener('input', () => {
      if (!elements.fields.slug.value.trim()) elements.fields.slug.value = slugify(elements.fields.title.value, elements.fields.entryType.value);
    });
    elements.fields.coverR2Key.addEventListener('input', renderCoverPreview);
    elements.fields.coverAlt.addEventListener('input', renderCoverPreview);
    elements.fields.coverFile.addEventListener('change', () => {
      const [file] = elements.fields.coverFile.files || [];
      setCoverStatus(file ? `已选择：${file.name}，点击上传封面。` : '');
    });
    elements.fields.file.addEventListener('change', async () => {
      const [file] = elements.fields.file.files || [];
      if (!file) return;
      applyImportedMarkdown(await file.text());
      elements.fields.file.value = '';
    });
    $$('[data-new-entry]').forEach((button) => {
      button.addEventListener('click', () => resetForm(button.dataset.newEntry));
    });

    const boot = async () => {
      try {
        await loadSchema();
        await loadPricingDefaults({ silent: true });
        resetForm('blog_post');
        resetSignalForm();
        resetSignalSourceForm();
        await loadEntries();
        const initialContentId = Number.parseInt(new URLSearchParams(window.location.search).get('contentId') || '', 10);
        if (Number.isFinite(initialContentId) && initialContentId > 0) {
          await loadEntryForEdit(initialContentId);
        } else {
          await loadRevisions();
        }
        await loadAuditLogs();
      } catch (error) {
        setStatus(error.message, 'error');
      }
    };

    boot();
  </script>
</BaseLayout>
