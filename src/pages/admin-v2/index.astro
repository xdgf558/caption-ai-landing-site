---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Station Cat Admin 2.0"
  description="Station Cat backend content platform for serial fiction, devlog publishing, pricing, orders, entitlements, and audit logs."
  lang="zh-Hant"
  canonicalPath="/admin-v2/"
  bodyClass="station-home admin-v2-page"
>
  <section class="admin-v2-shell">
    <header class="admin-v2-heading">
      <div>
        <p class="station-kicker">Admin 2.0</p>
        <h1>Station Cat 后台内容平台</h1>
      </div>
      <div class="admin-v2-heading__actions">
        <a class="button button-secondary" href="/admin/waitlist/">等待名单</a>
        <a class="button button-secondary" href="/zh-hant/works/">小说页</a>
        <a class="button button-secondary" href="/devlog/">博客页</a>
      </div>
    </header>

    <div class="admin-v2-status" id="admin-v2-status" role="status" aria-live="polite">
      正在连接后端内容平台。
    </div>

    <div class="admin-v2-grid">
      <aside class="admin-v2-panel admin-v2-sidebar" data-admin-v2-scroll-panel>
        <div class="admin-v2-tabs" role="tablist" aria-label="Admin sections">
            <button class="admin-v2-tab is-active" type="button" data-admin-v2-tab="content">内容</button>
            <button class="admin-v2-tab" type="button" data-admin-v2-tab="imports">导入审核</button>
            <button class="admin-v2-tab" type="button" data-admin-v2-tab="commerce">订单</button>
            <button class="admin-v2-tab" type="button" data-admin-v2-tab="accounts">账户</button>
            <button class="admin-v2-tab" type="button" data-admin-v2-tab="access">授权</button>
            <button class="admin-v2-tab" type="button" data-admin-v2-tab="audit">审计</button>
        </div>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="content-sidebar">
          <section class="admin-template-panel admin-global-pricing-panel" aria-labelledby="pricing-defaults-title">
            <div>
              <p class="station-kicker">Global Pricing</p>
              <h3 id="pricing-defaults-title">全局收费规则</h3>
              <p id="pricing-defaults-summary">正在读取默认收费规则。</p>
              <p class="admin-template-note">保存后对全部书籍和收费章节生效。章节不再直接用 USD 购买，只能先充值阅读点再解锁。</p>
            </div>
            <div class="admin-global-pricing-grid">
              <label>
                访问级别
                <select id="global-access-level">
                  <option value="free">免费</option>
                  <option value="paid">付费</option>
                  <option value="member">会员</option>
                </select>
              </label>
              <label>
                收费模式
                <select id="global-pricing-mode">
                  <option value="free">免费阅读</option>
                  <option value="tip-optional">免费 + 打赏</option>
                  <option value="chapter-paid">阅读点解锁</option>
                  <option value="member">会员阅读</option>
                </select>
              </label>
              <label>
                免费章节数
                <input id="global-pricing-free-chapters" type="number" min="0" step="1" value="20" />
              </label>
              <label>
                每章阅读点
                <input id="global-pricing-chapter-credits" type="number" min="1" step="1" value="1" />
              </label>
              <label class="admin-global-pricing-wide">
                点数包
                <input id="global-pricing-credit-packs" placeholder="10:1, 50:5, 100:10" />
              </label>
              <label class="admin-checkbox">
                <input id="global-subscription-enabled" type="checkbox" checked />
                开启会员兑换
              </label>
              <label>
                会员点数/月
                <input id="global-membership-credit-cost" type="number" min="1" step="1" value="10" />
              </label>
              <label>
                兑换月数
                <input id="global-membership-months" type="number" min="1" step="1" value="1" />
              </label>
              <label class="admin-checkbox">
                <input id="global-membership-covers-paid" type="checkbox" checked />
                会员免费看收费内容
              </label>
              <label class="admin-checkbox">
                <input id="global-tips-enabled" type="checkbox" />
                开启打赏
              </label>
              <label class="admin-global-pricing-wide">
                打赏金额 USD
                <input id="global-pricing-tip-amounts" placeholder="1, 3, 5" />
              </label>
            </div>
            <div class="button-row">
              <button class="button button-primary" id="pricing-defaults-save" type="button">保存全局收费</button>
              <button class="button button-secondary" id="pricing-defaults-apply" type="button">套用到当前编辑</button>
              <button class="button button-secondary" id="pricing-defaults-refresh" type="button">刷新</button>
            </div>
            <div class="admin-inline-status" id="pricing-defaults-status" role="status" aria-live="polite" hidden></div>
          </section>

          <div class="admin-v2-filter-grid">
            <label>
              类型
              <select id="content-filter-type">
                <option value="">全部</option>
                <option value="blog_post">Blog / Devlog</option>
                <option value="novel_series">小说作品</option>
                <option value="novel_chapter">小说章节</option>
              </select>
            </label>
            <label>
              状态
              <select id="content-filter-status">
                <option value="">全部</option>
                <option value="draft">草稿</option>
                <option value="scheduled">定时</option>
                <option value="published">已发布</option>
                <option value="archived">归档</option>
              </select>
            </label>
          </div>
          <div class="button-row">
            <button class="button button-primary" id="content-refresh" type="button">刷新内容</button>
          </div>
          <div class="button-row">
            <button class="button button-secondary" type="button" data-new-entry="blog_post">新 Blog</button>
            <button class="button button-secondary" type="button" data-new-entry="novel_series">新作品</button>
            <button class="button button-secondary" type="button" data-new-entry="novel_chapter">新章节</button>
          </div>
          <div class="admin-v2-list" id="content-list" aria-label="Backend content entries"></div>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="imports-sidebar" hidden>
          <div class="button-row">
            <button class="button button-primary" id="imports-refresh" type="button">刷新导入</button>
          </div>
          <section class="admin-template-panel" aria-labelledby="import-review-help-title">
            <div>
              <p class="station-kicker">NovelForge</p>
              <h3 id="import-review-help-title">导入 Review</h3>
              <p>从 NovelForge 导入后，先在这里核对作品、章节、封面和收费摘要，再进入内容编辑器做最终调整。</p>
            </div>
          </section>
          <div class="admin-v2-list" id="imports-list" aria-label="NovelForge imports"></div>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="commerce-sidebar" hidden>
          <div class="admin-v2-filter-grid">
            <label>
              订单状态
              <select id="orders-status">
                <option value="">全部</option>
                <option value="draft">draft</option>
                <option value="waiting">waiting</option>
                <option value="confirming">confirming</option>
                <option value="confirmed">confirmed</option>
                <option value="finished">finished</option>
                <option value="failed">failed</option>
                <option value="expired">expired</option>
                <option value="refunded">refunded</option>
                <option value="unknown">unknown</option>
              </select>
            </label>
            <label>
              订单类型
              <select id="orders-type">
                <option value="">全部</option>
                <option value="chapter">chapter</option>
                <option value="chapter-bundle">chapter-bundle</option>
                <option value="supporter">supporter</option>
                <option value="credit-pack">credit-pack</option>
                <option value="tip">tip</option>
              </select>
            </label>
          </div>
          <label>
            读者 Email
            <input id="orders-email" type="email" placeholder="reader@example.com" />
          </label>
          <label>
            seriesSlug
            <input id="orders-series" placeholder="deng-hai-liang-zhe" />
          </label>
          <button class="button button-primary" id="orders-refresh" type="button">刷新订单</button>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="accounts-sidebar" hidden>
          <label>
            读者 Email
            <input id="accounts-email-filter" type="email" placeholder="reader@example.com" />
          </label>
          <label>
            账户状态
            <select id="accounts-status">
              <option value="">全部</option>
              <option value="active">active</option>
              <option value="disabled">disabled</option>
            </select>
          </label>
          <button class="button button-primary" id="accounts-refresh" type="button">刷新账户</button>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="access-sidebar" hidden>
          <label>
            读者 Email
            <input id="access-email-filter" type="email" placeholder="reader@example.com" />
          </label>
          <button class="button button-primary" id="access-refresh" type="button">查询授权</button>
        </section>

        <section class="admin-v2-sidebar-section" data-admin-v2-panel="audit-sidebar" hidden>
          <label>
            目标类型
            <input id="audit-target-type" placeholder="blog_post / novel_chapter" />
          </label>
          <label>
            目标 Slug
            <input id="audit-target-slug" placeholder="series/chapter 或 slug" />
          </label>
          <button class="button button-primary" id="audit-refresh" type="button">刷新审计</button>
        </section>

      </aside>

      <div class="admin-v2-main">
        <section class="admin-v2-panel admin-v2-workspace" data-admin-v2-panel="content-main">
          <div class="admin-v2-section-heading">
            <div>
              <p class="station-kicker">Content Editor</p>
              <h2 id="editor-heading">创建后端内容</h2>
            </div>
            <div class="admin-v2-badges">
              <span id="schema-stage">Stage 7C</span>
              <span id="storage-badge">R2 未确认</span>
            </div>
          </div>

          <form id="content-form" class="admin-v2-form">
            <input id="content-entry-id" type="hidden" />
            <div class="admin-v2-form-grid">
              <label>
                内容类型
                <select id="content-entry-type" required>
                  <option value="blog_post">Blog / Devlog</option>
                  <option value="novel_series">小说作品</option>
                  <option value="novel_chapter">小说章节</option>
                </select>
              </label>
              <label>
                语言
                <select id="content-locale" required>
                  <option value="zh-Hant">繁中</option>
                  <option value="zh-Hans">简中</option>
                  <option value="en">English</option>
                  <option value="ja">日本語</option>
                </select>
              </label>
              <label>
                状态
                <select id="content-status">
                  <option value="draft">草稿</option>
                  <option value="scheduled">定时</option>
                  <option value="published">发布</option>
                  <option value="archived">归档</option>
                </select>
              </label>
              <label>
                可见性
                <select id="content-visibility">
                  <option value="public">公开</option>
                  <option value="unlisted">隐藏链接</option>
                  <option value="private">私有</option>
                </select>
              </label>
              <label>
                Slug
                <input id="content-slug" required placeholder="post-or-chapter-slug" />
              </label>
              <label>
                父级 seriesSlug
                <input id="content-parent-slug" placeholder="novel-series-slug" />
              </label>
              <label>
                标题
                <input id="content-title" required placeholder="内容标题" />
              </label>
              <label>
                副标题
                <input id="content-subtitle" placeholder="可选副标题" />
              </label>
              <label>
                作者
                <input id="content-author" placeholder="Station Cat" />
              </label>
              <label>
                Tags
                <input id="content-tags" placeholder="Novel, Devlog, Station Cat" />
              </label>
              <label>
                章节序号
                <input id="content-chapter-number" type="number" min="1" step="1" placeholder="1" />
              </label>
              <label>
                分卷标题
                <input id="content-volume-title" placeholder="第一卷" />
              </label>
              <label>
                发布时间
                <input id="content-published-at" type="datetime-local" />
              </label>
              <label>
                排序
                <input id="content-sort-order" type="number" min="0" step="1" value="0" />
              </label>
              <label class="admin-checkbox">
                <input id="content-featured" type="checkbox" />
                首页或书架精选
              </label>
            </div>

            <label>
              描述
              <textarea id="content-description" rows="3" placeholder="用于列表、SEO 和分享卡片的说明。"></textarea>
            </label>
            <label>
              摘要
              <textarea id="content-excerpt" rows="3" placeholder="可选短摘要。"></textarea>
            </label>

            <section class="admin-v2-subpanel">
              <div class="admin-v2-section-heading">
                <div>
                  <p class="station-kicker">Entry Override</p>
                  <h3>单篇收费覆盖（可选）</h3>
                  <p class="admin-template-note">全局收费规则请在左上角保存。章节 USD 直购已停用，收费章节统一用阅读点或会员阅读。</p>
                </div>
              </div>
              <div class="admin-v2-form-grid">
                <label>
                  访问级别
                  <select id="content-access-level">
                    <option value="free">免费</option>
                    <option value="paid">付费</option>
                    <option value="supporter">支持者</option>
                    <option value="member">会员</option>
                  </select>
                </label>
                <label>
                  收费模式
                  <select id="pricing-mode">
                    <option value="free">免费阅读</option>
                    <option value="tip-optional">免费 + 打赏</option>
                    <option value="chapter-paid">单章购买</option>
                    <option value="volume-paid">分卷购买</option>
                    <option value="member">会员阅读</option>
                  </select>
                </label>
                <label>
                  免费章节数
                  <input id="pricing-free-chapters" type="number" min="0" step="1" value="0" />
                </label>
                <label>
                  单章价格 USD（已停用）
                  <input id="pricing-chapter-price" type="number" min="0" step="0.01" placeholder="已停用" disabled />
                </label>
                <label>
                  支持者价格 USD（已停用）
                  <input id="pricing-supporter-price" type="number" min="0" step="0.01" placeholder="已停用" disabled />
                </label>
                <label>
                  单章阅读点
                  <input id="pricing-chapter-credits" type="number" min="1" step="1" placeholder="1" />
                </label>
                <label>
                  阅读点包
                  <input id="pricing-credit-packs" placeholder="10:1, 50:5, 100:10" />
                </label>
                <label class="admin-checkbox">
                  <input id="pricing-tips-enabled" type="checkbox" />
                  开启打赏
                </label>
                <label>
                  打赏金额 USD
                  <input id="pricing-tip-amounts" placeholder="1, 3, 5" />
                </label>
                <label class="admin-checkbox">
                  <input id="pricing-bundles-enabled" type="checkbox" />
                  开启多章折扣
                </label>
                <label>
                  多章折扣
                  <input id="pricing-bundles" placeholder="5:10, 10:20" />
                </label>
              </div>
              <section class="admin-effective-pricing" aria-labelledby="effective-pricing-title">
                <div class="admin-v2-section-heading">
                  <div>
                    <p class="station-kicker">Effective Pricing</p>
                    <h4 id="effective-pricing-title">生效价格预览</h4>
                  </div>
                  <button class="button button-secondary" id="pricing-effective-refresh" type="button">读取生效价格</button>
                </div>
                <div class="admin-pricing-preview" id="pricing-effective-preview">
                  保存或载入小说作品 / 章节后，这里会读取公共 pricing API 的最终返回结果。
                </div>
                <div class="admin-inline-status" id="pricing-effective-status" role="status" aria-live="polite" hidden></div>
              </section>
            </section>

            <section class="admin-v2-subpanel">
              <div class="admin-v2-section-heading">
                <div>
                  <p class="station-kicker">Media</p>
                  <h3>封面、导入备份与来源</h3>
                </div>
              </div>
              <div class="admin-media-upload">
                <div>
                  <strong>封面图片</strong>
                  <span>支持 JPG、PNG、WebP、GIF、AVIF，单张不超过 5MB。</span>
                </div>
                <div class="button-row">
                  <label class="button button-secondary admin-file-button" for="content-cover-file">选择封面图片</label>
                  <input class="admin-file-input" id="content-cover-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" />
                  <button class="button button-primary" id="content-cover-upload" type="button">上传封面</button>
                  <a class="button button-secondary" id="content-cover-open" href="#" target="_blank" rel="noreferrer" hidden>打开封面</a>
                </div>
                <figure class="admin-cover-preview" id="content-cover-preview" hidden></figure>
                <div class="admin-inline-status" id="content-cover-status" role="status" aria-live="polite" hidden></div>
              </div>
              <div class="admin-v2-form-grid">
                <label>
                  Cover R2 Key
                  <input id="content-cover-r2-key" placeholder="content/media/covers/name.webp" />
                </label>
                <label>
                  Cover Alt
                  <input id="content-cover-alt" placeholder="封面描述" />
                </label>
                <label>
                  Source Ref
                  <input id="content-source-ref" placeholder="source path, import id, or external reference" />
                </label>
                <label>
                  Revision Summary
                  <input id="content-revision-summary" placeholder="本次修改说明" />
                </label>
              </div>
            </section>

            <section class="admin-v2-subpanel">
              <div class="admin-v2-section-heading">
                <div>
                  <p class="station-kicker">Markdown</p>
                  <h3>导入、预览与正文</h3>
                </div>
                <div class="button-row">
                  <label class="button button-secondary admin-file-button" for="content-file">导入 Markdown</label>
                  <input class="admin-file-input" id="content-file" type="file" accept=".md,.markdown,text/markdown,text/plain" />
                  <button class="button button-secondary" id="content-preview-button" type="button">刷新预览</button>
                  <button class="button button-primary" id="content-worker-preview-button" type="button">打开 Worker 预览</button>
                </div>
              </div>
              <textarea id="content-markdown" rows="18" spellcheck="false" placeholder="这里写正文 Markdown。导入带 frontmatter 的文件时，系统会自动填入上面的字段。"></textarea>
              <div class="admin-v2-preview" id="content-preview">等待输入正文。</div>
            </section>

            <div class="button-row">
              <button class="button button-primary" id="content-save" type="submit">保存到后端内容平台</button>
              <button class="button button-secondary" id="content-reset" type="button">清空表单</button>
            </div>
            <div class="admin-inline-status" id="content-save-status" role="status" aria-live="polite" hidden></div>
          </form>

          <section class="admin-v2-subpanel">
            <div class="admin-v2-section-heading">
              <div>
                <p class="station-kicker">History</p>
                <h3>修订记录</h3>
              </div>
            </div>
            <div class="admin-v2-list admin-v2-list--compact" id="revision-list"></div>
          </section>
        </section>

        <section class="admin-v2-panel admin-v2-workspace" data-admin-v2-panel="imports-main" hidden>
          <div class="admin-v2-section-heading">
            <div>
              <p class="station-kicker">NovelForge Review</p>
              <h2>导入批次审核</h2>
            </div>
            <div class="admin-v2-badges">
              <span>Stage 8C</span>
              <span>Review before publish</span>
            </div>
          </div>
          <section class="admin-v2-subpanel admin-import-review" id="import-detail">
            <p class="admin-empty-list">选择一个 NovelForge 导入批次查看详情。</p>
          </section>
        </section>

        <section class="admin-v2-panel admin-v2-workspace" data-admin-v2-panel="commerce-main" hidden>
          <div class="admin-v2-section-heading">
            <div>
              <p class="station-kicker">Orders</p>
              <h2>订单与收入排查</h2>
            </div>
          </div>
          <div class="admin-commerce-grid">
            <div class="admin-v2-table-list" id="orders-list"></div>
            <section class="admin-v2-subpanel admin-detail-panel" id="order-detail">
              <p class="admin-empty-list">选择一笔订单查看支付事件、履约状态和排查信息。</p>
            </section>
          </div>
        </section>

        <section class="admin-v2-panel admin-v2-workspace" data-admin-v2-panel="accounts-main" hidden>
          <div class="admin-v2-section-heading">
            <div>
              <p class="station-kicker">Reader Accounts</p>
              <h2>读者账户、余额与流水</h2>
            </div>
          </div>
          <div class="admin-commerce-grid">
            <div class="admin-v2-table-list" id="accounts-list"></div>
            <section class="admin-v2-subpanel admin-detail-panel" id="account-detail">
              <p class="admin-empty-list">选择读者账户后查看余额、流水、订单和授权。</p>
            </section>
          </div>
        </section>

        <section class="admin-v2-panel admin-v2-workspace" data-admin-v2-panel="access-main" hidden>
          <div class="admin-v2-section-heading">
            <div>
              <p class="station-kicker">Entitlements</p>
              <h2>读者授权</h2>
            </div>
          </div>
          <form class="admin-v2-form" id="access-form">
            <div class="admin-v2-form-grid">
              <label>
                读者 Email
                <input id="access-email" type="email" required placeholder="reader@example.com" />
              </label>
              <label>
                seriesSlug
                <input id="access-series-slug" required placeholder="deng-hai-liang-zhe" />
              </label>
              <label>
                授权范围
                <select id="access-scope">
                  <option value="chapter">单章</option>
                  <option value="series">整本作品</option>
                </select>
              </label>
              <label>
                chapterSlug
                <input id="access-chapter-slug" placeholder="prologue-light" />
              </label>
              <label>
                权限级别
                <select id="access-level">
                  <option value="paid">付费</option>
                  <option value="supporter">支持者</option>
