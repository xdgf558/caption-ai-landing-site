    const apiJson = async (path, options = {}) => {
      const response = await fetch(path, {
        ...options,
        headers: {
          'content-type': 'application/json',
          ...(options.headers || {})
        }
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload.ok === false) {
        const error = new Error(payload.message || `Request failed: ${response.status}`);
        error.code = payload.code || '';
        error.payload = payload;
        error.status = response.status;
        throw error;
      }
      return payload;
    };

    const apiFormData = async (path, formData, options = {}) => {
      const response = await fetch(path, {
        method: 'POST',
        ...options,
        body: formData
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload.ok === false) {
        throw new Error(payload.message || `Request failed: ${response.status}`);
      }
      return payload;
    };

    const escapeHtml = (value) =>
      String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');

    const splitTags = (value) =>
      String(value || '')
        .split(',')
        .map((item) => item.trim())
        .filter(Boolean);

    const slugify = (value, fallback = 'entry') => {
      const slug = String(value || '')
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      return slug || `${fallback}-${Date.now()}`;
    };

    const toDatetimeLocal = (value) => {
      if (!value) return '';
      const date = new Date(value.includes('T') ? value : value.replace(' ', 'T'));
      if (Number.isNaN(date.getTime())) return '';
      const offset = date.getTimezoneOffset() * 60000;
      return new Date(date.getTime() - offset).toISOString().slice(0, 16);
    };

    const parseYamlScalar = (value) => {
      const trimmed = String(value || '').trim();
      if (!trimmed) return '';
      if (trimmed === 'true') return true;
      if (trimmed === 'false') return false;
      if (/^-?\d+(\.\d+)?$/.test(trimmed)) return Number(trimmed);
      return trimmed.replace(/^['"]|['"]$/g, '');
    };

    const parseMarkdownDocument = (markdown) => {
      const normalized = String(markdown || '').replace(/\r\n/g, '\n');
      const match = normalized.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
      if (!match) return { frontmatter: {}, body: normalized.trim() };

      const frontmatter = {};
      const lines = match[1].split('\n');
      for (let index = 0; index < lines.length; index += 1) {
        const line = lines[index];
        if (!line || line.startsWith('  ')) continue;
        const separator = line.indexOf(':');
        if (separator === -1) continue;
        const key = line.slice(0, separator).trim();
        const value = line.slice(separator + 1).trim();

        if (value) {
          frontmatter[key] = parseYamlScalar(value);
          continue;
        }

        const items = [];
        while (lines[index + 1]?.startsWith('  - ')) {
          index += 1;
          items.push(parseYamlScalar(lines[index].replace(/^  - /, '')));
        }
        frontmatter[key] = items;
      }

      return { frontmatter, body: match[2].trim() };
    };

    const detectEntryType = (frontmatter) => {
      if (frontmatter.entryType === 'signal_brief' || frontmatter.type === 'signal_brief' || frontmatter.briefDate || frontmatter.signalCategory) return 'signal_brief';
      if (frontmatter.chapterSlug || frontmatter.chapterNumber || frontmatter.number) return 'novel_chapter';
      if (frontmatter.seriesSlug || frontmatter.updateSchedule || frontmatter.latestChapterSlug) return 'novel_series';
      return 'blog_post';
    };

    const normalizeBackendStatus = (frontmatter) => {
      if (frontmatter.draft === true) return 'draft';
      if (['draft', 'scheduled', 'published', 'archived'].includes(frontmatter.status)) return frontmatter.status;
      return 'published';
    };

    const formatBundleRules = (value) =>
      String(value || '')
        .split(/[,\s]+/)
        .map((part) => part.trim())
        .filter(Boolean)
        .map((part) => {
          const [minimumChapters, discountPercent] = part.split(':').map((item) => Number.parseInt(item.trim(), 10));
          return Number.isFinite(minimumChapters) && Number.isFinite(discountPercent)
            ? { minimumChapters, discountPercent }
            : null;
        })
        .filter(Boolean);

    const bundleRulesToInput = (rules) =>
      Array.isArray(rules)
        ? rules.map((rule) => `${rule.minimumChapters}:${rule.discountPercent}`).join(', ')
