    };

    const loadXWidgets = () => {
      if (!document.querySelector('script[src="https://platform.twitter.com/widgets.js"]')) {
        window.__stationCatXWidgetsLoaded = true;
        const script = document.createElement('script');
        script.src = 'https://platform.twitter.com/widgets.js';
        script.async = true;
        script.charset = 'utf-8';
        document.body.appendChild(script);
      } else {
        window.twttr?.widgets?.load?.();
      }
    };

    const renderXPreview = () => {
      const xUrl = elements.work.xUrl.value.trim();
      const validation = validateXPostUrl(xUrl);
      elements.work.preview.innerHTML = '';

      if (!validation.valid) {
        elements.work.preview.textContent = validation.message;
        elements.work.preview.dataset.tone = xUrl ? 'error' : '';
        return;
      }

      elements.work.preview.dataset.tone = 'success';
      const wrapper = document.createElement('div');
      wrapper.className = 'x-embed-wrapper';

      const blockquote = document.createElement('blockquote');
      blockquote.className = 'twitter-tweet';
      blockquote.dataset.theme = 'dark';
      const embedLink = document.createElement('a');
      embedLink.href = xUrl;
      blockquote.append(embedLink);

      const fallback = document.createElement('a');
      fallback.className = 'x-fallback-link';
      fallback.href = xUrl;
      fallback.target = '_blank';
      fallback.rel = 'noopener noreferrer';
      fallback.textContent = 'Watch on X';

      wrapper.append(blockquote, fallback);
      elements.work.preview.append(wrapper);
      loadXWidgets();
    };

    elements.tabs.forEach((button) => {
      button.addEventListener('click', () => setActiveContentType(button.dataset.adminTab));
    });

      elements.load.addEventListener('click', () => {
        const actions = {
          devlog: loadDevlogPosts,
          xworks: loadXWorks,
          serials: loadSerials
        };
        const action = actions[activeContentType];
        action().catch((error) => setStatus(error.message, 'error'));
      });

      elements.newItem.addEventListener('click', () => {
        if (activeContentType === 'devlog') resetDevlogForm();
        else if (activeContentType === 'xworks') resetXWorkForm();
        else resetSerialImportForm();
      });

    elements.devlog.title.addEventListener('input', () => {
      if (!state.devlog.sha && !state.devlog.slugTouched) {
        elements.devlog.slug.value = `${today()}-${toSlug(elements.devlog.title.value, 'devlog')}`;
      }
    });

    elements.devlog.slug.addEventListener('input', () => {
      state.devlog.slugTouched = true;
    });

    elements.work.title.addEventListener('input', () => {
      if (!state.xworks.sha && !state.xworks.slugTouched) {
        elements.work.slug.value = `${today()}-${toSlug(elements.work.title.value, 'x-work')}`;
      }
    });

    elements.work.slug.addEventListener('input', () => {
      state.xworks.slugTouched = true;
    });

    elements.work.xUrl.addEventListener('input', renderXPreview);
    elements.work.previewButton.addEventListener('click', renderXPreview);
      elements.work.deleteButton.addEventListener('click', () => {
        deleteXWork().catch((error) => setStatus(error.message, 'error'));
      });

    elements.serial.kind.addEventListener('change', () => {
      if (!state.serials.sha) {
        resetSerialImportForm(elements.serial.kind.value);
      }
    });

    elements.serial.file.addEventListener('change', async () => {
      const selectedFile = elements.serial.file.files?.[0];
      if (!selectedFile) return;

      try {
        const markdown = await selectedFile.text();
        state.serials = { sha: '', path: '', kind: elements.serial.kind.value };
        elements.serial.path.value = '';
        elements.serial.markdown.value = markdown;
        parseSerialImport();
        setStatus(`已导入本地文件：${selectedFile.name}。`, 'success');
        setInlineStatus('serials', '本地 Markdown 文件已读取并解析通过，可以保存。', 'success');
      } catch (error) {
        elements.serial.preview.textContent = error.message;
        elements.serial.preview.dataset.tone = 'error';
        setInlineStatus('serials', error.message, 'error');
      } finally {
        elements.serial.file.value = '';
      }
    });

    elements.serial.parseButton.addEventListener('click', () => {
      try {
        parseSerialImport();
          setInlineStatus('serials', 'Markdown 解析通过，可以保存。', 'success');
        } catch (error) {
          elements.serial.preview.textContent = error.message;
          elements.serial.preview.dataset.tone = 'error';
          setInlineStatus('serials', error.message, 'error');
        }
      });

    elements.devlogForm.addEventListener('submit', (event) => {
      event.preventDefault();
      setInlineStatus('devlog', '正在保存 Devlog 到 GitHub...', 'neutral');
      setSaving('devlog', true);
      saveDevlogPost()
        .then(() => setInlineStatus('devlog', `Devlog 已保存。${new Date().toLocaleTimeString()}`, 'success'))
        .catch((error) => {
          setStatus(error.message, 'error');
          setInlineStatus('devlog', error.message, 'error');
        })
        .finally(() => setSaving('devlog', false));
    });

      elements.xworksForm.addEventListener('submit', (event) => {
        event.preventDefault();
        setInlineStatus('xworks', '正在保存 X Work 到 GitHub...', 'neutral');
      setSaving('xworks', true);
      saveXWork()
        .then(() => setInlineStatus('xworks', `X Work 已保存。${new Date().toLocaleTimeString()}`, 'success'))
        .catch((error) => {
          setStatus(error.message, 'error');
          setInlineStatus('xworks', error.message, 'error');
        })
          .finally(() => setSaving('xworks', false));
      });

      elements.serialsForm.addEventListener('submit', (event) => {
        event.preventDefault();
        setInlineStatus('serials', '正在保存小说 Markdown 到 GitHub...', 'neutral');
        setSaving('serials', true);
        saveSerialMarkdown()
          .then(() => setInlineStatus('serials', `小说 Markdown 已保存。${new Date().toLocaleTimeString()}`, 'success'))
          .catch((error) => {
            setStatus(error.message, 'error');
            elements.serial.preview.textContent = error.message;
            elements.serial.preview.dataset.tone = 'error';
            setInlineStatus('serials', error.message, 'error');
          })
          .finally(() => setSaving('serials', false));
      });

    elements.devlogForm.addEventListener(
      'invalid',
      (event) => {
        setInlineStatus('devlog', `请先填写：${fieldLabel(event.target)}。`, 'error');
      },
      true
    );

      elements.xworksForm.addEventListener(
        'invalid',
        (event) => {
        setInlineStatus('xworks', `请先填写：${fieldLabel(event.target)}。`, 'error');
      },
        true
      );

      elements.serialsForm.addEventListener(
        'invalid',
        (event) => {
          setInlineStatus('serials', `请先填写：${fieldLabel(event.target)}。`, 'error');
        },
        true
      );

      resetDevlogForm();
      resetXWorkForm();
      resetSerialImportForm('series');
      setActiveContentType('devlog');
  </script>
</BaseLayout>
