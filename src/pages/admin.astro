---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Station Cat Admin"
  description="Station Cat content, X works, and serial fiction admin editor."
  lang="zh-Hant"
  canonicalPath="/admin/"
  bodyClass="station-home"
>
  <section class="admin-shell">
    <div class="admin-heading">
      <p class="station-kicker">Admin</p>
      <h1>Station Cat 內容管理</h1>
      <p>
        使用 GitHub fine-grained token 更新 <code>src/content/devlog</code>、<code>src/content/xworks</code>、<code>src/content/serials</code> 和 <code>src/content/serialChapters</code> 裡的 Markdown。Token 只保存在當前頁面，不會寫入網站或 localStorage。
      </p>
    </div>

    <div class="admin-grid">
      <aside class="admin-panel admin-sidebar">
        <label for="admin-token">GitHub Token</label>
        <input id="admin-token" type="password" autocomplete="off" placeholder="github_pat_..." />
        <p class="fine-print">
          請使用只授權目前 repo 的 GitHub fine-grained token。權限只需要 Contents: Read and write。不要把 token 分享給別人。
        </p>

        <div class="admin-tabs" role="tablist" aria-label="Content type">
          <button class="admin-tab is-active" id="tab-devlog" type="button" data-admin-tab="devlog">Devlog</button>
          <button class="admin-tab" id="tab-xworks" type="button" data-admin-tab="xworks">X Works</button>
          <button class="admin-tab" id="tab-serials" type="button" data-admin-tab="serials">連載小說</button>
        </div>

        <div class="button-row">
          <button class="button button-primary" id="admin-load" type="button">读取 Devlog</button>
          <button class="button button-secondary" id="admin-new" type="button">新 Devlog</button>
        </div>
        <div class="button-row">
          <a class="button button-secondary" href="/admin/waitlist/">等待名單設定</a>
        </div>
        <div class="admin-status" id="admin-status" role="status">等待連接 GitHub。</div>

        <div class="admin-list-panel" id="devlog-list-panel">
          <p class="station-kicker">Devlog files</p>
          <div class="admin-post-list" id="admin-post-list" aria-label="Existing devlog posts"></div>
        </div>

        <div class="admin-list-panel" id="xworks-list-panel" hidden>
          <p class="station-kicker">X Works files</p>
          <div class="admin-post-list" id="xworks-list" aria-label="Existing X works"></div>
        </div>

        <div class="admin-list-panel" id="serials-list-panel" hidden>
          <p class="station-kicker">Serial files</p>
          <div class="admin-list-split">
            <div>
              <p class="fine-print">小說資料</p>
              <div class="admin-post-list" id="serial-series-list" aria-label="Existing serial metadata files"></div>
            </div>
            <div>
              <p class="fine-print">章節正文</p>
              <div class="admin-post-list" id="serial-chapters-list" aria-label="Existing serial chapter files"></div>
            </div>
          </div>
        </div>
      </aside>

      <form class="admin-panel admin-editor" id="devlog-editor">
        <div class="admin-form-grid">
          <label>
            標題
            <input id="post-title" name="title" required placeholder="例如：SnapCopy 第一次等待名單測試" />
          </label>
          <label>
            Slug
            <input id="post-slug" name="slug" required placeholder="2026-05-17-snapcopy-update" />
          </label>
          <label>
            日期
            <input id="post-date" name="pubDate" type="date" required />
          </label>
          <label>
            狀態
            <select id="post-status" name="status">
              <option value="building">開發中</option>
              <option value="testing">測試中</option>
              <option value="shipped">已完成</option>
              <option value="note">記錄</option>
              <option value="maintenance">維護</option>
            </select>
          </label>
          <label>
            語言
            <select id="post-language" name="language">
              <option value="zh-Hant">繁中</option>
              <option value="zh-Hans">简中</option>
              <option value="en">EN</option>
              <option value="ja">日本語</option>
            </select>
          </label>
          <label class="admin-checkbox">
            <input id="post-draft" name="draft" type="checkbox" />
            存為草稿
          </label>
        </div>

        <label>
          摘要
          <textarea id="post-description" name="description" rows="3" required placeholder="一句話說明這次更新。"></textarea>
        </label>
        <label>
          Tags
          <input id="post-tags" name="tags" placeholder="SnapCopy, Website, App Store" />
        </label>
        <label>
          內容
          <textarea id="post-body" name="body" rows="16" required placeholder="用 Markdown 寫開發進度、上架記錄或產品實驗。"></textarea>
        </label>

        <div class="button-row">
          <button class="button button-primary" id="devlog-save" type="submit">保存 Devlog</button>
          <a class="button button-secondary" href="/devlog/">查看博客</a>
        </div>
        <div class="admin-inline-status" id="devlog-save-status" role="status" aria-live="polite" hidden></div>
      </form>

      <form class="admin-panel admin-editor" id="xworks-editor" hidden>
        <div class="admin-form-grid">
          <label>
            标题
            <input id="work-title" name="title" required placeholder="AI cat experiment" />
          </label>
          <label>
            Slug
            <input id="work-slug" name="slug" required placeholder="2026-05-17-ai-cat-experiment" />
          </label>
          <label>
            简介
            <input id="work-description" name="description" required placeholder="一句话说明这个 X 作品" />
          </label>
          <label>
            X 原帖链接
            <input id="work-x-url" name="xUrl" required placeholder="https://x.com/bketck/status/1234567890" />
          </label>
          <label>
            类型
            <select id="work-type" name="type">
              <option value="video">video</option>
              <option value="post">post</option>
              <option value="image">image</option>
              <option value="thread">thread</option>
            </select>
          </label>
          <label>
            标签
            <input id="work-tags" name="tags" list="work-tag-options" placeholder="AI Creation, Cats, Meals" />
            <datalist id="work-tag-options">
              <option value="AI Creation"></option>
              <option value="Cats"></option>
              <option value="Meals"></option>
              <option value="App Build"></option>
              <option value="Strange Ideas"></option>
              <option value="Notes"></option>
            </datalist>
          </label>
          <label>
            语言
            <select id="work-language" name="language">
              <option value="en">en</option>
              <option value="ja">ja</option>
              <option value="zh-hant">zh-hant</option>
            </select>
          </label>
          <label class="admin-checkbox">
            <input id="work-featured" name="featured" type="checkbox" />
            首页精选
          </label>
          <label>
            状态
            <select id="work-status" name="status">
              <option value="draft">draft</option>
              <option value="published">published</option>
            </select>
          </label>
          <label>
            排序
            <input id="work-sort-order" name="sortOrder" type="number" placeholder="10" value="10" />
          </label>
          <label>
            发布时间
            <input id="work-published-at" name="publishedAt" type="datetime-local" />
          </label>
        </div>
        <p class="fine-print">
          保存 X Work 時會自動設為 published，並自動加入首頁精選。Cloudflare Workers 自動部署完成後會出現在首頁 Latest from X。
        </p>

        <label>
          补充说明
          <textarea id="work-body" name="body" rows="8" placeholder="可選 Markdown 正文"></textarea>
        </label>

        <div class="admin-preview-panel">
          <div>
            <p class="station-kicker">X Embed Preview</p>
            <h2>X Embed Preview</h2>
          </div>
          <div class="button-row">
            <button class="button button-secondary" id="work-preview-button" type="button">Preview embed</button>
            <a class="button button-secondary" href="/works/">查看 Works</a>
          </div>
          <div class="admin-preview" id="work-preview">请粘贴一条 X 原帖链接。</div>
        </div>

        <div class="button-row">
          <button class="button button-primary" id="xwork-save" type="submit">保存 X Work</button>
          <button class="button button-danger" id="work-delete" type="button">刪除 X Work</button>
        </div>
        <div class="admin-inline-status" id="xwork-save-status" role="status" aria-live="polite" hidden></div>
      </form>

      <form class="admin-panel admin-editor" id="serials-editor" hidden>
        <div class="admin-form-grid">
          <label>
            导入类型
            <select id="serial-kind" name="kind">
              <option value="series">小说资料</option>
              <option value="chapter">章节正文</option>
            </select>
          </label>
          <label>
            目标路径
            <input id="serial-path" name="path" required placeholder="src/content/serials/novel-slug.md" />
          </label>
          <label>
            seriesSlug
            <input id="serial-series-slug" name="seriesSlug" required placeholder="novel-slug" />
          </label>
          <label>
            章节序号
            <input id="serial-chapter-number" name="chapterNumber" type="number" min="1" placeholder="1" />
          </label>
          <label>
            chapterSlug
            <input id="serial-chapter-slug" name="chapterSlug" placeholder="chapter-slug" />
          </label>
        </div>
        <p class="fine-print">
          直接粘贴完整 Markdown。小说资料写入 <code>{'src/content/serials/{seriesSlug}.md'}</code>，章节正文写入 <code>{'src/content/serialChapters/{seriesSlug}-{number}-{chapterSlug}.md'}</code>。保存后 GitHub 会触发网站自动部署。
        </p>

        <label>
          Markdown
          <textarea id="serial-markdown" name="markdown" rows="24" required spellcheck="false" placeholder="请粘贴包含 frontmatter 的完整 Markdown。"></textarea>
        </label>

        <div class="admin-preview-panel">
          <div>
            <p class="station-kicker">Import Preview</p>
            <h2>小说 Markdown 导入预览</h2>
          </div>
          <div class="button-row">
            <label class="button button-secondary admin-file-button" for="serial-file">选择 Markdown 文件</label>
            <input class="admin-file-input" id="serial-file" name="file" type="file" accept=".md,.markdown,text/markdown,text/plain" />
            <button class="button button-secondary" id="serial-parse-button" type="button">解析 Markdown</button>
            <a class="button button-secondary" href="/zh-hant/works/">查看小说页</a>
          </div>
          <div class="admin-preview" id="serial-preview">粘贴小说或章节 Markdown 后点击解析。</div>
        </div>

        <div class="button-row">
          <button class="button button-primary" id="serial-save" type="submit">保存小说 Markdown</button>
        </div>
        <div class="admin-inline-status" id="serial-save-status" role="status" aria-live="polite" hidden></div>
      </form>
    </div>
  </section>

  <script is:inline>
    const repo = {
      owner: 'xdgf558',
      name: 'caption-ai-landing-site',
      branch: 'main',
      folders: {
        devlog: 'src/content/devlog',
        xworks: 'src/content/xworks',
        serials: 'src/content/serials',
        serialChapters: 'src/content/serialChapters'
      }
    };

    const elements = {
      token: document.getElementById('admin-token'),
      load: document.getElementById('admin-load'),
      newItem: document.getElementById('admin-new'),
      status: document.getElementById('admin-status'),
      tabs: Array.from(document.querySelectorAll('[data-admin-tab]')),
      devlogListPanel: document.getElementById('devlog-list-panel'),
      xworksListPanel: document.getElementById('xworks-list-panel'),
      serialsListPanel: document.getElementById('serials-list-panel'),
      devlogList: document.getElementById('admin-post-list'),
      xworksList: document.getElementById('xworks-list'),
      serialSeriesList: document.getElementById('serial-series-list'),
      serialChaptersList: document.getElementById('serial-chapters-list'),
      devlogForm: document.getElementById('devlog-editor'),
      xworksForm: document.getElementById('xworks-editor'),
      serialsForm: document.getElementById('serials-editor'),
      devlog: {
        title: document.getElementById('post-title'),
        slug: document.getElementById('post-slug'),
        date: document.getElementById('post-date'),
        statusField: document.getElementById('post-status'),
        language: document.getElementById('post-language'),
        draft: document.getElementById('post-draft'),
        description: document.getElementById('post-description'),
        tags: document.getElementById('post-tags'),
        body: document.getElementById('post-body'),
        saveButton: document.getElementById('devlog-save'),
        saveStatus: document.getElementById('devlog-save-status')
      },
      work: {
        slug: document.getElementById('work-slug'),
        title: document.getElementById('work-title'),
        xUrl: document.getElementById('work-x-url'),
        type: document.getElementById('work-type'),
        language: document.getElementById('work-language'),
        statusField: document.getElementById('work-status'),
        sortOrder: document.getElementById('work-sort-order'),
        publishedAt: document.getElementById('work-published-at'),
        featured: document.getElementById('work-featured'),
        description: document.getElementById('work-description'),
        tags: document.getElementById('work-tags'),
        body: document.getElementById('work-body'),
        previewButton: document.getElementById('work-preview-button'),
        preview: document.getElementById('work-preview'),
        deleteButton: document.getElementById('work-delete'),
        saveButton: document.getElementById('xwork-save'),
        saveStatus: document.getElementById('xwork-save-status')
      },
      serial: {
        kind: document.getElementById('serial-kind'),
        path: document.getElementById('serial-path'),
        seriesSlug: document.getElementById('serial-series-slug'),
        chapterNumber: document.getElementById('serial-chapter-number'),
        chapterSlug: document.getElementById('serial-chapter-slug'),
        markdown: document.getElementById('serial-markdown'),
        file: document.getElementById('serial-file'),
        parseButton: document.getElementById('serial-parse-button'),
        preview: document.getElementById('serial-preview'),
        saveButton: document.getElementById('serial-save'),
        saveStatus: document.getElementById('serial-save-status')
      }
    };

    let activeContentType = 'devlog';
    const state = {
      devlog: { sha: '', path: '', slugTouched: false },
      xworks: { sha: '', path: '', slugTouched: false },
      serials: { sha: '', path: '', kind: 'series' }
    };

    const today = () => new Date().toISOString().slice(0, 10);
    const nowLocal = () => new Date().toISOString().slice(0, 16);

    const toDatetimeLocal = (value) => {
      if (!value) return nowLocal();
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return nowLocal();
      return date.toISOString().slice(0, 16);
    };

    const toIso = (value) => {
      if (!value) return new Date().toISOString();
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? new Date().toISOString() : date.toISOString();
    };

    const setStatus = (message, tone = 'neutral') => {
      elements.status.textContent = message;
      elements.status.dataset.tone = tone;
    };

    const setInlineStatus = (contentType, message, tone = 'neutral') => {
      const targets = {
        devlog: elements.devlog.saveStatus,
        xworks: elements.work.saveStatus,
        serials: elements.serial.saveStatus
      };
      const target = targets[contentType];
      if (!target) return;
      target.textContent = message;
      target.dataset.tone = tone;
      target.hidden = !message;
    };

    const setSaving = (contentType, isSaving) => {
      const saveLabels = {
        devlog: ['保存 Devlog', '正在保存 Devlog...'],
        xworks: ['保存 X Work', '正在保存 X Work...'],
        serials: ['保存小说 Markdown', '正在保存小说 Markdown...']
      };
      const buttons = {
        devlog: elements.devlog.saveButton,
        xworks: elements.work.saveButton,
        serials: elements.serial.saveButton
      };
      const button = buttons[contentType];
      if (!button) return;
      button.disabled = isSaving;
      button.textContent = isSaving ? saveLabels[contentType][1] : saveLabels[contentType][0];

      if (contentType === 'xworks') {
        elements.work.deleteButton.disabled = isSaving;
      }
    };

    const fieldLabel = (field) => {
      const label = field.closest('label');
      if (!label) return field.name || '必填字段';
      return Array.from(label.childNodes)
        .filter((node) => node.nodeType === Node.TEXT_NODE)
        .map((node) => node.textContent.trim())
        .find(Boolean) || field.name || '必填字段';
    };

    const token = () => elements.token.value.trim();

    const requireToken = () => {
      const value = token();
      if (!value) {
        throw new Error('請先輸入 GitHub token。');
      }
      return value;
    };

    const githubErrorMessage = (status, fallback) => {
      if (status === 401) return 'GitHub token 無效或已過期。請重新建立 fine-grained token。';
      if (status === 403) return 'GitHub denied access. Check that your fine-grained token has Contents: Read and write permission for this repository.';
      if (status === 404) return 'Could not find the target repository, branch, or content path.';
      if (status === 429) return 'GitHub API rate limit reached. Please wait and try again.';
      return fallback || `GitHub request failed: ${status}`;
    };

    const githubFetch = async (url, options = {}) => {
      const response = await fetch(url, {
        ...options,
        headers: {
          Accept: 'application/vnd.github+json',
          Authorization: `Bearer ${requireToken()}`,
          'X-GitHub-Api-Version': '2022-11-28',
          ...(options.headers || {})
        }
      });

      if (!response.ok) {
        const detail = await response.json().catch(() => ({}));
        const error = new Error(githubErrorMessage(response.status, detail.message));
        error.status = response.status;
        throw error;
      }

      return response.json();
    };

    const apiUrl = (path) =>
      `https://api.github.com/repos/${repo.owner}/${repo.name}/contents/${path}?ref=${repo.branch}`;

    const contentUrl = (path) =>
      `https://api.github.com/repos/${repo.owner}/${repo.name}/contents/${path}`;

    const verifyRepoAccess = async () => {
      await githubFetch(apiUrl(''));
    };

    const readContentFolder = async (folder) => {
      try {
        const files = await githubFetch(apiUrl(folder));
        return Array.isArray(files) ? files : [];
      } catch (error) {
        if (error.status === 404) {
          await verifyRepoAccess();
          return [];
        }

        throw error;
      }
    };

    const renderEmptyList = (target, message) => {
      target.innerHTML = '';
      const empty = document.createElement('p');
      empty.className = 'admin-empty-list';
      empty.textContent = message;
      target.append(empty);
    };

    const toSlug = (value, fallback = 'entry') => {
      const ascii = value
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      return ascii || `${fallback}-${Date.now()}`;
    };

    const toBase64 = (value) => {
      const bytes = new TextEncoder().encode(value);
      let binary = '';
      bytes.forEach((byte) => {
        binary += String.fromCharCode(byte);
      });
      return btoa(binary);
    };

    const fromBase64 = (value) => {
      const binary = atob(value.replace(/\n/g, ''));
      const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
      return new TextDecoder().decode(bytes);
    };

    const yamlString = (value) => JSON.stringify(value || '');

    const splitTags = (value) =>
      value
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean);

    const yamlTags = (tags) => {
      if (!tags.length) return 'tags: []';
      return `tags:\n${tags.map((tag) => `  - ${yamlString(tag)}`).join('\n')}`;
    };

    const parseScalar = (value) => {
      const trimmed = value.trim();
      if (trimmed === 'true') return true;
      if (trimmed === 'false') return false;
      if (trimmed === '[]') return [];
      if (/^-?\d+(\.\d+)?$/.test(trimmed)) return Number(trimmed);
      try {
        return JSON.parse(trimmed);
      } catch {
        return trimmed;
      }
    };

      const parseMarkdown = (markdown) => {
        const match = markdown.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
        if (!match) {
          return { frontmatter: {}, body: markdown };
      }

      const frontmatter = {};
      const lines = match[1].split('\n');

      for (let index = 0; index < lines.length; index += 1) {
        const line = lines[index];
        const separator = line.indexOf(':');
        if (separator === -1 || line.startsWith('  ')) continue;

        const key = line.slice(0, separator).trim();
        const value = line.slice(separator + 1).trim();

        if (!value) {
          const items = [];
          while (lines[index + 1]?.startsWith('  - ')) {
            index += 1;
            items.push(parseScalar(lines[index].replace(/^  - /, '')));
          }
          frontmatter[key] = items;
        } else {
          frontmatter[key] = parseScalar(value);
        }
      }

        return { frontmatter, body: match[2].trim() };
      };

      const serialKindLabel = (kind) => (kind === 'chapter' ? '章节正文' : '小说资料');

      const padChapterNumber = (value) => String(Math.max(1, Number(value) || 1)).padStart(3, '0');

      const inferSerialKind = (frontmatter, fallback = 'series') => {
        if (frontmatter.chapterSlug || frontmatter.chapterNumber) return 'chapter';
        if (frontmatter.tagline || frontmatter.priceMode || frontmatter.latestChapterSlug) return 'series';
        return fallback;
      };

      const serialPathFromParts = ({ kind, seriesSlug, chapterNumber, chapterSlug }) => {
        if (kind === 'chapter') {
          return `${repo.folders.serialChapters}/${seriesSlug}-${padChapterNumber(chapterNumber)}-${chapterSlug}.md`;
        }

        return `${repo.folders.serials}/${seriesSlug}.md`;
      };

      const serialTemplate = (kind) => {
        const date = today();
        if (kind === 'chapter') {
          return `---\nseriesSlug: "novel-slug"\nchapterNumber: 1\nchapterSlug: "chapter-slug"\ntitle: "第一章：章节标题"\nexcerpt: "一到两句话概括本章，用于目录和章节页摘要。"\nstatus: "draft"\naccess: "free"\nlanguage: "zh-Hant"\nvolume: "第一卷：卷名"\nwordCount: 0\nreadingMinutes: 0\npublishedAt: ${date}\nupdatedAt: ${date}\n---\n\n这里写章节正文。\n`;
        }

        return `---\ntitle: "小说标题"\nseriesSlug: "novel-slug"\nauthor: "Station Cat"\ndescription: "一句较完整的作品介绍，用于 SEO、书架页和分享卡片。"\nsubtitle: "可选副标题"\ntagline: "更短的一句话钩子，显示在作品页和卡片上。"\nstatus: "planned"\nlanguage: "zh-Hant"\nupdateSchedule: "每周二 / 周五更新，或先写不定期。"\ntags:\n  - "Long novel"\n  - "Serial fiction"\ncoverImage: ""\ncoverLabel: "封面短标题"\ncoverAlt: "小说封面描述"\nfeatured: false\npriceMode: "free"\nfreeChapters: 3\nlatestChapterSlug: ""\nlatestChapterNumber: 0\ntotalPlannedChapters: 0\navailabilityNote: "当前阶段先开放免费阅读，后续再接入打赏和付费解锁。"\npublishedAt: ${date}\nupdatedAt: ${date}\n---\n\n这里写作品简介正文。\n`;
      };

      const renderSerialPreview = ({ kind, frontmatter, path, body }) => {
        elements.serial.preview.innerHTML = '';
        elements.serial.preview.dataset.tone = 'success';

        const summary = document.createElement('div');
        summary.className = 'admin-import-summary';

        const title = document.createElement('h3');
        title.textContent = frontmatter.title || serialKindLabel(kind);

        const meta = document.createElement('p');
        meta.textContent = kind === 'chapter'
          ? `${frontmatter.seriesSlug || 'no seriesSlug'} · 第 ${frontmatter.chapterNumber || '?'} 章 · ${frontmatter.status || 'draft'} · ${frontmatter.access || 'free'}`
          : `${frontmatter.seriesSlug || 'no seriesSlug'} · ${frontmatter.status || 'planned'} · ${frontmatter.language || 'zh-Hant'} · ${frontmatter.priceMode || 'free'}`;

        const targetPath = document.createElement('code');
        targetPath.textContent = path;

        const bodyInfo = document.createElement('p');
        bodyInfo.textContent = `正文长度约 ${body.length} 个字符。`;

        summary.append(title, meta, targetPath, bodyInfo);
        elements.serial.preview.append(summary);
      };

      const parseSerialImport = ({ sync = true } = {}) => {
        const fields = elements.serial;
        const markdown = fields.markdown.value.replace(/\r\n/g, '\n').trim();
        if (!markdown) {
          throw new Error('请先粘贴小说或章节 Markdown。');
        }

        if (!markdown.startsWith('---')) {
          throw new Error('Markdown 需要包含 YAML frontmatter，并以 --- 开头。');
        }

        const { frontmatter, body } = parseMarkdown(markdown);
        if (!Object.keys(frontmatter).length) {
          throw new Error('没有解析到 frontmatter，请检查开头和结尾的 ---。');
        }

        const kind = inferSerialKind(frontmatter, fields.kind.value);
        const seriesSlug = toSlug(frontmatter.seriesSlug || fields.seriesSlug.value, 'novel-slug');
        const chapterNumber = Number(frontmatter.chapterNumber || fields.chapterNumber.value || 1);
        const chapterSlug = toSlug(frontmatter.chapterSlug || fields.chapterSlug.value || frontmatter.title, 'chapter-slug');
        const calculatedPath = serialPathFromParts({ kind, seriesSlug, chapterNumber, chapterSlug });
        const expectedFolder = kind === 'chapter' ? repo.folders.serialChapters : repo.folders.serials;
        const currentPath = fields.path.value.trim();
        const path = currentPath && currentPath.startsWith(`${expectedFolder}/`) ? currentPath : calculatedPath;

        if (sync) {
          fields.kind.value = kind;
          fields.seriesSlug.value = seriesSlug;
          fields.chapterNumber.value = kind === 'chapter' ? String(chapterNumber) : '';
          fields.chapterSlug.value = kind === 'chapter' ? chapterSlug : '';
          fields.path.value = path;
        }

        const missing = kind === 'chapter'
          ? ['seriesSlug', 'chapterNumber', 'chapterSlug', 'title', 'excerpt'].filter((key) => frontmatter[key] === undefined || frontmatter[key] === '')
          : ['title', 'seriesSlug', 'description', 'tagline', 'publishedAt'].filter((key) => frontmatter[key] === undefined || frontmatter[key] === '');

        if (missing.length) {
          throw new Error(`${serialKindLabel(kind)} 缺少必要字段：${missing.join(', ')}。`);
        }

        if (!path.endsWith('.md')) {
          throw new Error('目标路径必须以 .md 结尾。');
        }

        if (!path.startsWith(`${expectedFolder}/`)) {
          throw new Error(`${serialKindLabel(kind)} 应保存到 ${expectedFolder}/。`);
        }

        const result = {
          kind,
          frontmatter,
          body,
          path,
          markdown: `${markdown}\n`,
          seriesSlug,
          chapterNumber,
          chapterSlug
        };
        renderSerialPreview(result);
        return result;
      };

    const validateXPostUrl = (input) => {
      const value = input.trim();
      if (!value) {
        return { valid: false, message: '请粘贴一条 X 原帖链接。' };
      }

      try {
        const url = new URL(value);
        const hostname = url.hostname.replace(/^www\./, '');
        const allowedHosts = ['x.com', 'twitter.com'];
        const parts = url.pathname.split('/').filter(Boolean);

        if (!allowedHosts.includes(hostname)) {
          return { valid: false, message: '请输入有效的 x.com 或 twitter.com 帖子链接。' };
        }

        if (!parts.includes('status')) {
          return { valid: false, message: '请输入具体 X 帖子链接，而不是个人主页链接。' };
        }

        const statusIndex = parts.indexOf('status');
        if (!parts[statusIndex + 1]) {
          return { valid: false, message: '请输入有效的 x.com 或 twitter.com 帖子链接。' };
        }

        return { valid: true, message: '' };
      } catch {
        return { valid: false, message: '请输入有效的 x.com 或 twitter.com 帖子链接。' };
      }
    };

    const buildDevlogMarkdown = () => {
      const fields = elements.devlog;
      const slug = fields.slug.value.trim();
      const data = {
        title: fields.title.value.trim(),
        postSlug: slug,
        description: fields.description.value.trim(),
        pubDate: fields.date.value,
        status: fields.statusField.value,
        language: fields.language.value,
        tags: splitTags(fields.tags.value),
        draft: fields.draft.checked
      };

      return `---\ntitle: ${yamlString(data.title)}\npostSlug: ${yamlString(data.postSlug)}\ndescription: ${yamlString(data.description)}\npubDate: ${yamlString(data.pubDate)}\nstatus: ${yamlString(data.status)}\nlanguage: ${yamlString(data.language)}\ntags: ${JSON.stringify(data.tags)}\ndraft: ${data.draft}\n---\n\n${fields.body.value.trim()}\n`;
    };

