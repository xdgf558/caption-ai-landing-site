---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Station Cat Admin"
  description="Station Cat content and serial fiction admin editor."
  lang="zh-Hant"
  canonicalPath="/admin/"
  bodyClass="station-home"
>
  <section class="admin-shell">
    <div class="admin-heading">
      <p class="station-kicker">Admin</p>
      <h1>Station Cat 內容管理</h1>
      <p>
        使用 GitHub fine-grained token 更新 <code>src/content/devlog</code>、<code>src/content/serials</code> 和 <code>src/content/serialChapters</code> 裡的 Markdown。Token 只保存在當前頁面，不會寫入網站或 localStorage。
      </p>
    </div>

    <div class="admin-grid">
      <aside class="admin-panel admin-sidebar">
        <label for="admin-token">GitHub Token</label>
        <input id="admin-token" type="password" autocomplete="off" placeholder="github_pat_..." />
        <p class="fine-print">
          請使用只授權目前 repo 的 GitHub fine-grained token。權限只需要 Contents: Read and write。不要把 token 分享給別人。
        </p>

        <div class="admin-tabs" role="tablist" aria-label="Content type">
          <button class="admin-tab is-active" id="tab-devlog" type="button" data-admin-tab="devlog">Devlog</button>
          <button class="admin-tab" id="tab-serials" type="button" data-admin-tab="serials">連載小說</button>
          <button class="admin-tab" id="tab-reader-access" type="button" data-admin-tab="readerAccess">讀者授權</button>
        </div>

        <div class="button-row">
          <button class="button button-primary" id="admin-load" type="button">读取 Devlog</button>
          <button class="button button-secondary" id="admin-new" type="button">新 Devlog</button>
        </div>
        <div class="button-row">
          <a class="button button-secondary" href="/admin/waitlist/">等待名單設定</a>
        </div>
        <div class="admin-status" id="admin-status" role="status">等待連接 GitHub。</div>

        <div class="admin-list-panel" id="devlog-list-panel">
          <p class="station-kicker">Devlog files</p>
          <div class="admin-post-list" id="admin-post-list" aria-label="Existing devlog posts"></div>
        </div>

        <div class="admin-list-panel" id="serials-list-panel" hidden>
          <p class="station-kicker">Serial files</p>
          <div class="admin-list-split">
            <div>
              <p class="fine-print">小說資料</p>
              <div class="admin-post-list" id="serial-series-list" aria-label="Existing serial metadata files"></div>
            </div>
            <div>
              <p class="fine-print">章節正文</p>
              <div class="admin-post-list" id="serial-chapters-list" aria-label="Existing serial chapter files"></div>
            </div>
          </div>
        </div>

        <div class="admin-list-panel" id="reader-access-list-panel" hidden>
          <p class="station-kicker">Reader access</p>
          <p class="fine-print">手動授權會寫入 D1 的 <code>novel_entitlements</code>，供書庫和章節頁權限判斷使用。</p>
          <div class="admin-post-list" id="reader-entitlements-list" aria-label="Reader entitlements"></div>
        </div>
      </aside>

      <form class="admin-panel admin-editor" id="devlog-editor">
        <div class="admin-form-grid">
          <label>
            標題
            <input id="post-title" name="title" required placeholder="例如：SnapCopy 第一次等待名單測試" />
          </label>
          <label>
            Slug
            <input id="post-slug" name="slug" required placeholder="2026-05-17-snapcopy-update" />
          </label>
          <label>
            日期
            <input id="post-date" name="pubDate" type="date" required />
          </label>
          <label>
            狀態
            <select id="post-status" name="status">
              <option value="building">開發中</option>
              <option value="testing">測試中</option>
              <option value="shipped">已完成</option>
              <option value="note">記錄</option>
              <option value="maintenance">維護</option>
            </select>
          </label>
          <label>
            語言
            <select id="post-language" name="language">
              <option value="zh-Hant">繁中</option>
              <option value="zh-Hans">简中</option>
              <option value="en">EN</option>
              <option value="ja">日本語</option>
            </select>
          </label>
          <label class="admin-checkbox">
            <input id="post-draft" name="draft" type="checkbox" />
            存為草稿
          </label>
        </div>

        <label>
          摘要
          <textarea id="post-description" name="description" rows="3" required placeholder="一句話說明這次更新。"></textarea>
        </label>
        <label>
          Tags
          <input id="post-tags" name="tags" placeholder="SnapCopy, Website, App Store" />
        </label>
        <label>
          內容
          <textarea id="post-body" name="body" rows="16" required placeholder="用 Markdown 寫開發進度、上架記錄或產品實驗。"></textarea>
        </label>

        <div class="button-row">
          <button class="button button-primary" id="devlog-save" type="submit">保存 Devlog</button>
          <a class="button button-secondary" href="/devlog/">查看博客</a>
        </div>
        <div class="admin-inline-status" id="devlog-save-status" role="status" aria-live="polite" hidden></div>
      </form>

      <form class="admin-panel admin-editor" id="serials-editor" hidden>
        <div class="admin-form-grid">
          <label>
            导入类型
            <select id="serial-kind" name="kind">
              <option value="series">小说资料</option>
              <option value="chapter">章节正文</option>
            </select>
          </label>
          <label>
            目标路径
            <input id="serial-path" name="path" required placeholder="src/content/serials/novel-slug.md" />
          </label>
          <label>
            seriesSlug
            <input id="serial-series-slug" name="seriesSlug" required placeholder="novel-slug" />
          </label>
          <label>
            章节序号
            <input id="serial-chapter-number" name="chapterNumber" type="number" min="1" placeholder="1" />
          </label>
          <label>
            chapterSlug
            <input id="serial-chapter-slug" name="chapterSlug" placeholder="chapter-slug" />
          </label>
        </div>
        <p class="fine-print">
          直接粘贴完整 Markdown。小说资料写入 <code>{'src/content/serials/{seriesSlug}.md'}</code>，章节正文写入 <code>{'src/content/serialChapters/{seriesSlug}-{number}-{chapterSlug}.md'}</code>。保存后 GitHub 会触发网站自动部署。
        </p>

        <section class="admin-pricing-panel" id="serial-pricing-panel">
          <div>
            <p class="station-kicker">Pricing</p>
            <h2>小说收费设置</h2>
            <p class="fine-print">这里会直接更新小说资料 Markdown 的 frontmatter。章节是否锁定仍在章节 Markdown 的 <code>access</code> 字段里设置。</p>
          </div>

          <div class="admin-form-grid">
            <label>
              收费模式
              <select id="serial-price-mode" name="priceMode">
                <option value="free">免费阅读</option>
                <option value="tip-optional">免费 + 打赏</option>
                <option value="chapter-paid">单章购买</option>
                <option value="volume-paid">分卷购买</option>
                <option value="member">会员阅读</option>
              </select>
            </label>
            <label>
              免费章节数
              <input id="serial-free-chapters" name="freeChapters" type="number" min="0" step="1" />
            </label>
            <label class="admin-checkbox">
              <input id="serial-tips-enabled" name="tipsEnabled" type="checkbox" />
              开启打赏
            </label>
            <label>
              打赏金额
              <input id="serial-tip-amounts" name="tipAmounts" placeholder="3, 5, 10" />
            </label>
            <label>
              打赏币种
              <select id="serial-tip-currency" name="tipCurrency">
                <option value="USD">USD</option>
              </select>
            </label>
            <label>
              单章价格
              <input id="serial-chapter-price-amount" name="chapterPriceAmount" type="number" min="0" step="0.01" />
            </label>
            <label>
              单章币种
              <select id="serial-chapter-price-currency" name="chapterPriceCurrency">
                <option value="USD">USD</option>
              </select>
            </label>
            <label>
              支持者价格
              <input id="serial-supporter-price-amount" name="supporterPriceAmount" type="number" min="0" step="0.01" />
            </label>
            <label>
              支持者币种
              <select id="serial-supporter-price-currency" name="supporterPriceCurrency">
                <option value="USD">USD</option>
              </select>
            </label>
            <label class="admin-checkbox">
              <input id="serial-bundles-enabled" name="bundlePurchasesEnabled" type="checkbox" />
              开启多章折扣
            </label>
          </div>

          <div class="admin-bundle-editor">
            <div class="admin-bundle-editor__heading">
              <div>
                <p class="station-kicker">Bundle Discount</p>
                <h3>一次购买多章折扣</h3>
              </div>
              <button class="button button-secondary" id="serial-bundle-add" type="button">新增折扣</button>
            </div>
            <div class="admin-bundle-list" id="serial-bundle-list"></div>
          </div>

          <div class="button-row">
            <button class="button button-secondary" id="serial-pricing-apply" type="button">套用收费设置到 Markdown</button>
          </div>
          <div class="admin-inline-status" id="serial-pricing-status" role="status" aria-live="polite" hidden></div>
        </section>

        <label>
          Markdown
          <textarea id="serial-markdown" name="markdown" rows="24" required spellcheck="false" placeholder="请粘贴包含 frontmatter 的完整 Markdown。"></textarea>
        </label>

        <div class="admin-preview-panel">
          <div>
            <p class="station-kicker">Import Preview</p>
            <h2>小说 Markdown 导入预览</h2>
          </div>
          <div class="button-row">
            <label class="button button-secondary admin-file-button" for="serial-file">选择 Markdown 文件</label>
            <input class="admin-file-input" id="serial-file" name="file" type="file" accept=".md,.markdown,text/markdown,text/plain" />
            <button class="button button-secondary" id="serial-parse-button" type="button">解析 Markdown</button>
            <a class="button button-secondary" href="/zh-hant/works/">查看小说页</a>
          </div>
          <div class="admin-preview" id="serial-preview">粘贴小说或章节 Markdown 后点击解析。</div>
        </div>

        <div class="button-row">
          <button class="button button-primary" id="serial-save" type="submit">保存小说 Markdown</button>
        </div>
        <div class="admin-inline-status" id="serial-save-status" role="status" aria-live="polite" hidden></div>
      </form>

      <form class="admin-panel admin-editor" id="reader-access-editor" hidden>
        <div class="admin-form-grid">
          <label>
            讀者 Email
            <input id="reader-access-email" name="email" type="email" required placeholder="reader@example.com" />
          </label>
          <label>
            seriesSlug
            <input id="reader-access-series" name="seriesSlug" required placeholder="deng-hai-liang-zhe" />
          </label>
          <label>
            授權範圍
            <select id="reader-access-scope" name="scope">
              <option value="chapter">單章</option>
              <option value="series">整本作品</option>
            </select>
          </label>
          <label>
            chapterSlug
            <input id="reader-access-chapter" name="chapterSlug" placeholder="prologue-light" />
          </label>
          <label>
            權限類型
            <select id="reader-access-level" name="accessLevel">
              <option value="paid">付費章節</option>
              <option value="supporter">支持者內容</option>
              <option value="all">全部權限</option>
            </select>
          </label>
          <label>
            到期時間
            <input id="reader-access-expires" name="expiresAt" type="datetime-local" />
          </label>
        </div>
        <label>
          備註
          <textarea id="reader-access-note" name="note" rows="4" placeholder="例如：4B 本地測試授權，或手動補發權限。"></textarea>
        </label>
        <div class="button-row">
          <button class="button button-primary" id="reader-access-save" type="submit">保存讀者授權</button>
          <button class="button button-secondary" id="reader-access-load-email" type="button">查看此 Email 權限</button>
          <a class="button button-secondary" href="/library/">查看書庫</a>
        </div>
        <div class="admin-preview" id="reader-access-preview">輸入讀者 Email 和作品 / 章節後，可以手動發放閱讀權限。</div>
        <div class="admin-inline-status" id="reader-access-save-status" role="status" aria-live="polite" hidden></div>
      </form>
    </div>
  </section>

  <script is:inline>
    const repo = {
      owner: 'xdgf558',
      name: 'caption-ai-landing-site',
      branch: 'main',
      folders: {
        devlog: 'src/content/devlog',
        serials: 'src/content/serials',
        serialChapters: 'src/content/serialChapters'
      }
    };

    const elements = {
      token: document.getElementById('admin-token'),
      load: document.getElementById('admin-load'),
      newItem: document.getElementById('admin-new'),
      status: document.getElementById('admin-status'),
      tabs: Array.from(document.querySelectorAll('[data-admin-tab]')),
      devlogListPanel: document.getElementById('devlog-list-panel'),
      serialsListPanel: document.getElementById('serials-list-panel'),
      readerAccessListPanel: document.getElementById('reader-access-list-panel'),
      devlogList: document.getElementById('admin-post-list'),
      serialSeriesList: document.getElementById('serial-series-list'),
      serialChaptersList: document.getElementById('serial-chapters-list'),
      readerEntitlementsList: document.getElementById('reader-entitlements-list'),
      devlogForm: document.getElementById('devlog-editor'),
      serialsForm: document.getElementById('serials-editor'),
      readerAccessForm: document.getElementById('reader-access-editor'),
      devlog: {
        title: document.getElementById('post-title'),
        slug: document.getElementById('post-slug'),
        date: document.getElementById('post-date'),
        statusField: document.getElementById('post-status'),
        language: document.getElementById('post-language'),
        draft: document.getElementById('post-draft'),
        description: document.getElementById('post-description'),
        tags: document.getElementById('post-tags'),
        body: document.getElementById('post-body'),
        saveButton: document.getElementById('devlog-save'),
        saveStatus: document.getElementById('devlog-save-status')
      },
      serial: {
        kind: document.getElementById('serial-kind'),
        path: document.getElementById('serial-path'),
        seriesSlug: document.getElementById('serial-series-slug'),
        chapterNumber: document.getElementById('serial-chapter-number'),
        chapterSlug: document.getElementById('serial-chapter-slug'),
        markdown: document.getElementById('serial-markdown'),
        file: document.getElementById('serial-file'),
        parseButton: document.getElementById('serial-parse-button'),
        preview: document.getElementById('serial-preview'),
        saveButton: document.getElementById('serial-save'),
        saveStatus: document.getElementById('serial-save-status'),
        pricingPanel: document.getElementById('serial-pricing-panel'),
        pricingStatus: document.getElementById('serial-pricing-status'),
        priceMode: document.getElementById('serial-price-mode'),
        freeChapters: document.getElementById('serial-free-chapters'),
        tipsEnabled: document.getElementById('serial-tips-enabled'),
        tipAmounts: document.getElementById('serial-tip-amounts'),
        tipCurrency: document.getElementById('serial-tip-currency'),
        chapterPriceAmount: document.getElementById('serial-chapter-price-amount'),
        chapterPriceCurrency: document.getElementById('serial-chapter-price-currency'),
        supporterPriceAmount: document.getElementById('serial-supporter-price-amount'),
        supporterPriceCurrency: document.getElementById('serial-supporter-price-currency'),
        bundlesEnabled: document.getElementById('serial-bundles-enabled'),
        bundleList: document.getElementById('serial-bundle-list'),
        bundleAddButton: document.getElementById('serial-bundle-add'),
        pricingApplyButton: document.getElementById('serial-pricing-apply')
      },
      readerAccess: {
        email: document.getElementById('reader-access-email'),
        seriesSlug: document.getElementById('reader-access-series'),
        scope: document.getElementById('reader-access-scope'),
        chapterSlug: document.getElementById('reader-access-chapter'),
        accessLevel: document.getElementById('reader-access-level'),
        expiresAt: document.getElementById('reader-access-expires'),
        note: document.getElementById('reader-access-note'),
        loadEmailButton: document.getElementById('reader-access-load-email'),
        preview: document.getElementById('reader-access-preview'),
        saveButton: document.getElementById('reader-access-save'),
        saveStatus: document.getElementById('reader-access-save-status')
      }
    };

    let activeContentType = 'devlog';
    const state = {
      devlog: { sha: '', path: '', slugTouched: false },
      serials: { sha: '', path: '', kind: 'series' },
      readerAccess: { lastEmail: '' }
    };

    const today = () => new Date().toISOString().slice(0, 10);

    const setStatus = (message, tone = 'neutral') => {
      elements.status.textContent = message;
      elements.status.dataset.tone = tone;
    };

    const setInlineStatus = (contentType, message, tone = 'neutral') => {
      const targets = {
        devlog: elements.devlog.saveStatus,
        serials: elements.serial.saveStatus,
        readerAccess: elements.readerAccess.saveStatus
      };
      const target = targets[contentType];
      if (!target) return;
      target.textContent = message;
      target.dataset.tone = tone;
      target.hidden = !message;
    };

    const setSaving = (contentType, isSaving) => {
      const saveLabels = {
        devlog: ['保存 Devlog', '正在保存 Devlog...'],
        serials: ['保存小说 Markdown', '正在保存小说 Markdown...'],
        readerAccess: ['保存讀者授權', '正在保存讀者授權...']
      };
      const buttons = {
        devlog: elements.devlog.saveButton,
        serials: elements.serial.saveButton,
        readerAccess: elements.readerAccess.saveButton
      };
      const button = buttons[contentType];
      if (!button) return;
      button.disabled = isSaving;
      button.textContent = isSaving ? saveLabels[contentType][1] : saveLabels[contentType][0];
    };

    const fieldLabel = (field) => {
      const label = field.closest('label');
      if (!label) return field.name || '必填字段';
      return Array.from(label.childNodes)
        .filter((node) => node.nodeType === Node.TEXT_NODE)
        .map((node) => node.textContent.trim())
        .find(Boolean) || field.name || '必填字段';
    };

    const token = () => elements.token.value.trim();

    const requireToken = () => {
      const value = token();
      if (!value) {
        throw new Error('請先輸入 GitHub token。');
      }
      return value;
    };

    const githubErrorMessage = (status, fallback) => {
      if (status === 401) return 'GitHub token 無效或已過期。請重新建立 fine-grained token。';
      if (status === 403) return 'GitHub denied access. Check that your fine-grained token has Contents: Read and write permission for this repository.';
      if (status === 404) return 'Could not find the target repository, branch, or content path.';
      if (status === 429) return 'GitHub API rate limit reached. Please wait and try again.';
      return fallback || `GitHub request failed: ${status}`;
    };

    const githubFetch = async (url, options = {}) => {
      const response = await fetch(url, {
        ...options,
        headers: {
          Accept: 'application/vnd.github+json',
          Authorization: `Bearer ${requireToken()}`,
          'X-GitHub-Api-Version': '2022-11-28',
          ...(options.headers || {})
        }
      });

      if (!response.ok) {
        const detail = await response.json().catch(() => ({}));
        const error = new Error(githubErrorMessage(response.status, detail.message));
        error.status = response.status;
        throw error;
      }

      return response.json();
    };

    const apiUrl = (path) =>
      `https://api.github.com/repos/${repo.owner}/${repo.name}/contents/${path}?ref=${repo.branch}`;

    const contentUrl = (path) =>
      `https://api.github.com/repos/${repo.owner}/${repo.name}/contents/${path}`;

    const verifyRepoAccess = async () => {
      await githubFetch(apiUrl(''));
    };

    const readContentFolder = async (folder) => {
      try {
        const files = await githubFetch(apiUrl(folder));
        return Array.isArray(files) ? files : [];
      } catch (error) {
        if (error.status === 404) {
          await verifyRepoAccess();
          return [];
        }

        throw error;
      }
    };

    const renderEmptyList = (target, message) => {
      target.innerHTML = '';
      const empty = document.createElement('p');
      empty.className = 'admin-empty-list';
      empty.textContent = message;
      target.append(empty);
    };

    const toSlug = (value, fallback = 'entry') => {
      const ascii = value
        .toLowerCase()
        .normalize('NFKD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
      return ascii || `${fallback}-${Date.now()}`;
    };

    const toBase64 = (value) => {
      const bytes = new TextEncoder().encode(value);
      let binary = '';
      bytes.forEach((byte) => {
        binary += String.fromCharCode(byte);
      });
      return btoa(binary);
    };

    const fromBase64 = (value) => {
      const binary = atob(value.replace(/\n/g, ''));
      const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
      return new TextDecoder().decode(bytes);
    };

    const yamlString = (value) => JSON.stringify(value || '');

    const splitTags = (value) =>
      value
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean);

    const parseScalar = (value) => {
      const trimmed = value.trim();
      if (trimmed === 'true') return true;
      if (trimmed === 'false') return false;
      if (trimmed === '[]') return [];
      if (/^-?\d+(\.\d+)?$/.test(trimmed)) return Number(trimmed);
      try {
        return JSON.parse(trimmed);
      } catch {
        return trimmed;
      }
    };

    const parseKeyValue = (line) => {
      const separator = line.indexOf(':');
      if (separator === -1) return null;
      return {
        key: line.slice(0, separator).trim(),
        value: line.slice(separator + 1).trim()
      };
    };

    const parseListBlock = (lines, index) => {
      const items = [];

      while (lines[index + 1]?.startsWith('  - ')) {
        index += 1;
        const itemText = lines[index].replace(/^  - /, '');
        const firstPair = parseKeyValue(itemText);

        if (firstPair) {
          const item = { [firstPair.key]: parseScalar(firstPair.value) };
          while (lines[index + 1]?.startsWith('    ')) {
            index += 1;
            const nestedPair = parseKeyValue(lines[index].trim());
            if (nestedPair) item[nestedPair.key] = parseScalar(nestedPair.value);
          }
          items.push(item);
        } else {
          items.push(parseScalar(itemText));
        }
      }

      return { items, index };
    };

    const parseMarkdown = (markdown) => {
      const match = markdown.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
      if (!match) {
        return { frontmatter: {}, body: markdown };
      }

      const frontmatter = {};
      const lines = match[1].split('\n');

      for (let index = 0; index < lines.length; index += 1) {
        const line = lines[index];
        if (line.startsWith('  ')) continue;
        const pair = parseKeyValue(line);
        if (!pair) continue;

        const { key, value } = pair;

        if (!value) {
          const listBlock = parseListBlock(lines, index);
          const items = listBlock.items;
          index = listBlock.index;
          frontmatter[key] = items;
        } else {
          frontmatter[key] = parseScalar(value);
        }
      }

      return { frontmatter, body: match[2].trim() };
    };

    const pricingFieldOrder = [
      'priceMode',
      'freeChapters',
      'tipsEnabled',
      'tipAmounts',
      'tipCurrency',
      'chapterPriceAmount',
      'chapterPriceCurrency',
      'supporterPriceAmount',
      'supporterPriceCurrency',
      'bundlePurchasesEnabled',
      'chapterBundleDiscounts'
    ];

    const pricingFieldSet = new Set(pricingFieldOrder);

    const formatYamlScalar = (value) => {
      if (typeof value === 'number') return Number.isFinite(value) ? String(value) : '0';
      if (typeof value === 'boolean') return value ? 'true' : 'false';
      return JSON.stringify(value ?? '');
    };

    const formatYamlBlock = (key, value) => {
      if (Array.isArray(value)) {
        if (!value.length) return `${key}: []`;
        const lines = [`${key}:`];
        value.forEach((item) => {
          if (item && typeof item === 'object' && !Array.isArray(item)) {
            const entries = Object.entries(item);
            if (!entries.length) return;
            const [firstKey, firstValue] = entries[0];
            lines.push(`  - ${firstKey}: ${formatYamlScalar(firstValue)}`);
            entries.slice(1).forEach(([nestedKey, nestedValue]) => {
              lines.push(`    ${nestedKey}: ${formatYamlScalar(nestedValue)}`);
            });
          } else {
            lines.push(`  - ${formatYamlScalar(item)}`);
          }
        });
        return lines.join('\n');
      }

      return `${key}: ${formatYamlScalar(value)}`;
    };

    const pricingYamlBlock = (updates) =>
      pricingFieldOrder
        .filter((key) => Object.prototype.hasOwnProperty.call(updates, key))
        .map((key) => formatYamlBlock(key, updates[key]));

    const updateMarkdownFrontmatter = (markdown, updates) => {
      const normalized = markdown.replace(/\r\n/g, '\n').trim();
      const match = normalized.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
      if (!match) throw new Error('Markdown 需要包含 YAML frontmatter。');

      const lines = match[1].split('\n');
      const output = [];
      const pricingBlocks = pricingYamlBlock(updates);
      let insertedPricing = false;

      for (let index = 0; index < lines.length; index += 1) {
        const line = lines[index];
        const pair = line.startsWith('  ') ? null : parseKeyValue(line);
        const isPricingField = pair && pricingFieldSet.has(pair.key);

        if (isPricingField) {
          if (!insertedPricing) {
            output.push(...pricingBlocks);
            insertedPricing = true;
          }
          while (lines[index + 1]?.startsWith('  ')) index += 1;
          continue;
        }

        if (!insertedPricing && pair?.key === 'latestChapterSlug') {
          output.push(...pricingBlocks);
          insertedPricing = true;
        }

        output.push(line);
      }

      if (!insertedPricing) output.push(...pricingBlocks);

      return `---\n${output.join('\n')}\n---\n\n${match[2].trim()}\n`;
    };

      const serialKindLabel = (kind) => (kind === 'chapter' ? '章节正文' : '小说资料');

      const padChapterNumber = (value) => String(Math.max(1, Number(value) || 1)).padStart(3, '0');

      const inferSerialKind = (frontmatter, fallback = 'series') => {
        if (frontmatter.chapterSlug || frontmatter.chapterNumber) return 'chapter';
        if (frontmatter.tagline || frontmatter.priceMode || frontmatter.latestChapterSlug) return 'series';
        return fallback;
      };

      const serialPathFromParts = ({ kind, seriesSlug, chapterNumber, chapterSlug }) => {
        if (kind === 'chapter') {
          return `${repo.folders.serialChapters}/${seriesSlug}-${padChapterNumber(chapterNumber)}-${chapterSlug}.md`;
        }

        return `${repo.folders.serials}/${seriesSlug}.md`;
      };

      const serialTemplate = (kind) => {
        const date = today();
        if (kind === 'chapter') {
          return `---\nseriesSlug: "novel-slug"\nchapterNumber: 1\nchapterSlug: "chapter-slug"\ntitle: "第一章：章节标题"\nexcerpt: "一到两句话概括本章，用于目录和章节页摘要。"\nstatus: "draft"\naccess: "free"\nlanguage: "zh-Hant"\nvolume: "第一卷：卷名"\nwordCount: 0\nreadingMinutes: 0\npublishedAt: ${date}\nupdatedAt: ${date}\n---\n\n这里写章节正文。\n`;
        }

        return `---\ntitle: "小说标题"\nseriesSlug: "novel-slug"\nauthor: "Station Cat"\ndescription: "一句较完整的作品介绍，用于 SEO、书架页和分享卡片。"\nsubtitle: "可选副标题"\ntagline: "更短的一句话钩子，显示在作品页和卡片上。"\nstatus: "planned"\nlanguage: "zh-Hant"\nupdateSchedule: "每周二 / 周五更新，或先写不定期。"\ntags:\n  - "Long novel"\n  - "Serial fiction"\ncoverImage: ""\ncoverLabel: "封面短标题"\ncoverAlt: "小说封面描述"\nfeatured: false\npriceMode: "free"\nfreeChapters: 3\ntipsEnabled: true\ntipAmounts:\n  - 3\n  - 5\n  - 10\ntipCurrency: "USD"\nchapterPriceAmount: 1.99\nchapterPriceCurrency: "USD"\nsupporterPriceAmount: 4.99\nsupporterPriceCurrency: "USD"\nbundlePurchasesEnabled: false\nchapterBundleDiscounts:\n  - chapters: 5\n    discountPercent: 10\n  - chapters: 10\n    discountPercent: 18\nlatestChapterSlug: ""\nlatestChapterNumber: 0\ntotalPlannedChapters: 0\navailabilityNote: "当前阶段先开放免费阅读，后续再接入打赏和付费解锁。"\npublishedAt: ${date}\nupdatedAt: ${date}\n---\n\n这里写作品简介正文。\n`;
      };

      const priceModeOptions = ['free', 'tip-optional', 'chapter-paid', 'volume-paid', 'member'];

      const normalizePositiveNumber = (value, fallback) => {
        const number = Number(value);
        return Number.isFinite(number) && number >= 0 ? Math.round(number * 100) / 100 : fallback;
      };

      const normalizePositiveInteger = (value, fallback) => {
        const number = Number(value);
        return Number.isFinite(number) && number >= 0 ? Math.round(number) : fallback;
      };

      const normalizeTipAmounts = (value) => {
        const values = Array.isArray(value)
          ? value
          : String(value || '')
            .split(',')
            .map((item) => item.trim());
        const amounts = values
          .map((item) => normalizePositiveNumber(item, 0))
          .filter((amount) => amount > 0);
        return amounts.length ? [...new Set(amounts)] : [3, 5, 10];
      };

      const normalizeBundleDiscounts = (value) => {
        const rows = Array.isArray(value) ? value : [];
        return rows
          .map((row) => ({
            chapters: normalizePositiveInteger(row?.chapters, 0),
            discountPercent: normalizePositiveNumber(row?.discountPercent, 0)
          }))
          .filter((row) => row.chapters > 1 && row.discountPercent > 0)
          .map((row) => ({
            chapters: row.chapters,
            discountPercent: Math.min(row.discountPercent, 95)
          }))
          .sort((a, b) => a.chapters - b.chapters);
      };

      const setPricingStatus = (message, tone = 'neutral') => {
        elements.serial.pricingStatus.textContent = message;
        elements.serial.pricingStatus.dataset.tone = tone;
        elements.serial.pricingStatus.hidden = !message;
      };

      const setSerialPricingVisibility = (kind) => {
        const isSeries = kind === 'series';
        elements.serial.pricingPanel.hidden = !isSeries;
        Array.from(elements.serial.pricingPanel.querySelectorAll('input, select, button')).forEach((control) => {
          control.disabled = !isSeries;
        });
      };

      const addBundleDiscountRow = ({ chapters = 5, discountPercent = 10 } = {}) => {
        const row = document.createElement('div');
        row.className = 'admin-bundle-row';
        row.dataset.bundleRow = 'true';

        const chapterLabel = document.createElement('label');
        chapterLabel.textContent = '购买章节数';
        const chapterInput = document.createElement('input');
        chapterInput.type = 'number';
        chapterInput.min = '2';
        chapterInput.step = '1';
        chapterInput.value = String(chapters);
        chapterInput.dataset.bundleChapters = 'true';
        chapterLabel.append(chapterInput);

        const discountLabel = document.createElement('label');
        discountLabel.textContent = '折扣比例 (%)';
        const discountInput = document.createElement('input');
        discountInput.type = 'number';
        discountInput.min = '1';
        discountInput.max = '95';
        discountInput.step = '1';
        discountInput.value = String(discountPercent);
        discountInput.dataset.bundleDiscount = 'true';
        discountLabel.append(discountInput);

        const removeButton = document.createElement('button');
        removeButton.className = 'button button-secondary';
        removeButton.type = 'button';
        removeButton.textContent = '移除';
        removeButton.addEventListener('click', () => {
          row.remove();
          if (!elements.serial.bundleList.querySelector('[data-bundle-row]')) {
            addBundleDiscountRow();
          }
        });

        row.append(chapterLabel, discountLabel, removeButton);
        elements.serial.bundleList.append(row);
      };

      const renderBundleDiscountRows = (discounts) => {
        elements.serial.bundleList.innerHTML = '';
        const rows = discounts.length ? discounts : [{ chapters: 5, discountPercent: 10 }];
        rows.forEach((row) => addBundleDiscountRow(row));
      };

      const syncPricingControls = (frontmatter, kind) => {
        setSerialPricingVisibility(kind);
        if (kind !== 'series') {
          setPricingStatus('');
          return;
        }

        elements.serial.priceMode.value = priceModeOptions.includes(frontmatter.priceMode) ? frontmatter.priceMode : 'free';
        elements.serial.freeChapters.value = String(normalizePositiveInteger(frontmatter.freeChapters, 0));
        elements.serial.tipsEnabled.checked = frontmatter.tipsEnabled !== false;
        elements.serial.tipAmounts.value = normalizeTipAmounts(frontmatter.tipAmounts).join(', ');
        elements.serial.tipCurrency.value = frontmatter.tipCurrency || 'USD';
        elements.serial.chapterPriceAmount.value = String(normalizePositiveNumber(frontmatter.chapterPriceAmount, 1.99));
        elements.serial.chapterPriceCurrency.value = frontmatter.chapterPriceCurrency || 'USD';
        elements.serial.supporterPriceAmount.value = String(normalizePositiveNumber(frontmatter.supporterPriceAmount, 4.99));
        elements.serial.supporterPriceCurrency.value = frontmatter.supporterPriceCurrency || 'USD';
        elements.serial.bundlesEnabled.checked = Boolean(frontmatter.bundlePurchasesEnabled);
        renderBundleDiscountRows(normalizeBundleDiscounts(frontmatter.chapterBundleDiscounts));
        setPricingStatus('收费设置已从小说 Markdown 读取。', 'success');
      };

      const pricingSettingsFromControls = () => {
        const discounts = normalizeBundleDiscounts(
          Array.from(elements.serial.bundleList.querySelectorAll('[data-bundle-row]')).map((row) => ({
            chapters: row.querySelector('[data-bundle-chapters]')?.value,
            discountPercent: row.querySelector('[data-bundle-discount]')?.value
          }))
        );

        return {
          priceMode: elements.serial.priceMode.value,
          freeChapters: normalizePositiveInteger(elements.serial.freeChapters.value, 0),
          tipsEnabled: elements.serial.tipsEnabled.checked,
          tipAmounts: normalizeTipAmounts(elements.serial.tipAmounts.value),
          tipCurrency: elements.serial.tipCurrency.value || 'USD',
          chapterPriceAmount: normalizePositiveNumber(elements.serial.chapterPriceAmount.value, 1.99),
          chapterPriceCurrency: elements.serial.chapterPriceCurrency.value || 'USD',
          supporterPriceAmount: normalizePositiveNumber(elements.serial.supporterPriceAmount.value, 4.99),
          supporterPriceCurrency: elements.serial.supporterPriceCurrency.value || 'USD',
          bundlePurchasesEnabled: elements.serial.bundlesEnabled.checked,
          chapterBundleDiscounts: discounts
        };
      };

      const applyPricingSettingsToMarkdown = ({ silent = false } = {}) => {
        const parsed = parseSerialImport({ sync: false });
        if (parsed.kind !== 'series') {
          throw new Error('收费设置只能套用到小说资料 Markdown，不能套用到章节正文。');
        }

        elements.serial.markdown.value = updateMarkdownFrontmatter(elements.serial.markdown.value, pricingSettingsFromControls());
        const updated = parseSerialImport();
        if (!silent) {
          setPricingStatus('收费设置已套用到 Markdown，可以保存。', 'success');
          setInlineStatus('serials', '收费设置已套用到 Markdown，可以保存。', 'success');
        }
        return updated;
      };

      const renderSerialPreview = ({ kind, frontmatter, path, body }) => {
        elements.serial.preview.innerHTML = '';
        elements.serial.preview.dataset.tone = 'success';

        const summary = document.createElement('div');
        summary.className = 'admin-import-summary';

        const title = document.createElement('h3');
        title.textContent = frontmatter.title || serialKindLabel(kind);

        const meta = document.createElement('p');
        meta.textContent = kind === 'chapter'
          ? `${frontmatter.seriesSlug || 'no seriesSlug'} · 第 ${frontmatter.chapterNumber || '?'} 章 · ${frontmatter.status || 'draft'} · ${frontmatter.access || 'free'}`
          : `${frontmatter.seriesSlug || 'no seriesSlug'} · ${frontmatter.status || 'planned'} · ${frontmatter.language || 'zh-Hant'} · ${frontmatter.priceMode || 'free'}`;

        const targetPath = document.createElement('code');
        targetPath.textContent = path;

        const bodyInfo = document.createElement('p');
        bodyInfo.textContent = `正文长度约 ${body.length} 个字符。`;

        summary.append(title, meta, targetPath, bodyInfo);
        elements.serial.preview.append(summary);
      };

      const parseSerialImport = ({ sync = true } = {}) => {
        const fields = elements.serial;
        const markdown = fields.markdown.value.replace(/\r\n/g, '\n').trim();
        if (!markdown) {
          throw new Error('请先粘贴小说或章节 Markdown。');
        }

        if (!markdown.startsWith('---')) {
          throw new Error('Markdown 需要包含 YAML frontmatter，并以 --- 开头。');
        }

        const { frontmatter, body } = parseMarkdown(markdown);
        if (!Object.keys(frontmatter).length) {
          throw new Error('没有解析到 frontmatter，请检查开头和结尾的 ---。');
        }

        const kind = inferSerialKind(frontmatter, fields.kind.value);
        const seriesSlug = toSlug(frontmatter.seriesSlug || fields.seriesSlug.value, 'novel-slug');
        const chapterNumber = Number(frontmatter.chapterNumber || fields.chapterNumber.value || 1);
        const chapterSlug = toSlug(frontmatter.chapterSlug || fields.chapterSlug.value || frontmatter.title, 'chapter-slug');
        const calculatedPath = serialPathFromParts({ kind, seriesSlug, chapterNumber, chapterSlug });
        const expectedFolder = kind === 'chapter' ? repo.folders.serialChapters : repo.folders.serials;
        const currentPath = fields.path.value.trim();
        const path = currentPath && currentPath.startsWith(`${expectedFolder}/`) ? currentPath : calculatedPath;

        if (sync) {
          fields.kind.value = kind;
          fields.seriesSlug.value = seriesSlug;
          fields.chapterNumber.value = kind === 'chapter' ? String(chapterNumber) : '';
          fields.chapterSlug.value = kind === 'chapter' ? chapterSlug : '';
          fields.path.value = path;
          syncPricingControls(frontmatter, kind);
        }

        const missing = kind === 'chapter'
          ? ['seriesSlug', 'chapterNumber', 'chapterSlug', 'title', 'excerpt'].filter((key) => frontmatter[key] === undefined || frontmatter[key] === '')
          : ['title', 'seriesSlug', 'description', 'tagline', 'publishedAt'].filter((key) => frontmatter[key] === undefined || frontmatter[key] === '');

        if (missing.length) {
          throw new Error(`${serialKindLabel(kind)} 缺少必要字段：${missing.join(', ')}。`);
        }

        if (!path.endsWith('.md')) {
          throw new Error('目标路径必须以 .md 结尾。');
        }

        if (!path.startsWith(`${expectedFolder}/`)) {
          throw new Error(`${serialKindLabel(kind)} 应保存到 ${expectedFolder}/。`);
        }

        const result = {
          kind,
          frontmatter,
          body,
          path,
          markdown: `${markdown}\n`,
          seriesSlug,
          chapterNumber,
          chapterSlug
        };
        renderSerialPreview(result);
        return result;
      };

    const buildDevlogMarkdown = () => {
      const fields = elements.devlog;
      const slug = fields.slug.value.trim();
      const data = {
        title: fields.title.value.trim(),
        postSlug: slug,
        description: fields.description.value.trim(),
        pubDate: fields.date.value,
        status: fields.statusField.value,
        language: fields.language.value,
        tags: splitTags(fields.tags.value),
        draft: fields.draft.checked
      };

      return `---\ntitle: ${yamlString(data.title)}\npostSlug: ${yamlString(data.postSlug)}\ndescription: ${yamlString(data.description)}\npubDate: ${yamlString(data.pubDate)}\nstatus: ${yamlString(data.status)}\nlanguage: ${yamlString(data.language)}\ntags: ${JSON.stringify(data.tags)}\ndraft: ${data.draft}\n---\n\n${fields.body.value.trim()}\n`;
    };

    const resetDevlogForm = () => {
      state.devlog = { sha: '', path: '', slugTouched: false };
      const fields = elements.devlog;
      fields.title.value = '';
      fields.slug.value = '';
      fields.date.value = today();
      fields.statusField.value = 'building';
      fields.language.value = 'zh-Hant';
      fields.draft.checked = false;
      fields.description.value = '';
      fields.tags.value = '';
      fields.body.value = '';
      setInlineStatus('devlog', '');
      setStatus('正在撰寫新 Devlog。');
    };

      const resetSerialImportForm = (kind = elements.serial.kind.value || 'series') => {
        state.serials = { sha: '', path: '', kind };
        const fields = elements.serial;
        fields.kind.value = kind;
        fields.path.value = '';
        fields.seriesSlug.value = '';
        fields.chapterNumber.value = '';
        fields.chapterSlug.value = '';
        fields.markdown.value = serialTemplate(kind);
        setInlineStatus('serials', '');
        parseSerialImport();
        if (kind !== 'series') setPricingStatus('');
        setStatus(`正在导入新的${serialKindLabel(kind)}。`);
      };

    const fillDevlogForm = ({ path, sha, markdown }) => {
      const { frontmatter, body } = parseMarkdown(markdown);
      const fields = elements.devlog;
      state.devlog = { sha, path, slugTouched: true };
      fields.title.value = frontmatter.title || '';
      fields.slug.value = frontmatter.postSlug || path.split('/').pop().replace(/\.(zh-Hant|zh-Hans|en|ja)?\.?md$/i, '');
      fields.date.value = frontmatter.pubDate || today();
      fields.statusField.value = frontmatter.status || 'note';
      fields.language.value = frontmatter.language || 'zh-Hant';
      fields.draft.checked = Boolean(frontmatter.draft);
      fields.description.value = frontmatter.description || '';
      fields.tags.value = Array.isArray(frontmatter.tags) ? frontmatter.tags.join(', ') : '';
      fields.body.value = body;
      setStatus(`已載入 Devlog：${fields.slug.value}。`, 'success');
    };

      const fillSerialImportForm = ({ path, sha, markdown }) => {
        const fields = elements.serial;
        fields.markdown.value = markdown.trim();
        const parsed = parseSerialImport();
        fields.path.value = path;
        state.serials = { sha, path, kind: parsed.kind };
        renderSerialPreview({ ...parsed, path });
        setStatus(`已载入${serialKindLabel(parsed.kind)}：${path.split('/').pop()}。`, 'success');
      };

      const setActiveContentType = (contentType) => {
        activeContentType = contentType;
        const labels = {
          devlog: {
            load: '读取 Devlog',
            newItem: '新 Devlog',
            status: '已切換到 Devlog 管理。'
          },
          serials: {
            load: '读取连载小说',
            newItem: '新小说 Markdown',
            status: '已切換到连载小说管理。'
          },
          readerAccess: {
            load: '讀取讀者授權',
            newItem: '新讀者授權',
            status: '已切換到讀者授權管理。'
          }
        };
        elements.tabs.forEach((button) => {
          const active = button.dataset.adminTab === contentType;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-selected', String(active));
        });
        elements.devlogForm.hidden = contentType !== 'devlog';
        elements.serialsForm.hidden = contentType !== 'serials';
        elements.readerAccessForm.hidden = contentType !== 'readerAccess';
        elements.devlogListPanel.hidden = contentType !== 'devlog';
        elements.serialsListPanel.hidden = contentType !== 'serials';
        elements.readerAccessListPanel.hidden = contentType !== 'readerAccess';
        elements.load.textContent = labels[contentType].load;
        elements.newItem.textContent = labels[contentType].newItem;
        setStatus(labels[contentType].status);
      };

    const renderFileButton = ({ file, target, onOpen, meta }) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'admin-post-button';
      button.innerHTML = '';
      const name = document.createElement('span');
      name.textContent = file.name.replace(/\.md$/, '');
      button.append(name);
      if (meta) {
        const small = document.createElement('small');
        small.textContent = meta;
        button.append(small);
      }
      button.addEventListener('click', onOpen);
      target.append(button);
    };

      const renderSerialListItem = ({ file, entry, markdown, kind, target }) => {
        const { frontmatter } = parseMarkdown(markdown);
        const meta = kind === 'chapter'
          ? `${frontmatter.seriesSlug || 'no seriesSlug'} · 第 ${frontmatter.chapterNumber || '?'} 章 · ${frontmatter.status || 'draft'}`
          : `${frontmatter.seriesSlug || file.name.replace(/\.md$/, '')} · ${frontmatter.status || 'planned'}`;

        renderFileButton({
          file: {
            ...file,
            name: frontmatter.title ? `${frontmatter.title}.md` : file.name
          },
          target,
          meta,
          onOpen: () => {
            fillSerialImportForm({
              path: file.path,
              sha: entry.sha,
              markdown
            });
            elements.serialsForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      };

      const apiFetch = async (url, options = {}) => {
        const response = await fetch(url, {
          ...options,
          headers: {
            'content-type': 'application/json',
            ...(options.headers || {})
          }
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.ok) {
          throw new Error(data.message || `Request failed: ${response.status}`);
        }
        return data;
      };

      const readerScopeLabel = (scope) => (scope === 'series' ? '整本作品' : '單章');

      const readerAccessLabel = (level) => {
        if (level === 'all') return '全部權限';
        if (level === 'supporter') return '支持者內容';
        return '付費章節';
      };

      const renderReaderEntitlements = (items = []) => {
        elements.readerEntitlementsList.innerHTML = '';

        if (!items.length) {
          renderEmptyList(elements.readerEntitlementsList, '目前沒有符合條件的讀者授權。');
          return;
        }

        items.forEach((item) => {
          const row = document.createElement('div');
          row.className = 'admin-file-row';

          const main = document.createElement('div');
          main.className = 'admin-file-row__main';

          const title = document.createElement('h3');
          title.textContent = `${item.email || 'reader'} · ${readerAccessLabel(item.accessLevel)}`;

          const target = document.createElement('p');
          target.textContent = item.scope === 'series'
            ? `${item.seriesSlug} · ${readerScopeLabel(item.scope)}`
            : `${item.seriesSlug} / ${item.chapterSlug} · ${readerScopeLabel(item.scope)}`;

          const meta = document.createElement('p');
          const stateText = item.revokedAt ? `已撤銷 ${item.revokedAt}` : `有效 · ${item.grantedAt || item.createdAt}`;
          meta.textContent = `${stateText}${item.expiresAt ? ` · 到期 ${item.expiresAt}` : ''}`;

          main.append(title, target, meta);

          if (item.note) {
            const note = document.createElement('p');
            note.textContent = item.note;
            main.append(note);
          }

          const actions = document.createElement('div');
          actions.className = 'admin-file-row__actions';

          const revoke = document.createElement('button');
          revoke.type = 'button';
          revoke.className = 'button button-danger';
          revoke.textContent = item.revokedAt ? '已撤銷' : '撤銷';
          revoke.disabled = Boolean(item.revokedAt);
          revoke.addEventListener('click', async () => {
            revoke.disabled = true;
            try {
              const data = await apiFetch('/admin/api/novels/entitlements/revoke', {
                method: 'POST',
                body: JSON.stringify({ id: item.id, email: elements.readerAccess.email.value.trim() })
              });
              renderReaderEntitlements(data.entitlements || []);
              setInlineStatus('readerAccess', '授權已撤銷。', 'success');
            } catch (error) {
              revoke.disabled = false;
              setInlineStatus('readerAccess', error.message, 'error');
            }
          });

          actions.append(revoke);
          row.append(main, actions);
          elements.readerEntitlementsList.append(row);
        });
      };

      const syncReaderScope = () => {
        const isSeries = elements.readerAccess.scope.value === 'series';
        elements.readerAccess.chapterSlug.disabled = isSeries;
        elements.readerAccess.chapterSlug.required = !isSeries;
        if (isSeries) elements.readerAccess.chapterSlug.value = '';
      };

      const resetReaderAccessForm = () => {
        const fields = elements.readerAccess;
        fields.email.value = fields.email.value || state.readerAccess.lastEmail || '';
        fields.seriesSlug.value = 'deng-hai-liang-zhe';
        fields.scope.value = 'chapter';
        fields.chapterSlug.value = 'prologue-light';
        fields.accessLevel.value = 'paid';
        fields.expiresAt.value = '';
        fields.note.value = '4B manual access test';
        fields.preview.textContent = '輸入讀者 Email 和作品 / 章節後，可以手動發放閱讀權限。';
        fields.preview.dataset.tone = '';
        syncReaderScope();
        setInlineStatus('readerAccess', '');
        setStatus('正在建立新的讀者授權。');
      };

      const loadReaderEntitlements = async () => {
        const email = elements.readerAccess.email.value.trim();
        state.readerAccess.lastEmail = email;
        const query = email ? `?email=${encodeURIComponent(email)}` : '';
        setStatus(email ? `正在讀取 ${email} 的授權...` : '正在讀取最近的讀者授權...');
        const data = await apiFetch(`/admin/api/novels/entitlements${query}`, {
          headers: { accept: 'application/json' }
        });
        renderReaderEntitlements(data.entitlements || []);
        setStatus(`已讀取 ${(data.entitlements || []).length} 筆讀者授權。`, 'success');
      };

      const saveReaderEntitlement = async () => {
        const fields = elements.readerAccess;
        const payload = {
          email: fields.email.value.trim(),
          seriesSlug: fields.seriesSlug.value.trim(),
          scope: fields.scope.value,
          chapterSlug: fields.chapterSlug.value.trim(),
          accessLevel: fields.accessLevel.value,
          expiresAt: fields.expiresAt.value,
          note: fields.note.value.trim()
        };

        const data = await apiFetch('/admin/api/novels/entitlements/grant', {
          method: 'POST',
          body: JSON.stringify(payload)
        });

        state.readerAccess.lastEmail = payload.email;
        renderReaderEntitlements(data.entitlements || []);
        const target = payload.scope === 'series' ? payload.seriesSlug : `${payload.seriesSlug}/${payload.chapterSlug}`;
        fields.preview.textContent = `已授權 ${payload.email} 讀取 ${target}。`;
        fields.preview.dataset.tone = 'success';
        setStatus('讀者授權已保存到 D1。', 'success');
      };

    const loadDevlogPosts = async () => {
      setStatus('正在讀取 Devlog 列表...');
      const files = await readContentFolder(repo.folders.devlog);
      elements.devlogList.innerHTML = '';

      if (!files.length) {
        renderEmptyList(elements.devlogList, `远端还没有 ${repo.folders.devlog} 目录或 Markdown 文件。你可以直接保存第一篇 Devlog。`);
        setStatus(`远端还没有 ${repo.folders.devlog} 内容；保存第一篇后会自动创建。`, 'success');
        return;
      }

      files
        .filter((file) => file.name.endsWith('.md'))
        .sort((a, b) => b.name.localeCompare(a.name))
        .forEach((file) => {
          renderFileButton({
            file,
            target: elements.devlogList,
            onOpen: async () => {
              setStatus(`正在讀取 ${file.name}...`);
              const entry = await githubFetch(apiUrl(file.path));
              fillDevlogForm({
                path: file.path,
                sha: entry.sha,
                markdown: fromBase64(entry.content)
              });
            }
          });
        });

      const count = files.filter((file) => file.name.endsWith('.md')).length;
      if (!count) {
        renderEmptyList(elements.devlogList, `远端 ${repo.folders.devlog} 目录里还没有 Markdown 文件。`);
      }

      setStatus(`已讀取 ${count} 個 Devlog 檔案。`, 'success');
    };

      const loadSerials = async () => {
        setStatus('正在读取连载小说列表...');
        const [seriesFiles, chapterFiles] = await Promise.all([
          readContentFolder(repo.folders.serials),
          readContentFolder(repo.folders.serialChapters)
        ]);
        elements.serialSeriesList.innerHTML = '';
        elements.serialChaptersList.innerHTML = '';

        const markdownSeries = seriesFiles.filter((entry) => entry.name.endsWith('.md')).sort((a, b) => a.name.localeCompare(b.name));
        const markdownChapters = chapterFiles.filter((entry) => entry.name.endsWith('.md')).sort((a, b) => a.name.localeCompare(b.name));

        if (!markdownSeries.length) {
          renderEmptyList(elements.serialSeriesList, `远端还没有 ${repo.folders.serials} Markdown 文件。保存一本小说资料后会自动创建。`);
        }

        if (!markdownChapters.length) {
          renderEmptyList(elements.serialChaptersList, `远端还没有 ${repo.folders.serialChapters} Markdown 文件。保存一章正文后会自动创建。`);
        }

        for (const file of markdownSeries) {
          const entry = await githubFetch(apiUrl(file.path));
          renderSerialListItem({
            file,
            entry,
            markdown: fromBase64(entry.content),
            kind: 'series',
            target: elements.serialSeriesList
          });
        }

        for (const file of markdownChapters) {
          const entry = await githubFetch(apiUrl(file.path));
          renderSerialListItem({
            file,
            entry,
            markdown: fromBase64(entry.content),
            kind: 'chapter',
            target: elements.serialChaptersList
          });
        }

        setStatus(`已读取 ${markdownSeries.length} 本小说资料、${markdownChapters.length} 个章节文件。`, 'success');
      };

    const saveDevlogPost = async () => {
      const fields = elements.devlog;
      const slug = fields.slug.value.trim() || `${today()}-${toSlug(fields.title.value, 'devlog')}`;
      fields.slug.value = slug;
      const language = fields.language.value;
      const filename = language === 'zh-Hant' ? `${slug}.md` : `${slug}.${language}.md`;
      const path = `${repo.folders.devlog}/${filename}`;
      const body = {
        message: `${state.devlog.sha ? 'Update' : 'Create'} devlog: ${fields.title.value.trim() || slug}`,
        content: toBase64(buildDevlogMarkdown()),
        branch: repo.branch
      };

      if (state.devlog.sha && state.devlog.path === path) {
        body.sha = state.devlog.sha;
      } else {
        const existing = await githubFetch(apiUrl(path)).catch(() => null);
        if (existing?.sha) body.sha = existing.sha;
      }

      setStatus('正在保存 Devlog 到 GitHub...');
      const result = await githubFetch(contentUrl(path), {
        method: 'PUT',
        body: JSON.stringify(body)
      });

      state.devlog = { sha: result.content.sha, path, slugTouched: true };
      setStatus('Devlog 已保存。Cloudflare Workers 會在 GitHub 更新後自動部署。', 'success');
      await loadDevlogPosts();
      setStatus('Devlog 已保存。Cloudflare Workers 會在 GitHub 更新後自動部署。', 'success');
    };

      const saveSerialMarkdown = async () => {
        const firstPass = parseSerialImport({ sync: false });
        if (firstPass.kind === 'series') {
          applyPricingSettingsToMarkdown({ silent: true });
        }
        const parsed = parseSerialImport({ sync: false });
        const path = parsed.path;
        elements.serial.path.value = path;
        const title = parsed.frontmatter.title || path.split('/').pop().replace(/\.md$/i, '');
        const body = {
          message: `${state.serials.sha && state.serials.path === path ? 'Update' : 'Import'} ${parsed.kind === 'chapter' ? 'serial chapter' : 'serial'}: ${title}`,
          content: toBase64(parsed.markdown),
          branch: repo.branch
        };

        if (state.serials.sha && state.serials.path === path) {
          body.sha = state.serials.sha;
        } else {
          const existing = await githubFetch(apiUrl(path)).catch(() => null);
          if (existing?.sha) body.sha = existing.sha;
        }

        setStatus(`正在保存${serialKindLabel(parsed.kind)}到 GitHub...`);
        const result = await githubFetch(contentUrl(path), {
          method: 'PUT',
          body: JSON.stringify(body)
        });

        state.serials = { sha: result.content.sha, path, kind: parsed.kind };
        setStatus(`${serialKindLabel(parsed.kind)}已保存。Cloudflare Workers 會在 GitHub 更新後自動部署。`, 'success');
        await loadSerials();
        setStatus(`${serialKindLabel(parsed.kind)}已保存。Cloudflare Workers 會在 GitHub 更新後自動部署。`, 'success');
      };

    elements.tabs.forEach((button) => {
      button.addEventListener('click', () => setActiveContentType(button.dataset.adminTab));
    });

      elements.load.addEventListener('click', () => {
        const actions = {
          devlog: loadDevlogPosts,
          serials: loadSerials,
          readerAccess: loadReaderEntitlements
        };
        const action = actions[activeContentType];
        action().catch((error) => setStatus(error.message, 'error'));
      });

      elements.newItem.addEventListener('click', () => {
        if (activeContentType === 'devlog') resetDevlogForm();
        else if (activeContentType === 'serials') resetSerialImportForm();
        else resetReaderAccessForm();
      });

    elements.devlog.title.addEventListener('input', () => {
      if (!state.devlog.sha && !state.devlog.slugTouched) {
        elements.devlog.slug.value = `${today()}-${toSlug(elements.devlog.title.value, 'devlog')}`;
      }
    });

    elements.devlog.slug.addEventListener('input', () => {
      state.devlog.slugTouched = true;
    });

    elements.serial.kind.addEventListener('change', () => {
      setSerialPricingVisibility(elements.serial.kind.value);
      if (!state.serials.sha) {
        resetSerialImportForm(elements.serial.kind.value);
      }
    });

    elements.serial.bundleAddButton.addEventListener('click', () => {
      addBundleDiscountRow();
      setPricingStatus('已新增一条多章折扣，保存前会写入 Markdown。');
    });

    elements.serial.pricingApplyButton.addEventListener('click', () => {
      try {
        applyPricingSettingsToMarkdown();
      } catch (error) {
        setPricingStatus(error.message, 'error');
        setInlineStatus('serials', error.message, 'error');
      }
    });

    elements.readerAccess.scope.addEventListener('change', syncReaderScope);

    elements.readerAccess.loadEmailButton.addEventListener('click', () => {
      loadReaderEntitlements().catch((error) => {
        setStatus(error.message, 'error');
        setInlineStatus('readerAccess', error.message, 'error');
      });
    });

    elements.serial.file.addEventListener('change', async () => {
      const selectedFile = elements.serial.file.files?.[0];
      if (!selectedFile) return;

      try {
        const markdown = await selectedFile.text();
        state.serials = { sha: '', path: '', kind: elements.serial.kind.value };
        elements.serial.path.value = '';
        elements.serial.markdown.value = markdown;
        parseSerialImport();
        setStatus(`已导入本地文件：${selectedFile.name}。`, 'success');
        setInlineStatus('serials', '本地 Markdown 文件已读取并解析通过，可以保存。', 'success');
      } catch (error) {
        elements.serial.preview.textContent = error.message;
        elements.serial.preview.dataset.tone = 'error';
        setInlineStatus('serials', error.message, 'error');
      } finally {
        elements.serial.file.value = '';
      }
    });

    elements.serial.parseButton.addEventListener('click', () => {
      try {
        parseSerialImport();
          setInlineStatus('serials', 'Markdown 解析通过，可以保存。', 'success');
        } catch (error) {
          elements.serial.preview.textContent = error.message;
          elements.serial.preview.dataset.tone = 'error';
          setInlineStatus('serials', error.message, 'error');
        }
      });

    elements.devlogForm.addEventListener('submit', (event) => {
      event.preventDefault();
      setInlineStatus('devlog', '正在保存 Devlog 到 GitHub...', 'neutral');
      setSaving('devlog', true);
      saveDevlogPost()
        .then(() => setInlineStatus('devlog', `Devlog 已保存。${new Date().toLocaleTimeString()}`, 'success'))
        .catch((error) => {
          setStatus(error.message, 'error');
          setInlineStatus('devlog', error.message, 'error');
        })
        .finally(() => setSaving('devlog', false));
    });

      elements.serialsForm.addEventListener('submit', (event) => {
        event.preventDefault();
        setInlineStatus('serials', '正在保存小说 Markdown 到 GitHub...', 'neutral');
        setSaving('serials', true);
        saveSerialMarkdown()
          .then(() => setInlineStatus('serials', `小说 Markdown 已保存。${new Date().toLocaleTimeString()}`, 'success'))
          .catch((error) => {
            setStatus(error.message, 'error');
            elements.serial.preview.textContent = error.message;
            elements.serial.preview.dataset.tone = 'error';
            setInlineStatus('serials', error.message, 'error');
          })
          .finally(() => setSaving('serials', false));
      });

      elements.readerAccessForm.addEventListener('submit', (event) => {
        event.preventDefault();
        setInlineStatus('readerAccess', '正在保存讀者授權到 D1...', 'neutral');
        setSaving('readerAccess', true);
        saveReaderEntitlement()
          .then(() => setInlineStatus('readerAccess', `讀者授權已保存。${new Date().toLocaleTimeString()}`, 'success'))
          .catch((error) => {
            setStatus(error.message, 'error');
            elements.readerAccess.preview.textContent = error.message;
            elements.readerAccess.preview.dataset.tone = 'error';
            setInlineStatus('readerAccess', error.message, 'error');
          })
          .finally(() => setSaving('readerAccess', false));
      });

    elements.devlogForm.addEventListener(
      'invalid',
      (event) => {
        setInlineStatus('devlog', `请先填写：${fieldLabel(event.target)}。`, 'error');
      },
      true
    );

      elements.serialsForm.addEventListener(
        'invalid',
        (event) => {
          setInlineStatus('serials', `请先填写：${fieldLabel(event.target)}。`, 'error');
        },
        true
      );

      elements.readerAccessForm.addEventListener(
        'invalid',
        (event) => {
          setInlineStatus('readerAccess', `請先填寫：${fieldLabel(event.target)}。`, 'error');
        },
        true
      );

      resetDevlogForm();
      resetSerialImportForm('series');
      resetReaderAccessForm();
      setActiveContentType('devlog');
  </script>
</BaseLayout>
