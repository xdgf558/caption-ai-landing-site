---
import { getCollection } from 'astro:content';
import BackendContentShelf from '../../components/BackendContentShelf.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { devlogCopy, devlogPath, devlogSlug, formatDevlogDate } from '../../data/devlog';

const lang = 'zh-Hant';
const copy = devlogCopy[lang];
const posts = (await getCollection('devlog', ({ data }) => !data.draft && data.language === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const staticPostSlugs = posts.map((post) => devlogSlug(post));
const backendShelfCopy = {
  empty: '目前沒有額外從後台發布的開發記錄。',
  eyebrow: '後台新發布',
  readLabel: '閱讀',
  sourceLabel: 'Admin 2.0',
  title: '從後台即時發布的開發記錄。'
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath="/devlog/"
  bodyClass="station-home"
  robots="noindex, follow"
>
  <section class="devlog-hero">
    <div class="devlog-hero__copy">
      <p class="station-kicker">{copy.eyebrow}</p>
      <h1>{copy.heroTitle}</h1>
      <p>{copy.heroDescription}</p>
    </div>
    <div class="devlog-hero__panel">
      <span>{copy.buildNotes}</span>
      <strong>{posts.length}</strong>
      <p>{copy.postCount}</p>
    </div>
  </section>

  <section class="devlog-list" aria-label={copy.postsLabel}>
    {posts.length === 0 && <p>{copy.empty}</p>}
    {posts.map((post) => (
      <article class="devlog-card">
        <div class="devlog-card__meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDevlogDate(post.data.pubDate, lang)}</time>
          <span>{copy.statuses[post.data.status]}</span>
        </div>
        <h2><a href={devlogPath(lang, devlogSlug(post))}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="devlog-tags">
            {post.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        )}
      </article>
    ))}
    <BackendContentShelf
      basePath="/devlog/"
      copy={backendShelfCopy}
      entryType="blog_post"
      existingSlugs={staticPostSlugs}
      locale={lang}
    />
  </section>
</BaseLayout>
