---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Everyday AI Apps builds simple AI lifestyle and productivity tools for everyday creativity."
  lang="en"
  canonicalPath="/about/"
>
  <section class="page-shell">
    <p class="section-kicker">About</p>
    <h1>Small AI tools for everyday creative routines.</h1>
    <p>
      Everyday AI Apps is a lightweight product home for simple AI lifestyle and productivity apps. The first product is Caption AI, a mobile app in development for turning everyday photos into share-ready captions.
    </p>
    <div class="button-row">
      <a class="button button-primary" href="/apps/caption-ai/">View Caption AI</a>
      <a class="button button-secondary" href="/apps/">Browse apps</a>
    </div>
  </section>
</BaseLayout>
