---
import { getCollection } from 'astro:content';
import BackendContentShelf from '../../../components/BackendContentShelf.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { devlogCopy, devlogLocales, devlogPath, devlogSlug, formatDevlogDate, pathLocaleToLang } from '../../../data/devlog';

export function getStaticPaths() {
  return devlogLocales
    .filter(({ lang }) => lang !== 'zh-Hant')
    .map(({ lang, pathLocale }) => ({
      params: { locale: pathLocale },
      props: { lang }
    }));
}

const { lang } = Astro.props;
const copy = devlogCopy[lang];
const posts = (await getCollection('devlog', ({ data }) => !data.draft && data.language === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const localeParam = Astro.params.locale || '';
const routeLang = pathLocaleToLang(localeParam);
const staticPostSlugs = posts.map((post) => devlogSlug(post));
const backendShelfCopy = {
  en: {
    empty: 'No backend-published dev notes are waiting outside the static list.',
    eyebrow: 'New from Admin',
    readLabel: 'Read',
    sourceLabel: 'Admin 2.0',
    title: 'New backend-published dev notes.'
  },
  ja: {
    empty: '管理画面から追加された開発ログはまだありません。',
    eyebrow: '管理画面から追加',
    readLabel: '読む',
    sourceLabel: 'Admin 2.0',
    title: '新しく公開された開発ログ。'
  },
  'zh-Hant': {
    empty: '目前沒有額外從後台發布的開發記錄。',
    eyebrow: '後台新發布',
    readLabel: '閱讀',
    sourceLabel: 'Admin 2.0',
    title: '從後台即時發布的開發記錄。'
  },
  'zh-Hans': {
    empty: '目前没有额外从后台发布的开发记录。',
    eyebrow: '后台新发布',
    readLabel: '阅读',
    sourceLabel: 'Admin 2.0',
    title: '从后台即时发布的开发记录。'
  }
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={routeLang}
  canonicalPath={devlogPath(routeLang)}
  bodyClass="station-home"
  robots="noindex, follow"
>
  <section class="devlog-hero">
    <div class="devlog-hero__copy">
      <p class="station-kicker">{copy.eyebrow}</p>
      <h1>{copy.heroTitle}</h1>
      <p>{copy.heroDescription}</p>
    </div>
    <div class="devlog-hero__panel">
      <span>{copy.buildNotes}</span>
      <strong>{posts.length}</strong>
      <p>{copy.postCount}</p>
    </div>
  </section>

  <section class="devlog-list" aria-label={copy.postsLabel}>
    {posts.length === 0 && <p>{copy.empty}</p>}
    {posts.map((post) => (
      <article class="devlog-card">
        <div class="devlog-card__meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDevlogDate(post.data.pubDate, routeLang)}</time>
          <span>{copy.statuses[post.data.status]}</span>
        </div>
        <h2><a href={devlogPath(routeLang, devlogSlug(post))}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="devlog-tags">
            {post.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        )}
      </article>
    ))}
    <BackendContentShelf
      basePath={devlogPath(routeLang)}
      copy={backendShelfCopy[routeLang]}
      entryType="blog_post"
      existingSlugs={staticPostSlugs}
      locale={routeLang}
    />
  </section>
</BaseLayout>
