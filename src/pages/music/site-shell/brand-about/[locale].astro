---
import StationBrandLayout from '../../../../layouts/StationBrandLayout.astro';
import Glyph from '../../../../components/redesign/Glyph.astro';
import { aboutCopy } from '../../../../redesign/aboutCopy.js';
import { stationHref } from '../../../../redesign/routes.js';
export function getStaticPaths() {
  return ['zh-Hant', 'zh-Hans', 'en', 'ja'].map(locale => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
const copy = aboutCopy[locale];
---
<StationBrandLayout lang={locale} title={copy.title} description={copy.intro} activeSection="about" preview>
  <section class="sc-container sc-about" aria-labelledby="sc-about-title" data-sc-brand-about>
    <p class="gentle-eyebrow">STATION CAT</p><h1 id="sc-about-title">{copy.headline}</h1>
    <p class="sc-about-intro">{copy.intro}</p><p class="sc-about-body">{copy.body}</p>
    <div class="sc-about-destinations">
      {(['music', 'games', 'member'] as const).map(section => <a href={stationHref(locale, section)} class={'sc-about-card sc-about-' + section}>
        <Glyph name={section === 'member' ? 'crown' : section} size={32} /><h2>{copy[section]}</h2><p>{copy[section + 'Text']}</p>
      </a>)}
    </div>
    <a class="sc-button sc-button-secondary" href={stationHref(locale, 'home')}>{copy.back}</a>
  </section>
</StationBrandLayout>
<style>
  .sc-about { padding-block: 56px 64px; }
  .sc-about h1 { font-size: clamp(28px, 4.5vw, 46px); line-height: 1.3; margin: 14px 0 20px; }
  .sc-about-intro { color: var(--sc-accent); font-size: 19px; line-height: 1.7; max-width: 44em; }
  .sc-about-body { color: var(--sc-muted); font-size: 16px; line-height: 1.9; max-width: 45em; }
  .sc-about-destinations { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 36px 0; }
  .sc-about-card { display: block; padding: 24px; border: 1px solid var(--sc-line); border-radius: 14px; text-decoration: none; background: #faf8ff; }
  .sc-about-music { background: #fcf3fb; } .sc-about-games { background: #eff9fd; }
  .sc-about-card h2 { margin: 15px 0 10px; font-size: 20px; line-height: 1.4; }
  .sc-about-card p { color: var(--sc-muted); font-size: 14px; line-height: 1.8; margin: 0; }
  .sc-about-card:hover { border-color: #9c94c1; }
  @media (max-width: 767px) { .sc-about { padding-block: 32px 36px; } .sc-about-destinations { grid-template-columns: 1fr; margin: 24px 0; } .sc-about-card { padding: 20px; } .sc-about-intro { font-size: 17px; } }
</style>
