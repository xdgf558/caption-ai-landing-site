---
import LegalLayout from '../../../layouts/LegalLayout.astro';
import { privatePinyinLegalNoticeEn, privatePinyinPrivacyEn } from '../../../data/legal/privatepinyin';
---

<LegalLayout
  title="PrivatePinyin Privacy Policy"
  description="Privacy policy for the PrivatePinyin iOS app, keyboard extension, and support pages."
  lang="en"
  canonicalPath="/apps/privatepinyin/privacy/"
  productLabel="PrivatePinyin"
  ogImage="/images/apps/privatepinyin-icon.png"
  notice={privatePinyinLegalNoticeEn}
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/privatepinyin/privacy/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/privatepinyin/privacy/' },
    { hrefLang: 'en', href: '/apps/privatepinyin/privacy/' },
    { hrefLang: 'ja', href: '/ja/apps/privatepinyin/privacy/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/privatepinyin/privacy/' }
  ]}
>
  <div class="legal-content">
    {privatePinyinPrivacyEn.map((section) => (
      <section><h2>{section.heading}</h2><p>{section.body}</p></section>
    ))}
  </div>
</LegalLayout>
