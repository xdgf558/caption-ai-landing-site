---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import FAQ from '../../../components/FAQ.astro';
import { privatePinyinProduct } from '../../../data/products/privatepinyin';

const items = [
  { question: 'How do I enable the keyboard?', answer: 'Open iOS Settings, go to General > Keyboard > Keyboards > Add New Keyboard, choose PrivatePinyin, and switch with the globe key. Full Access is not required.' },
  { question: 'Does the keyboard upload what I type?', answer: 'No. The keyboard extension remains offline and processes composition, candidates, correction, and learning on the device.' },
  { question: 'How do I remove local learning data?', answer: 'Open Privacy & Learning in the container app and use the clear control. Imported dictionaries can be cleared separately in Dictionary Management.' }
];
---

<ProductLayout title="PrivatePinyin Support" description="Help and privacy resources for PrivatePinyin." lang="en" canonicalPath="/apps/privatepinyin/support/" ogImage="/images/apps/privatepinyin-icon.png" alternates={[
  { hrefLang: 'zh-Hant', href: '/zh-hant/apps/privatepinyin/support/' }, { hrefLang: 'zh-Hans', href: '/zh-hans/apps/privatepinyin/support/' },
  { hrefLang: 'en', href: '/apps/privatepinyin/support/' }, { hrefLang: 'ja', href: '/ja/apps/privatepinyin/support/' },
  { hrefLang: 'x-default', href: '/zh-hant/apps/privatepinyin/support/' }
]}>
  <section class="page-shell">
    <p class="section-kicker">Support</p><h1>PrivatePinyin support.</h1>
    <p>For help or privacy questions, email <a href={`mailto:${privatePinyinProduct.supportEmail}`}>{privatePinyinProduct.supportEmail}</a> and mention PrivatePinyin.</p>
    <ul class="check-list"><li>Report keyboard activation or candidate selection problems.</li><li>Include the iOS version, device model, target app, and reproducible input.</li><li>Do not send passwords, private conversations, or other sensitive typed content.</li></ul>
    <div class="button-row"><a class="button button-primary" href={`mailto:${privatePinyinProduct.supportEmail}?subject=PrivatePinyin%20support`}>Email support</a><a class="button button-secondary" href="/apps/privatepinyin/privacy/">Privacy policy</a><a class="button button-secondary" href="/apps/privatepinyin/">Product page</a></div>
  </section><FAQ title="Frequently asked questions" items={items} />
</ProductLayout>
