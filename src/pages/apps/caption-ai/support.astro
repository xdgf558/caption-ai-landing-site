---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import FAQ from '../../../components/FAQ.astro';
import { captionAiProduct } from '../../../data/products/caption-ai';

const supportFaqEn = [
  {
    question: 'The app is not generating accurate captions. What should I do?',
    answer: 'Please send the photo type, selected style, and a short note about what felt wrong. This helps improve scene understanding and caption quality.'
  },
  {
    question: 'The photo scene detection is wrong. Can I report it?',
    answer: 'Yes. Scene detection is a current development focus, so examples of wrong breakfast, cafe, walking, pet, travel, or outfit detection are especially useful.'
  },
  {
    question: 'How do I share a caption?',
    answer: 'You can copy a generated caption or use the iOS share flow when available. SnapCopy does not automatically post to social platforms.'
  },
  {
    question: 'How do I give feedback on captions?',
    answer: 'Use the rating or feedback controls in the app when available, or email support with the caption style you expected.'
  },
  {
    question: 'How do I join the Android waitlist?',
    answer: 'Use the Android waitlist link on this website so you can receive updates when Android testing opens.'
  }
];
---

<ProductLayout
  title="SnapCopy Support"
  description="Get help with SnapCopy, send feedback, and review privacy and terms links."
  lang="en"
  canonicalPath="/apps/caption-ai/support/"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/support/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/support/' },
    { hrefLang: 'en', href: '/apps/caption-ai/support/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/support/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/support/' }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">Support</p>
    <h1>How to get help with SnapCopy.</h1>
    <p>
      For product feedback, bug reports, or waitlist deletion requests, email <a href={`mailto:${captionAiProduct.supportEmail}`}>{captionAiProduct.supportEmail}</a> and mention SnapCopy.
    </p>
    <ul class="check-list">
      <li>Report a bug or inaccurate caption result.</li>
      <li>Suggest a feature or new caption style.</li>
      <li>Ask a privacy question or request waitlist data deletion.</li>
      <li>Send TestFlight feedback when testing opens.</li>
      <li>Ask about App Store launch or Android waitlist updates.</li>
    </ul>
    <div class="button-row">
      <a class="button button-primary" href={`mailto:${captionAiProduct.supportEmail}?subject=SnapCopy%20support`}>Email support</a>
      <a class="button button-secondary" href="/apps/caption-ai/privacy/">Privacy policy</a>
      <a class="button button-secondary" href="/apps/caption-ai/terms/">Terms</a>
    </div>
  </section>
  <FAQ title="Support FAQ" items={supportFaqEn} />
</ProductLayout>
