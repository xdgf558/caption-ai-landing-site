---
import ProductLayout from '../../../layouts/ProductLayout.astro';
import WaitlistForm from '../../../components/WaitlistForm.astro';
import { captionAiProduct } from '../../../data/products/caption-ai';
---

<ProductLayout
  title="Android version coming soon"
  description="Join the SnapCopy Android updates list and help validate Android demand."
  lang="en"
  canonicalPath="/apps/caption-ai/android/"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/android/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/android/' },
    { hrefLang: 'en', href: '/apps/caption-ai/android/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/android/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/android/' }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">Android</p>
    <h1>Android version coming soon.</h1>
    <p>
      We are currently prioritizing the iOS version and exploring Android demand. Join the list and we will let you know when the Android version is ready for testing.
    </p>
    <ul class="check-list">
      <li>Hidden fields should include product=snapcopy and platform=android.</li>
      <li>The future real form can ask for country or region, social platform, and most wanted feature.</li>
      <li>No launch date is promised yet.</li>
    </ul>
  </section>
  <WaitlistForm
    id="waitlist-android"
    title="Get Android updates"
    description="Tell us you want the Android version. This helps decide when Android development should move forward."
    formUrl={captionAiProduct.platforms.android.waitlistFormUrl}
    product={captionAiProduct.id}
    locale="en"
    platform="android"
    privacyPath="/apps/caption-ai/privacy/"
    buttonLabel="Get Android updates"
  />
</ProductLayout>
