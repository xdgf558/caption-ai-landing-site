---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { captionAiProduct } from '../../data/products/caption-ai';
---

<BaseLayout
  title="Apps from Station Cat"
  description="Browse small AI tools from Station Cat, starting with Caption AI."
  lang="en"
  canonicalPath="/apps/"
>
  <section class="page-shell">
    <p class="section-kicker">Station Cat Apps</p>
    <h1>Small AI tools for everyday creativity.</h1>
    <p>
      Today the station has one app in development: Caption AI. Future products can be added here without changing the product-page structure.
    </p>
  </section>
  <section class="page-section">
    <ProductCard
      title="Caption AI"
      description="Turn everyday photos into shareable captions for breakfast, coffee, walks, pets, travel, and small lifestyle moments."
      href={captionAiProduct.productPath}
      image={captionAiProduct.assets.screenshot}
      cta="View product"
    />
  </section>
</BaseLayout>
