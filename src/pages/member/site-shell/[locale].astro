---
import ReaderLibraryPage from '../../../components/ReaderLibraryPage.astro';
export function getStaticPaths() {
  return ['zh-Hant', 'zh-Hans', 'en', 'ja'].map(lang => ({ params: { locale: lang }, props: { lang } }));
}
const { lang } = Astro.props;
---
<ReaderLibraryPage lang={lang} redesign />
