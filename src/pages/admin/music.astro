---
import { Plus, RefreshCw, ArrowLeft, ArrowRight, Save, Search, History, X, Upload, Music2 } from '@lucide/astro';
const locales = [['zh-Hans', '简体中文'], ['zh-Hant', '繁體中文'], ['en', 'English'], ['ja', '日本語']];
const kinds = [['audio', '完整音频', '.mp3,.wav', 'MP3 ≤ 32 MiB · WAV ≤ 256 MiB'], ['preview', '独立试听', '.mp3,.wav', 'MP3 ≤ 4 MiB · WAV ≤ 32 MiB'],
  ['cover', '封面', '.jpg,.jpeg,.png,.webp', 'JPEG / PNG / WebP · 最大 5 MiB'], ['lyrics', '歌词', '.txt,.lrc', 'UTF-8 TXT / LRC · 最大 128 KiB'], ['evidence', '权利凭证', '.pdf,.jpg,.jpeg,.png', 'PDF / JPEG / PNG · 最大 10 MiB']];
const rightsText = [['sourceSongId', '来源歌曲 ID'], ['authorizationBasis', '商业使用授权依据'], ['lyricsRightsNotes', '歌词权利说明'],
  ['coverRightsNotes', '封面权利说明'], ['audioInputRightsNotes', '音频输入权利说明']];
---
<!doctype html>
<html lang="zh-Hans">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow" />
  <title>音乐管理 | Station Cat</title><link rel="icon" href="/favicon.ico" /><link rel="stylesheet" href="/styles/admin-music.css" /></head>
<body class="music-admin">
<header class="music-topbar"><a href="/admin-v2/"><img src="/images/optimized/station-cat-logo-1668c2e5-160.webp" width="32" height="32" alt="" />Station Cat <span>/ 后台</span></a><div class="music-topbar-actions"><a href="/admin/music/featured/">首页推荐</a><a href="/admin/music/collections/">专辑与歌单</a><button id="analytics-open" type="button">收听统计</button><button id="audit-open" type="button"><History size={16} />操作记录</button></div></header>
<main class="music-shell">
  <header class="music-heading"><div><p class="eyebrow">内容工作区</p><h1>音乐</h1></div><button id="track-new" class="primary" type="button" disabled><Plus size={18} />新建曲目</button></header>
  <div class="music-health"><span id="environment">正在连接音乐服务</span><span id="storage">配额待查询</span></div>
  <div class="music-feedback"><p id="music-status" role="status" aria-live="polite">正在读取曲库。</p><button id="music-reload" type="button" title="重新读取服务状态" aria-label="重新读取服务状态"><RefreshCw size={17} /></button><button id="mutation-retry" type="button" hidden>核对并重试原操作</button></div>
  <div class="music-layout">
    <aside aria-label="曲目列表" class="music-library">
      <form id="search-form" role="search"><label class="sr-only" for="track-search">搜索曲目</label><input id="track-search" type="search" maxlength="120" placeholder="搜索曲名或标识" /><button type="submit" title="搜索曲目" aria-label="搜索曲目"><Search size={17} /></button></form>
      <label class="sr-only" for="track-filter">曲目状态</label><select id="track-filter"><option value="">全部状态</option><option value="draft">草稿</option><option value="published">已发布</option><option value="unpublished">已下架</option><option value="archived">已归档</option></select>
      <div id="track-list"><p class="muted">正在加载…</p></div>
      <div class="pagination"><button id="list-prev" type="button" aria-label="上一页" title="上一页" disabled><ArrowLeft size={17} /></button><span id="list-page">第 1 页</span><button id="list-next" type="button" aria-label="下一页" title="下一页" disabled><ArrowRight size={17} /></button></div>
    </aside>
    <section class="music-workspace" aria-label="曲目编辑">
      <div id="workspace-empty"><Music2 size={32} /><h2>选择一首曲目</h2><p>暂无选中的曲目。</p></div>
      <div id="workspace" hidden>
        <header class="workspace-heading"><div><h2 id="track-heading">新曲目</h2><p id="track-version" class="muted">未保存</p></div><span id="track-state" class="badge">草稿</span></header>
        <div role="tablist" aria-label="曲目工作区" class="music-tabs">
          {['基本资料', '素材', '审核发布', '角色预览'].map((name, i) => <button type="button" id={`step-${i}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${i}`} tabindex={i === 0 ? 0 : -1}>{name}</button>)}
        </div>
        <section id="panel-0" role="tabpanel" aria-labelledby="step-0">
          <form id="track-form">
            <fieldset id="metadata-fields"><div class="field-grid">
              <label>原文语言<select id="original-locale">{locales.map(([value, name]) => <option value={value}>{name}</option>)}</select></label>
              <label>署名<input id="creator-name" required maxlength="80" /></label>
              <label class="full">曲目链接标识<input id="track-slug" required maxlength="100" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="例如 evening-at-the-station" /></label>
              <label class="full">曲名<input id="track-title" required maxlength="120" /></label>
              <label class="full">简介<input id="track-summary" maxlength="500" /></label>
              <label>演唱语言<input id="track-language" required maxlength="40" placeholder="例如 中文 / 无人声" /></label>
              <label class="check"><input id="track-instrumental" type="checkbox" />纯音乐</label>
              <label>风格<input id="track-genres" placeholder="以逗号分隔" maxlength="395" /></label><label>情绪<input id="track-moods" placeholder="以逗号分隔" maxlength="395" /></label>
              <label class="full">创作故事<textarea id="track-story" maxlength="8000" rows="4"></textarea></label>
            </div>
            <details><summary>多语言曲名与简介</summary><div class="field-grid">{locales.map(([value, name]) => <div><label>{name} 曲名<input data-title-locale={value} maxlength="120" /></label><label>{name} 简介<input data-summary-locale={value} maxlength="500" /></label></div>)}</div></details>
            <h3>收听范围</h3><div class="field-grid">
              <label>访问策略<select id="access-mode"><option value="vip">VIP 专享</option><option value="free">免费精选</option><option value="early_access">VIP 抢先听</option></select></label>
              <div id="early-options" class="field-grid full" hidden><label>抢先结束时间（本地时区）<input id="early-until" type="datetime-local" step="1" /></label><label>结束后<select id="post-early"><option value="vip">VIP 专享</option><option value="free">免费精选</option></select></label></div>
            </div>
            <label id="save-reason-label">修改说明<input id="save-reason" maxlength="1000" /></label>
            <footer class="music-actions"><button id="track-save" class="primary" type="submit"><Save size={17} />保存草稿</button><span id="draft-notice" class="muted">尚未发布</span></footer></fieldset>
          </form>
        </section>
        <section id="panel-1" role="tabpanel" aria-labelledby="step-1" hidden>
          <p id="upload-availability" class="notice">保存曲目后可上传素材。</p>
          <div class="upload-rows">{kinds.map(([kind, name, accept, limit]) => <section class="upload-row" aria-label={name}>
            <header><h3>{name}</h3><span class="muted">{limit}</span></header>
            <div data-asset-kind={kind} class="asset-view"></div>
            {kind === 'preview' && <div class="field-grid"><label>原曲起点（秒）<input id="preview-start" type="number" min="0" step="0.001" value="0" /></label><label>原曲终点（秒）<input id="preview-end" type="number" min="0.001" step="0.001" /></label></div>}
            <div class="upload-control"><label class="sr-only" for={`file-${kind}`}>选择{name}文件</label><input id={`file-${kind}`} type="file" accept={accept} /><button type="button" data-upload-kind={kind}><Upload size={16} /><span>上传</span></button></div>
            {['audio', 'preview'].includes(kind) && <>
              <p class="muted wav-help">WAV 在本机转为 MP3 后上传，原文件留在你的电脑。{kind === 'audio' ? '最长 20 分钟。' : '最长 45 秒，且不得超过原曲一半；请先裁好试听。'}</p>
              <div id={`wav-progress-${kind}`} class="wav-progress" hidden>
                <label for={`wav-meter-${kind}`}>正在本机转换</label><progress id={`wav-meter-${kind}`} max="100" value="0"></progress><button id={`wav-cancel-${kind}`} type="button">取消转换</button>
              </div>
            </>}
          </section>)}</div>
          <details class="wav-formats"><summary>WAV 格式与转换说明</summary><p class="muted">支持单／双声道，32、44.1 或 48 kHz，PCM 16/24/32 位或 Float 32 位。输出 MP3 192 kbps，保留采样率与声道，不做响度归一化；浮点超出满幅会裁限，高位深会转为 16 位。其他格式请先在本机导出 MP3。</p><p class="muted">取消仅停止本机转换。进入上传后，结果不明请使用“查询并恢复”，不要另开会话。转换和上传成功仍需试听与审核。</p><a href="/vendor/music-mp3/NOTICE.txt" target="_blank" rel="noopener">LAME 编码器许可与对应源码</a></details>
          <section id="upload-recovery" hidden><h3>上传会话</h3><div id="upload-sessions"></div></section>
          <p class="muted">失败或过期的上传仍占用预留额度；目前不能自动回收。</p>
          <footer class="music-actions"><button id="assets-save" class="primary" type="button"><Save size={17} />保存素材到草稿</button><span id="assets-state" class="muted"></span></footer>
        </section>
        <section id="panel-2" role="tabpanel" aria-labelledby="step-2" hidden>
          <p id="review-state" class="notice"></p>
          <details id="rights-details"><summary>来源材料与权利核对（可选） <span id="rights-state" class="badge">未提供（可选）</span></summary>
            <p class="muted">来源材料可留空，完成试听与技术核对后即可发布。未提供或未核对不代表授权已确认；明确选择“不通过”会阻止技术核对和发布。若选择“通过”，仍需填写完整依据及凭证。</p>
            <form id="rights-form"><fieldset id="rights-fields"><div class="field-grid">
              <label>来源平台<select data-right="sourcePlatform"><option value="">请选择</option><option value="suno">Suno</option></select></label>
              <label>来源歌曲链接<input data-right="sourceSongUrl" type="url" maxlength="500" placeholder="https://suno.com/…" /></label>
              {rightsText.map(([key, label]) => <label class={key === 'sourceSongId' ? '' : 'full'}>{label}<input data-right={key} maxlength="4000" /></label>)}
              { [['generatedAt','生成时间'],['downloadedAt','下载时间'],['termsCheckedAt','条款核对时间']].map(([key,label]) => <label>{label}（本地时区）<input data-right={key} type="datetime-local" step="1" /></label>) }
              {[['planAtGeneration','生成时套餐'],['planAtDownload','下载时套餐']].map(([key,label]) => <label>{label}<select data-right={key}><option value="">请选择</option><option value="free">Free</option><option value="pro">Pro</option><option value="premier">Premier</option><option value="other">其他</option></select></label>)}
              <label>作品类型<select data-right="outputKind"><option value="">请选择</option><option value="standard">标准作品</option><option value="remix">Remix</option><option value="other">其他</option></select></label>
              <label>下载方式<select data-right="downloadMethod"><option value="">请选择</option><option value="official">官方下载</option></select></label>
              <label>授权用途<select data-right="permittedUse"><option value="">请选择</option><option value="commercial">商业使用</option></select></label>
            </div><details><summary>例外授权材料</summary><label>例外授权依据<input data-right="exceptionAuthorizationBasis" maxlength="4000" /></label><label>对应凭证<select data-right="exceptionEvidenceAssetId"><option value="">未选择</option></select></label></details>
            <p id="evidence-count" class="muted"></p>
            <label>审核结论<select id="rights-decision"><option value="pending">未核对（可选，不阻止发布）</option><option value="blocked">不通过（阻止发布）</option><option value="approved">通过</option></select></label>
            <label>审核说明<input id="rights-reason" required maxlength="1000" /></label>
            <footer class="music-actions"><button type="submit">提交权利核对</button></footer></fieldset></form>
          </details>
          <details id="technical-details"><summary>试听与技术核对 <span id="technical-state" class="badge">待核对</span></summary>
            <form id="technical-form"><fieldset id="technical-fields">
              <label class="check"><input data-tech="audioListened" type="checkbox" />已听完整音频，确认可播放且无明显损坏</label>
              <label class="check" id="check-preview"><input data-tech="previewListened" type="checkbox" />已听独立试听文件，确认可播放</label>
              <label class="check" id="check-source"><input data-tech="previewSourceConfirmed" type="checkbox" />已对照原曲，确认试听片段来源和区间正确</label>
              <label class="check" id="check-artwork"><input data-tech="artworkChecked" type="checkbox" />已查看封面，确认显示正常</label>
              <label>核对说明<input id="technical-reason" required maxlength="1000" /></label>
              <footer class="music-actions"><button type="submit">提交技术核对</button></footer>
            </fieldset></form>
          </details>
          <section class="publication"><h3>发布状态</h3><p id="publication-summary"></p><div class="music-actions"><button id="track-publish" type="button" class="primary">发布曲目</button><button id="track-unpublish" type="button">下架</button><button id="track-archive" type="button" class="danger">归档</button></div></section>
        </section>
        <section id="panel-3" role="tabpanel" aria-labelledby="step-3" hidden>
          <div id="role-preview">
            <h3>四种身份，同一首歌</h3>
            <p>对照收听按钮与会员提示。预览只展示已保存内容，不发声、不登录，也不会发布曲目。</p>
            <p data-role-unsaved class="notice" hidden>你有未保存修改。以下仍使用服务器已保存版本，编辑内容保留在原表单中。</p>
            <fieldset data-role-controls disabled><div class="field-grid">
              <label for="role-preview-revision">预览版本<select id="role-preview-revision" data-role-revision><option value="draft">已保存草稿</option><option value="published">发布版本</option></select></label>
              <label for="role-preview-locale">内容语言<select id="role-preview-locale" data-role-locale>{locales.map(([value, name]) => <option value={value}>{name}</option>)}</select></label>
              <label for="role-preview-scenario">预览场景<select id="role-preview-scenario" data-role-scenario><option value="current">当前发布状态与开关</option><option value="released">假设发布并开放公开及 VIP 播放</option></select></label>
              <label for="role-preview-time">策略时刻<select id="role-preview-time" data-role-time><option value="read">服务器读取时</option><option value="boundary" data-role-boundary>抢先结束时（模拟）</option></select></label>
            </div></fieldset>
            <p data-role-flags class="muted"></p><p data-role-notice role="status" class="notice">保存曲目后可预览四种身份的收听界面。</p>
            <div data-role-detail hidden><p data-role-policy></p><div data-role-cards class="role-cards"></div>
              <p data-role-material class="muted"></p><details><summary>已保存的创作故事</summary><p data-role-story class="role-story"></p></details>
            </div>
            <p data-role-action role="status" aria-live="polite"></p>
            <footer class="music-actions"><button data-role-refresh type="button"><RefreshCw size={16} />重新读取预览</button><button data-role-assets type="button">前往素材核对</button></footer>
            <p class="muted">这不是发布检查通过证明。素材仍需技术核对，来源材料可选；真实完整音频按听众当次资格检查。</p>
          </div>
        </section>
      </div>
    </section>
  </div>
</main>
<dialog id="confirm-dialog" aria-labelledby="confirm-title"><form method="dialog" id="confirm-form"><header><h2 id="confirm-title"></h2></header><p id="confirm-description"></p><label id="confirm-reason-label">操作说明<input id="confirm-reason" maxlength="1000" /></label><footer class="music-actions"><button value="cancel" formnovalidate>取消</button><button id="confirm-accept" value="yes" class="primary">确认</button></footer></form></dialog>
<dialog id="audit-dialog" aria-labelledby="audit-title"><header><h2 id="audit-title">操作记录</h2><button id="audit-close" type="button" aria-label="关闭操作记录" title="关闭操作记录"><X size={18} /></button></header><div id="audit-list"></div><button id="audit-next" type="button" hidden>加载更多</button></dialog>
<script src="../../scripts/adminMusic.js"></script>
<dialog id="analytics-dialog" aria-labelledby="analytics-title">
  <header><h2 id="analytics-title">收听统计</h2><button id="analytics-close" type="button" aria-label="关闭收听统计"><X size={18} /></button></header>
  <form id="analytics-form"><div class="field-grid"><label>开始日期（UTC）<input id="analytics-from" type="date" required /></label><label>结束日期（UTC）<input id="analytics-to" type="date" required /></label></div><p class="muted">每次最多查看 31 天，默认最近 7 天。</p><button id="analytics-refresh" type="submit"><RefreshCw size={16} />读取汇总</button></form>
  <p id="analytics-notice" role="status">统计尚未读取。</p>
  <table id="analytics-table" hidden><thead><tr><th>指标</th><th>音频</th><th>次数</th></tr></thead><tbody id="analytics-results"></tbody></table>
  <p class="muted">有效收听：真实累计时长达到 30 秒或音频时长的 50%，取较短者。同一统计会话、曲目与音频版本类型在 30 分钟内最多一次。自然完成还需累计收听至少 90%。这些是本站口径。</p>
  <p>会员中心到达、付费激活与续费归因：不可用。入口点击只表示意向，不代表开通或收入。</p>
</dialog>
</body></html>
