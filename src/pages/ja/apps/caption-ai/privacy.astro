---
import LegalLayout from '../../../../layouts/LegalLayout.astro';
import { legalNoticeJa, privacyJa } from '../../../../data/legal/caption-ai';
---

<LegalLayout
  title="SnapCopy プライバシーポリシー"
  description="SnapCopy アプリ、ウェブサイト、通知リスト、サポートページに関するプライバシーポリシーです。"
  lang="ja"
  canonicalPath="/ja/apps/caption-ai/privacy/"
  notice={legalNoticeJa}
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/privacy/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/privacy/' },
    { hrefLang: 'en', href: '/en/apps/caption-ai/privacy/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/privacy/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/privacy/' }
  ]}
>
  <div class="legal-content">
    {privacyJa.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        <p>{section.body}</p>
      </section>
    ))}
  </div>
</LegalLayout>
