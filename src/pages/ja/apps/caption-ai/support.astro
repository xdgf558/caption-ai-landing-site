---
import ProductLayout from '../../../../layouts/ProductLayout.astro';
import FAQ from '../../../../components/FAQ.astro';
import { captionAiProduct } from '../../../../data/products/caption-ai';
import { captionAiFaqJa } from '../../../../data/faqs/caption-ai.ja';
---

<ProductLayout
  title="Caption AI サポート"
  description="Caption AI のお問い合わせ、フィードバック、プライバシー、規約へのリンクです。"
  lang="ja"
  canonicalPath="/ja/apps/caption-ai/support/"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/support/' },
    { hrefLang: 'en', href: '/apps/caption-ai/support/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/support/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/support/' }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">Support</p>
    <h1>Caption AI のサポート。</h1>
    <p>
      フィードバック、不具合報告、先行案内メールの削除希望は、本文に Caption AI と書いて <a href={`mailto:${captionAiProduct.supportEmail}`}>{captionAiProduct.supportEmail}</a> までお送りください。
    </p>
    <div class="button-row">
      <a class="button button-primary" href={`mailto:${captionAiProduct.supportEmail}?subject=Caption%20AI%20support`}>メールする</a>
      <a class="button button-secondary" href="/ja/apps/caption-ai/privacy/">プライバシー</a>
      <a class="button button-secondary" href="/ja/apps/caption-ai/terms/">利用規約</a>
    </div>
  </section>
  <FAQ title="よくある質問" items={captionAiFaqJa} />
</ProductLayout>
