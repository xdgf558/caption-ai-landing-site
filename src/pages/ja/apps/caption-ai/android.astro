---
import ProductLayout from '../../../../layouts/ProductLayout.astro';
import WaitlistForm from '../../../../components/WaitlistForm.astro';
import { captionAiProduct } from '../../../../data/products/caption-ai';
---

<ProductLayout
  title="Android 版は準備中です"
  description="Caption AI の Android 版のお知らせを受け取れます。"
  lang="ja"
  canonicalPath="/ja/apps/caption-ai/android/"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/android/' },
    { hrefLang: 'en', href: '/apps/caption-ai/android/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/android/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/android/' }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">Android</p>
    <h1>Android 版は準備中です。</h1>
    <p>
      現在は iOS 版を優先して開発しています。Android 版の需要を確認しているため、お知らせリストに登録すると、テスト準備ができたときにご案内します。
    </p>
    <ul class="check-list">
      <li>hidden field で product=caption-ai と platform=android を記録します。</li>
      <li>将来の実フォームでは、国や地域、よく使う SNS、使いたい機能を確認できます。</li>
      <li>具体的な公開日はまだ約束しません。</li>
    </ul>
  </section>
  <WaitlistForm
    id="waitlist-android"
    title="Android 版のお知らせを受け取る"
    description="Android 版を希望する方は、こちらからお知らせを受け取れます。"
    formUrl={captionAiProduct.platforms.android.waitlistFormUrl}
    product={captionAiProduct.id}
    locale="ja"
    platform="android"
    privacyPath="/ja/apps/caption-ai/privacy/"
    buttonLabel="お知らせを受け取る"
  />
</ProductLayout>
