---
import ProductLayout from '../../../../layouts/ProductLayout.astro';
import CaptionAiLanding from '../../../../components/CaptionAiLanding.astro';
import { captionAiJa } from '../../../../data/copy/caption-ai.ja';
import { captionAiFaqJa } from '../../../../data/faqs/caption-ai.ja';
import { siteConfig } from '../../../../data/site';

const links = {
  download: '/ja/apps/caption-ai/download/?product=snapcopy&source=product-page&campaign=hero',
  platformDownload: '/ja/apps/caption-ai/download/?product=snapcopy&source=product-page&campaign=platform',
  downloadBox: '/ja/apps/caption-ai/download/?product=snapcopy&source=product-page&campaign=download-box',
  finalDownload: '/ja/apps/caption-ai/download/?product=snapcopy&source=product-page&campaign=final-cta',
  privacy: '/ja/apps/caption-ai/privacy/?product=snapcopy&source=product-page&campaign=hero-privacy',
  android: '/android/?product=snapcopy&source=product-page&campaign=android-waitlist',
  follow: siteConfig.xUrl
};
---

<ProductLayout
  title={captionAiJa.seo.title}
  description={captionAiJa.seo.description}
  lang="ja"
  canonicalPath="/ja/apps/caption-ai/"
  bodyClass="caption-product-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/' },
    { hrefLang: 'en', href: '/en/apps/caption-ai/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/' }
  ]}
>
  <CaptionAiLanding copy={captionAiJa} faqItems={captionAiFaqJa} locale="ja" links={links} />
</ProductLayout>
