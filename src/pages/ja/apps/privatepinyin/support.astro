---
import ProductLayout from '../../../../layouts/ProductLayout.astro';
import FAQ from '../../../../components/FAQ.astro';
import { privatePinyinProduct } from '../../../../data/products/privatepinyin';

const items = [
  { question: 'キーボードを有効にするには？', answer: '「設定 > 一般 > キーボード > キーボード > 新しいキーボードを追加」で猫栈ピンインを選び、地球キーで切り替えます。フルアクセスは不要です。' },
  { question: '入力内容はアップロードされますか？', answer: 'いいえ。キーボード拡張はオフラインで動作し、候補、訂正、学習は端末内で処理されます。' },
  { question: 'ローカル学習データの削除方法は？', answer: 'コンテナアプリの「プライバシーと学習」から消去できます。インポート辞書は辞書管理で個別に消去できます。' }
];
---

<ProductLayout title="猫栈ピンイン サポート" description="猫栈ピンインのヘルプ、フィードバック、プライバシー情報。" lang="ja" canonicalPath="/ja/apps/privatepinyin/support/" ogImage="/images/apps/privatepinyin-icon.png" alternates={[
  { hrefLang: 'zh-Hant', href: '/zh-hant/apps/privatepinyin/support/' }, { hrefLang: 'zh-Hans', href: '/zh-hans/apps/privatepinyin/support/' },
  { hrefLang: 'en', href: '/en/apps/privatepinyin/support/' }, { hrefLang: 'ja', href: '/ja/apps/privatepinyin/support/' },
  { hrefLang: 'x-default', href: '/zh-hant/apps/privatepinyin/support/' }
]}>
  <section class="page-shell"><p class="section-kicker">Support</p><h1>猫栈ピンイン サポート。</h1>
    <p>サポートやプライバシーの質問は <a href={`mailto:${privatePinyinProduct.supportEmail}`}>{privatePinyinProduct.supportEmail}</a> までお送りください。</p>
    <ul class="check-list"><li>キーボードの有効化、入力、候補選択の問題を報告できます。</li><li>iOS バージョン、端末、対象 App、再現入力を添えてください。</li><li>パスワードや私的な会話は送らないでください。</li></ul>
    <div class="button-row"><a class="button button-primary" href={`mailto:${privatePinyinProduct.supportEmail}?subject=PrivatePinyin%20support`}>メールを送る</a><a class="button button-secondary" href="/ja/apps/privatepinyin/privacy/">プライバシー</a><a class="button button-secondary" href="/ja/apps/privatepinyin/">製品ページ</a></div>
  </section><FAQ title="よくある質問" items={items} />
</ProductLayout>
