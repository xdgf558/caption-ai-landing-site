---
import LegalLayout from '../../../../layouts/LegalLayout.astro';
import { privatePinyinLegalNoticeJa, privatePinyinPrivacyJa } from '../../../../data/legal/privatepinyin';
---

<LegalLayout
  title="猫栈ピンイン プライバシーポリシー"
  description="猫栈ピンイン iOS App、キーボード拡張、サポートページのプライバシーポリシー。"
  lang="ja"
  canonicalPath="/ja/apps/privatepinyin/privacy/"
  productLabel="猫栈ピンイン"
  ogImage="/images/apps/privatepinyin-icon.png"
  notice={privatePinyinLegalNoticeJa}
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/privatepinyin/privacy/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/privatepinyin/privacy/' },
    { hrefLang: 'en', href: '/en/apps/privatepinyin/privacy/' },
    { hrefLang: 'ja', href: '/ja/apps/privatepinyin/privacy/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/privatepinyin/privacy/' }
  ]}
>
  <div class="legal-content">
    {privatePinyinPrivacyJa.map((section) => (
      <section><h2>{section.heading}</h2><p>{section.body}</p></section>
    ))}
  </div>
</LegalLayout>
