---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import ContentPillars from '../../components/ContentPillars.astro';
import AppCard from '../../components/AppCard.astro';
import CreatorNote from '../../components/CreatorNote.astro';
import CTASection from '../../components/CTASection.astro';

const xUrl = 'https://x.com/bketck';

const heroCards = [
  { icon: 'cat', title: 'Cats', text: '窓辺、ソファ、日常の小さな気配。' },
  { icon: 'meal', title: 'Meals', text: '朝食、コーヒー、食卓の記録。' },
  { icon: 'AI', title: 'AI Tools', text: '日常の共有を助ける小さなAIツール。' },
  { icon: 'idea', title: 'Ideas', text: '少し不思議で、でも気になるアイデア。' }
];

const pillars = [
  { icon: 'cat', title: 'Cats', description: '猫と日常の小さな相棒を記録します。' },
  { icon: 'meal', title: 'Meals', description: '朝食、食卓、コーヒー、生活の小さな場面。' },
  { icon: 'signal', title: 'Signals', description: 'テクノロジー、情報、AIの変化から見えるサイン。' },
  { icon: 'spark', title: 'Odd Ideas', description: '不思議な考え、プロダクト実験、突然のひらめき。' }
];

const experiments = [
  { icon: 'AI', title: 'AI caption generation', description: '日常写真を共有しやすい言葉に変える実験。' },
  { icon: 'local', title: 'On-device AI experiments', description: 'より軽く、よりプライベートなAI体験を探ります。' },
  { icon: 'photo', title: 'Photo understanding', description: '朝食、猫、散歩、旅の空気を読み取る方向。' },
  { icon: 'voice', title: 'Personal style learning', description: '生成結果を自分の言葉に近づけていく試み。' },
  { icon: 'lang', title: 'Multi-language sharing', description: '小さなアイデアを複数言語で共有しやすくします。' }
];
---

<BaseLayout
  title="Station Cat"
  description="猫、食卓、AIツール、少し不思議なアイデアを記録する小さな場所。"
  lang="ja"
  canonicalPath="/ja/"
  bodyClass="station-home station-landing-home"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/' },
    { hrefLang: 'en', href: '/en/' },
    { hrefLang: 'ja', href: '/ja/' },
    { hrefLang: 'x-default', href: '/' }
  ]}
>
  <HeroSection
    eyebrow="Station Cat"
    title="猫、食卓、AIツール、少し不思議なアイデアを記録する小さな場所。"
    subtitle="日常の写真をもっと楽しく共有するためのAIアプリや、個人で作っている小さなプロダクトを紹介しています。"
    ctas={[
      { label: 'アプリを見る', href: '/ja/apps/', variant: 'primary' },
      { label: 'Xでフォロー', href: xUrl, variant: 'secondary' },
      { label: 'テストに参加', href: '/ja/apps/caption-ai/download/', variant: 'ghost' }
    ]}
    cards={heroCards}
    tags={['Cats', 'Meals', 'AI Tools', 'Strange Ideas']}
    portraitSrc="/images/home/station-cat-dog.png"
    portraitAlt="Station Cat dog mascot"
  />

  <section id="about" class="station-section station-about">
    <div class="station-section__heading">
      <p class="station-kicker">What is Station Cat?</p>
      <h2>大きな会社のページではなく、個人の小さな創作ステーションです。</h2>
    </div>
    <div class="station-about__copy">
      <p>Station Cat は、猫、食卓、インターネットのサイン、AIで作る小さなツールについての場所です。</p>
      <p>あたたかく、好奇心があり、少しだけ変な個人スタジオのように育てています。</p>
    </div>
  </section>

  <ContentPillars
    eyebrow="Content pillars"
    title="ここに集まるもの"
    description="猫、食卓、AIツール、気になるサインが、夜の駅の小さな灯りのように並びます。"
    items={pillars}
  />

  <section id="apps" class="station-section">
    <div class="station-section__heading">
      <p class="station-kicker">Apps from Station Cat</p>
      <h2>日常の創作を助ける小さなツール。</h2>
      <p>ここではテスト中、またはダウンロードできるアプリへの入口をまとめています。詳しい情報は各プロダクトページにあります。</p>
    </div>
    <AppCard
      eyebrow="Current app"
      title="SnapCopy"
      subtitle="Turn everyday photos into shareable captions."
      description="朝食、コーヒー、散歩、ペット、旅行の写真から、共有しやすいキャプションを作り、少しずつ好みの表現に近づけます。"
      href="/ja/apps/caption-ai/"
      waitlistHref="/ja/apps/caption-ai/download/"
      ctaLabel="アプリを見る"
      waitlistLabel="テストに参加"
      status="First closed testing round"
    />
    <AppCard
      eyebrow="Mac app"
      title="StationCat Radar"
      subtitle="Public signals for X creators."
      description="公開情報、RSS、AI リサーチ、キーワードを追い、X 向けの投稿アイデアに整理します。"
      href="/ja/apps/stationcat-radar/"
      waitlistHref="/ja/apps/stationcat-radar/download/"
      ctaLabel="アプリを見る"
      waitlistLabel="Mac 版をダウンロード"
      status="Mac test build 0.1.0"
      image="/images/stationcat-radar-preview.svg"
      visualNote="Mac creator radar"
    />
  </section>

  <CreatorNote
    eyebrow="A note from Station Cat"
    title="小さなものも、ちゃんと言葉にしたい。"
    paragraphs={[
      '朝食の写真、窓辺の猫、散歩中に浮かんだ変な考え、投稿を少し楽にしてくれる道具。そういう小さなものが好きです。',
      'AI が日常の瞬間を表現しやすくするなら、それはただのツールではなく、静かな創作の相棒にもなります。'
    ]}
  />

  <ContentPillars
    id="experiments"
    eyebrow="Latest experiments"
    title="いま試していること"
    description="重いブログではなく、育ち始めた方向を小さく並べています。"
    items={experiments}
  />

  <CTASection
    eyebrow="Follow the build"
    title="制作の途中を見に来てください。"
    description="Station Cat はまだ育っています。猫、アプリ、AI実験、食卓、少し不思議なアイデアを共有していきます。"
    ctas={[
      { label: 'Follow on X', href: xUrl, variant: 'primary' },
      { label: 'View SnapCopy', href: '/ja/apps/caption-ai/', variant: 'secondary' },
      { label: 'Join Android Waitlist', href: '/android/', variant: 'ghost' }
    ]}
  />
</BaseLayout>
