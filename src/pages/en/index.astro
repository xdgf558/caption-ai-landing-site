---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import ContentPillars from '../../components/ContentPillars.astro';
import AppCard from '../../components/AppCard.astro';
import CreatorNote from '../../components/CreatorNote.astro';
import CTASection from '../../components/CTASection.astro';

const xUrl = 'https://x.com/bketck';

const heroCards = [
  { icon: 'cat', title: 'Cat log', text: 'Window seats, soft paws, and tiny daily opinions.' },
  { icon: 'meal', title: 'Table notes', text: 'Breakfast, coffee, meals, and small scenes worth saving.' },
  { icon: 'AI', title: 'Tool bench', text: 'Simple AI products for everyday creativity.' },
  { icon: 'idea', title: 'Odd signals', text: 'Internet signals and strange little thoughts from the walk home.' }
];

const pillars = [
  { icon: 'cat', title: 'Cats', description: 'Small companions and soft evidence that the day happened.' },
  { icon: 'meal', title: 'Meals', description: 'Breakfast, table photos, coffee, and everyday fragments.' },
  { icon: 'signal', title: 'Signals', description: 'Technology, internet shifts, markets, and AI changes worth noticing.' },
  { icon: 'spark', title: 'Odd Ideas', description: 'Weird thoughts, product experiments, and sudden little sparks.' }
];

const experiments = [
  { icon: 'AI', title: 'AI caption generation', description: 'Turning everyday photos into words that feel ready to share.' },
  { icon: 'local', title: 'On-device AI experiments', description: 'Exploring private, lightweight flows before reaching for the cloud.' },
  { icon: 'photo', title: 'Photo understanding', description: 'Reading the mood of breakfast, cats, walks, coffee, and travel.' },
  { icon: 'voice', title: 'Personal style learning', description: 'Helping drafts move closer to your own voice over time.' },
  { icon: 'lang', title: 'Multi-language sharing', description: 'Keeping small ideas portable across languages.' }
];
---

<BaseLayout
  title="Station Cat"
  description="A small creative station for cats, meals, AI tools, internet signals, and curious ideas."
  lang="en"
  canonicalPath="/en/"
  bodyClass="station-home"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/' },
    { hrefLang: 'en', href: '/en/' },
    { hrefLang: 'ja', href: '/ja/' },
    { hrefLang: 'x-default', href: '/' }
  ]}
>
  <HeroSection
    eyebrow="Station Cat"
    title="A small creative station for cats, food, AI tools, and curious ideas."
    subtitle="I make simple AI products for everyday sharing, while documenting cats, meals, internet signals, and strange little thoughts."
    ctas={[
      { label: 'Explore Apps', href: '/apps/', variant: 'primary' },
      { label: 'Follow on X', href: xUrl, variant: 'secondary' },
      { label: 'Join Waitlist', href: '/apps/caption-ai/download/', variant: 'ghost' }
    ]}
    cards={heroCards}
    tags={['Cats', 'Meals', 'AI Tools', 'Strange Ideas']}
  />

  <section id="about" class="station-section station-about">
    <div class="station-section__heading">
      <p class="station-kicker">What is Station Cat?</p>
      <h2>A personal creative station, not a big-company product page.</h2>
    </div>
    <div class="station-about__copy">
      <p>
        Station Cat is about cats, everyday meals, internet signals, and AI-made tools.
      </p>
      <p>
        It should feel like a small independent creator studio: warm, curious, useful, and just a little strange in the best way.
      </p>
    </div>
  </section>

  <ContentPillars
    eyebrow="Content pillars"
    title="What shows up here?"
    description="Cats, table notes, AI tools, and curious signals meet under a soft night-station light."
    items={pillars}
  />

  <section id="apps" class="station-section">
    <div class="station-section__heading">
      <p class="station-kicker">Apps from Station Cat</p>
      <h2>Small tools built around everyday creativity.</h2>
      <p>
        This section keeps the app entry points clear. Details, use cases, privacy notes, and download information stay on each product page.
      </p>
    </div>
    <AppCard
      eyebrow="Current app"
      title="SnapCopy"
      subtitle="Turn everyday photos into shareable captions."
      description="Take breakfast, coffee, walking, pet, or travel photos and generate social-ready captions that gradually learn your preferred style."
      href="/apps/caption-ai/"
      waitlistHref="/apps/caption-ai/download/"
      ctaLabel="View App"
      waitlistLabel="Join the Test"
      status="First closed testing round"
    />
    <AppCard
      eyebrow="Mac app"
      title="StationCat Radar"
      subtitle="Public signals for X creators."
      description="Track public sources, RSS, AI research, and keyword pools, then turn useful signals into clearer X content angles."
      href="/apps/stationcat-radar/"
      waitlistHref="/apps/stationcat-radar/download/"
      ctaLabel="View App"
      waitlistLabel="Download for Mac"
      status="Mac test build 0.1.0"
      image="/images/stationcat-radar-preview.svg"
      visualNote="Mac creator radar"
    />
  </section>

  <CreatorNote
    eyebrow="A note from Station Cat"
    title="Small things are worth sharing well."
    paragraphs={[
      'I like small things that make everyday life easier to share: a good breakfast photo, a cat sitting near the window, a weird thought that appears during a walk, or a tool that helps you post without overthinking.',
      'If AI can help people express those moments with less friction, it becomes more than software. It becomes a quiet creative companion.'
    ]}
  />

  <ContentPillars
    id="experiments"
    eyebrow="Latest experiments"
    title="What is being tested"
    description="No heavy blog system yet. Just a small board for directions that are starting to grow."
    items={experiments}
  />

  <CTASection
    eyebrow="Follow the build"
    title="Follow the build."
    description="Station Cat is still evolving. Follow along for cats, apps, AI experiments, and strange ideas."
    ctas={[
      { label: 'Follow on X', href: xUrl, variant: 'primary' },
      { label: 'View SnapCopy', href: '/apps/caption-ai/', variant: 'secondary' },
      { label: 'Join Android Waitlist', href: '/android/', variant: 'ghost' }
    ]}
  />
</BaseLayout>
