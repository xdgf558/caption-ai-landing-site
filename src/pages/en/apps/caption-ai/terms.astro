---
import LegalLayout from '../../../../layouts/LegalLayout.astro';
import { legalNoticeEn, termsEn } from '../../../../data/legal/caption-ai';
---

<LegalLayout
  title="SnapCopy Terms of Service"
  description="Terms of service for SnapCopy app, website, update lists, and support pages."
  lang="en"
  canonicalPath="/en/apps/caption-ai/terms/"
  notice={legalNoticeEn}
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/terms/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/terms/' },
    { hrefLang: 'en', href: '/en/apps/caption-ai/terms/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/terms/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/terms/' }
  ]}
>
  <div class="legal-content">
    {termsEn.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        <p>{section.body}</p>
      </section>
    ))}
  </div>
</LegalLayout>
