---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Android"
  description="Android updates entry point for SnapCopy."
  lang="en"
  canonicalPath="/android/"
>
  <section class="page-shell">
    <p class="section-kicker">Android</p>
    <h1>Android waitlist for SnapCopy.</h1>
    <p>
      SnapCopy is being developed for iPhone first. Android interest is being collected while the iOS version is tested and improved.
    </p>
    <div class="button-row">
      <a class="button button-primary" href="/en/apps/caption-ai/android/?product=snapcopy&source=android-page&campaign=android-waitlist">Join Android Waitlist</a>
      <a class="button button-secondary" href="/en/apps/caption-ai/download/?product=snapcopy&source=android-page&campaign=ios-waitlist">Join iOS Waitlist</a>
    </div>
  </section>
</BaseLayout>
