---
import { getCollection, render } from 'astro:content';
import SerialChapterPage from '../../../../components/SerialChapterPage.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getPublishedChapters, getVisibleSerials, serialsCopy } from '../../../../data/serials';

export async function getStaticPaths() {
  const serials = getVisibleSerials(await getCollection('serials'));
  const serialMap = new Map(serials.map((serial) => [serial.data.seriesSlug, serial]));
  const chapters = await getCollection('serialChapters');

  return chapters
    .filter((chapter) => chapter.data.status === 'published' && serialMap.has(chapter.data.seriesSlug))
    .map((chapter) => ({
      params: { series: chapter.data.seriesSlug, chapter: chapter.data.chapterSlug },
      props: { chapter, serial: serialMap.get(chapter.data.seriesSlug) }
    }));
}

const locale = 'zh-Hant';
const basePath = '/zh-hant/works/';
const copy = serialsCopy[locale];
const { chapter, serial } = Astro.props;
const chapterList = getPublishedChapters(await getCollection('serialChapters'), serial.data.seriesSlug);
const currentIndex = chapterList.findIndex((entry) => entry.slug === chapter.slug);
const previousChapter = currentIndex > 0 ? chapterList[currentIndex - 1] : undefined;
const nextChapter = currentIndex >= 0 ? chapterList[currentIndex + 1] : undefined;
const { Content } = await render(chapter);
---

<BaseLayout
  title={`${chapter.data.title} | ${serial.data.title}`}
  description={chapter.data.excerpt}
  lang="zh-Hant"
  canonicalPath={`${basePath}${serial.data.seriesSlug}/${chapter.data.chapterSlug}/`}
  bodyClass="station-home"
  alternates={[
    { hrefLang: 'zh-Hant', href: `/zh-hant/works/${serial.data.seriesSlug}/${chapter.data.chapterSlug}/` },
    { hrefLang: 'zh-Hans', href: `/zh-hans/works/${serial.data.seriesSlug}/${chapter.data.chapterSlug}/` },
    { hrefLang: 'en', href: `/works/${serial.data.seriesSlug}/${chapter.data.chapterSlug}/` },
    { hrefLang: 'ja', href: `/ja/works/${serial.data.seriesSlug}/${chapter.data.chapterSlug}/` },
    { hrefLang: 'x-default', href: `/zh-hant/works/${serial.data.seriesSlug}/${chapter.data.chapterSlug}/` }
  ]}
>
  <SerialChapterPage
    basePath={basePath}
    chapter={chapter}
    chapterList={chapterList}
    copy={copy}
    locale={locale}
    nextChapter={nextChapter}
    previousChapter={previousChapter}
    serial={serial}
    Content={Content}
  />
</BaseLayout>
