---
import LegalLayout from '../../../../layouts/LegalLayout.astro';
import { legalNoticeZhHant, termsZhHant } from '../../../../data/legal/caption-ai';
---

<LegalLayout
  title="SnapCopy 服務條款"
  description="SnapCopy App、網站、通知名單與支援頁面的服務條款。"
  lang="zh-Hant"
  canonicalPath="/zh-hant/apps/caption-ai/terms/"
  notice={legalNoticeZhHant}
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/terms/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/terms/' },
    { hrefLang: 'en', href: '/apps/caption-ai/terms/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/terms/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/terms/' }
  ]}
>
  <div class="legal-content">
    {termsZhHant.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        <p>{section.body}</p>
      </section>
    ))}
  </div>
</LegalLayout>
