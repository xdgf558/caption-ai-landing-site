---
import ProductLayout from '../../../../layouts/ProductLayout.astro';
import CaptionAiLanding from '../../../../components/CaptionAiLanding.astro';
import { captionAiZhHant } from '../../../../data/copy/caption-ai.zh-Hant';
import { captionAiFaqZhHant } from '../../../../data/faqs/caption-ai.zh-Hant';

const links = {
  download: '/zh-hant/apps/caption-ai/download/?product=snapcopy&source=product-page&campaign=hero',
  platformDownload: '/zh-hant/apps/caption-ai/download/?product=snapcopy&source=product-page&campaign=platform',
  downloadBox: '/zh-hant/apps/caption-ai/download/?product=snapcopy&source=product-page&campaign=download-box',
  finalDownload: '/zh-hant/apps/caption-ai/download/?product=snapcopy&source=product-page&campaign=final-cta',
  privacy: '/zh-hant/apps/caption-ai/privacy/?product=snapcopy&source=product-page&campaign=hero-privacy',
  android: '/android/?product=snapcopy&source=product-page&campaign=android-waitlist',
  follow: 'https://x.com/bketck'
};
---

<ProductLayout
  title={captionAiZhHant.seo.title}
  description={captionAiZhHant.seo.description}
  lang="zh-Hant"
  canonicalPath="/zh-hant/apps/caption-ai/"
  bodyClass="caption-product-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/' },
    { hrefLang: 'en', href: '/en/apps/caption-ai/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/' }
  ]}
>
  <CaptionAiLanding copy={captionAiZhHant} faqItems={captionAiFaqZhHant} locale="zh-Hant" links={links} />
</ProductLayout>
