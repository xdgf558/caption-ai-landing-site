---
import ProductLayout from '../../../../layouts/ProductLayout.astro';
import FAQ from '../../../../components/FAQ.astro';
import { captionAiProduct } from '../../../../data/products/caption-ai';

const supportFaqZhHant = [
  {
    question: 'App 生成的文案不夠準確怎麼辦？',
    answer: '請寄來照片類型、選擇的語氣，以及你覺得不準確的地方。這些回饋會幫助改善場景理解和文案品質。'
  },
  {
    question: '照片場景辨識錯了，可以回報嗎？',
    answer: '可以。場景辨識是目前的開發重點，早餐、咖啡、散步、寵物、旅行或穿搭等辨識錯誤範例都很有幫助。'
  },
  {
    question: '我要怎麼分享文案？',
    answer: '你可以複製生成的文案，或在功能開放後使用 iOS 分享流程。SnapCopy 不會自動幫你發布到社交平台。'
  },
  {
    question: '我要怎麼給文案回饋？',
    answer: '功能開放後可以使用 App 內的評分或回饋控制，也可以寄信說明你期待的文案風格。'
  },
  {
    question: '如何加入 Android 等待名單？',
    answer: '可以使用網站上的 Android 等待名單連結，後續 Android 測試開放時會收到更新。'
  }
];
---

<ProductLayout
  title="SnapCopy 支援"
  description="取得 SnapCopy 協助、寄送回饋，並查看隱私政策與服務條款連結。"
  lang="zh-Hant"
  canonicalPath="/zh-hant/apps/caption-ai/support/"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/support/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/support/' },
    { hrefLang: 'en', href: '/apps/caption-ai/support/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/support/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/support/' }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">Support</p>
    <h1>SnapCopy 支援。</h1>
    <p>
      若要寄送產品回饋、問題回報或等待名單刪除請求，請寄信到 <a href={`mailto:${captionAiProduct.supportEmail}`}>{captionAiProduct.supportEmail}</a>，並註明 SnapCopy。
    </p>
    <ul class="check-list">
      <li>回報錯誤或不準確的文案結果。</li>
      <li>建議功能或新的文案風格。</li>
      <li>詢問隱私問題，或要求刪除等待名單資料。</li>
      <li>寄送 App 使用回饋，或分享需要改善的範例。</li>
      <li>詢問 App Store 下載或 Android 通知名單更新。</li>
    </ul>
    <div class="button-row">
      <a class="button button-primary" href={`mailto:${captionAiProduct.supportEmail}?subject=SnapCopy%20support`}>寄信給支援</a>
      <a class="button button-secondary" href="/zh-hant/apps/caption-ai/privacy/">隱私政策</a>
      <a class="button button-secondary" href="/zh-hant/apps/caption-ai/terms/">服務條款</a>
    </div>
  </section>
  <FAQ title="支援常見問題" items={supportFaqZhHant} />
</ProductLayout>
