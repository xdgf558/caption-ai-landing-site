---
import LegalLayout from '../../../../layouts/LegalLayout.astro';
import { legalNoticeZhHant, privacyZhHant } from '../../../../data/legal/caption-ai';
---

<LegalLayout
  title="SnapCopy 隱私政策"
  description="SnapCopy 等待名單、網站與未來 App 資料處理的隱私政策草案。"
  lang="zh-Hant"
  canonicalPath="/zh-hant/apps/caption-ai/privacy/"
  notice={legalNoticeZhHant}
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/privacy/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/privacy/' },
    { hrefLang: 'en', href: '/apps/caption-ai/privacy/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/privacy/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/privacy/' }
  ]}
>
  <div class="legal-content">
    {privacyZhHant.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        <p>{section.body}</p>
      </section>
    ))}
  </div>
</LegalLayout>
