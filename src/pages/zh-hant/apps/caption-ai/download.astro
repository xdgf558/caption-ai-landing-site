---
import ProductLayout from '../../../../layouts/ProductLayout.astro';
import WaitlistForm from '../../../../components/WaitlistForm.astro';
import DownloadButtons from '../../../../components/DownloadButtons.astro';
import UseCaseSection from '../../../../components/UseCaseSection.astro';
import { captionAiProduct } from '../../../../data/products/caption-ai';
import { captionAiZhHant } from '../../../../data/copy/caption-ai.zh-Hant';
---

<ProductLayout
  title="SnapCopy 第一輪封閉測試"
  description="SnapCopy 已經進入第一輪封閉測試。需要測試名額的使用者，可以點擊參與測試。"
  lang="zh-Hant"
  canonicalPath="/zh-hant/apps/caption-ai/download/"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/download/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/download/' },
    { hrefLang: 'en', href: '/apps/caption-ai/download/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/download/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/download/' }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">Download</p>
    <h1>SnapCopy 已進入第一輪封閉測試。</h1>
    <p>
      需要測試名額的使用者，請點擊下面的「參與測試」。
    </p>
    <div class="button-row">
      <a class="button button-primary" href="#waitlist-ios">參與測試</a>
      <a class="button button-secondary" href="/android/?product=snapcopy&source=download-page&campaign=android-waitlist">取得 Android 通知</a>
    </div>
  </section>
  <DownloadButtons
    ios={captionAiProduct.platforms.ios}
    android={captionAiProduct.platforms.android}
    locale="zh-Hant"
    iosWaitlistHref="#waitlist-ios"
    androidWaitlistHref="/android/?product=snapcopy&source=download-page&campaign=android-waitlist"
  />
  <WaitlistForm
    id="waitlist-ios"
    title="參與 iOS 封閉測試"
    description="填寫 Email 後，如果本輪仍有測試名額，系統會提供 TestFlight 測試入口。"
    formUrl={captionAiProduct.platforms.ios.waitlistFormUrl}
    product={captionAiProduct.id}
    locale="zh-Hant"
    platform="ios"
    privacyPath="/zh-hant/apps/caption-ai/privacy/"
    buttonLabel="參與測試"
    source="download-page"
  />
  <UseCaseSection title="圍繞日常分享而設計" scenes={captionAiZhHant.scenes} />
</ProductLayout>
