---
import ProductLayout from '../../../../layouts/ProductLayout.astro';
import WaitlistForm from '../../../../components/WaitlistForm.astro';
import { captionAiProduct } from '../../../../data/products/caption-ai';
---

<ProductLayout
  title="Android 版本即将推出"
  description="加入 SnapCopy Android 通知名单，协助验证 Android 需求。"
  lang="zh-Hans"
  canonicalPath="/zh-hans/apps/caption-ai/android/"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/android/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/android/' },
    { hrefLang: 'en', href: '/apps/caption-ai/android/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/android/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/android/' }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">Android</p>
    <h1>Android 版本即将推出。</h1>
    <p>
      目前优先开发 iOS 版本，同时也在评估 Android 需求。加入名单后，Android 版本准备测试时我们会发送通知。
    </p>
    <ul class="check-list">
      <li>hidden field 会包含 product=snapcopy 和 platform=android。</li>
      <li>未来正式表单可选填国家或地区、常用社交平台和最想使用的功能。</li>
      <li>目前不承诺具体上线日期。</li>
    </ul>
  </section>
  <WaitlistForm
    id="waitlist-android"
    title="接收 Android 版本通知"
    description="告诉我们你想使用 Android 版本，这会帮助判断后续开发优先顺序。"
    formUrl={captionAiProduct.platforms.android.waitlistFormUrl}
    product={captionAiProduct.id}
    locale="zh-Hans"
    platform="android"
    privacyPath="/zh-hans/apps/caption-ai/privacy/"
    buttonLabel="接收 Android 通知"
  />
</ProductLayout>
