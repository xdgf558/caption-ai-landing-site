---
import ProductLayout from '../../../../layouts/ProductLayout.astro';
import WaitlistForm from '../../../../components/WaitlistForm.astro';
import DownloadButtons from '../../../../components/DownloadButtons.astro';
import UseCaseSection from '../../../../components/UseCaseSection.astro';
import { captionAiProduct } from '../../../../data/products/caption-ai';
import { captionAiZhHans } from '../../../../data/copy/caption-ai.zh-Hans';
---

<ProductLayout
  title="SnapCopy 第一轮封闭测试"
  description="SnapCopy 已经进入第一轮封闭测试。需要测试名额的用户，可以点击参与测试。"
  lang="zh-Hans"
  canonicalPath="/zh-hans/apps/caption-ai/download/"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/caption-ai/download/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/caption-ai/download/' },
    { hrefLang: 'en', href: '/apps/caption-ai/download/' },
    { hrefLang: 'ja', href: '/ja/apps/caption-ai/download/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/caption-ai/download/' }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">Download</p>
    <h1>SnapCopy 已进入第一轮封闭测试。</h1>
    <p>
      需要测试名额的用户，请点击下面的「参与测试」。
    </p>
    <div class="button-row">
      <a class="button button-primary" href="#waitlist-ios">参与测试</a>
      <a class="button button-secondary" href="/android/?product=snapcopy&source=download-page&campaign=android-waitlist">获取 Android 通知</a>
    </div>
  </section>
  <DownloadButtons
    ios={captionAiProduct.platforms.ios}
    android={captionAiProduct.platforms.android}
    locale="zh-Hans"
    iosWaitlistHref="#waitlist-ios"
    androidWaitlistHref="/android/?product=snapcopy&source=download-page&campaign=android-waitlist"
  />
  <WaitlistForm
    id="waitlist-ios"
    title="参与 iOS 封闭测试"
    description="填写 Email 后，如果本轮仍有测试名额，系统会提供 TestFlight 测试入口。"
    formUrl={captionAiProduct.platforms.ios.waitlistFormUrl}
    product={captionAiProduct.id}
    locale="zh-Hans"
    platform="ios"
    privacyPath="/zh-hans/apps/caption-ai/privacy/"
    buttonLabel="参与测试"
    source="download-page"
  />
  <UseCaseSection title="围绕日常分享而设计" scenes={captionAiZhHans.scenes} />
</ProductLayout>
