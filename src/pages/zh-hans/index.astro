---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import ContentPillars from '../../components/ContentPillars.astro';
import AppCard from '../../components/AppCard.astro';
import CreatorNote from '../../components/CreatorNote.astro';
import CTASection from '../../components/CTASection.astro';

const xUrl = 'https://x.com/bketck';

const heroCards = [
  { icon: 'cat', title: 'Cat log', text: '窗边、沙发和一些很有主见的小动静。' },
  { icon: 'meal', title: 'Table notes', text: '早餐、咖啡、饭桌，以及每天值得记下的一口。' },
  { icon: 'AI', title: 'Tool bench', text: '把 AI 做成更轻、更日常的创作工具。' },
  { icon: 'idea', title: 'Odd signals', text: '资讯、灵感和暂时看起来有点奇怪的想法。' }
];

const pillars = [
  { icon: 'cat', title: 'Cats', description: '记录猫咪和日常里的小陪伴。' },
  { icon: 'meal', title: 'Meals', description: '早餐、饭桌、咖啡和生活里的小片段。' },
  { icon: 'signal', title: 'Signals', description: '关注科技、资讯、市场和 AI 变化里的信号。' },
  { icon: 'spark', title: 'Odd Ideas', description: '一些奇怪想法、产品实验和突然冒出来的灵感。' }
];

const experiments = [
  { icon: 'AI', title: 'AI caption generation', description: '让日常照片更快变成适合分享的文字。' },
  { icon: 'local', title: 'On-device AI experiments', description: '优先探索更私密、更轻量的本地 AI 流程。' },
  { icon: 'photo', title: 'Photo understanding', description: '理解早餐、猫、咖啡、散步和旅途里的情绪。' },
  { icon: 'voice', title: 'Personal style learning', description: '让生成结果慢慢靠近自己的语气。' },
  { icon: 'lang', title: 'Multi-language sharing', description: '支持跨语言分享，不把灵感卡在一种语言里。' }
];
---

<BaseLayout
  title="Station Cat"
  description="Station Cat 是一个记录猫咪、饭桌、资讯、AI 创作和奇怪想法的个人创作小站。"
  lang="zh-Hans"
  canonicalPath="/zh-hans/"
  bodyClass="station-home"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/' },
    { hrefLang: 'en', href: '/en/' },
    { hrefLang: 'ja', href: '/ja/' },
    { hrefLang: 'x-default', href: '/' }
  ]}
>
  <HeroSection
    eyebrow="Station Cat"
    title="一个记录猫咪、饭桌、资讯和奇怪想法的小站。"
    subtitle="这里会放我的 AI 创作、生活记录、产品实验和正在开发的 App。如果你也喜欢猫、日常分享、AI 工具和一点点奇怪的灵感，欢迎常来看看。"
    ctas={[
      { label: '查看正在开发的 App', href: '/zh-hans/apps/caption-ai/', variant: 'primary' },
      { label: '关注我的 X', href: xUrl, variant: 'secondary' },
      { label: '加入等待名单', href: '/zh-hans/apps/caption-ai/download/', variant: 'ghost' }
    ]}
    cards={heroCards}
    tags={['Cats', 'Meals', 'AI Tools', 'Strange Ideas']}
  />

  <section id="about" class="station-section station-about">
    <div class="station-section__heading">
      <p class="station-kicker">What is Station Cat?</p>
      <h2>不是冷冰冰的产品官网，更像一个个人创作小站。</h2>
    </div>
    <div class="station-about__copy">
      <p>Station Cat 会记录猫咪、饭桌、资讯、AI 创作，以及一些暂时看起来奇怪但可能有趣的想法。</p>
      <p>这里也会发布我自己做的小工具。它们不一定很大，但会围绕日常表达、分享和创作慢慢长出来。</p>
    </div>
  </section>

  <ContentPillars
    eyebrow="Content pillars"
    title="这个小站会持续收集什么？"
    description="猫、饭桌、资讯信号和 AI 工具会在这里交会，像夜间车站里一盏还亮着的小灯。"
    items={pillars}
  />

  <section id="apps" class="station-section">
    <div class="station-section__heading">
      <p class="station-kicker">Apps from Station Cat</p>
      <h2>围绕日常创作做的小 AI 工具。</h2>
      <p>首个产品是 SnapCopy。首页只放入口和方向，真正的功能、场景、隐私和等待名单会留在产品页。</p>
    </div>
    <AppCard
      eyebrow="Current app"
      title="SnapCopy"
      subtitle="Turn everyday photos into shareable captions."
      description="拍下早餐、咖啡、散步、宠物或旅行场景，生成适合社交平台分享的文案，并逐渐学习你的表达偏好。"
      href="/zh-hans/apps/caption-ai/"
      waitlistHref="/zh-hans/apps/caption-ai/download/"
      ctaLabel="查看 App"
      waitlistLabel="加入等待名单"
      status="第一款开发中 App"
    />
  </section>

  <CreatorNote
    eyebrow="A note from Station Cat"
    title="小东西也值得被好好表达。"
    paragraphs={[
      '我喜欢记录一些很小但真实的东西：一顿早餐，一只猫，一个散步时看到的场景，一条突然冒出来的想法。',
      '如果 AI 能帮人更轻松地表达这些瞬间，那它就不只是工具，也可以变成一种创作陪伴。'
    ]}
  />

  <ContentPillars
    id="experiments"
    eyebrow="Latest experiments"
    title="正在实验的方向"
    description="目前不做复杂博客系统，先把正在长出来的想法放在这里。"
    items={experiments}
  />

  <CTASection
    eyebrow="Follow the build"
    title="跟着这个小站一起长大。"
    description="Station Cat 还在演化。这里会继续出现猫、App、AI 实验、饭桌和一些奇怪但有趣的想法。"
    ctas={[
      { label: 'Follow on X', href: xUrl, variant: 'primary' },
      { label: 'View SnapCopy', href: '/zh-hans/apps/caption-ai/', variant: 'secondary' },
      { label: 'Join Android Waitlist', href: '/android/', variant: 'ghost' }
    ]}
  />
</BaseLayout>
