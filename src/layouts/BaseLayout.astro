---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site';
import '../styles/global.css';

interface AlternateLink {
  hrefLang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
  canonicalPath?: string;
  ogImage?: string;
  robots?: string;
  alternates?: AlternateLink[];
  bodyClass?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  lang = 'zh-Hant',
  canonicalPath = Astro.url.pathname,
  ogImage = siteConfig.ogImage,
  robots = '',
  alternates = [],
  bodyClass,
  structuredData = []
} = Astro.props;

const fullTitle = title.includes(siteConfig.name)
  ? title
  : `${title} | ${siteConfig.name}`;
const canonicalUrl = new URL(canonicalPath, siteConfig.baseUrl).toString();
const ogImageUrl = new URL(ogImage, siteConfig.baseUrl).toString();
const usesDefaultOgImage = ogImage === siteConfig.ogImage;
const isAdminPage = Astro.url.pathname.startsWith('/admin');
const shouldUsePaperTheme = !isAdminPage && !bodyClass?.includes('station-home-v2');
const resolvedBodyClass = [
  isAdminPage ? 'admin-page' : '',
  shouldUsePaperTheme ? 'station-paper-page' : '',
  bodyClass
].filter(Boolean).join(' ');
const structuredDataScripts = (Array.isArray(structuredData) ? structuredData : [structuredData])
  .filter((entry) => entry && typeof entry === 'object')
  .map((entry) => JSON.stringify(entry).replace(/</g, '\\u003c'));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hrefLang} href={new URL(alternate.href, siteConfig.baseUrl).toString()} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {usesDefaultOgImage && <meta property="og:image:type" content="image/png" />}
    {usesDefaultOgImage && <meta property="og:image:width" content="1200" />}
    {usesDefaultOgImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={`${fullTitle} social preview`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {structuredDataScripts.map((script) => <script type="application/ld+json" set:html={script} />)}
  </head>
  <body class={resolvedBodyClass}>
    <a class="skip-link" href="#main">{lang === 'ja' ? '本文へ移動' : lang === 'zh-Hant' ? '跳到主要內容' : lang === 'zh-Hans' ? '跳到主要内容' : 'Skip to content'}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
