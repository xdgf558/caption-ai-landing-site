---
import ProductLayout from './ProductLayout.astro';
import LegalNotice from '../components/LegalNotice.astro';

interface AlternateLink {
  hrefLang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
  canonicalPath: string;
  notice: string;
  alternates?: AlternateLink[];
  productLabel?: string;
  ogImage?: string;
}

const {
  title,
  description,
  lang = 'zh-Hant',
  canonicalPath,
  notice,
  alternates = [],
  productLabel = 'SnapCopy',
  ogImage
} = Astro.props;
---

<ProductLayout
  title={title}
  description={description}
  lang={lang}
  canonicalPath={canonicalPath}
  alternates={alternates}
  ogImage={ogImage}
>
  <section class="page-shell legal-shell">
    <div class="section-kicker">{productLabel}</div>
    <h1>{title}</h1>
    <LegalNotice text={notice} />
    <slot />
  </section>
</ProductLayout>
