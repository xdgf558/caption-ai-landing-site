---
import BaseLayout from './BaseLayout.astro';

interface AlternateLink {
  hrefLang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
  canonicalPath: string;
  alternates?: AlternateLink[];
  bodyClass?: string;
}

const { title, description, lang = 'zh-Hant', canonicalPath, alternates = [], bodyClass } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  canonicalPath={canonicalPath}
  alternates={alternates}
  ogImage="/images/caption-ai-hero-phone-placeholder.svg"
  bodyClass={bodyClass}
>
  <slot />
</BaseLayout>
