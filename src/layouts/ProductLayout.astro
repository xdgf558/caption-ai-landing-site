---
import BaseLayout from './BaseLayout.astro';

interface AlternateLink {
  hrefLang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
  canonicalPath: string;
  alternates?: AlternateLink[];
  bodyClass?: string;
  ogImage?: string;
}

const {
  title,
  description,
  lang = 'zh-Hant',
  canonicalPath,
  alternates = [],
  bodyClass,
  ogImage = '/images/apps/snapcopy-app-icon.png'
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  canonicalPath={canonicalPath}
  alternates={alternates}
  ogImage={ogImage}
  bodyClass={bodyClass}
>
  <slot />
</BaseLayout>
