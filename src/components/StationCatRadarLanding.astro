---
import BaseLayout from '../layouts/BaseLayout.astro';
import { stationCatRadarProduct } from '../data/products/stationcat-radar';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;

const copy = {
  'zh-Hant': {
    title: 'StationCat Radar',
    eyebrow: 'Mac App',
    headline: '把公開資訊整理成更容易創作的 X 選題。',
    intro:
      'StationCat Radar 是一個給創作者使用的 Mac 小工具，用來追蹤公開資料源、RSS、AI 研究和你關心的關鍵詞，幫你更快整理出可以發到 X 的內容方向。',
    primary: '下載 Mac 版本',
    secondary: '查看 SnapCopy',
    downloadHref: stationCatRadarProduct.zhHantDownloadPagePath,
    snapcopyHref: '/zh-hant/apps/caption-ai/',
    featuresTitle: '它適合做什麼',
    features: [
      ['整理公開熱點', '從 RSS、Hacker News、GDELT、YouTube 等來源整理候選話題。'],
      ['保留你的內容方向', '用 Keyword Pool 維護你關心的 AI、貓咪、生活、科技和創作關鍵詞。'],
      ['生成創作角度', '把一條資訊轉成更適合 X 發布的提示詞、觀點和短帖方向。'],
      ['降低選題成本', '不用在很多網站之間來回切換，先在本機把候選內容排好。']
    ],
    notesTitle: '早期測試說明',
    notes: [
      `目前版本：${stationCatRadarProduct.version}`,
      `${stationCatRadarProduct.architecture}，${stationCatRadarProduct.minimumSystem}`,
      '這是一個早期 Mac 測試版，適合願意嘗鮮並回報問題的創作者。',
      '如果 macOS 首次打開時提示安全確認，請確認來源後再允許打開。'
    ]
  },
  'zh-Hans': {
    title: 'StationCat Radar',
    eyebrow: 'Mac App',
    headline: '把公开资讯整理成更容易创作的 X 选题。',
    intro:
      'StationCat Radar 是一个给创作者使用的 Mac 小工具，用来追踪公开数据源、RSS、AI 研究和你关心的关键词，帮你更快整理出可以发到 X 的内容方向。',
    primary: '下载 Mac 版本',
    secondary: '查看 SnapCopy',
    downloadHref: stationCatRadarProduct.zhHansDownloadPagePath,
    snapcopyHref: '/zh-hans/apps/caption-ai/',
    featuresTitle: '它适合做什么',
    features: [
      ['整理公开热点', '从 RSS、Hacker News、GDELT、YouTube 等来源整理候选话题。'],
      ['保留你的内容方向', '用 Keyword Pool 维护你关心的 AI、猫咪、生活、科技和创作关键词。'],
      ['生成创作角度', '把一条资讯转成更适合 X 发布的提示词、观点和短帖方向。'],
      ['降低选题成本', '不用在很多网站之间来回切换，先在本机把候选内容排好。']
    ],
    notesTitle: '早期测试说明',
    notes: [
      `当前版本：${stationCatRadarProduct.version}`,
      `${stationCatRadarProduct.architecture}，${stationCatRadarProduct.minimumSystem}`,
      '这是一个早期 Mac 测试版，适合愿意尝鲜并反馈问题的创作者。',
      '如果 macOS 首次打开时提示安全确认，请确认来源后再允许打开。'
    ]
  },
  en: {
    title: 'StationCat Radar',
    eyebrow: 'Mac App',
    headline: 'Turn public signals into clearer X ideas.',
    intro:
      'StationCat Radar is a small Mac app for creators who want to track public sources, RSS feeds, AI research, and keyword pools, then turn useful signals into X-ready content angles.',
    primary: 'Download for Mac',
    secondary: 'View SnapCopy',
    downloadHref: stationCatRadarProduct.downloadPagePath,
    snapcopyHref: '/apps/caption-ai/',
    featuresTitle: 'What it helps with',
    features: [
      ['Track public signals', 'Collect candidate topics from RSS, Hacker News, GDELT, YouTube, and other open sources.'],
      ['Keep your interests close', 'Maintain a keyword pool around AI, cats, life, tech, and creator themes.'],
      ['Shape posting angles', 'Turn one signal into a clearer prompt, point of view, or short X post direction.'],
      ['Reduce topic hunting', 'Spend less time switching between sources and more time deciding what to say.']
    ],
    notesTitle: 'Early test notes',
    notes: [
      `Current version: ${stationCatRadarProduct.version}`,
      `${stationCatRadarProduct.architecture}, ${stationCatRadarProduct.minimumSystem}`,
      'This is an early Mac test build for creators who are comfortable trying new tools.',
      'If macOS shows a first-open security prompt, verify the source before allowing it to open.'
    ]
  },
  ja: {
    title: 'StationCat Radar',
    eyebrow: 'Mac App',
    headline: '公開情報を、X に投稿しやすいアイデアへ。',
    intro:
      'StationCat Radar は、公開ソース、RSS、AI リサーチ、キーワードを追いながら、X 向けの投稿アイデアに整理するための小さな Mac アプリです。',
    primary: 'Mac 版をダウンロード',
    secondary: 'SnapCopy を見る',
    downloadHref: stationCatRadarProduct.jaDownloadPagePath,
    snapcopyHref: '/ja/apps/caption-ai/',
    featuresTitle: 'できること',
    features: [
      ['公開トピックを整理', 'RSS、Hacker News、GDELT、YouTube などから候補トピックを集めます。'],
      ['関心テーマを保存', 'AI、猫、生活、テック、クリエイター向けのキーワードを管理できます。'],
      ['投稿の切り口を作る', 'ひとつの情報を、X に出しやすい視点や短い投稿案へ整理します。'],
      ['ネタ探しを軽くする', '複数サイトを行き来する時間を減らし、何を書くかに集中できます。']
    ],
    notesTitle: 'テスト版について',
    notes: [
      `現在のバージョン：${stationCatRadarProduct.version}`,
      `${stationCatRadarProduct.architecture}、${stationCatRadarProduct.minimumSystem}`,
      'これは新しいツールを試したいクリエイター向けの早期 Mac テスト版です。',
      'macOS の初回起動時に確認が出た場合は、配布元を確認してから開いてください。'
    ]
  }
}[lang];

const canonicalPath =
  lang === 'zh-Hant'
    ? stationCatRadarProduct.zhHantProductPath
    : lang === 'zh-Hans'
      ? stationCatRadarProduct.zhHansProductPath
      : lang === 'ja'
        ? stationCatRadarProduct.jaProductPath
        : stationCatRadarProduct.productPath;
---

<BaseLayout
  title={`${copy.title} for Mac`}
  description={copy.intro}
  lang={lang}
  canonicalPath={canonicalPath}
  ogImage={stationCatRadarProduct.assets.screenshot}
  bodyClass="radar-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: stationCatRadarProduct.zhHantProductPath },
    { hrefLang: 'zh-Hans', href: stationCatRadarProduct.zhHansProductPath },
    { hrefLang: 'en', href: stationCatRadarProduct.productPath },
    { hrefLang: 'ja', href: stationCatRadarProduct.jaProductPath },
    { hrefLang: 'x-default', href: stationCatRadarProduct.zhHantProductPath }
  ]}
>
  <section class="radar-hero">
    <div class="radar-hero__copy">
      <p class="section-kicker">{copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p>{copy.intro}</p>
      <div class="button-row">
        <a class="button button-primary" href={copy.downloadHref}>{copy.primary}</a>
        <a class="button button-secondary" href={copy.snapcopyHref}>{copy.secondary}</a>
      </div>
    </div>
    <div class="radar-preview-card" aria-label="StationCat Radar app preview">
      <img src={stationCatRadarProduct.assets.screenshot} alt="StationCat Radar interface preview" width="1040" height="720" />
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="section-kicker">Radar</p>
      <h2>{copy.featuresTitle}</h2>
    </div>
    <div class="radar-feature-grid">
      {copy.features.map(([title, text]) => (
        <article>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="radar-note-panel">
      <div>
        <p class="section-kicker">Version {stationCatRadarProduct.version}</p>
        <h2>{copy.notesTitle}</h2>
      </div>
      <ul>
        {copy.notes.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

