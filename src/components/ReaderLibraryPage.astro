                <p>{copy.softwareDownloadsDesc}</p>
                <p>{copy.plannedNotice}</p>
              </article>

              <article class="reader-capability-card reader-capability-card--planned">
                <div class="reader-capability-card__heading">
                  <span aria-hidden="true">⌘</span>
                  <h3>{copy.softwareAccess}</h3>
                  <small>{copy.plannedLabel}</small>
                </div>
                <p>{copy.softwareAccessDesc}</p>
                <p>{copy.plannedNotice}</p>
              </article>
            </div>
          </section>

          <section class="reader-overview-section" aria-labelledby="reader-recent-heading">
            <div class="reader-section-heading reader-section-heading--row">
              <div>
                <p class="reader-v2-kicker">Activity</p>
                <h2 id="reader-recent-heading">{ui.recentActivity}</h2>
              </div>
              <button type="button" data-reader-view-target="shelf" data-reader-shelf-target="history">{ui.allHistory} →</button>
