const clientConfig = {
  locale: lang,
  libraryPath: readerLibraryPaths[lang],
  pointsPath: pointsPaths[localeKey],
  messages: getReaderLibraryMessages(lang),
  errorMessageKeys: readerErrorMessageKeys,
  publicPriceLoading: copy.publicTitle,
  publicPriceUnavailable: lang === 'ja' ? '現在購入できるポイントパックはありません' : lang === 'en' ? 'No points packs are currently available' : lang === 'zh-Hans' ? '目前没有可购买的积分包' : '目前沒有可購買的積分包',
  auth: {
    loginTitle: copy.authTitle,
    registerTitle: lang === 'ja' ? '会員登録' : lang === 'en' ? 'Create member account' : lang === 'zh-Hans' ? '会员注册' : '會員註冊',
    resetTitle: copy.reset,
    newPasswordTitle: lang === 'ja' ? '新しいパスワードを設定' : lang === 'en' ? 'Set a new password' : lang === 'zh-Hans' ? '设置新密码' : '設定新密碼',
    loginSubmit: copy.loginSubmit,
    registerSubmit: lang === 'ja' ? '登録してログイン' : lang === 'en' ? 'Register and sign in' : lang === 'zh-Hans' ? '注册并登录' : '註冊並登入',
    resetSubmit: lang === 'ja' ? '確認コードでリセット' : lang === 'en' ? 'Reset with verification code' : lang === 'zh-Hans' ? '用验证码重置密码' : '用驗證碼重置密碼',
    updateSubmit: copy.updatePassword,
    resetHelp: copy.resetHelp,
    legacyResetHelp: lang === 'ja' ? '以前のパスワードリセットリンク用に新しいパスワードを設定してください。' : lang === 'en' ? 'Set a new member password for this password reset link.' : lang === 'zh-Hans' ? '请为旧密码重置链接设置新的会员密码。' : '請為舊密碼重置連結設定新的會員密碼。'
  }
};
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDescription}
  lang={lang}
  canonicalPath={readerLibraryPaths[lang]}
  alternates={[
    { hrefLang: 'zh-Hant', href: readerLibraryPaths['zh-Hant'] },
    { hrefLang: 'zh-Hans', href: readerLibraryPaths['zh-Hans'] },
    { hrefLang: 'en', href: readerLibraryPaths.en },
    { hrefLang: 'ja', href: readerLibraryPaths.ja },
    { hrefLang: 'x-default', href: readerLibraryPaths.en }
  ]}
>
  <script id="reader-client-config" type="application/json" set:html={JSON.stringify(clientConfig)} />
  <section class="works-hero reader-library-hero">
    <div class="reader-library-hero__copy">
      <p class="station-kicker">Member Center</p>
      <h1>{copy.heading}</h1>
      <p>{copy.heroDesc}</p>
    </div>
  </section>

  <section class="station-section reader-public-points" aria-labelledby="reader-public-points-title">
    <div>
      <p class="station-kicker">STATION POINTS</p>
      <h2 id="reader-public-points-title">{copy.publicTitle}</h2>
      <p>{copy.publicDesc}</p>
    </div>
    <a class="button button-secondary" href={pointsPaths[localeKey]}>{copy.publicLink}</a>
  </section>

  <section class="station-section reader-membership-overview" id="reader-membership-panel" hidden>
    <div class="reader-membership-summary" id="reader-membership-summary" data-state="neutral" aria-live="polite">
      <div class="reader-membership-summary__main">
        <span class="reader-membership-summary__dot" aria-hidden="true"></span>
        <div>
          <p>{copy.membershipLabel}</p>
          <strong id="reader-membership-summary-title">{copy.loading}</strong>
          <span id="reader-membership-summary-detail">{copy.loadingMembership}</span>
        </div>
      </div>
      <div class="reader-membership-summary__actions">
        <span id="reader-membership-overview-credits">{copy.balance}</span>
        <button class="button button-primary" id="reader-membership-redeem" type="button">{copy.redeemMembership}</button>
      </div>
    </div>
    <p class="reader-membership-state" id="reader-membership-state">{copy.noMembership}</p>
    <p class="fine-print" id="reader-membership-rule">{copy.membershipRule}</p>
    <div class="reader-status" id="reader-membership-status" role="status" aria-live="polite"></div>
  </section>

  <section class="station-section reader-library-grid">
    <form class="reader-panel reader-login-panel" id="reader-login-form">
      <div>
        <p class="station-kicker">Member Account</p>
        <h2 id="reader-auth-title">{copy.authTitle}</h2>
      </div>
      <div class="reader-auth-switch" role="tablist" aria-label={copy.authLabel}>
        <button class="reader-auth-switch__button is-active" type="button" data-auth-mode="login" aria-selected="true">{copy.login}</button>
        <button class="reader-auth-switch__button" type="button" data-auth-mode="register" aria-selected="false">{copy.register}</button>
        <button class="reader-auth-switch__button" type="button" data-auth-mode="reset" aria-selected="false">{copy.reset}</button>
      </div>
      <div class="reader-auth-fields" id="reader-login-fields">
        <label>
          {copy.identifier}
          <input id="reader-identifier" name="identifier" type="text" autocomplete="username" placeholder="username@example.com" />
        </label>
        <label>
          {copy.password}
          <input id="reader-password" name="password" type="password" autocomplete="current-password" placeholder={copy.min8} />
        </label>
      </div>
      <div class="reader-auth-fields" id="reader-register-fields" hidden>
        <label>
          {copy.username}
          <input id="reader-username" name="username" type="text" autocomplete="username" placeholder="stationcat" />
        </label>
        <label>
          Email
          <input id="reader-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" />
        </label>
        <label>
          {copy.password}
          <input id="reader-register-password" name="register-password" type="password" autocomplete="new-password" placeholder={copy.min8} />
        </label>
        <label>
          {copy.confirmPassword}
          <input id="reader-register-password-confirm" name="register-password-confirm" type="password" autocomplete="new-password" placeholder={copy.repeatPassword} />
        </label>
      </div>
      <div class="reader-auth-fields" id="reader-reset-fields" hidden>
        <label id="reader-reset-identifier-field">
          {copy.identifier}
          <input id="reader-reset-identifier" name="reset-identifier" type="text" autocomplete="username" placeholder="username@example.com" />
        </label>
        <label id="reader-reset-totp-field">
          {copy.totpCode}
          <input id="reader-reset-totp-code" name="reset-totp-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder={copy.sixDigits} />
        </label>
        <label>
          {copy.newPassword}
          <input id="reader-reset-password" name="reset-password" type="password" autocomplete="new-password" placeholder={copy.min8} />
        </label>
        <label>
          {copy.confirmNewPassword}
          <input id="reader-reset-password-confirm" name="reset-password-confirm" type="password" autocomplete="new-password" placeholder={copy.repeatNewPassword} />
        </label>
        <p class="fine-print" id="reader-reset-help">{copy.resetHelp}</p>
      </div>
      <button class="button button-primary" id="reader-login-submit" type="submit">{copy.loginSubmit}</button>
      <div class="reader-status" id="reader-login-status" role="status" aria-live="polite"></div>
    </form>

    <div class="reader-panel reader-account-panel" id="reader-account-panel" hidden>
      <div class="reader-panel__header">
        <p class="station-kicker">Account</p>
        <h2>{copy.account}</h2>
      </div>
      <div class="reader-account-profile">
        <span class="reader-account-avatar" aria-hidden="true">SC</span>
        <p id="reader-account-email" class="reader-account-email"></p>
      </div>
      <details class="reader-password-disclosure">
        <summary>{copy.changePassword}</summary>
        <form class="reader-password-form" id="reader-password-form">
          <label>
            {copy.currentPassword}
            <input id="reader-current-password" name="current-password" type="password" autocomplete="current-password" placeholder={copy.currentPassword} />
          </label>
          <label>
            {copy.newPassword}
            <input id="reader-new-password" name="new-password" type="password" autocomplete="new-password" placeholder={copy.min8} />
          </label>
          <label>
            {copy.confirmNewPassword}
            <input id="reader-new-password-confirm" name="new-password-confirm" type="password" autocomplete="new-password" placeholder={copy.repeatNewPassword} />
          </label>
          <label>
            {copy.totpCode}
            <input id="reader-password-totp-code" name="password-totp-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder={copy.boundRequired} />
          </label>
          <button class="button button-primary" id="reader-password-submit" type="submit">{copy.updatePassword}</button>
          <div class="reader-status" id="reader-password-status" role="status" aria-live="polite"></div>
        </form>
      </details>
      <button class="button button-secondary reader-danger-action" id="reader-logout" type="button">{copy.logout}</button>
    </div>

    <div class="reader-panel reader-totp-panel" id="reader-totp-panel" hidden>
      <div class="reader-panel__header">
        <p class="station-kicker">Authenticator</p>
        <h2>{copy.authenticator}</h2>
        <span class="reader-status-badge" id="reader-totp-badge" data-state="neutral">{copy.reading}</span>
      </div>
      <p class="reader-totp-state" id="reader-totp-state">{copy.readingBinding}</p>
      <button class="button button-secondary" id="reader-totp-setup" type="button">{copy.bind}</button>
      <div class="reader-totp-setup-box" id="reader-totp-setup-box" hidden>
        <div class="reader-totp-qr-card" id="reader-totp-qr-card" hidden>
          <div class="reader-totp-qr" id="reader-totp-qr" aria-label={getReaderLibraryMessages(lang).qrLabel}></div>
          <p class="fine-print">{copy.qrHelp}</p>
        </div>
        <details class="reader-totp-manual">
          <summary>{copy.manual}</summary>
          <label>
            {copy.setupKey}
            <input id="reader-totp-secret" type="text" readonly />
          </label>
          <label>
            otpauth URI
            <textarea id="reader-totp-uri" readonly rows="3"></textarea>
          </label>
        </details>
        <label>
          {copy.currentCode}
          <input id="reader-totp-confirm-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder={getReaderLibraryMessages(lang).sixDigits} />
        </label>
        <button class="button button-primary" id="reader-totp-confirm" type="button">{copy.confirmBinding}</button>
      </div>
      <div class="reader-status" id="reader-totp-status" role="status" aria-live="polite"></div>
    </div>

    <div class="reader-panel reader-credits-panel" id="reader-credits-panel" hidden>
      <div class="reader-panel__header">
        <div>
          <p class="station-kicker">Station Points</p>
          <h2>{copy.points}</h2>
        </div>
        <span class="reader-credit-scope">{copy.pointsScope}</span>
      </div>
      <div class="reader-credit-summary">
        <p class="reader-credit-balance" id="reader-credit-balance">0 Station Points</p>
        <p>{copy.pointsIntro}</p>
      </div>

      <div class="reader-credit-use-columns">
        <section class="reader-credit-use-group" aria-labelledby="reader-credit-available-title">
          <div class="reader-credit-use-heading">
            <h3 id="reader-credit-available-title">{copy.availableNow}</h3>
            <span class="reader-credit-use-status" data-state="active">{copy.activeLabel}</span>
          </div>
          <div class="reader-credit-use-list">
            <article>
              <strong>{copy.readingMembership}</strong>
              <p>{copy.readingMembershipDesc}</p>
            </article>
            <article>
              <strong>{copy.paidChapters}</strong>
              <p id="reader-credit-cost">{copy.chapterCost}</p>
            </article>
          </div>
        </section>

        <section class="reader-credit-use-group" aria-labelledby="reader-credit-planned-title">
          <div class="reader-credit-use-heading">
            <h3 id="reader-credit-planned-title">{copy.comingNext}</h3>
            <span class="reader-credit-use-status" data-state="planned">{copy.plannedLabel}</span>
          </div>
          <div class="reader-credit-use-list">
            <article>
              <strong>{copy.softwareDownloads}</strong>
              <p>{copy.softwareDownloadsDesc}</p>
            </article>
            <article>
              <strong>{copy.softwareAccess}</strong>
              <p>{copy.softwareAccessDesc}</p>
            </article>
          </div>
          <p class="reader-credit-planned-note">{copy.plannedNotice}</p>
        </section>
      </div>

      <div id="reader-credit-purchase-controls" hidden>
        <div class="reader-credit-purchase-heading">
          <h3>{copy.buyPoints}</h3>
          <p>{copy.buyPointsDesc}</p>
        </div>
        <div class="reader-credit-packs" id="reader-credit-packs"></div>
      </div>
      <div class="reader-status" id="reader-credit-status" role="status" aria-live="polite"></div>
    </div>
  </section>

  <section class="station-section reader-library-content" id="reader-library-content" hidden>
    <div class="station-section__heading">
      <p class="station-kicker">Bookmarks</p>
      <h2>{copy.continueReading}</h2>
      <p class="reader-bookmark-hint" set:html={copy.bookmarkHint} />
    </div>
    <div class="reader-library-list" id="reader-bookmark-list"></div>
    <div class="reader-status" id="reader-bookmark-status" role="status" aria-live="polite"></div>
    <div class="reader-empty-shelf" id="reader-bookmark-empty">
      <h3>{copy.noBookmarks}</h3>
      <p>{copy.noBookmarksDesc}</p>
      <a class="button button-secondary" href="/novel/">{copy.browse}</a>
    </div>

    <div class="station-section__heading">
      <p class="station-kicker">Unlocked Content</p>
      <h2>{copy.unlocked}</h2>
    </div>
    <div class="reader-library-list" id="reader-library-list"></div>
    <div class="reader-empty-shelf" id="reader-library-empty">
      <h3>{copy.noUnlocked}</h3>
      <p>{copy.noUnlockedDesc}</p>
      <a class="button button-secondary" href="/novel/">{copy.backNovel}</a>
    </div>
  </section>

  <script>
    import qrcode from 'qrcode-generator';

    const readerClientConfigNode = document.getElementById('reader-client-config');
    const readerClientConfig = JSON.parse(readerClientConfigNode?.textContent || '{}');
    const readerLocale = readerClientConfig.locale || 'zh-Hant';
    const readerLibraryPath = readerClientConfig.libraryPath || '/library/';
    const readerMessages = readerClientConfig.messages || {};
    const formatReaderMessage = (key, values = {}) => String(readerMessages[key] || key).replace(
      /\{(\w+)\}/g,
      (match, name) => Object.prototype.hasOwnProperty.call(values, name) ? String(values[name]) : match
    );
    const localizedApiMessage = (data, fallbackKey) => {
      const mappedKey = readerClientConfig.errorMessageKeys?.[String(data?.code || '')];
      return formatReaderMessage(mappedKey || fallbackKey);
    };
    const createReaderError = (fallbackKey, data = null) => {
      const error = new Error(data ? localizedApiMessage(data, fallbackKey) : formatReaderMessage(fallbackKey));
      error.readerLocalized = true;
      return error;
    };
    const caughtReaderMessage = (error, fallbackKey) => error?.readerLocalized
      ? error.message
      : formatReaderMessage(fallbackKey);
    const publicPointsTitle = document.getElementById('reader-public-points-title');
    const form = document.getElementById('reader-login-form');
    const authTitle = document.getElementById('reader-auth-title');
    const authModeButtons = Array.from(document.querySelectorAll('[data-auth-mode]'));
    const loginFields = document.getElementById('reader-login-fields');
    const registerFields = document.getElementById('reader-register-fields');
    const resetFields = document.getElementById('reader-reset-fields');
    const identifierInput = document.getElementById('reader-identifier');
    const loginPasswordInput = document.getElementById('reader-password');
    const usernameInput = document.getElementById('reader-username');
    const emailInput = document.getElementById('reader-email');
    const registerPasswordInput = document.getElementById('reader-register-password');
    const registerPasswordConfirmInput = document.getElementById('reader-register-password-confirm');
    const resetIdentifierInput = document.getElementById('reader-reset-identifier');
    const resetIdentifierField = document.getElementById('reader-reset-identifier-field');
    const resetTotpCodeInput = document.getElementById('reader-reset-totp-code');
    const resetTotpField = document.getElementById('reader-reset-totp-field');
    const resetPasswordInput = document.getElementById('reader-reset-password');
    const resetPasswordConfirmInput = document.getElementById('reader-reset-password-confirm');
    const resetHelp = document.getElementById('reader-reset-help');
    const submitButton = document.getElementById('reader-login-submit');
    const statusBox = document.getElementById('reader-login-status');
    const accountPanel = document.getElementById('reader-account-panel');
    const accountEmail = document.getElementById('reader-account-email');
    const passwordForm = document.getElementById('reader-password-form');
    const currentPasswordInput = document.getElementById('reader-current-password');
    const newPasswordInput = document.getElementById('reader-new-password');
    const newPasswordConfirmInput = document.getElementById('reader-new-password-confirm');
    const passwordTotpCodeInput = document.getElementById('reader-password-totp-code');
    const passwordSubmitButton = document.getElementById('reader-password-submit');
    const passwordStatus = document.getElementById('reader-password-status');
    const logoutButton = document.getElementById('reader-logout');
    const totpPanel = document.getElementById('reader-totp-panel');
    const totpState = document.getElementById('reader-totp-state');
    const totpSetupButton = document.getElementById('reader-totp-setup');
    const totpSetupBox = document.getElementById('reader-totp-setup-box');
    const totpQrCard = document.getElementById('reader-totp-qr-card');
    const totpQr = document.getElementById('reader-totp-qr');
    const totpSecretInput = document.getElementById('reader-totp-secret');
    const totpUriInput = document.getElementById('reader-totp-uri');
    const totpConfirmCodeInput = document.getElementById('reader-totp-confirm-code');
    const totpConfirmButton = document.getElementById('reader-totp-confirm');
    const totpStatus = document.getElementById('reader-totp-status');
    const totpBadge = document.getElementById('reader-totp-badge');
    const creditsPanel = document.getElementById('reader-credits-panel');
    const creditBalance = document.getElementById('reader-credit-balance');
    const creditCost = document.getElementById('reader-credit-cost');
    const creditPurchaseControls = document.getElementById('reader-credit-purchase-controls');
    const creditPacks = document.getElementById('reader-credit-packs');
    const creditStatus = document.getElementById('reader-credit-status');
    const membershipPanel = document.getElementById('reader-membership-panel');
    const membershipState = document.getElementById('reader-membership-state');
    const membershipRule = document.getElementById('reader-membership-rule');
    const membershipRedeem = document.getElementById('reader-membership-redeem');
    const membershipStatus = document.getElementById('reader-membership-status');
    const membershipSummary = document.getElementById('reader-membership-summary');
    const membershipSummaryTitle = document.getElementById('reader-membership-summary-title');
    const membershipSummaryDetail = document.getElementById('reader-membership-summary-detail');
    const membershipOverviewCredits = document.getElementById('reader-membership-overview-credits');
    const libraryContent = document.getElementById('reader-library-content');
    const libraryList = document.getElementById('reader-library-list');
    const libraryEmpty = document.getElementById('reader-library-empty');
    const bookmarkList = document.getElementById('reader-bookmark-list');
    const bookmarkEmpty = document.getElementById('reader-bookmark-empty');
    const bookmarkStatus = document.getElementById('reader-bookmark-status');
    let authMode = 'login';

    const setStatus = (message, tone = 'neutral') => {
      statusBox.textContent = message;
      statusBox.dataset.tone = tone;
    };

    const setPasswordStatus = (message, tone = 'neutral') => {
      passwordStatus.textContent = message;
      passwordStatus.dataset.tone = tone;
    };

    const setTotpStatus = (message, tone = 'neutral') => {
      totpStatus.textContent = message;
      totpStatus.dataset.tone = tone;
    };

    const setBookmarkStatus = (message, tone = 'neutral') => {
      bookmarkStatus.textContent = message;
      bookmarkStatus.dataset.tone = tone;
    };

    const setMembershipSummary = (title, detail, state = 'neutral') => {
      membershipSummaryTitle.textContent = title;
      membershipSummaryDetail.textContent = detail;
      membershipSummary.dataset.state = state;
    };

    const setFieldState = (fields, enabled) => {
      fields.forEach((field) => {
        field.disabled = !enabled;
      });
    };

    const setAuthMode = (mode) => {
      authMode = ['register', 'reset', 'legacyReset'].includes(mode) ? mode : 'login';
      const isRegister = authMode === 'register';
      const isReset = authMode === 'reset';
      const isLegacyReset = authMode === 'legacyReset';
      const showsReset = isReset || isLegacyReset;

      authTitle.textContent = isRegister
        ? readerClientConfig.auth.registerTitle
        : showsReset
          ? isLegacyReset
            ? readerClientConfig.auth.newPasswordTitle
            : readerClientConfig.auth.resetTitle
          : readerClientConfig.auth.loginTitle;
      submitButton.textContent = isRegister
        ? readerClientConfig.auth.registerSubmit
        : showsReset
          ? isLegacyReset
            ? readerClientConfig.auth.updateSubmit
            : readerClientConfig.auth.resetSubmit
          : readerClientConfig.auth.loginSubmit;
      loginFields.hidden = isRegister || showsReset;
      registerFields.hidden = !isRegister;
      resetFields.hidden = !showsReset;
      resetIdentifierField.hidden = isLegacyReset;
      resetTotpField.hidden = isLegacyReset;
      resetHelp.textContent = isLegacyReset
        ? readerClientConfig.auth.legacyResetHelp
        : readerClientConfig.auth.resetHelp;
      setFieldState([identifierInput, loginPasswordInput], authMode === 'login');
      setFieldState([usernameInput, emailInput, registerPasswordInput, registerPasswordConfirmInput], isRegister);
      setFieldState([resetIdentifierInput, resetTotpCodeInput], isReset);
      setFieldState([resetPasswordInput, resetPasswordConfirmInput], showsReset);
      authModeButtons.forEach((button) => {
        const visibleMode = isLegacyReset ? 'reset' : authMode;
        const selected = button.dataset.authMode === visibleMode;
        button.classList.toggle('is-active', selected);
        button.setAttribute('aria-selected', selected ? 'true' : 'false');
      });
      setStatus('');
    };

    const setSignedIn = (session) => {
      const signedIn = Boolean(session?.authenticated);
      form.hidden = signedIn;
      accountPanel.hidden = !signedIn;
      totpPanel.hidden = !signedIn;
      creditsPanel.hidden = !signedIn;
      membershipPanel.hidden = !signedIn;
      libraryContent.hidden = !signedIn;
      accountEmail.textContent = signedIn
        ? `${session.account.displayName || session.account.username || session.account.email} · ${session.account.email}`
        : '';
      setMembershipSummary(
        formatReaderMessage(signedIn ? 'loading' : 'signedOut'),
        formatReaderMessage(signedIn ? 'membershipChecking' : 'membershipAfterSignIn'),
        signedIn ? 'loading' : 'neutral'
      );
    };

    const entitlementTitle = (item) => {
      const target = item.scope === 'series'
        ? item.seriesSlug
        : `${item.seriesSlug} / ${item.chapterSlug}`;
      const access = item.accessLevel === 'all'
        ? formatReaderMessage('accessAll')
        : item.accessLevel === 'supporter'
          ? formatReaderMessage('accessSupporter')
          : formatReaderMessage('accessPaid');
      return `${target} · ${access}`;
    };

    const entitlementHref = (item) => {
      if (item.scope === 'series') return `/novel/${item.seriesSlug}/`;
      return `/novel/${item.seriesSlug}/chapter/${item.chapterSlug}/`;
    };

    const renderLibrary = (items) => {
      libraryList.innerHTML = '';
      libraryEmpty.hidden = items.length > 0;

      items.forEach((item) => {
        const card = document.createElement('article');
        card.className = 'reader-library-card';

        const title = document.createElement('h3');
        title.textContent = entitlementTitle(item);

        const meta = document.createElement('p');
        meta.textContent = `${item.source === 'manual' ? formatReaderMessage('manualGrant') : item.source} · ${item.grantedAt || formatReaderMessage('granted')}`;

        const link = document.createElement('a');
        link.className = 'paper-link';
        link.href = entitlementHref(item);
        link.textContent = formatReaderMessage(item.scope === 'series' ? 'openSeries' : 'openChapter');

        if (item.expiresAt) {
          const expires = document.createElement('p');
          expires.className = 'fine-print';
          expires.textContent = formatReaderMessage('expires', { date: item.expiresAt });
          card.append(title, meta, expires, link);
        } else {
          card.append(title, meta, link);
        }

        if (item.note) {
          const note = document.createElement('p');
          note.className = 'fine-print';
          note.textContent = item.note;
          card.append(note);
        }

        libraryList.append(card);
      });
    };

    const renderBookmarks = (items) => {
      bookmarkList.innerHTML = '';
      bookmarkEmpty.hidden = items.length > 0;

      const bookmarkHref = (item) => {
        const fallbackPath = `/novel/${item.seriesSlug}/chapter/${item.chapterSlug}/`;
        const sourcePath = item.sourcePath || fallbackPath;
        const anchorId = item.metadata?.anchorId;
        if (anchorId && !sourcePath.includes('#')) {
          return `${sourcePath}#${encodeURIComponent(anchorId)}`;
        }
        return sourcePath;
      };

      items.forEach((item) => {
        const card = document.createElement('article');
        card.className = 'reader-library-card reader-bookmark-card';

        const title = document.createElement('h3');
        title.textContent = item.chapterTitle || item.chapterSlug;

        const meta = document.createElement('p');
        const progress = Number.parseInt(item.progressPercent || 0, 10);
        const position = item.positionLabel || (progress > 0
          ? formatReaderMessage('readProgress', { progress })
          : formatReaderMessage('savedPosition'));
        meta.textContent = `${item.seriesTitle || item.seriesSlug} · ${position} · ${formatLocalDate(item.updatedAt)}`;

        const link = document.createElement('a');
        link.className = 'paper-link';
        link.href = bookmarkHref(item);
        link.textContent = formatReaderMessage('continueReading');

        const actions = document.createElement('div');
        actions.className = 'reader-bookmark-actions';
        actions.append(link);

        const bookmarkId = Number.parseInt(item.id || '', 10);
        if (Number.isFinite(bookmarkId) && bookmarkId > 0) {
          const deleteButton = document.createElement('button');
          deleteButton.className = 'button button-secondary reader-bookmark-delete';
          deleteButton.type = 'button';
          deleteButton.dataset.readerBookmarkDelete = String(bookmarkId);
          deleteButton.textContent = formatReaderMessage('deleteBookmark');
          deleteButton.setAttribute('aria-label', formatReaderMessage('deleteBookmarkLabel', {
            title: item.chapterTitle || item.chapterSlug
          }));
          actions.append(deleteButton);
        }

        card.append(title, meta, actions);
        if (item.note) {
          const note = document.createElement('p');
          note.className = 'fine-print';
          note.textContent = item.note;
          card.append(note);
        }
        bookmarkList.append(card);
      });
    };

    const loadLibrary = async () => {
      const response = await fetch('/api/novels/library');
      const data = await response.json();
      if (!response.ok || !data.ok) throw createReaderError('libraryLoadFailed', data);
      renderLibrary(data.entitlements || []);
    };

    const loadBookmarks = async () => {
      const response = await fetch('/api/readers/bookmarks');
      const data = await response.json();
      if (!response.ok || !data.ok) throw createReaderError('bookmarkLoadFailed', data);
      if (!data.authenticated) return;
      renderBookmarks(data.bookmarks || []);
      setBookmarkStatus('');
      if (data.setupRequired) {
        const warning = document.createElement('p');
        warning.className = 'reader-status';
        warning.dataset.tone = 'error';
        warning.textContent = localizedApiMessage(data, 'bookmarksNotReady');
        bookmarkList.append(warning);
      }
    };

    bookmarkList.addEventListener('click', async (event) => {
      const deleteButton = event.target instanceof HTMLElement
        ? event.target.closest('[data-reader-bookmark-delete]')
        : null;
      if (!deleteButton) return;

      const bookmarkId = deleteButton.dataset.readerBookmarkDelete;
      if (!bookmarkId) return;

      const previousText = deleteButton.textContent;
      deleteButton.disabled = true;
      deleteButton.textContent = formatReaderMessage('deletingBookmark');
      setBookmarkStatus(formatReaderMessage('deletingBookmark'));

      try {
        const response = await fetch(`/api/readers/bookmarks?id=${encodeURIComponent(bookmarkId)}`, {
          method: 'DELETE'
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.ok) {
          throw createReaderError('deleteBookmarkFailed', data);
        }
        renderBookmarks(data.bookmarks || []);
        setBookmarkStatus(formatReaderMessage('bookmarkDeleted'), 'success');
      } catch (error) {
        deleteButton.disabled = false;
        deleteButton.textContent = previousText || formatReaderMessage('deleteBookmark');
        setBookmarkStatus(caughtReaderMessage(error, 'deleteBookmarkFailed'), 'error');
      }
    });

    const setCreditStatus = (message, tone = 'neutral') => {
      creditStatus.textContent = message;
      creditStatus.dataset.tone = tone;
    };

    const setMembershipStatus = (message, tone = 'neutral') => {
      membershipStatus.textContent = message;
      membershipStatus.dataset.tone = tone;
    };

    const formatLocalDate = (value) => {
      if (!value) return '';
      const date = new Date(String(value).replace(' ', 'T'));
      if (Number.isNaN(date.getTime())) return value;
      return date.toLocaleString(readerLocale, { dateStyle: 'medium', timeStyle: 'short' });
    };

    const loadPublicPointsPrice = async () => {
      if (!publicPointsTitle) return;
      try {
        const response = await fetch('/api/novels/payments/status', { headers: { accept: 'application/json' }, cache: 'no-store' });
        const data = await response.json();
        const packs = Array.isArray(data.readerCredits?.packs) ? data.readerCredits.packs : [];
        if (!response.ok || !data.ok || data.publicCheckoutEnabled !== true || packs.length === 0) {
          publicPointsTitle.textContent = readerClientConfig.publicPriceUnavailable;
          return;
        }
        publicPointsTitle.textContent = packs
          .map((pack) => `${pack.label || `${pack.credits} Station Points`} · ${new Intl.NumberFormat(readerLocale, { style: 'currency', currency: pack.priceCurrency || 'USD' }).format(Number(pack.priceAmount))}`)
          .join(' / ');
      } catch {
        publicPointsTitle.textContent = readerClientConfig.publicPriceUnavailable;
      }
    };

    const renderCreditPacks = (packs, checkoutEnabled = false) => {
      creditPacks.innerHTML = '';
      creditPurchaseControls.hidden = !checkoutEnabled || packs.length === 0;
      if (creditPurchaseControls.hidden) return;
      packs.forEach((pack) => {
        const button = document.createElement('button');
        button.className = 'button button-secondary reader-credit-pack-button';
        button.type = 'button';
        button.dataset.credits = pack.credits;
        button.textContent = `${pack.label || `${pack.credits} Station Points`} · ${pack.priceAmount} ${pack.priceCurrency}`;
        creditPacks.append(button);
      });
    };

    const renderMembership = (membership, settings, creditAccount) => {
      const cost = settings?.membershipCreditCost || 10;
      const months = settings?.membershipDurationMonths || 1;
      const unitLabel = settings?.unitLabel || creditAccount?.unitLabel || 'Station Points';
      const balanceCredits = creditAccount?.balanceCredits || 0;
      const coversPaid = settings?.membershipCoversPaidContent !== false;
      membershipOverviewCredits.textContent = formatReaderMessage('membershipPoints', { balance: balanceCredits });
      membershipRule.textContent = formatReaderMessage('membershipRule', {
        cost,
        months,
        coverage: formatReaderMessage(coversPaid ? 'membershipCoversPaid' : 'membershipNoPaidCoverage')
      });
      membershipRedeem.textContent = membership?.active
        ? formatReaderMessage('renewMembership')
        : formatReaderMessage('redeemMembership', { cost, months });
      membershipRedeem.hidden = settings?.enabled === false;
      membershipRedeem.disabled = settings?.enabled === false || balanceCredits < cost;
      if (membership?.active) {
        const expiresAt = formatLocalDate(membership.expiresAt);
        setMembershipSummary(
          formatReaderMessage('membershipActive'),
          formatReaderMessage('membershipExpires', { date: expiresAt }),
          'active'
        );
        membershipState.textContent = formatReaderMessage(coversPaid ? 'membershipBenefitsActive' : 'membershipBenefitsLimited');
      } else {
        setMembershipSummary(
          formatReaderMessage('membershipInactive'),
          formatReaderMessage('availableBalance', { balance: balanceCredits, unit: unitLabel }),
          'inactive'
        );
        membershipState.textContent = formatReaderMessage('currentBalance', { balance: balanceCredits, unit: unitLabel });
      }
      if (settings?.enabled === false) {
        setMembershipSummary(
          formatReaderMessage('membershipDisabled'),
          formatReaderMessage('membershipDisabledDetail'),
          'inactive'
        );
        setMembershipStatus(formatReaderMessage('membershipDisabledStatus'), 'neutral');
      } else if (!membership?.active && balanceCredits < cost) {
        setMembershipStatus(formatReaderMessage('insufficientCredits'), 'neutral');
      } else {
        setMembershipStatus('');
      }
    };

    const renderTotpStatus = (totp) => {
      const enabled = Boolean(totp?.enabled);
      totpState.textContent = formatReaderMessage(enabled ? 'totpEnabledState' : 'totpDisabledState');
      totpBadge.textContent = `${enabled ? '✓ ' : ''}${formatReaderMessage(enabled ? 'enabledBadge' : 'disabledBadge')}`;
      totpBadge.dataset.state = enabled ? 'active' : 'neutral';
      totpSetupButton.hidden = enabled;
      passwordTotpCodeInput.placeholder = formatReaderMessage(enabled ? 'sixDigits' : 'totpOptional');
      totpSetupBox.hidden = true;
      renderTotpQrCode('');
      if (!enabled) {
        totpSecretInput.value = '';
        totpUriInput.value = '';
        totpConfirmCodeInput.value = '';
      }
    };

    const loadTotpStatus = async () => {
      const response = await fetch('/api/readers/totp/status');
      const data = await response.json();
      if (!response.ok || !data.ok) throw createReaderError('totpLoadFailed', data);
      if (!data.authenticated) return;
      if (data.setupRequired) {
        renderTotpStatus({ enabled: false });
        setTotpStatus(localizedApiMessage(data, 'totpNotReady'), 'error');
        return;
      }
      renderTotpStatus(data.totp || { enabled: false });
      setTotpStatus('');
    };

    const safeLoadTotpStatus = async () => {
      try {
        await loadTotpStatus();
      } catch (error) {
        renderTotpStatus({ enabled: false });
        setTotpStatus(caughtReaderMessage(error, 'totpLoadFailed'), 'error');
      }
    };

    const renderTotpQrCode = (otpauthUrl) => {
      totpQr.innerHTML = '';
      totpQrCard.hidden = true;
      if (!otpauthUrl) return true;

      try {
        const qr = qrcode(0, 'M');
        qr.addData(otpauthUrl);
        qr.make();
        totpQr.innerHTML = qr.createSvgTag(5, 3);
        const svg = totpQr.querySelector('svg');
        if (svg) {
          svg.setAttribute('role', 'img');
          svg.setAttribute('aria-label', formatReaderMessage('qrLabel'));
          svg.removeAttribute('width');
          svg.removeAttribute('height');
        }
        totpQrCard.hidden = false;
        return true;
      } catch (error) {
        return false;
      }
    };

    const loadCredits = async () => {
      const response = await fetch('/api/readers/credits');
      const data = await response.json();
      if (!response.ok || !data.ok) throw createReaderError('creditsLoadFailed', data);
      if (!data.authenticated) return;

      const unitLabel = data.account?.unitLabel || 'Station Points';
      creditBalance.textContent = `${data.account?.balanceCredits || 0} ${unitLabel}`;
      creditCost.textContent = formatReaderMessage('chapterCost', { cost: data.chapterCostCredits || 1 });
      renderCreditPacks(data.packs || [], data.checkoutEnabled === true);
      renderMembership(data.membership, data.membershipSettings, data.account);
    };

    const wait = (milliseconds) => new Promise((resolve) => {
      window.setTimeout(resolve, milliseconds);
    });

    const describePaymentOrder = (data) => {
      const order = data.order || {};
      const fulfillment = data.fulfillment || {};
      if (fulfillment.complete) {
        if (fulfillment.kind === 'credit-pack') return formatReaderMessage('paymentCreditConfirmed');
        if (fulfillment.kind === 'tip') return formatReaderMessage('paymentTipConfirmed');
        return formatReaderMessage('paymentAccessConfirmed');
      }
      if (fulfillment.needsReview) {
        return formatReaderMessage('paymentNeedsReview');
      }
      if (['failed', 'expired', 'refunded'].includes(order.status)) {
        return formatReaderMessage('paymentFailedStatus', { status: order.status });
      }
      if (order.status === 'confirming') return formatReaderMessage('paymentConfirming');
      if (['confirmed', 'finished'].includes(order.status)) return formatReaderMessage('paymentUpdating');
      return formatReaderMessage('paymentReturnedPending');
    };

    const refreshReturnedPaymentOrder = async () => {
      const orderToken = query.get('order') || '';
      if (query.get('payment') !== 'success' || !orderToken) return;

      setCreditStatus(formatReaderMessage('paymentReturnedPending'), 'neutral');
      for (let attempt = 0; attempt < 12; attempt += 1) {
        const response = await fetch(`/api/novels/payments/order?order=${encodeURIComponent(orderToken)}`);
        const data = await response.json();
        if (!response.ok || !data.ok) throw createReaderError('orderLoadFailed', data);

        const fulfillment = data.fulfillment || {};
        const tone = fulfillment.complete ? 'success' : fulfillment.needsReview ? 'error' : 'neutral';
        setCreditStatus(describePaymentOrder(data), tone);

        if (fulfillment.complete) {
          await Promise.all([loadLibrary(), loadCredits()]);
          return;
        }

        if (!fulfillment.nextCheckSeconds) return;
        await wait(fulfillment.nextCheckSeconds * 1000);
      }

      setCreditStatus(formatReaderMessage('paymentStillPending'), 'neutral');
    };

    const loadSession = async () => {
      const response = await fetch('/api/readers/session');
      const data = await response.json();
      if (!response.ok || !data.ok) throw createReaderError('sessionLoadFailed', data);
      setSignedIn(data);
      if (data.authenticated) {
        await Promise.all([loadLibrary(), loadCredits(), loadBookmarks(), safeLoadTotpStatus()]);
      }
    };

    const query = new URLSearchParams(window.location.search);
    const resetToken = query.get('resetToken') || '';
    const resetEmail = query.get('resetEmail') || '';
    const redirectPath = (() => {
      const value = query.get('returnTo') || readerLibraryPath;
      if (!value.startsWith('/') || value.startsWith('//')) return readerLibraryPath;
      return value;
    })();

    if (resetEmail) {
      resetIdentifierInput.value = resetEmail;
    }

    if (query.get('login') === 'success') {
      setStatus(formatReaderMessage('loginSuccessLoading'), 'success');
    } else if (query.get('login') === 'invalid') {
      setStatus(formatReaderMessage('loginInvalid'), 'error');
    } else if (resetToken) {
      setStatus(formatReaderMessage('setNewPassword'), 'neutral');
    }

    if (query.get('payment') === 'success' && query.get('order')) {
      setCreditStatus(formatReaderMessage('paymentReturnedPending'), 'neutral');
    } else if (query.get('payment') === 'success') {
      setCreditStatus(formatReaderMessage('paymentReturned'), 'success');
    } else if (query.get('payment') === 'cancelled') {
      setCreditStatus(formatReaderMessage('paymentCancelled'), 'error');
    }

    authModeButtons.forEach((button) => {
      button.addEventListener('click', () => setAuthMode(button.dataset.authMode));
    });

    const loadReaderHome = async () => {
      await Promise.all([loadLibrary(), loadCredits(), loadBookmarks(), safeLoadTotpStatus()]);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      submitButton.disabled = true;
      setStatus(
        authMode === 'register'
          ? formatReaderMessage('creatingAccount')
          : authMode === 'legacyReset'
            ? formatReaderMessage('updatingPassword')
            : authMode === 'reset'
              ? formatReaderMessage('resettingPassword')
              : formatReaderMessage('signingIn'),
        'neutral'
      );

      try {
        let endpoint = '/api/readers/login';
        let body = {
          identifier: identifierInput.value,
          password: loginPasswordInput.value,
          redirectPath
        };

        if (authMode === 'register') {
          endpoint = '/api/readers/register';
          body = {
            username: usernameInput.value,
            email: emailInput.value,
            password: registerPasswordInput.value,
            confirmPassword: registerPasswordConfirmInput.value,
            redirectPath
          };
        } else if (authMode === 'reset') {
          endpoint = '/api/readers/password-reset/confirm';
          body = {
            identifier: resetIdentifierInput.value,
            totpCode: resetTotpCodeInput.value,
            password: resetPasswordInput.value,
            confirmPassword: resetPasswordConfirmInput.value
          };
        } else if (authMode === 'legacyReset') {
          endpoint = '/api/readers/password-reset/confirm';
          body = {
            token: resetToken,
            password: resetPasswordInput.value,
            confirmPassword: resetPasswordConfirmInput.value
          };
        }

        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await response.json();
        if (!response.ok || !data.ok) throw createReaderError('loginFailed', data);

        setStatus(formatReaderMessage('signedIn'), 'success');
        setSignedIn(data);
        if (authMode === 'reset' || authMode === 'legacyReset') {
          window.history.replaceState({}, '', readerLibraryPath);
        }
        await loadReaderHome();
        if (redirectPath && redirectPath !== readerLibraryPath && redirectPath !== window.location.pathname) {
          window.location.href = redirectPath;
        }
      } catch (error) {
        setStatus(caughtReaderMessage(error, 'loginFailed'), 'error');
      } finally {
        submitButton.disabled = false;
      }
    });

    logoutButton.addEventListener('click', async () => {
      logoutButton.disabled = true;
      try {
        await fetch('/api/readers/logout', { method: 'POST' });
        setSignedIn({ authenticated: false });
        renderLibrary([]);
        renderBookmarks([]);
        renderCreditPacks([]);
        renderTotpStatus({ enabled: false });
        setTotpStatus('');
        creditBalance.textContent = '0 Station Points';
        renderMembership(null, { enabled: true, membershipCreditCost: 10, membershipDurationMonths: 1 }, { balanceCredits: 0, unitLabel: 'Station Points' });
        setAuthMode('login');
        setStatus(formatReaderMessage('signedOutSuccess'), 'success');
      } finally {
        logoutButton.disabled = false;
      }
    });

    passwordForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      passwordSubmitButton.disabled = true;
      setPasswordStatus(formatReaderMessage('updatingPassword'), 'neutral');

      try {
        const response = await fetch('/api/readers/password/change', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            currentPassword: currentPasswordInput.value,
            password: newPasswordInput.value,
            confirmPassword: newPasswordConfirmInput.value,
            totpCode: passwordTotpCodeInput.value
          })
        });
        const data = await response.json();
        if (!response.ok || !data.ok) throw createReaderError('passwordUpdateFailed', data);
        currentPasswordInput.value = '';
        newPasswordInput.value = '';
        newPasswordConfirmInput.value = '';
        passwordTotpCodeInput.value = '';
        setPasswordStatus(formatReaderMessage('passwordUpdated'), 'success');
      } catch (error) {
        setPasswordStatus(caughtReaderMessage(error, 'passwordUpdateFailed'), 'error');
      } finally {
        passwordSubmitButton.disabled = false;
      }
    });

    totpSetupButton.addEventListener('click', async () => {
      totpSetupButton.disabled = true;
      setTotpStatus(formatReaderMessage('totpGenerating'), 'neutral');

      try {
        const response = await fetch('/api/readers/totp/setup', { method: 'POST' });
        const data = await response.json();
        if (!response.ok || !data.ok) throw createReaderError('totpGenerateFailed', data);

        if (data.setup) {
          totpSecretInput.value = data.setup.secretBase32 || '';
          totpUriInput.value = data.setup.otpauthUrl || '';
          const qrReady = renderTotpQrCode(data.setup.otpauthUrl || '');
          totpSetupBox.hidden = false;
          setTotpStatus(
            qrReady
              ? formatReaderMessage('totpScanQr')
              : formatReaderMessage('totpQrFailed'),
            qrReady ? 'neutral' : 'error'
          );
        } else {
          renderTotpStatus(data.totp || { enabled: false });
          setTotpStatus(formatReaderMessage('totpUpdated'), data.totp?.enabled ? 'success' : 'neutral');
        }
      } catch (error) {
        setTotpStatus(caughtReaderMessage(error, 'totpGenerateFailed'), 'error');
      } finally {
        totpSetupButton.disabled = false;
      }
    });

    totpConfirmButton.addEventListener('click', async () => {
      totpConfirmButton.disabled = true;
      setTotpStatus(formatReaderMessage('totpConfirming'), 'neutral');

      try {
        const response = await fetch('/api/readers/totp/confirm', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            code: totpConfirmCodeInput.value
          })
        });
        const data = await response.json();
        if (!response.ok || !data.ok) throw createReaderError('totpBindFailed', data);
        renderTotpStatus(data.totp || { enabled: true });
        setTotpStatus(formatReaderMessage('totpBound'), 'success');
      } catch (error) {
        setTotpStatus(caughtReaderMessage(error, 'totpBindFailed'), 'error');
      } finally {
        totpConfirmButton.disabled = false;
      }
    });

    creditPacks.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-credits]');
      if (!button) return;

      const buttons = Array.from(creditPacks.querySelectorAll('button'));
      buttons.forEach((item) => {
        item.disabled = true;
      });
      setCreditStatus(formatReaderMessage('checkoutCreating'), 'neutral');

      try {
        const response = await fetch('/api/novels/payments/checkout', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            orderType: 'credit-pack',
            credits: Number.parseInt(button.dataset.credits || '0', 10),
            locale: readerLocale,
            returnPath: readerLibraryPath
          })
        });
        const data = await response.json();
        if (!response.ok || !data.ok) throw createReaderError('checkoutFailed', data);
        if (!data.paymentUrl) throw createReaderError('paymentUrlMissing');
        setCreditStatus(formatReaderMessage('checkoutOpening'), 'success');
        window.location.href = data.paymentUrl;
      } catch (error) {
        setCreditStatus(caughtReaderMessage(error, 'checkoutFailed'), 'error');
        buttons.forEach((item) => {
          item.disabled = false;
        });
      }
    });

    membershipRedeem.addEventListener('click', async () => {
      membershipRedeem.disabled = true;
      setMembershipStatus(formatReaderMessage('membershipRedeeming'), 'neutral');

      try {
        const response = await fetch('/api/readers/membership/redeem', { method: 'POST' });
        const data = await response.json();
        if (!response.ok || !data.ok) {
          throw createReaderError('membershipRedeemFailed', data);
        }
        setMembershipStatus(formatReaderMessage('membershipRedeemed'), 'success');
        await Promise.all([loadLibrary(), loadCredits()]);
      } catch (error) {
        setMembershipStatus(caughtReaderMessage(error, 'membershipRedeemFailed'), 'error');
        membershipRedeem.disabled = false;
      }
    });

    setAuthMode(resetToken ? 'legacyReset' : 'login');
    if (resetToken) {
      setStatus(formatReaderMessage('setNewPassword'), 'neutral');
    }

    loadPublicPointsPrice();
    loadSession()
      .then(refreshReturnedPaymentOrder)
      .catch((error) => setStatus(caughtReaderMessage(error, 'sessionLoadFailed'), 'error'));
  </script>
</BaseLayout>
