---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getReaderLibraryMessages,
  readerErrorMessageKeys,
  readerLibraryPaths
} from '../data/reader-library-client.js';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const localeKey = lang === 'zh-Hant' ? 'zhHant' : lang === 'zh-Hans' ? 'zhHans' : lang;
const pointsPaths = {
  en: '/points/', ja: '/ja/points/', zhHant: '/zh-hant/points/', zhHans: '/zh-hans/points/'
};
const copy = {
