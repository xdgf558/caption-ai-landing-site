              </article>

              <article class="reader-capability-card reader-capability-card--active">
                <div class="reader-capability-card__heading">
                  <span aria-hidden="true">▤</span>
                  <h3>{copy.paidChapters}</h3>
                  <small>{copy.activeLabel}</small>
