    authTitle: '会員ログイン', authLabel: '会員認証方法', login: 'ログイン', register: '登録', reset: 'パスワードをリセット', identifier: 'ユーザー名またはメール', password: 'パスワード', min8: '8文字以上', username: 'ユーザー名', confirmPassword: 'パスワード確認', repeatPassword: 'パスワードをもう一度入力', totpCode: '2段階認証コード', sixDigits: '6桁のコード', newPassword: '新しいパスワード', confirmNewPassword: '新しいパスワードの確認', repeatNewPassword: '新しいパスワードをもう一度入力', resetHelp: '認証アプリを連携済みのアカウントは、現在の確認コードでパスワードをリセットできます。', loginSubmit: '会員センターを開く',
