    metaTitle: '会员中心', metaDescription: 'Station Cat 会员中心，用于管理全站通用 Station 积分、会员状态、已解锁内容和账户安全。',
    heading: '会员中心', heroDesc: '管理你的账户、使用权限与 Station Cat 全站通用积分。',
    publicTitle: '目前可购买的 Station 积分包', publicDesc: 'Station 积分是 Station Cat 站内符合资格的内容与服务共用余额。一次性购买，无自动续费。', publicLink: '查看价格与完整积分规则',
    membershipLabel: '会员状态', loading: '正在读取', loadingMembership: '正在确认会员有效期', balance: '0 Station 积分', redeemMembership: '用积分兑换会员', noMembership: '尚未开通会员。', membershipRule: '目前所需积分与有效期间会在登录后显示。',
    authTitle: '会员登录', authLabel: '会员登录方式', login: '登录', register: '注册', reset: '重置密码', identifier: '用户名或 Email', password: '密码', min8: '至少 8 个字符', username: '用户名', confirmPassword: '确认密码', repeatPassword: '再次输入密码', totpCode: '两步验证码', sixDigits: '6 位数字', newPassword: '新密码', confirmNewPassword: '确认新密码', repeatNewPassword: '再次输入新密码', resetHelp: '只有已绑定 Google Authenticator / 两步验证器的账户，可以用验证码重置密码。', loginSubmit: '登录会员中心',
    account: '账户', changePassword: '修改密码', currentPassword: '当前密码', boundRequired: '已绑定时必填', updatePassword: '更新密码', logout: '退出登录',
    authenticator: '两步验证器', reading: '读取中', readingBinding: '正在读取绑定状态。', bind: '绑定 Google Authenticator', qrHelp: '打开 Google Authenticator，点击加号，选择“扫描 QR code”。', manual: '无法扫码时，手动输入设置密钥', setupKey: '设置密钥', currentCode: '6 位验证码', confirmBinding: '确认绑定',
    points: '我的 Station 积分', pointsScope: 'Station Cat 全站通用积分', pointsIntro: '凡是明确显示 Station 积分兑换入口的内容与服务，都使用这一份余额。确认兑换前，系统会先显示所需积分与取得的权限。',
    availableNow: '目前已开放', activeLabel: '可使用', readingMembership: '阅读会员', readingMembershipDesc: '使用积分兑换有期限的会员阅读权益。', paidChapters: '付费小说章节', chapterCost: '目前单章付费内容会扣除 {cost} 点。',
    comingNext: '接下来会支持', plannedLabel: '规划中', softwareDownloads: '付费软件下载权限', softwareDownloadsDesc: '兑换符合资格的桌面或移动软件下载权限。', softwareAccess: '软件功能与使用权限', softwareAccessDesc: '兑换符合资格的高级功能或有期限的产品使用权。', plannedNotice: '规划中的用途目前还不能兑换；只有产品页显示积分价格与兑换按钮后，才代表正式开放。',
    buyPoints: '购买 Station 积分', buyPointsDesc: '一次性购买并加入同一份全站余额，不会自动续费。',
    continueReading: '继续阅读', bookmarkHint: '在章节阅读页按 B 可保存目前阅读位置；手机可点右下角“保存书签”按钮。', noBookmarks: '目前还没有保存书签。', noBookmarksDesc: '打开小说章节后保存书签，下次就可以从这里继续阅读。', browse: '去看连载小说',
