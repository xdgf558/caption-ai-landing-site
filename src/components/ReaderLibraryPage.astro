    securityKicker: 'Account security', securityHeading: '账户安全', securityDesc: '密码与两步验证各自独立管理；已启用两步验证时，修改密码也会要求当前验证码。', passwordHeading: '修改密码', passwordDesc: '设置一组安全的新密码；更新后，其他设备可能需要重新登录。',
    checkoutDialogTitle: '确认购买', checkoutDialogDesc: '打开安全付款页前，请确认积分包与到账账户。', checkoutAccount: '到账账户', checkoutPack: '到账积分', checkoutTotal: '应付金额', checkoutTax: '税费与可用付款方式会在付款页显示。', cancel: '取消', confirmPay: '确认并付款',
    activityPurchase: '积分购买', activitySpend: '积分兑换', activityRefund: '付款冲回', activityAdjustment: '余额调整', activityStatus: '已完成', permanent: '永久权限', continueAction: '继续阅读', openAction: '打开内容'
  }
}[lang];

const clientConfig = {
  locale: lang,
  libraryPath: readerLibraryPaths[lang],
  pointsPath: pointsPaths[localeKey],
  messages: getReaderLibraryMessages(lang),
  errorMessageKeys: readerErrorMessageKeys,
  publicPriceLoading: copy.publicTitle,
  publicPriceUnavailable: lang === 'ja' ? '現在購入できるポイントパックはありません' : lang === 'en' ? 'No points packs are currently available' : lang === 'zh-Hans' ? '目前没有可购买的积分包' : '目前沒有可購買的積分包',
  ui,
  auth: {
    loginTitle: copy.authTitle,
    registerTitle: lang === 'ja' ? '会員登録' : lang === 'en' ? 'Create member account' : lang === 'zh-Hans' ? '会员注册' : '會員註冊',
    resetTitle: copy.reset,
    newPasswordTitle: lang === 'ja' ? '新しいパスワードを設定' : lang === 'en' ? 'Set a new password' : lang === 'zh-Hans' ? '设置新密码' : '設定新密碼',
    loginSubmit: copy.loginSubmit,
    registerSubmit: lang === 'ja' ? '登録してログイン' : lang === 'en' ? 'Register and sign in' : lang === 'zh-Hans' ? '注册并登录' : '註冊並登入',
    resetSubmit: lang === 'ja' ? '確認コードでリセット' : lang === 'en' ? 'Reset with verification code' : lang === 'zh-Hans' ? '用验证码重置密码' : '用驗證碼重置密碼',
    updateSubmit: copy.updatePassword,
    resetHelp: copy.resetHelp,
    legacyResetHelp: lang === 'ja' ? '以前のパスワードリセットリンク用に新しいパスワードを設定してください。' : lang === 'en' ? 'Set a new member password for this password reset link.' : lang === 'zh-Hans' ? '请为旧密码重置链接设置新的会员密码。' : '請為舊密碼重置連結設定新的會員密碼。'
  }
};
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDescription}
  lang={lang}
  bodyClass="reader-center-page"
  canonicalPath={readerLibraryPaths[lang]}
  alternates={[
    { hrefLang: 'zh-Hant', href: readerLibraryPaths['zh-Hant'] },
    { hrefLang: 'zh-Hans', href: readerLibraryPaths['zh-Hans'] },
    { hrefLang: 'en', href: readerLibraryPaths.en },
    { hrefLang: 'ja', href: readerLibraryPaths.ja },
    { hrefLang: 'x-default', href: readerLibraryPaths.en }
  ]}
>
  <script id="reader-client-config" type="application/json" set:html={JSON.stringify(clientConfig)} />
  <div class="reader-center-v2">
    <section class="reader-auth-shell" id="reader-auth-shell" aria-labelledby="reader-auth-heading">
      <div class="reader-auth-intro">
        <p class="reader-v2-kicker">Member Center</p>
        <h1 id="reader-auth-heading">{ui.authHeading}</h1>
        <p class="reader-auth-intro__lead">{ui.authDesc}</p>
        <div class="reader-auth-benefits">
          <article>
            <span aria-hidden="true">◇</span>
            <div>
              <h2>{ui.authFeatureBalance}</h2>
              <p>{ui.authFeatureBalanceDesc}</p>
            </div>
          </article>
          <article>
            <span aria-hidden="true">▤</span>
            <div>
              <h2>{ui.authFeatureShelf}</h2>
              <p>{ui.authFeatureShelfDesc}</p>
            </div>
          </article>
          <article>
            <span aria-hidden="true">◈</span>
            <div>
              <h2>{ui.authFeatureSecurity}</h2>
              <p>{ui.authFeatureSecurityDesc}</p>
            </div>
          </article>
        </div>
        <a class="reader-auth-price-link" href={pointsPaths[localeKey]}>
          <span>{copy.publicLink}</span>
          <strong id="reader-public-points-title">{copy.publicTitle}</strong>
        </a>
      </div>

      <div class="reader-auth-card-wrap">
        <span class="reader-offset-layer" aria-hidden="true"></span>
        <form class="reader-auth-card reader-panel" id="reader-login-form">
          <div class="reader-auth-switch" role="tablist" aria-label={copy.authLabel}>
            <button class="reader-auth-switch__button is-active" type="button" data-auth-mode="login" aria-selected="true">{copy.login}</button>
            <button class="reader-auth-switch__button" type="button" data-auth-mode="register" aria-selected="false">{copy.register}</button>
            <button class="reader-auth-switch__button" type="button" data-auth-mode="reset" aria-selected="false">{copy.reset}</button>
          </div>
          <div>
            <p class="reader-v2-kicker">Station Cat</p>
            <h2 id="reader-auth-title">{copy.authTitle}</h2>
          </div>
          <div class="reader-auth-fields" id="reader-login-fields">
            <label>
              {copy.identifier}
              <input id="reader-identifier" name="identifier" type="text" autocomplete="username" placeholder="you@example.com" />
            </label>
            <label>
              {copy.password}
              <input id="reader-password" name="password" type="password" autocomplete="current-password" placeholder={copy.min8} />
            </label>
            <div class="reader-auth-options">
              <label class="reader-auth-remember">
                <input type="checkbox" checked />
                <span>{ui.remember}</span>
              </label>
              <button id="reader-forgot-password" type="button">{ui.forgot}</button>
            </div>
            <p class="reader-form-note">{ui.loginNote}</p>
          </div>
          <div class="reader-auth-fields" id="reader-register-fields" hidden>
            <label>
              {copy.username}
              <input id="reader-username" name="username" type="text" autocomplete="username" placeholder="stationcat" />
            </label>
            <label>
              Email
              <input id="reader-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" />
            </label>
            <label>
              {copy.password}
              <input id="reader-register-password" name="register-password" type="password" autocomplete="new-password" placeholder={copy.min8} />
            </label>
            <label>
              {copy.confirmPassword}
              <input id="reader-register-password-confirm" name="register-password-confirm" type="password" autocomplete="new-password" placeholder={copy.repeatPassword} />
            </label>
            <p class="reader-form-note">
              {ui.registerNote}
              <a href={termsPaths[localeKey]}>{copy.publicLink.includes('価格') ? '利用規約' : lang === 'en' ? 'Terms' : lang === 'zh-Hans' ? '服务条款' : '服務條款'}</a>
              <a href={privacyPaths[localeKey]}>{lang === 'ja' ? 'プライバシー' : lang === 'en' ? 'Privacy' : lang === 'zh-Hans' ? '隐私政策' : '隱私政策'}</a>
            </p>
          </div>
          <div class="reader-auth-fields" id="reader-reset-fields" hidden>
            <label id="reader-reset-identifier-field">
              {copy.identifier}
              <input id="reader-reset-identifier" name="reset-identifier" type="text" autocomplete="username" placeholder="you@example.com" />
            </label>
            <label id="reader-reset-totp-field">
              {copy.totpCode}
              <input id="reader-reset-totp-code" name="reset-totp-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder={copy.sixDigits} />
            </label>
            <label>
              {copy.newPassword}
              <input id="reader-reset-password" name="reset-password" type="password" autocomplete="new-password" placeholder={copy.min8} />
            </label>
            <label>
              {copy.confirmNewPassword}
              <input id="reader-reset-password-confirm" name="reset-password-confirm" type="password" autocomplete="new-password" placeholder={copy.repeatNewPassword} />
            </label>
            <p class="reader-form-note" id="reader-reset-help">{copy.resetHelp}</p>
          </div>
          <button class="reader-v2-button reader-v2-button--primary" id="reader-login-submit" type="submit">{copy.loginSubmit}</button>
          <div class="reader-status" id="reader-login-status" role="status" aria-live="polite"></div>
        </form>
      </div>
    </section>

    <section class="reader-dashboard-shell" id="reader-credits-panel" hidden>
      <aside class="reader-dashboard-sidebar" aria-label={ui.memberCenter}>
        <p class="reader-v2-kicker">Member Center</p>
        <nav class="reader-dashboard-nav">
          <button class="is-active" type="button" data-reader-view="overview" aria-current="true"><span aria-hidden="true">⌂</span>{ui.overview}</button>
          <button type="button" data-reader-view="points"><span aria-hidden="true">◇</span>{ui.pointsPack}</button>
          <button type="button" data-reader-view="shelf"><span aria-hidden="true">▤</span>{ui.shelf}</button>
          <button type="button" data-reader-view="security"><span aria-hidden="true">◈</span>{ui.security}</button>
        </nav>

        <div class="reader-sidebar-balance">
          <span>Station Points</span>
          <p><strong id="reader-sidebar-credit-balance">0</strong> <small>Points</small></p>
          <button class="reader-v2-button reader-v2-button--outline" type="button" data-reader-view-target="points">{ui.addPoints}</button>
        </div>

        <div class="reader-sidebar-account">
          <p id="reader-sidebar-account"></p>
          <button id="reader-logout" type="button"><span aria-hidden="true">↪</span>{copy.logout}</button>
        </div>
      </aside>

      <main class="reader-dashboard-main">
        <section class="reader-dashboard-view is-active" data-reader-view-panel="overview">
          <div class="reader-overview-hero">
            <div class="reader-overview-copy">
              <p class="reader-v2-kicker">{ui.overviewKicker}</p>
              <h1>{ui.overviewHeading}</h1>
              <p>{ui.overviewDesc}</p>
              <div class="reader-overview-actions">
                <button class="reader-v2-button reader-v2-button--primary" type="button" data-reader-view-target="points"><span aria-hidden="true">◇</span>{ui.buyPack}</button>
                <button class="reader-v2-button reader-v2-button--outline" type="button" data-reader-view-target="shelf">{ui.openShelf}<span aria-hidden="true">→</span></button>
              </div>
            </div>
            <div class="reader-balance-visual">
              <div class="reader-ticket-shadow" aria-hidden="true"></div>
              <article class="reader-balance-ticket">
                <span>{ui.balanceLabel}</span>
                <strong id="reader-credit-balance">0</strong>
                <small>Station Points</small>
                <div></div>
                <footer><span>Station Cat</span><span>SC · 2026</span></footer>
              </article>
              <div class="reader-overview-security">
                <button id="reader-overview-totp-badge" type="button" data-reader-view-target="security">2FA · {copy.reading}</button>
                <span id="reader-member-since"></span>
              </div>
            </div>
          </div>

          <section class="reader-overview-section" aria-labelledby="reader-points-uses-heading">
            <div class="reader-section-heading">
              <div>
                <p class="reader-v2-kicker">Station Points</p>
                <h2 id="reader-points-uses-heading">{ui.whatPointsDo}</h2>
              </div>
              <p>{ui.whatPointsDoDesc}</p>
            </div>

            <div class="reader-capability-grid">
              <article class="reader-capability-card reader-capability-card--active" id="reader-membership-panel" hidden>
                <div class="reader-capability-card__heading">
                  <span aria-hidden="true">♕</span>
                  <h3>{copy.readingMembership}</h3>
                  <small>{copy.activeLabel}</small>
                </div>
                <p>{copy.readingMembershipDesc}</p>
                <div class="reader-membership-summary" id="reader-membership-summary" data-state="neutral" aria-live="polite">
                  <div class="reader-membership-summary__main">
                    <span class="reader-membership-summary__dot" aria-hidden="true"></span>
                    <div>
                      <p>{copy.membershipLabel}</p>
                      <strong id="reader-membership-summary-title">{copy.loading}</strong>
                      <span id="reader-membership-summary-detail">{copy.loadingMembership}</span>
                    </div>
                  </div>
                  <div class="reader-membership-summary__actions">
                    <span id="reader-membership-overview-credits">{copy.balance}</span>
                    <button class="reader-v2-button reader-v2-button--outline" id="reader-membership-redeem" type="button">{copy.redeemMembership}</button>
                  </div>
                </div>
                <p class="reader-membership-state" id="reader-membership-state">{copy.noMembership}</p>
