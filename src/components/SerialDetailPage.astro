---
import type { SerialChapterEntry, SerialEntry, SiteLocale } from '../data/serials';
import { formatChapterNumber, getChapterHref, getPriceModeLabel, getSerialStatusLabel, getSeriesHref } from '../data/serials';
import SerialChapterList from './SerialChapterList.astro';

interface CopyShape {
  accessLabel: string;
  authorLabel: string;
  backHome: string;
  backShelf: string;
  chapterEmpty: string;
  chapterEyebrow: string;
  chapterLabel: string;
  chapterTitle: string;
  chapterWordCount: string;
  freeLabel: string;
  latestFallback: string;
  latestLabel: string;
  openSeries: string;
  plannedLabel: string;
  readChapter: string;
  readFirst: string;
  readLatest: string;
  scheduleLabel: string;
  seriesCtaNote: string;
  statusLabel: string;
  synopsisEyebrow: string;
  synopsisTitle: string;
}

interface Props {
  basePath: string;
  chapterContent: SerialChapterEntry[];
  copy: CopyShape;
  firstChapter?: SerialChapterEntry;
  homePath: string;
  latestChapter?: SerialChapterEntry;
  locale: SiteLocale;
  serial: SerialEntry;
  Content: any;
}

const { basePath, chapterContent, copy, firstChapter, latestChapter, locale, serial, Content } = Astro.props;
const coverText = serial.data.coverLabel ?? serial.data.title;
const seriesHref = getSeriesHref(basePath, serial.data.seriesSlug);
const tipAmounts = serial.data.tipAmounts?.length ? serial.data.tipAmounts : [3, 5, 10];
const tipCurrency = serial.data.tipCurrency || 'USD';
const tipsEnabled = serial.data.tipsEnabled !== false;
const formatPaymentAmount = (amount: number, currency: string) =>
  new Intl.NumberFormat(locale, { style: 'currency', currency }).format(amount);
const supportCopy = {
  en: {
    eyebrow: 'Support',
    title: 'Support this serial',
    body: 'Send a small tip through NOWPayments. Tips help keep the serial running, but do not unlock paid chapters.',
    button: 'Tip',
    working: 'Creating payment link...',
    ready: 'Opening NOWPayments...',
    disabled: 'Checkout is not configured yet.',
    failed: 'Could not create the payment link.'
  },
  ja: {
    eyebrow: 'サポート',
    title: 'この連載を応援する',
    body: 'NOWPayments で小さな支援を送れます。打賞は連載継続の応援で、有料章の解放とは別扱いです。',
    button: '支援',
    working: '支払いリンクを作成しています...',
    ready: 'NOWPayments を開いています...',
    disabled: '支払い設定はまだ有効ではありません。',
    failed: '支払いリンクを作成できませんでした。'
  },
  'zh-Hant': {
    eyebrow: '支持',
    title: '支持這部連載',
    body: '可以透過 NOWPayments 給一筆小額打賞。打賞用來支持連載繼續寫下去，不等同於解鎖付費章節。',
    button: '打賞',
    working: '正在建立支付連結...',
    ready: '正在打開 NOWPayments...',
    disabled: '支付通道尚未配置完成。',
    failed: '支付連結建立失敗。'
  },
  'zh-Hans': {
    eyebrow: '支持',
    title: '支持这部连载',
    body: '可以通过 NOWPayments 给一笔小额打赏。打赏用于支持连载继续写下去，不等同于解锁付费章节。',
    button: '打赏',
    working: '正在建立支付链接...',
    ready: '正在打开 NOWPayments...',
    disabled: '支付通道尚未配置完成。',
    failed: '支付链接建立失败。'
  }
}[locale];
---

<section class="works-hero serial-detail-hero">
  <div class="serial-detail-hero__copy">
    <p class="station-kicker">{copy.statusLabel}</p>
    <h1>{serial.data.title}</h1>
    {serial.data.subtitle && <p class="fine-print">{serial.data.subtitle}</p>}
    <p>{serial.data.tagline}</p>
    <div class="serial-detail-hero__meta">
      <span class="paper-stamp">{getSerialStatusLabel(serial.data.status, locale)}</span>
      <span>{copy.authorLabel}: {serial.data.author}</span>
      <span>{copy.accessLabel}: {getPriceModeLabel(serial.data.priceMode, locale)}</span>
      <span>{copy.freeLabel}: {serial.data.freeChapters}</span>
    </div>
    <div class="button-row">
      {firstChapter ? (
        <a class="button button-primary" href={getChapterHref(basePath, serial.data.seriesSlug, firstChapter.data.chapterSlug)}>{copy.readFirst}</a>
      ) : (
        <a class="button button-primary" href={basePath}>{copy.backShelf}</a>
      )}
      {latestChapter && latestChapter.data.chapterSlug !== firstChapter?.data.chapterSlug && (
        <a class="button button-secondary" href={getChapterHref(basePath, serial.data.seriesSlug, latestChapter.data.chapterSlug)}>{copy.readLatest}</a>
      )}
      <a class="button button-secondary" href={basePath}>{copy.backShelf}</a>
    </div>
    <p class="fine-print">{serial.data.availabilityNote ?? copy.seriesCtaNote}</p>
  </div>

  <aside class="serial-cover serial-detail-hero__cover" aria-label={serial.data.coverAlt ?? serial.data.title}>
    {serial.data.coverImage ? (
      <img src={serial.data.coverImage} alt={serial.data.coverAlt ?? `${serial.data.title} cover`} loading="lazy" />
    ) : (
      <>
        <span class="serial-cover__mark">SC</span>
        <strong>{coverText}</strong>
      </>
    )}
  </aside>
</section>

<section class="station-section serial-detail-grid">
  <div class="serial-detail-card">
    <p class="station-kicker">{copy.synopsisEyebrow}</p>
    <h2>{copy.synopsisTitle}</h2>
    <div class="serial-prose">
      <Content />
    </div>
  </div>

  <div class="serial-detail-card serial-detail-card--meta">
    <div>
      <span>{copy.authorLabel}</span>
      <strong>{serial.data.author}</strong>
    </div>
    <div>
      <span>{copy.scheduleLabel}</span>
      <strong>{serial.data.updateSchedule ?? '-'}</strong>
    </div>
    <div>
      <span>{copy.latestLabel}</span>
      <strong>
        {latestChapter
          ? `${formatChapterNumber(latestChapter.data.chapterNumber, locale)} ${latestChapter.data.title}`
          : copy.latestFallback}
      </strong>
    </div>
    {serial.data.totalPlannedChapters && (
      <div>
        <span>{copy.plannedLabel}</span>
        <strong>{serial.data.totalPlannedChapters}</strong>
      </div>
    )}
    <div>
      <span>{copy.accessLabel}</span>
      <strong>{getPriceModeLabel(serial.data.priceMode, locale)}</strong>
    </div>
  </div>
</section>

{tipsEnabled && (
  <section
    class="station-section serial-support-section"
    data-serial-tip-panel
    data-series-slug={serial.data.seriesSlug}
    data-currency={tipCurrency}
    data-locale={locale}
    data-return-path={seriesHref}
  >
    <div class="station-section__heading">
      <p class="station-kicker">{supportCopy.eyebrow}</p>
      <h2>{supportCopy.title}</h2>
      <p>{supportCopy.body}</p>
    </div>
    <div class="serial-tip-actions">
      {tipAmounts.map((amount) => (
        <button class="button button-secondary" type="button" data-tip-amount={amount}>
          {supportCopy.button} {formatPaymentAmount(amount, tipCurrency)}
        </button>
      ))}
    </div>
    <div class="reader-status" data-serial-tip-status role="status" aria-live="polite"></div>
  </section>
)}

<section class="station-section">
  <div class="station-section__heading">
    <p class="station-kicker">{copy.chapterEyebrow}</p>
    <h2>{copy.chapterTitle}</h2>
  </div>
  <SerialChapterList chapters={chapterContent} copy={copy} basePath={basePath} seriesSlug={serial.data.seriesSlug} locale={locale} />
</section>

{tipsEnabled && (
  <script define:vars={{ supportCopy }}>
    const tipPanel = document.querySelector('[data-serial-tip-panel]');
    const tipStatus = tipPanel?.querySelector('[data-serial-tip-status]');
    const tipButtons = tipPanel ? Array.from(tipPanel.querySelectorAll('[data-tip-amount]')) : [];

    const setTipStatus = (message, tone = 'neutral') => {
      if (!tipStatus) return;
      tipStatus.textContent = message;
      tipStatus.dataset.tone = tone;
    };

    const setTipButtonsDisabled = (disabled) => {
      tipButtons.forEach((button) => {
        button.disabled = disabled;
      });
    };

    tipButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        if (!tipPanel) return;
        setTipButtonsDisabled(true);
        setTipStatus(supportCopy.working, 'neutral');

        try {
          const response = await fetch('/api/novels/payments/checkout', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              orderType: 'tip',
              seriesSlug: tipPanel.dataset.seriesSlug,
              amount: button.dataset.tipAmount,
              priceCurrency: tipPanel.dataset.currency,
              locale: tipPanel.dataset.locale,
              returnPath: tipPanel.dataset.returnPath
            })
          });
          const data = await response.json();
          if (!response.ok || !data.ok) {
            if (data.code === 'PAYMENT_PROVIDER_NOT_CONFIGURED') throw new Error(supportCopy.disabled);
            throw new Error(data.message || supportCopy.failed);
          }
          if (!data.paymentUrl) throw new Error(supportCopy.failed);
          setTipStatus(supportCopy.ready, 'success');
          window.location.href = data.paymentUrl;
        } catch (error) {
          setTipStatus(error.message || supportCopy.failed, 'error');
          setTipButtonsDisabled(false);
        }
      });
    });
  </script>
)}
