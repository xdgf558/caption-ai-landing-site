---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  isStoryCatTestFlightReady,
  storyCatCopy,
  storyCatProduct
} from '../data/products/storycat';

type Locale = 'zh-Hant' | 'zh-Hans' | 'en' | 'ja';

interface Props {
  lang?: Locale;
}

const { lang = 'zh-Hant' } = Astro.props;
const copy = storyCatCopy[lang];

const paths = {
  'zh-Hant': {
    canonical: storyCatProduct.zhHantProductPath,
    apps: '/zh-hant/apps/'
  },
  'zh-Hans': {
    canonical: storyCatProduct.zhHansProductPath,
    apps: '/zh-hans/apps/'
  },
  en: {
    canonical: storyCatProduct.productPath,
    apps: '/apps/'
  },
  ja: {
    canonical: storyCatProduct.jaProductPath,
    apps: '/ja/apps/'
  }
}[lang];

const testHref = isStoryCatTestFlightReady
  ? storyCatProduct.testFlightUrl
  : undefined;
---

<BaseLayout
  title={copy.metaTitle}
  description={copy.metaDescription}
  lang={lang}
  canonicalPath={paths.canonical}
  ogImage={storyCatProduct.assets.preview}
  bodyClass="storycat-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: storyCatProduct.zhHantProductPath },
    { hrefLang: 'zh-Hans', href: storyCatProduct.zhHansProductPath },
    { hrefLang: 'en', href: storyCatProduct.productPath },
    { hrefLang: 'ja', href: storyCatProduct.jaProductPath },
    { hrefLang: 'x-default', href: storyCatProduct.zhHantProductPath }
  ]}
>
  <section class="storycat-hero">
    <div class="storycat-hero__copy">
      <p class="paper-kicker">{copy.eyebrow}</p>
      <p class="storycat-product-label">{copy.title}</p>
      <h1>{copy.headline}</h1>
      <p class="paper-lede">{copy.intro}</p>
      <div class="paper-actions">
        {testHref ? (
          <a class="ticket-button ticket-button--primary" href={testHref} target="_blank" rel="noopener noreferrer">
            {copy.primaryCta}
          </a>
        ) : (
          <span class="ticket-button ticket-button--primary ticket-button--disabled" aria-disabled="true">
            {copy.notReadyCta}
          </span>
        )}
        <a class="ticket-button ticket-button--secondary" href="#how-it-works">{copy.secondaryCta}</a>
      </div>
      <p class="storycat-beta-note">{copy.betaNote}</p>
    </div>

    <aside class="storycat-preview-card" aria-label={copy.previewTitle}>
      <div class="storycat-preview-card__top">
        <span class="paper-stamp">StoryCat</span>
        <span>{copy.previewLabel}</span>
      </div>
      <h2>{copy.previewTitle}</h2>
      <p>{copy.previewBody}</p>
      <ol class="storycat-choice-list">
        {copy.previewChoices.map((choice, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {choice}
          </li>
        ))}
      </ol>
      <p class="storycat-generated-note">{copy.generatedNote}</p>
    </aside>
  </section>

  <section id="how-it-works" class="paper-section storycat-section">
    <div class="paper-section__heading">
      <p class="paper-kicker">How it works</p>
      <h2>{copy.howTitle}</h2>
      <p>{copy.howIntro}</p>
    </div>
    <div class="storycat-step-grid">
      {copy.steps.map((step, index) => (
        <article>
          <span class="paper-stamp">{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="paper-section storycat-section">
    <div class="paper-section__heading">
      <p class="paper-kicker">Playable novel</p>
      <h2>{copy.whyTitle}</h2>
    </div>
    <div class="storycat-note-grid">
      {copy.whyItems.map((item) => (
        <article class="storycat-paper-note">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="paper-section storycat-section">
    <div class="paper-section__heading">
      <p class="paper-kicker">Templates</p>
      <h2>{copy.templatesTitle}</h2>
      <p>{copy.templatesIntro}</p>
    </div>
    <div class="storycat-template-grid">
      {copy.templates.map((template) => (
        <article>
          <h3>{template.title}</h3>
          <p>{template.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="testflight" class="paper-section storycat-section">
    <div class="storycat-test-panel">
      <div>
        <p class="paper-kicker">TestFlight</p>
        <h2>{copy.testTitle}</h2>
        <p>{copy.testIntro}</p>
      </div>
      <ul class="storycat-check-list">
        {copy.testNotes.map((note) => <li>{note}</li>)}
      </ul>
      <div class="paper-actions">
        {testHref ? (
          <a class="ticket-button ticket-button--primary" href={testHref} target="_blank" rel="noopener noreferrer">
            {copy.primaryCta}
          </a>
        ) : (
          <span class="ticket-button ticket-button--primary ticket-button--disabled" aria-disabled="true">
            {copy.notReadyCta}
          </span>
        )}
        <a class="ticket-button ticket-button--secondary" href={paths.apps}>Apps</a>
      </div>
    </div>
  </section>

  <section class="paper-section storycat-section">
    <div class="storycat-privacy-card">
      <div>
        <p class="paper-kicker">Privacy</p>
        <h2>{copy.privacyTitle}</h2>
        <p>{copy.privacyIntro}</p>
      </div>
      <ul class="storycat-check-list">
        {copy.privacyPoints.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  </section>

  <section class="paper-section storycat-section">
    <div class="paper-section__heading">
      <p class="paper-kicker">FAQ</p>
      <h2>{copy.faqTitle}</h2>
    </div>
    <div class="faq-list storycat-faq">
      {copy.faq.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
