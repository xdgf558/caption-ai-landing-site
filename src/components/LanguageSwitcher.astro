---
interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const path = Astro.url.pathname;
const normalizedPath = path === '/en/' || path === '/zh-hant/' || path === '/zh-hans/' || path === '/ja/' ? '/' : path;
const appsPath = normalizedPath
  .replace(/^\/ja(?=\/apps)/, '')
  .replace(/^\/en(?=\/apps)/, '')
  .replace(/^\/zh-hant(?=\/apps)/, '')
  .replace(/^\/zh-hans(?=\/apps)/, '');
const devlogPath = normalizedPath
  .replace(/^\/ja(?=\/devlog)/, '')
  .replace(/^\/en(?=\/devlog)/, '')
  .replace(/^\/zh-hant(?=\/devlog)/, '')
  .replace(/^\/zh-hans(?=\/devlog)/, '');
const novelPath = normalizedPath
  .replace(/^\/en(?=\/novel)/, '');
const worksPath = normalizedPath
  .replace(/^\/ja(?=\/works)/, '')
  .replace(/^\/en(?=\/works)/, '')
  .replace(/^\/zh-hant(?=\/works)/, '')
  .replace(/^\/zh-hans(?=\/works)/, '');
const standalonePath = normalizedPath
  .replace(/^\/ja(?=\/(?:points|library|terms|privacy))/, '')
  .replace(/^\/en(?=\/(?:points|library|terms|privacy))/, '')
  .replace(/^\/zh-hant(?=\/(?:points|library|terms|privacy))/, '')
  .replace(/^\/zh-hans(?=\/(?:points|library|terms|privacy))/, '');
const isApps = appsPath.startsWith('/apps');
const isDevlog = devlogPath.startsWith('/devlog');
const isNovel = novelPath.startsWith('/novel');
const isWorks = worksPath.startsWith('/works');
const isStandalone = /^\/(?:points|library|terms|privacy)\/$/.test(standalonePath);
const standaloneEnglishPath = `/en${standalonePath}`;
const enPath = isStandalone ? standaloneEnglishPath : isApps ? `/en${appsPath}` : isDevlog ? `/en${devlogPath}` : isNovel ? `/en${novelPath}` : isWorks ? `/en${worksPath}` : '/en/';
const jaPath = isStandalone ? `/ja${standalonePath}` : isApps ? `/ja${appsPath}` : isDevlog ? `/ja${devlogPath}` : isWorks ? `/ja${worksPath}` : '/ja/';
const zhHantPath = isStandalone ? `/zh-hant${standalonePath}` : isApps ? `/zh-hant${appsPath}` : isDevlog ? devlogPath : isNovel ? novelPath : isWorks ? `/zh-hant${worksPath}` : '/';
const zhHansPath = isStandalone ? `/zh-hans${standalonePath}` : isApps ? `/zh-hans${appsPath}` : isDevlog ? `/zh-hans${devlogPath}` : isWorks ? `/zh-hans${worksPath}` : '/zh-hans/';
const currentLabel = lang === 'zh-Hans' ? '简中' : lang === 'en' ? 'EN' : lang === 'ja' ? '日本語' : '繁中';
---

<div class="language-switcher language-switcher--select">
  <label class="sr-only" for="language-select">Language</label>
  <select id="language-select" class="language-select" aria-label="Language" title={currentLabel}>
    <option value={zhHantPath} selected={lang === 'zh-Hant'}>繁中</option>
    <option value={zhHansPath} selected={lang === 'zh-Hans'}>简中</option>
    <option value={enPath} selected={lang === 'en'}>EN</option>
    <option value={jaPath} selected={lang === 'ja'}>日本語</option>
  </select>
</div>

<script>
  document.querySelectorAll('.language-select').forEach((select) => {
    select.addEventListener('change', () => {
      if (select instanceof HTMLSelectElement && select.value) {
        window.location.href = select.value;
      }
    });
  });
</script>
