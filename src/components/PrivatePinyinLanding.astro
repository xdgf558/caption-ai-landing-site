---
import BaseLayout from '../layouts/BaseLayout.astro';
import { privatePinyinProduct } from '../data/products/privatepinyin';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const downloads = privatePinyinProduct.downloads;
const macDownload = downloads.find((item) => item.id === 'macos-pkg') ?? downloads[0];
const windowsDownload = downloads.find((item) => item.id === 'windows-exe');
const iosTestflight = privatePinyinProduct.iosTestflight;
const latestVersion = privatePinyinProduct.latestVersion;
const macVersion = macDownload.version;
const windowsVersion = windowsDownload?.version ?? latestVersion;
const inputSourceName = '猫栈拼音';
const internalName = 'PrivatePinyin';

const copy = {
  'zh-Hant': {
    title: '猫栈拼音',
    eyebrow: 'macOS / Windows / iOS Input Method',
    headline: '猫栈拼音：本機中文輸入法測試版。',
    intro:
      `猫栈拼音（PrivatePinyin）是 Station Cat 正在測試的中文輸入法。macOS 版目前是 ${macVersion}，Windows TSF 內測版是 ${windowsVersion}，iOS 版也已開放 TestFlight 外部測試。`,
    primary: '下載 macOS 版',
    windowsCta: '下載 Windows 內測版',
    iosCta: '加入 iOS TestFlight',
    secondary: '查看下載資訊',
    downloadHref: privatePinyinProduct.zhHantDownloadPagePath,
    featuresTitle: '目前這個版本適合',
    features: [
      ['本機中文輸入', '先把日常拼音輸入跑順，候選詞、標點和打字手感會持續調整。'],
      [`macOS ${macVersion}`, '新增本機 trigram 聯想，最近兩個已選詞可共同影響下一候選，近期輸入習慣也能逐步替代舊習慣。'],
      [`Windows ${windowsVersion} 內測`, 'Windows EXE 內測包已更新，適合願意協助測試 TSF 版本的使用者。'],
      ['iOS 外部測試', 'iPhone 與 iPad 使用者可透過 TestFlight 加入外部測試，協助驗證行動端鍵盤、候選詞和輸入流程。'],
      ['小而清楚的下載入口', '安裝包、版本、大小和 SHA-256 都集中在下載頁，方便確認來源。']
    ],
    notesTitle: '上架狀態',
    notes: [
      `目前版本：Windows ${windowsVersion}；macOS ${macVersion}`,
      `${macDownload.platform}，${macDownload.architecture}，${macDownload.minimumSystem}`,
      `安裝後請在系統輸入法設定裡加入「${inputSourceName}」（PrivatePinyin）。`,
