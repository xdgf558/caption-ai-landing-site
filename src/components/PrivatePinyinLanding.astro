---
import BaseLayout from '../layouts/BaseLayout.astro';
import { privatePinyinProduct } from '../data/products/privatepinyin';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const downloads = privatePinyinProduct.downloads;
const macDownload = downloads.find((item) => item.id === 'macos-pkg') ?? downloads[0];
const windowsDownload = downloads.find((item) => item.id === 'windows-exe');
const iosAppStore = privatePinyinProduct.iosAppStore;
const latestVersion = privatePinyinProduct.latestVersion;
const macVersion = macDownload.version;
const windowsVersion = windowsDownload?.version ?? latestVersion;
const releaseToken = `${macVersion}-${windowsVersion}`;
const versionedDownloadPage = (path: string) => `${path}?release=${releaseToken}`;
const inputSourceName = '猫栈拼音';
const internalName = 'PrivatePinyin';

const copy = {
  'zh-Hant': {
    title: '猫栈拼音｜macOS、Windows 與 iOS 中文輸入法',
    eyebrow: 'macOS / Windows / iOS Input Method',
    headline: '猫栈拼音：本機中文輸入法測試版。',
    intro:
      `猫栈拼音（PrivatePinyin）是 Station Cat 開發的本機中文輸入法。macOS 版目前是 ${macVersion}，Windows TSF 內測版是 ${windowsVersion}，iOS ${iosAppStore.version} 已正式上架 App Store。`,
    primary: '下載 macOS 版',
    windowsCta: '下載 Windows 內測版',
    iosCta: '在 App Store 下載',
    secondary: '查看下載資訊',
    downloadHref: versionedDownloadPage(privatePinyinProduct.zhHantDownloadPagePath),
    featuresTitle: '目前這個版本適合',
    features: [
      ['本機中文輸入', '先把日常拼音輸入跑順，候選詞、標點和打字手感會持續調整。'],
      [`macOS ${macVersion}`, '修正原生候選面板偶爾點擊無反應的問題，並阻止過期候選回調提交舊文字或覆蓋目前高亮。'],
      [`Windows ${windowsVersion} 內測`, '穩定空格首選，加入可選的寬容拼音與溫和學習；並修正預測狀態數字輸入、含空格使用者路徑及下載 TLS 相容性。'],
      [`iOS ${iosAppStore.version} 正式版`, 'iPhone 與 iPad 使用者可直接從 App Store 安裝，後續更新也由 Apple App Store 提供。'],
      ['本機與隱私優先', 'Writer 模型按需下載並校驗，透過獨立簽名的 Helper 在本機運行；嚴格隱私模式會停用並取消 Writer。'],
      ['小而清楚的下載入口', '安裝包、版本、大小和 SHA-256 都集中在下載頁，方便確認來源。']
    ],
    notesTitle: '上架狀態',
    notes: [
      `目前版本：Windows ${windowsVersion}；macOS ${macVersion}`,
      `${macDownload.platform}，${macDownload.architecture}，${macDownload.minimumSystem}`,
      `安裝後請在系統輸入法設定裡加入「${inputSourceName}」（PrivatePinyin）。`,
      'macOS 安裝包只支援 Apple Silicon Mac，Intel Mac 暫不支援。',
      windowsDownload ? `${windowsDownload.platform} ${windowsDownload.architecture} 內測版已提供 EXE，未簽名，安裝時可能出現 SmartScreen 提示。` : '',
      `iOS ${iosAppStore.version} 已正式上架 App Store，支援 ${iosAppStore.devices}，需要 ${iosAppStore.minimumSystem}。`,
      '這是早期測試版，首次安裝或啟用輸入法時請以系統安全提示為準。'
    ]
  },
  'zh-Hans': {
    title: '猫栈拼音｜macOS、Windows 与 iOS 中文输入法',
    eyebrow: 'macOS / Windows / iOS Input Method',
    headline: '猫栈拼音：本机中文输入法测试版。',
    intro:
      `猫栈拼音（PrivatePinyin）是 Station Cat 开发的本机中文输入法。macOS 版目前是 ${macVersion}，Windows TSF 内测版是 ${windowsVersion}，iOS ${iosAppStore.version} 已正式上架 App Store。`,
    primary: '下载 macOS 版',
    windowsCta: '下载 Windows 内测版',
    iosCta: '从 App Store 下载',
    secondary: '查看下载信息',
    downloadHref: versionedDownloadPage(privatePinyinProduct.zhHansDownloadPagePath),
    featuresTitle: '目前这个版本适合',
    features: [
      ['本机中文输入', '先把日常拼音输入跑顺，候选词、标点和打字手感会持续调整。'],
      [`macOS ${macVersion}`, '修复原生候选面板偶尔点击无反应的问题，并阻止过期候选回调提交旧文本或覆盖当前高亮。'],
      [`Windows ${windowsVersion} 内测`, '稳定空格首选，加入可选的宽容拼音与温和学习；并修复预测状态数字输入、含空格用户路径及下载 TLS 兼容性。'],
      [`iOS ${iosAppStore.version} 正式版`, 'iPhone 和 iPad 用户可直接从 App Store 安装，后续更新也由 Apple App Store 提供。'],
      ['本地与隐私优先', 'Writer 模型按需下载并校验，通过独立签名的 Helper 在本地运行；严格隐私模式会停用并取消 Writer。'],
      ['小而清楚的下载入口', '安装包、版本、大小和 SHA-256 都集中在下载页，方便确认来源。']
    ],
    notesTitle: '上架状态',
    notes: [
      `当前版本：Windows ${windowsVersion}；macOS ${macVersion}`,
      `${macDownload.platform}，${macDownload.architecture}，${macDownload.minimumSystem}`,
      `安装后请在系统输入法设置里加入「${inputSourceName}」（PrivatePinyin）。`,
      'macOS 安装包只支持 Apple Silicon Mac，Intel Mac 暂不支持。',
      windowsDownload ? `${windowsDownload.platform} ${windowsDownload.architecture} 内测版已提供 EXE，未签名，安装时可能出现 SmartScreen 提示。` : '',
      `iOS ${iosAppStore.version} 已正式上架 App Store，支持 ${iosAppStore.devices}，需要 ${iosAppStore.minimumSystem}。`,
      '这是早期测试版，首次安装或启用输入法时请以系统安全提示为准。'
    ]
  },
  en: {
    title: 'Maozhan Pinyin | Chinese Input for macOS, Windows, and iOS',
    eyebrow: 'macOS / Windows / iOS Input Method',
    headline: 'Maozhan Pinyin, a local Chinese input method test build.',
    intro:
      `Maozhan Pinyin (PrivatePinyin) is a local Chinese input method by Station Cat. The macOS build is ${macVersion}, the Windows TSF internal test build is ${windowsVersion}, and iOS ${iosAppStore.version} is officially available on the App Store.`,
    primary: 'Download for macOS',
    windowsCta: 'Download Windows beta',
    iosCta: 'Download on the App Store',
    secondary: 'View download info',
    downloadHref: versionedDownloadPage(privatePinyinProduct.downloadPagePath),
    featuresTitle: 'What this build is for',
    features: [
      ['Local Chinese typing', 'The focus is making daily pinyin input feel steady, with candidates, punctuation, and typing flow improving over time.'],
      [`macOS ${macVersion}`, 'Fixes intermittent no-op clicks in the native candidate panel and prevents stale callbacks from committing old text or replacing the current highlight.'],
      [`Windows ${windowsVersion} internal test`, 'Stabilizes the Space-key default, adds opt-in tolerant pinyin and gentle learning, and fixes prediction-only digits, user paths containing spaces, and download TLS compatibility.'],
      [`iOS ${iosAppStore.version} release`, 'iPhone and iPad users can install the public release directly from the App Store and receive updates through Apple.'],
      ['Local and privacy-first', 'The Writer model is downloaded and verified on demand, then runs locally through a separately signed Helper. Strict privacy mode disables and cancels Writer.'],
      ['Clear download trail', 'The installer, version, size, and SHA-256 checksum are kept together on the download page.']
    ],
    notesTitle: 'Release status',
    notes: [
      `Current versions: Windows ${windowsVersion}; macOS ${macVersion}`,
      `${macDownload.platform}, ${macDownload.architecture}, ${macDownload.minimumSystem}`,
      `After installing, add "${inputSourceName}" (PrivatePinyin) in System Settings > Keyboard > Input Sources.`,
      'The macOS installer supports Apple Silicon Macs only. Intel Macs are not supported yet.',
      windowsDownload ? `${windowsDownload.platform} ${windowsDownload.architecture} internal test build is available as an EXE installer. It is unsigned and may trigger SmartScreen prompts.` : '',
      `iOS ${iosAppStore.version} is available on the App Store for ${iosAppStore.devices} and requires ${iosAppStore.minimumSystem}.`,
      'This is an early test build. Follow system security prompts during install or input method activation.'
    ]
  },
  ja: {
    title: '猫栈拼音｜macOS・Windows・iOS 中国語入力',
    eyebrow: 'macOS / Windows / iOS Input Method',
    headline: '猫栈拼音：ローカル中国語入力メソッドのテスト版。',
    intro:
      `猫栈拼音（PrivatePinyin）は Station Cat が開発するローカル中国語入力メソッドです。macOS 版は ${macVersion}、Windows TSF 内部テスト版は ${windowsVersion}、iOS ${iosAppStore.version} は App Store で正式公開しています。`,
    primary: 'macOS 版をダウンロード',
    windowsCta: 'Windows 内部テスト版',
    iosCta: 'App Store からダウンロード',
    secondary: 'ダウンロード情報を見る',
    downloadHref: versionedDownloadPage(privatePinyinProduct.jaDownloadPagePath),
    featuresTitle: 'このバージョンでできること',
    features: [
      ['ローカル中国語入力', '日常的なピンイン入力、候補、句読点、入力感を整えていきます。'],
      [`macOS ${macVersion}`, 'ネイティブ候補パネルでクリックが反応しないことがある問題を修正し、古いコールバックによる旧テキストの確定や現在のハイライトの上書きを防ぎました。'],
      [`Windows ${windowsVersion} 内部テスト`, 'Space キーの先頭候補を安定させ、任意の曖昧ピンインと穏やかな学習を追加し、予測中の数字入力、空白を含むユーザーパス、ダウンロード TLS の互換性を修正しました。'],
      [`iOS ${iosAppStore.version} 正式版`, 'iPhone と iPad に App Store から直接インストールでき、今後の更新も Apple から提供されます。'],
      ['ローカル処理とプライバシー', 'Writer モデルは必要時にダウンロードして検証し、署名済みの独立 Helper でローカル実行します。厳格プライバシーモードでは Writer を停止します。'],
      ['わかりやすい配布情報', 'インストーラー、バージョン、サイズ、SHA-256 をダウンロードページにまとめています。']
    ],
    notesTitle: '公開状況',
    notes: [
      `現在のバージョン：Windows ${windowsVersion}、macOS ${macVersion}`,
      `${macDownload.platform}、${macDownload.architecture}、${macDownload.minimumSystem}`,
      `インストール後、システムの入力メソッド設定で「${inputSourceName}」（PrivatePinyin）を追加してください。`,
      'macOS インストーラーは Apple Silicon Mac のみ対応です。Intel Mac はまだ対応していません。',
      windowsDownload ? `${windowsDownload.platform} ${windowsDownload.architecture} 内部テスト版を EXE で提供しています。未署名のため SmartScreen が表示される場合があります。` : '',
      `iOS ${iosAppStore.version} は App Store で正式公開中です。${iosAppStore.devices} に対応し、${iosAppStore.minimumSystem} が必要です。`,
      'これは早期テスト版です。インストールや入力メソッド有効化時はシステムの安全確認に従ってください。'
    ]
  }
}[lang];

const feedbackCopy = {
  'zh-Hant': {
    kicker: 'Bug Feedback',
    title: '回報猫栈拼音問題',
    intro: '遇到安裝、啟用、候選詞或輸入異常時，可以直接提交。內容會進入 Station Cat 後台的回饋處理區。',
    platform: '系統平台',
    version: '版本',
    issueType: '問題類型',
    impact: '影響程度',
    summary: '問題摘要',
    summaryPlaceholder: '例如：Windows 安裝後找不到輸入法',
    details: '詳細描述',
    detailsPlaceholder: '請描述發生了什麼、原本預期看到什麼。',
    steps: '重現步驟（選填）',
    stepsPlaceholder: '1. 打開設定\n2. 加入輸入法\n3. ...',
    environment: '系統環境（選填）',
    environmentPlaceholder: '例如：Windows 11 24H2 / macOS 15.5',
    email: '聯絡 Email（選填）',
    emailPlaceholder: '需要回覆時使用',
    submit: '提交 Bug 回饋',
    submitting: '正在提交…',
    success: '已收到回饋，謝謝你幫忙測試。',
    error: '提交失敗，請稍後再試。',
    issueOptions: [['install', '安裝問題'], ['activation', '啟用問題'], ['typing', '輸入異常'], ['candidates', '候選詞問題'], ['performance', '閃退或效能'], ['other', '其他']],
    impactOptions: [['minor', '輕微，不影響繼續使用'], ['normal', '一般，會影響部分使用'], ['blocking', '嚴重，無法繼續使用']]
  },
  'zh-Hans': {
    kicker: 'Bug Feedback',
    title: '反馈猫栈拼音问题',
    intro: '遇到安装、启用、候选词或输入异常时，可以直接提交。内容会进入 Station Cat 后台的反馈处理区。',
    platform: '系统平台',
    version: '版本',
    issueType: '问题类型',
    impact: '影响程度',
    summary: '问题摘要',
    summaryPlaceholder: '例如：Windows 安装后找不到输入法',
    details: '详细描述',
    detailsPlaceholder: '请描述发生了什么、原本预期看到什么。',
    steps: '复现步骤（选填）',
    stepsPlaceholder: '1. 打开设置\n2. 添加输入法\n3. ...',
    environment: '系统环境（选填）',
    environmentPlaceholder: '例如：Windows 11 24H2 / macOS 15.5',
    email: '联系 Email（选填）',
    emailPlaceholder: '需要回复时使用',
    submit: '提交 Bug 反馈',
    submitting: '正在提交…',
    success: '已收到反馈，谢谢你帮助测试。',
    error: '提交失败，请稍后再试。',
    issueOptions: [['install', '安装问题'], ['activation', '启用问题'], ['typing', '输入异常'], ['candidates', '候选词问题'], ['performance', '闪退或性能'], ['other', '其他']],
    impactOptions: [['minor', '轻微，不影响继续使用'], ['normal', '一般，会影响部分使用'], ['blocking', '严重，无法继续使用']]
  },
  en: {
    kicker: 'Bug Feedback',
    title: 'Report a Maozhan Pinyin issue',
    intro: 'Send installation, activation, candidate, typing, crash, or performance problems directly to the Station Cat admin feedback queue.',
    platform: 'Platform',
    version: 'Version',
    issueType: 'Issue type',
    impact: 'Impact',
    summary: 'Issue summary',
    summaryPlaceholder: 'Example: Input method is missing after installation',
    details: 'Details',
    detailsPlaceholder: 'Describe what happened and what you expected instead.',
    steps: 'Steps to reproduce (optional)',
    stepsPlaceholder: '1. Open Settings\n2. Add the input method\n3. ...',
    environment: 'System environment (optional)',
    environmentPlaceholder: 'Example: Windows 11 24H2 / macOS 15.5',
    email: 'Contact email (optional)',
    emailPlaceholder: 'Only used if a reply is needed',
    submit: 'Submit bug feedback',
    submitting: 'Submitting…',
    success: 'Feedback received. Thank you for helping test the app.',
    error: 'Feedback could not be submitted. Please try again later.',
    issueOptions: [['install', 'Installation'], ['activation', 'Activation'], ['typing', 'Typing'], ['candidates', 'Candidates'], ['performance', 'Crash or performance'], ['other', 'Other']],
    impactOptions: [['minor', 'Minor, I can keep using it'], ['normal', 'Moderate, some use is affected'], ['blocking', 'Blocking, I cannot continue']]
  },
  ja: {
    kicker: 'Bug Feedback',
    title: '猫栈拼音の問題を報告',
    intro: 'インストール、有効化、候補、入力、クラッシュ、性能の問題を Station Cat 管理画面へ直接送信できます。',
    platform: 'プラットフォーム',
    version: 'バージョン',
    issueType: '問題の種類',
    impact: '影響度',
    summary: '問題の概要',
    summaryPlaceholder: '例：インストール後に入力メソッドが見つからない',
    details: '詳細',
    detailsPlaceholder: '起きたことと、期待していた動作を記入してください。',
    steps: '再現手順（任意）',
    stepsPlaceholder: '1. 設定を開く\n2. 入力メソッドを追加\n3. ...',
    environment: 'システム環境（任意）',
    environmentPlaceholder: '例：Windows 11 24H2 / macOS 15.5',
    email: '連絡用 Email（任意）',
    emailPlaceholder: '返信が必要な場合のみ使用します',
    submit: 'Bug フィードバックを送信',
    submitting: '送信中…',
    success: 'フィードバックを受け付けました。テストへのご協力ありがとうございます。',
    error: '送信できませんでした。しばらくしてから再度お試しください。',
    issueOptions: [['install', 'インストール'], ['activation', '有効化'], ['typing', '入力'], ['candidates', '候補'], ['performance', 'クラッシュ・性能'], ['other', 'その他']],
    impactOptions: [['minor', '軽微、使用を続けられる'], ['normal', '中程度、一部の使用に影響'], ['blocking', '重大、使用を続けられない']]
  }
}[lang];

const canonicalPath =
  lang === 'zh-Hant'
    ? privatePinyinProduct.zhHantProductPath
    : lang === 'zh-Hans'
      ? privatePinyinProduct.zhHansProductPath
      : lang === 'ja'
        ? privatePinyinProduct.jaProductPath
        : privatePinyinProduct.productPath;

const legalLinks =
  lang === 'zh-Hant'
    ? {
        privacy: privatePinyinProduct.privacyPaths.zhHant,
        privacyLabel: '隱私政策',
        support: privatePinyinProduct.supportPaths.zhHant,
        supportLabel: '支援與聯絡'
      }
    : lang === 'zh-Hans'
      ? {
          privacy: privatePinyinProduct.privacyPaths.zhHans,
          privacyLabel: '隐私政策',
          support: privatePinyinProduct.supportPaths.zhHans,
          supportLabel: '支持与联系'
        }
      : lang === 'ja'
        ? {
            privacy: privatePinyinProduct.privacyPaths.ja,
            privacyLabel: 'プライバシーポリシー',
            support: privatePinyinProduct.supportPaths.ja,
            supportLabel: 'サポート'
          }
        : {
            privacy: privatePinyinProduct.privacyPaths.en,
            privacyLabel: 'Privacy policy',
            support: privatePinyinProduct.supportPaths.en,
            supportLabel: 'Support'
          };
---

<BaseLayout
  title={copy.title}
  description={copy.intro}
  lang={lang}
  canonicalPath={canonicalPath}
  ogImage={privatePinyinProduct.assets.icon}
  bodyClass="station-paper-page radar-page privatepinyin-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: privatePinyinProduct.zhHantProductPath },
    { hrefLang: 'zh-Hans', href: privatePinyinProduct.zhHansProductPath },
    { hrefLang: 'en', href: privatePinyinProduct.productPath },
    { hrefLang: 'ja', href: privatePinyinProduct.jaProductPath },
    { hrefLang: 'x-default', href: privatePinyinProduct.zhHantProductPath }
  ]}
>
  <section class="radar-hero privatepinyin-hero">
    <div class="radar-hero__copy">
      <p class="section-kicker">{copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p>{copy.intro}</p>
      <div class="button-row">
        <a class="button button-primary" href={macDownload.downloadPath}>{copy.primary}</a>
        {windowsDownload && <a class="button button-secondary" href={windowsDownload.downloadPath}>{copy.windowsCta}</a>}
        <a class="button button-secondary" href={iosAppStore.url} target="_blank" rel="noreferrer">{copy.iosCta}</a>
        <a class="button button-secondary" href={copy.downloadHref}>{copy.secondary}</a>
        <a class="button button-secondary" href={legalLinks.privacy}>{legalLinks.privacyLabel}</a>
        <a class="button button-secondary" href={legalLinks.support}>{legalLinks.supportLabel}</a>
      </div>
    </div>
    <div class="privatepinyin-preview-card" aria-label={`${copy.title} app icon`}>
      <img src={privatePinyinProduct.assets.icon} alt={`${copy.title} app icon`} width="512" height="512" />
      <div>
        <p class="section-kicker">Windows {windowsVersion} · macOS {macVersion} · iOS {iosAppStore.version}</p>
        <h2>{copy.title}</h2>
        <p>{internalName}</p>
        <p>macOS / Windows / iOS</p>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="section-kicker">Input Method</p>
      <h2>{copy.featuresTitle}</h2>
    </div>
    <div class="radar-feature-grid">
      {copy.features.map(([title, text]) => (
        <article>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="radar-note-panel">
      <div>
        <p class="section-kicker">{copy.title}</p>
        <h2>{copy.notesTitle}</h2>
      </div>
      <ul>
        {copy.notes.filter(Boolean).map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </section>

  <section class="page-section privatepinyin-feedback" aria-labelledby={`privatepinyin-feedback-title-${lang}`}>
    <div class="section-heading">
      <p class="section-kicker">{feedbackCopy.kicker}</p>
      <h2 id={`privatepinyin-feedback-title-${lang}`}>{feedbackCopy.title}</h2>
      <p>{feedbackCopy.intro}</p>
    </div>
    <form
      class="privatepinyin-feedback-form"
      data-product-feedback-form
      data-locale={lang}
      data-mac-version={macVersion}
      data-windows-version={windowsVersion}
      data-submitting-label={feedbackCopy.submitting}
      data-success-message={feedbackCopy.success}
      data-error-message={feedbackCopy.error}
    >
      <div class="privatepinyin-feedback-grid">
        <label>
          {feedbackCopy.platform}
          <select name="platform" required>
            <option value="macos">macOS</option>
            <option value="windows">Windows</option>
            <option value="ios">iOS</option>
            <option value="other">Other</option>
          </select>
        </label>
        <label>
          {feedbackCopy.version}
          <input name="appVersion" value={macVersion} maxlength="40" required />
        </label>
        <label>
          {feedbackCopy.issueType}
          <select name="issueType" required>
            {feedbackCopy.issueOptions.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
        <label>
          {feedbackCopy.impact}
          <select name="impact" required>
            {feedbackCopy.impactOptions.map(([value, label]) => <option value={value} selected={value === 'normal'}>{label}</option>)}
          </select>
        </label>
        <label class="privatepinyin-feedback-wide">
          {feedbackCopy.summary}
          <input name="summary" minlength="4" maxlength="120" placeholder={feedbackCopy.summaryPlaceholder} required />
        </label>
        <label class="privatepinyin-feedback-wide">
          {feedbackCopy.details}
          <textarea name="details" rows="6" minlength="20" maxlength="4000" placeholder={feedbackCopy.detailsPlaceholder} required></textarea>
        </label>
        <label class="privatepinyin-feedback-wide">
          {feedbackCopy.steps}
          <textarea name="reproductionSteps" rows="4" maxlength="2000" placeholder={feedbackCopy.stepsPlaceholder}></textarea>
        </label>
        <label>
          {feedbackCopy.environment}
          <input name="environment" maxlength="500" placeholder={feedbackCopy.environmentPlaceholder} />
        </label>
        <label>
          {feedbackCopy.email}
          <input name="contactEmail" type="email" maxlength="254" autocomplete="email" placeholder={feedbackCopy.emailPlaceholder} />
        </label>
      </div>
      <label class="product-feedback-honeypot" aria-hidden="true">
        Website
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
      <div class="privatepinyin-feedback-actions">
        <button class="button button-primary" type="submit" data-product-feedback-submit>{feedbackCopy.submit}</button>
        <p class="privatepinyin-feedback-status" data-product-feedback-status role="status" aria-live="polite"></p>
      </div>
    </form>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-product-feedback-form]').forEach((form) => {
      const platform = form.elements.platform;
      const version = form.elements.appVersion;
      const submit = form.querySelector('[data-product-feedback-submit]');
      const status = form.querySelector('[data-product-feedback-status]');
      const submitLabel = submit.textContent;

      const syncVersion = () => {
        if (platform.value === 'macos') version.value = form.dataset.macVersion || '';
        else if (platform.value === 'windows') version.value = form.dataset.windowsVersion || '';
        else version.value = '';
      };

      platform.addEventListener('change', syncVersion);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        submit.disabled = true;
        submit.textContent = form.dataset.submittingLabel || submitLabel;
        form.setAttribute('aria-busy', 'true');
        status.textContent = '';
        status.dataset.tone = 'neutral';

        const values = new FormData(form);
        const payload = {
          appVersion: values.get('appVersion'),
          contactEmail: values.get('contactEmail'),
          details: values.get('details'),
          environment: values.get('environment'),
          impact: values.get('impact'),
          issueType: values.get('issueType'),
          locale: form.dataset.locale,
          platform: values.get('platform'),
          product: 'privatepinyin',
          reproductionSteps: values.get('reproductionSteps'),
          sourcePath: window.location.pathname,
          summary: values.get('summary'),
          viewportWidth: window.innerWidth,
          website: values.get('website')
        };

        try {
          const response = await fetch('/api/product-feedback', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || result.ok === false) throw new Error(result.message || 'Feedback request failed.');
          const selectedPlatform = platform.value;
          form.reset();
          platform.value = selectedPlatform;
          syncVersion();
          status.textContent = form.dataset.successMessage || 'Feedback received.';
          status.dataset.tone = 'success';
        } catch (error) {
          status.textContent = form.dataset.errorMessage || 'Feedback could not be submitted.';
          status.dataset.tone = 'error';
        } finally {
          submit.disabled = false;
          submit.textContent = submitLabel;
          form.removeAttribute('aria-busy');
        }
      });
    });
  </script>
</BaseLayout>
