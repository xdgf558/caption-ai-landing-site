---
import BaseLayout from '../layouts/BaseLayout.astro';
import { privatePinyinProduct } from '../data/products/privatepinyin';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const download = privatePinyinProduct.downloads[0];
const inputSourceName = '猫栈拼音';

const copy = {
  'zh-Hant': {
    title: 'PrivatePinyin',
    eyebrow: 'macOS Input Method',
    headline: 'PrivatePinyin：先從 macOS 開始的中文輸入法。',
    intro:
      'PrivatePinyin 是 Station Cat 正在測試的中文輸入法。第一個公開版本先提供 macOS pkg 安裝包，後續會繼續補上 Windows 和 iOS 版本。',
    primary: '下載 macOS 版',
    secondary: '查看下載資訊',
    downloadHref: privatePinyinProduct.zhHantDownloadPagePath,
    featuresTitle: '目前這個版本適合',
    features: [
      ['本機中文輸入', '先把 macOS 上的日常拼音輸入跑順，候選詞、標點和打字手感會持續調整。'],
      ['早期測試回饋', `${download.version} 是公開測試包，適合願意試用並回報問題的使用者。`],
      ['後續多平台', 'macOS 版本先上架，Windows 和 iOS 版本會在後續開發完成後補上。'],
      ['小而清楚的下載入口', '安裝包、版本、大小和 SHA-256 都集中在下載頁，方便確認來源。']
    ],
    notesTitle: '上架狀態',
    notes: [
      `目前版本：${download.version}`,
      `${download.platform}，${download.architecture}，${download.minimumSystem}`,
      '目前只提供 macOS pkg 安裝包。',
      `安裝後請在系統輸入法設定裡加入「${inputSourceName}」（PrivatePinyin）。`,
      '目前安裝包只支援 Apple Silicon Mac，Intel Mac 暫不支援。',
      '這是早期測試版，首次安裝時請以 macOS 安全提示為準。'
    ]
  },
  'zh-Hans': {
    title: 'PrivatePinyin',
    eyebrow: 'macOS Input Method',
    headline: 'PrivatePinyin：先从 macOS 开始的中文输入法。',
    intro:
      'PrivatePinyin 是 Station Cat 正在测试的中文输入法。第一个公开版本先提供 macOS pkg 安装包，后续会继续补上 Windows 和 iOS 版本。',
    primary: '下载 macOS 版',
    secondary: '查看下载信息',
    downloadHref: privatePinyinProduct.zhHansDownloadPagePath,
    featuresTitle: '目前这个版本适合',
    features: [
      ['本机中文输入', '先把 macOS 上的日常拼音输入跑顺，候选词、标点和打字手感会持续调整。'],
      ['早期测试反馈', `${download.version} 是公开测试包，适合愿意试用并反馈问题的用户。`],
      ['后续多平台', 'macOS 版本先上架，Windows 和 iOS 版本会在后续开发完成后补上。'],
      ['小而清楚的下载入口', '安装包、版本、大小和 SHA-256 都集中在下载页，方便确认来源。']
    ],
    notesTitle: '上架状态',
    notes: [
      `当前版本：${download.version}`,
      `${download.platform}，${download.architecture}，${download.minimumSystem}`,
      '目前只提供 macOS pkg 安装包。',
      `安装后请在系统输入法设置里加入「${inputSourceName}」（PrivatePinyin）。`,
      '目前安装包只支持 Apple Silicon Mac，Intel Mac 暂不支持。',
      '这是早期测试版，首次安装时请以 macOS 安全提示为准。'
    ]
  },
  en: {
    title: 'PrivatePinyin',
    eyebrow: 'macOS Input Method',
    headline: 'PrivatePinyin, a Chinese input method starting on macOS.',
    intro:
      'PrivatePinyin is a Chinese input method being tested by Station Cat. The first public build is a macOS pkg installer, with Windows and iOS versions planned for later.',
    primary: 'Download for macOS',
    secondary: 'View download info',
    downloadHref: privatePinyinProduct.downloadPagePath,
    featuresTitle: 'What this build is for',
    features: [
      ['Local Chinese typing', 'The first focus is making daily pinyin input on macOS feel steady, with candidates, punctuation, and typing flow improving over time.'],
      ['Early testing feedback', `${download.version} is a public test package for people who are comfortable trying early builds and reporting issues.`],
      ['Multi-platform roadmap', 'The macOS version comes first. Windows and iOS builds will follow when they are ready.'],
      ['Clear download trail', 'The installer, version, size, and SHA-256 checksum are kept together on the download page.']
    ],
    notesTitle: 'Release status',
    notes: [
      `Current version: ${download.version}`,
      `${download.platform}, ${download.architecture}, ${download.minimumSystem}`,
      'The current public download is a macOS pkg installer.',
      `After installing, add "${inputSourceName}" (PrivatePinyin) in System Settings > Keyboard > Input Sources.`,
      'The current installer supports Apple Silicon Macs only. Intel Macs are not supported yet.',
      'This is an early test build. Follow macOS security prompts during first install.'
    ]
  },
  ja: {
    title: 'PrivatePinyin',
    eyebrow: 'macOS Input Method',
    headline: 'PrivatePinyin：macOS から始める中国語入力メソッド。',
    intro:
      'PrivatePinyin は Station Cat がテストしている中国語入力メソッドです。最初の公開版は macOS pkg インストーラーで、Windows と iOS 版は今後追加予定です。',
    primary: 'macOS 版をダウンロード',
    secondary: 'ダウンロード情報を見る',
    downloadHref: privatePinyinProduct.jaDownloadPagePath,
    featuresTitle: 'このバージョンでできること',
    features: [
      ['ローカル中国語入力', 'まずは macOS での日常的なピンイン入力、候補、句読点、入力感を整えていきます。'],
      ['早期テストのフィードバック', `${download.version} は公開テストパッケージです。早期版を試し、問題を共有できる方向けです。`],
      ['複数プラットフォーム予定', 'macOS 版を先に公開し、Windows と iOS 版は準備ができ次第追加します。'],
      ['わかりやすい配布情報', 'インストーラー、バージョン、サイズ、SHA-256 をダウンロードページにまとめています。']
    ],
    notesTitle: '公開状況',
    notes: [
      `現在のバージョン：${download.version}`,
      `${download.platform}、${download.architecture}、${download.minimumSystem}`,
      '現在は macOS pkg インストーラーのみ提供しています。',
      `インストール後、システムの入力メソッド設定で「${inputSourceName}」（PrivatePinyin）を追加してください。`,
      '現在のインストーラーは Apple Silicon Mac のみ対応です。Intel Mac はまだ対応していません。',
      'これは早期テスト版です。初回インストール時は macOS の安全確認に従ってください。'
    ]
  }
}[lang];

const canonicalPath =
  lang === 'zh-Hant'
    ? privatePinyinProduct.zhHantProductPath
    : lang === 'zh-Hans'
      ? privatePinyinProduct.zhHansProductPath
      : lang === 'ja'
        ? privatePinyinProduct.jaProductPath
        : privatePinyinProduct.productPath;
---

<BaseLayout
  title={copy.title}
  description={copy.intro}
  lang={lang}
  canonicalPath={canonicalPath}
  ogImage={privatePinyinProduct.assets.icon}
  bodyClass="station-paper-page radar-page privatepinyin-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: privatePinyinProduct.zhHantProductPath },
    { hrefLang: 'zh-Hans', href: privatePinyinProduct.zhHansProductPath },
    { hrefLang: 'en', href: privatePinyinProduct.productPath },
    { hrefLang: 'ja', href: privatePinyinProduct.jaProductPath },
    { hrefLang: 'x-default', href: privatePinyinProduct.zhHantProductPath }
  ]}
>
  <section class="radar-hero privatepinyin-hero">
    <div class="radar-hero__copy">
      <p class="section-kicker">{copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p>{copy.intro}</p>
      <div class="button-row">
        <a class="button button-primary" href={download.downloadPath}>{copy.primary}</a>
        <a class="button button-secondary" href={copy.downloadHref}>{copy.secondary}</a>
      </div>
    </div>
    <div class="privatepinyin-preview-card" aria-label="PrivatePinyin app icon">
      <img src={privatePinyinProduct.assets.icon} alt="PrivatePinyin app icon" width="512" height="512" />
      <div>
        <p class="section-kicker">Version {download.version}</p>
        <h2>PrivatePinyin</h2>
        <p>{download.label}</p>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="section-kicker">Input Method</p>
      <h2>{copy.featuresTitle}</h2>
    </div>
    <div class="radar-feature-grid">
      {copy.features.map(([title, text]) => (
        <article>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="radar-note-panel">
      <div>
        <p class="section-kicker">PrivatePinyin</p>
        <h2>{copy.notesTitle}</h2>
      </div>
      <ul>
        {copy.notes.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
