---
interface Props {
  id: string;
  title: string;
  description: string;
  formUrl: string;
  product: string;
  locale: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
  platform: 'ios' | 'android';
  privacyPath: string;
  buttonLabel: string;
  source?: string;
}

const { id, title, description, formUrl, product, locale, platform, privacyPath, buttonLabel, source = '' } = Astro.props;
const isRealTally = formUrl.startsWith('https://tally.so/');
const isApiForm = formUrl.startsWith('/api/');
const privacyPrefix =
  locale === 'ja'
    ? '送信前に '
    : locale === 'zh-Hant'
      ? '送出前，請先閱讀'
      : locale === 'zh-Hans'
        ? '提交前，请先阅读'
      : 'Before submitting, review the ';
const privacyLabel =
  locale === 'ja' ? 'プライバシーポリシー' : locale === 'zh-Hant' ? '隱私政策' : locale === 'zh-Hans' ? '隐私政策' : 'privacy policy';
const privacySuffix = locale === 'ja' ? ' をご確認ください。' : locale === 'zh-Hant' || locale === 'zh-Hans' ? '。' : '.';
---

<section class="waitlist-panel" id={id}>
  <div>
    <p class="section-kicker">{
      platform === 'ios'
        ? locale === 'ja'
          ? 'iOS のお知らせ'
          : locale === 'zh-Hant'
            ? 'iOS 通知'
            : locale === 'zh-Hans'
              ? 'iOS 通知'
              : 'iOS updates'
        : locale === 'ja'
          ? 'Android のお知らせ'
          : locale === 'zh-Hant'
            ? 'Android 通知'
            : locale === 'zh-Hans'
              ? 'Android 通知'
              : 'Android updates'
    }</p>
    <h2>{title}</h2>
    <p>{description}</p>
    <p class="form-privacy">
      {privacyPrefix}
      <a href={privacyPath}>{privacyLabel}</a>
      {privacySuffix}
    </p>
  </div>

  {isApiForm ? (
    <form class="mock-form js-waitlist-form" aria-label={title} data-endpoint={formUrl}>
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required placeholder="name@example.com" />
      <input type="hidden" name="product" value={product} />
      <input type="hidden" name="source" value={source} />
      <input type="hidden" name="locale" value={locale} />
      <input type="hidden" name="platform" value={platform} />
      <input type="hidden" name="utm_source" value="" />
      <input type="hidden" name="utm_medium" value="" />
      <input type="hidden" name="utm_campaign" value="" />
      <input type="hidden" name="utm_content" value="" />
      <input type="hidden" name="landing_path" value={Astro.url.pathname} />
      <button class="button button-primary" type="submit">{buttonLabel}</button>
      <p class="waitlist-result" aria-live="polite" hidden></p>
    </form>
  ) : isRealTally ? (
    <iframe
      class="tally-frame js-tally-frame"
      data-base-url={formUrl}
      data-product={product}
      data-locale={locale}
      data-platform={platform}
      data-source={source}
      title={title}
      loading="lazy"
    ></iframe>
  ) : (
    <form class="mock-form" aria-label={title}>
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" placeholder="name@example.com" />
      <input type="hidden" name="product" value={product} />
      <input type="hidden" name="source" value={source} />
      <input type="hidden" name="locale" value={locale} />
      <input type="hidden" name="platform" value={platform} />
      <input type="hidden" name="utm_source" value="" />
      <input type="hidden" name="utm_medium" value="" />
      <input type="hidden" name="utm_campaign" value="" />
      <input type="hidden" name="utm_content" value="" />
      <input type="hidden" name="landing_path" value={Astro.url.pathname} />
      <button class="button button-primary" type="button">{buttonLabel}</button>
      <p class="placeholder-note">
        {locale === 'ja'
          ? 'Tally の実フォーム URL を設定すると、この場所に埋め込みフォームが表示されます。'
          : locale === 'zh-Hant'
            ? '設定正式的 Tally 表單 URL 後，這裡會顯示嵌入式通知表單。'
          : locale === 'zh-Hans'
            ? '设置正式的 Tally 表单 URL 后，这里会显示嵌入式通知表单。'
          : 'Replace the Tally placeholder URL to show the embedded waitlist form here.'}
      </p>
    </form>
  )}
</section>

<script>
  const resultCopy = {
    en: {
      loading: 'Submitting...',
      invite: 'Your invitation link is ready:',
      waitlisted: 'Your request was received. We will email you when there is an update.',
      error: 'Something went wrong. Please try again later.',
      open: 'Open link'
    },
    ja: {
      loading: '送信中...',
      invite: '案内リンクを用意しました:',
      waitlisted: 'リクエストを受け付けました。更新がある場合はメールでお知らせします。',
      error: '送信できませんでした。時間をおいて再度お試しください。',
      open: 'リンクを開く'
    },
    'zh-Hant': {
      loading: '送出中...',
      invite: '你的邀請連結已準備好：',
      waitlisted: '已收到你的通知需求。有更新時我們會寄信通知你。',
      error: '送出失敗，請稍後再試。',
      open: '開啟連結'
    },
    'zh-Hans': {
      loading: '提交中...',
      invite: '你的邀请链接已准备好：',
      waitlisted: '已收到你的通知需求。有更新时我们会发邮件通知你。',
      error: '提交失败，请稍后再试。',
      open: '打开链接'
    }
  };

  document.querySelectorAll('.js-waitlist-form').forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    const result = form.querySelector('.waitlist-result');
    const button = form.querySelector('button[type="submit"]');
    const copy = resultCopy[form.elements.locale?.value] || resultCopy.en;

    const setResult = (html, tone = 'neutral') => {
      if (!(result instanceof HTMLElement)) return;
      result.hidden = false;
      result.dataset.tone = tone;
      result.innerHTML = html;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(button instanceof HTMLButtonElement)) return;
      const endpoint = form.dataset.endpoint;
      if (!endpoint) return;

      const params = new URLSearchParams(window.location.search);
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach((key) => {
        const input = form.elements.namedItem(key);
        if (input instanceof HTMLInputElement) input.value = params.get(key) || '';
      });
      const landingPath = form.elements.namedItem('landing_path');
      if (landingPath instanceof HTMLInputElement) landingPath.value = window.location.pathname;

      button.disabled = true;
      setResult(copy.loading);

      try {
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (!response.ok || !data.ok) {
          throw new Error(data.message || copy.error);
        }

        if (data.status === 'invite' && data.publicLink) {
          setResult(
            `${copy.invite}<br /><a class="button button-secondary" href="${data.publicLink}" target="_blank" rel="noopener noreferrer">${copy.open}</a>`,
            'success'
          );
        } else {
          setResult(data.message || copy.waitlisted, 'success');
        }
      } catch (error) {
        setResult(error instanceof Error ? error.message : copy.error, 'error');
      } finally {
        button.disabled = false;
      }
    });
  });

  document.querySelectorAll('.js-tally-frame').forEach((frame) => {
    if (!(frame instanceof HTMLIFrameElement)) return;
    const baseUrl = frame.dataset.baseUrl;
    if (!baseUrl) return;
    const params = new URLSearchParams(window.location.search);
    params.set('product', frame.dataset.product || '');
    params.set('locale', frame.dataset.locale || '');
    params.set('platform', frame.dataset.platform || '');
    if (!params.has('source')) params.set('source', frame.dataset.source || '');
    params.set('landing_path', window.location.pathname);
    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach((key) => {
      if (!params.has(key)) params.set(key, '');
    });
    const separator = baseUrl.includes('?') ? '&' : '?';
    frame.src = `${baseUrl}${separator}${params.toString()}`;
  });
</script>
