---
import BaseLayout from '../layouts/BaseLayout.astro';
import { anyTlsDesktopManagerProduct } from '../data/products/anytls-desktop-manager';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const [macDownload, windowsDownload] = anyTlsDesktopManagerProduct.downloads;

const copy = {
  'zh-Hant': {
    title: 'NodePilot',
    eyebrow: 'Desktop Test Builds',
    headline: '用一個桌面小工具，整理你被授權管理的 AnyTLS 配置。',
    intro:
      'NodePilot 是一個早期桌面測試版，用來幫你在本機整理、查看和管理自己的 AnyTLS 相關配置。目前提供 macOS Apple Silicon 和 Windows x64 下載。它適合個人學習、內部測試和你明確有權管理的環境，不應用於未授權的網路、帳號、服務或第三方系統。',
    primaryMac: '下載 macOS arm64',
    primaryWindows: '下載 Windows x64',
    secondary: '返回 Apps',
    secondaryHref: '/zh-hant/apps/',
    iconAlt: 'NodePilot 軟體圖標',
    featuresTitle: '可以謹慎用在哪裡',
    features: [
      ['本機配置整理', '把常用配置、連線資訊和備註集中放在桌面端，減少手動翻找。'],
      ['測試環境管理', '適合管理你自己搭建或團隊授權的測試節點與設定。'],
      ['日常狀態檢查', '在使用前確認配置是否完整、版本是否對應、備註是否清楚。'],
      ['保留操作邊界', '頁面和軟體都不鼓勵、也不提供未授權訪問、規避限制或侵犯第三方服務的用途。']
    ],
    releaseTitle: '0.2.26 版本更新',
    releaseNotes: [
      '重新設計 NodePilot 工作區，加入固定左側導航並簡化各頁面的資訊層級。',
      '改善鍵盤焦點、減少動態效果支援與響應式版面。',
      '切換語言時只儲存語言偏好，不再連帶提交其他尚未儲存的設定。'
    ],
    notesTitle: '下載前請先確認',
    notes: [
      `目前版本：macOS ${macDownload.version}；Windows ${windowsDownload.version}`,
      `${macDownload.platform} ${macDownload.architecture}，${macDownload.minimumSystem}`,
      `${windowsDownload.platform} ${windowsDownload.architecture}，${windowsDownload.minimumSystem}`,
      '這是早期測試版，可能會有錯誤、相容性問題或未完善的介面。',
      '請只在你擁有或已獲授權管理的系統、伺服器和網路環境中使用。',
      '請遵守所在地法律、服務條款、組織政策和網路管理規範。'
    ],
    metaTitle: '選擇下載版本',
    checksum: 'SHA-256',
    downloadLabels: {
      mac: {
        title: 'macOS Apple Silicon 測試版',
        button: '下載 macOS DMG',
        warning: 'macOS 可能會提示未驗證開發者或安全確認。請先核對來源和 SHA-256，再自行決定是否打開。'
      },
      windows: {
        title: 'Windows x64 測試版',
        button: '下載 Windows 安裝包',
        warning: 'Windows 可能會提示未知發布者或安全確認。下載後請核對來源和 SHA-256，再自行決定是否安裝。'
      }
    }
  },
  'zh-Hans': {
    title: 'NodePilot',
    eyebrow: 'Desktop Test Builds',
    headline: '用一个桌面小工具，整理你被授权管理的 AnyTLS 配置。',
    intro:
      'NodePilot 是一个早期桌面测试版，用来帮你在本机整理、查看和管理自己的 AnyTLS 相关配置。目前提供 macOS Apple Silicon 和 Windows x64 下载。它适合个人学习、内部测试和你明确有权管理的环境，不应用于未授权的网络、账号、服务或第三方系统。',
    primaryMac: '下载 macOS arm64',
    primaryWindows: '下载 Windows x64',
    secondary: '返回 Apps',
    secondaryHref: '/zh-hans/apps/',
    iconAlt: 'NodePilot 软件图标',
    featuresTitle: '可以谨慎用在哪里',
    features: [
      ['本机配置整理', '把常用配置、连接信息和备注集中放在桌面端，减少手动翻找。'],
      ['测试环境管理', '适合管理你自己搭建或团队授权的测试节点与设置。'],
      ['日常状态检查', '在使用前确认配置是否完整、版本是否对应、备注是否清楚。'],
      ['保留操作边界', '页面和软件都不鼓励、也不提供未授权访问、规避限制或侵犯第三方服务的用途。']
    ],
    releaseTitle: '0.2.26 版本更新',
    releaseNotes: [
      '重新设计 NodePilot 工作区，加入固定左侧导航并简化各页面的信息层级。',
      '改善键盘焦点、减少动态效果支持与响应式布局。',
      '切换语言时只保存语言偏好，不再连带提交其他尚未保存的设置。'
    ],
    notesTitle: '下载前请先确认',
    notes: [
      `当前版本：macOS ${macDownload.version}；Windows ${windowsDownload.version}`,
      `${macDownload.platform} ${macDownload.architecture}，${macDownload.minimumSystem}`,
      `${windowsDownload.platform} ${windowsDownload.architecture}，${windowsDownload.minimumSystem}`,
      '这是早期测试版，可能会有错误、兼容性问题或未完善的界面。',
      '请只在你拥有或已获授权管理的系统、服务器和网络环境中使用。',
      '请遵守所在地法律、服务条款、组织政策和网络管理规范。'
    ],
    metaTitle: '选择下载版本',
    checksum: 'SHA-256',
    downloadLabels: {
      mac: {
        title: 'macOS Apple Silicon 测试版',
        button: '下载 macOS DMG',
        warning: 'macOS 可能会提示未验证开发者或安全确认。请先核对来源和 SHA-256，再自行决定是否打开。'
      },
      windows: {
        title: 'Windows x64 测试版',
        button: '下载 Windows 安装包',
        warning: 'Windows 可能会提示未知发布者或安全确认。下载后请核对来源和 SHA-256，再自行决定是否安装。'
      }
    }
  },
  en: {
    title: 'NodePilot',
    eyebrow: 'Desktop Test Builds',
    headline: 'A desktop utility for AnyTLS configurations you are authorized to manage.',
    intro:
      'NodePilot is an early desktop test build for organizing, reviewing, and managing your own AnyTLS-related configuration notes locally. It now offers macOS Apple Silicon and Windows x64 downloads. It is intended for personal learning, internal testing, and environments you are explicitly authorized to manage. It is not intended for unauthorized access, bypassing restrictions, or interfering with third-party systems.',
    primaryMac: 'Download macOS arm64',
    primaryWindows: 'Download Windows x64',
    secondary: 'Back to Apps',
    secondaryHref: '/apps/',
    iconAlt: 'NodePilot app icon',
    featuresTitle: 'Careful use cases',
    features: [
      ['Local configuration notes', 'Keep frequently used profiles, connection details, and notes in one desktop workspace.'],
      ['Authorized test environments', 'Manage settings for servers, systems, or networks you own or are permitted to administer.'],
      ['Daily readiness checks', 'Review whether a profile is complete, versioned, and clearly documented before use.'],
      ['Clear boundaries', 'The page and software do not encourage or provide unauthorized access, restriction bypassing, or misuse of third-party services.']
    ],
    releaseTitle: 'What is new in 0.2.26',
    releaseNotes: [
      'Redesigned the NodePilot workspace with a fixed sidebar and clearer, quieter page layouts.',
      'Improved keyboard focus visibility, reduced-motion support, and responsive layouts.',
      'Language switching now saves only the language preference and leaves other draft settings untouched.'
    ],
    notesTitle: 'Before downloading',
    notes: [
      `Current versions: macOS ${macDownload.version}; Windows ${windowsDownload.version}`,
      `${macDownload.platform} ${macDownload.architecture}, ${macDownload.minimumSystem}`,
      `${windowsDownload.platform} ${windowsDownload.architecture}, ${windowsDownload.minimumSystem}`,
      'These are early test builds and may contain bugs, compatibility issues, or unfinished UI.',
      'Use them only with systems, servers, and networks you own or are authorized to manage.',
      'Follow applicable laws, service terms, organizational policies, and network administration rules.'
    ],
    metaTitle: 'Choose a download',
    checksum: 'SHA-256',
    downloadLabels: {
      mac: {
        title: 'macOS Apple Silicon test build',
        button: 'Download macOS DMG',
        warning: 'macOS may show an unidentified developer or security prompt. Verify the source and SHA-256 before deciding whether to open it.'
      },
      windows: {
        title: 'Windows x64 test build',
        button: 'Download Windows installer',
        warning: 'Windows may show an unknown publisher or security prompt. Verify the source and SHA-256 before deciding whether to install.'
      }
    }
  },
  ja: {
    title: 'NodePilot',
    eyebrow: 'Desktop Test Builds',
    headline: '管理権限のある AnyTLS 設定を整理するためのデスクトップツール。',
    intro:
      'NodePilot は、AnyTLS 関連の設定メモをローカルで整理・確認・管理するための早期デスクトップテスト版です。現在は macOS Apple Silicon と Windows x64 のダウンロードを用意しています。個人学習、内部テスト、自分または所属組織が明確に管理権限を持つ環境での利用を想定しています。未承認アクセス、制限回避、第三者システムへの干渉を目的としたものではありません。',
    primaryMac: 'macOS arm64 をダウンロード',
    primaryWindows: 'Windows x64 をダウンロード',
    secondary: 'Apps に戻る',
    secondaryHref: '/ja/apps/',
    iconAlt: 'NodePilot アプリアイコン',
    featuresTitle: '慎重に使う場面',
    features: [
      ['ローカル設定の整理', 'よく使うプロファイル、接続情報、メモをデスクトップ上でまとめます。'],
      ['承認済みテスト環境', '自分またはチームが管理を許可されたサーバーやネットワーク設定を扱います。'],
      ['日常の確認', '利用前に設定、バージョン、メモが分かりやすいか確認します。'],
      ['利用範囲を明確に', 'このページとソフトウェアは、未承認アクセス、制限回避、第三者サービスの不正利用を推奨しません。']
    ],
    releaseTitle: '0.2.26 アップデート',
    releaseNotes: [
      '固定サイドバーとより明確な情報階層で NodePilot ワークスペースを再設計しました。',
      'キーボードフォーカスの視認性、動きを減らす設定、レスポンシブレイアウトを改善しました。',
      '言語切り替え時は言語設定のみを保存し、未保存の他の設定には影響しません。'
    ],
    notesTitle: 'ダウンロード前の確認',
    notes: [
      `現在のバージョン：macOS ${macDownload.version}、Windows ${windowsDownload.version}`,
      `${macDownload.platform} ${macDownload.architecture}、${macDownload.minimumSystem}`,
      `${windowsDownload.platform} ${windowsDownload.architecture}、${windowsDownload.minimumSystem}`,
      'これは早期テスト版であり、不具合、互換性の問題、未完成の UI が含まれる可能性があります。',
      '自分が所有している、または管理を許可されたシステム、サーバー、ネットワークでのみ使用してください。',
      '適用される法律、サービス規約、組織ポリシー、ネットワーク管理ルールに従ってください。'
    ],
    metaTitle: 'ダウンロードを選択',
    checksum: 'SHA-256',
    downloadLabels: {
      mac: {
        title: 'macOS Apple Silicon テスト版',
        button: 'macOS DMG をダウンロード',
        warning: 'macOS が未確認の開発元やセキュリティ確認を表示する場合があります。開く前に配布元と SHA-256 を確認してください。'
      },
      windows: {
        title: 'Windows x64 テスト版',
        button: 'Windows インストーラーをダウンロード',
        warning: 'Windows が不明な発行元やセキュリティ確認を表示する場合があります。インストール前に配布元と SHA-256 を確認してください。'
      }
    }
  }
}[lang];

const canonicalPath =
  lang === 'zh-Hant'
    ? anyTlsDesktopManagerProduct.zhHantProductPath
    : lang === 'zh-Hans'
      ? anyTlsDesktopManagerProduct.zhHansProductPath
      : lang === 'ja'
        ? anyTlsDesktopManagerProduct.jaProductPath
        : anyTlsDesktopManagerProduct.productPath;

const localizedDownloads = [
  {
    ...macDownload,
    title: copy.downloadLabels.mac.title,
    button: copy.downloadLabels.mac.button,
    warning: copy.downloadLabels.mac.warning
  },
  {
    ...windowsDownload,
    title: copy.downloadLabels.windows.title,
    button: copy.downloadLabels.windows.button,
    warning: copy.downloadLabels.windows.warning
  }
];
---

<BaseLayout
  title={`${copy.title} for macOS and Windows`}
  description={copy.intro}
  lang={lang}
  canonicalPath={canonicalPath}
  ogImage={anyTlsDesktopManagerProduct.assets.icon}
  bodyClass="station-paper-page radar-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: anyTlsDesktopManagerProduct.zhHantProductPath },
    { hrefLang: 'zh-Hans', href: anyTlsDesktopManagerProduct.zhHansProductPath },
    { hrefLang: 'en', href: anyTlsDesktopManagerProduct.productPath },
    { hrefLang: 'ja', href: anyTlsDesktopManagerProduct.jaProductPath },
    { hrefLang: 'x-default', href: anyTlsDesktopManagerProduct.zhHantProductPath }
  ]}
>
  <section class="radar-hero">
    <div class="radar-hero__copy">
      <p class="section-kicker">{copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p>{copy.intro}</p>
      <div class="button-row">
        <a class="button button-primary" href={macDownload.downloadPath}>{copy.primaryMac}</a>
        <a class="button button-secondary" href={windowsDownload.downloadPath}>{copy.primaryWindows}</a>
        <a class="button button-secondary" href={copy.secondaryHref}>{copy.secondary}</a>
      </div>
    </div>
    <div class="radar-preview-card anytls-icon-preview" aria-label="NodePilot app icon">
      <img src={anyTlsDesktopManagerProduct.assets.icon} alt={copy.iconAlt} width="512" height="512" />
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="section-kicker">Use carefully</p>
      <h2>{copy.featuresTitle}</h2>
    </div>
    <div class="radar-feature-grid">
      {copy.features.map(([title, text]) => (
        <article>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="radar-note-panel">
      <div>
        <p class="section-kicker">Release notes</p>
        <h2>{copy.releaseTitle}</h2>
      </div>
      <ul>
        {copy.releaseNotes.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </section>

  <section class="page-section">
    <div class="radar-note-panel">
      <div>
        <p class="section-kicker">Version {anyTlsDesktopManagerProduct.latestVersion}</p>
        <h2>{copy.notesTitle}</h2>
      </div>
      <ul>
        {copy.notes.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </section>

  <section class="download-box radar-download-box">
    <h2>{copy.metaTitle}</h2>
    <div class="anytls-download-grid">
      {localizedDownloads.map((download) => (
        <article class="anytls-download-card">
          <div>
            <p class="section-kicker">{download.label}</p>
            <h3>{download.title}</h3>
          </div>
          <dl class="radar-meta-list">
            <div>
              <dt>Version</dt>
              <dd>{download.version}</dd>
            </div>
            <div>
              <dt>Platform</dt>
              <dd>{download.platform}</dd>
            </div>
            <div>
              <dt>Architecture</dt>
              <dd>{download.architecture}</dd>
            </div>
            <div>
              <dt>Minimum system</dt>
              <dd>{download.minimumSystem}</dd>
            </div>
            <div>
              <dt>File size</dt>
              <dd>{download.fileSize}</dd>
            </div>
          </dl>
          <div class="checksum-block">
            <strong>{copy.checksum}</strong>
            <code>{download.sha256}</code>
          </div>
          <p>{download.warning}</p>
          <a class="button button-primary" href={download.downloadPath}>{download.button}</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
