---
import ProductLayout from '../layouts/ProductLayout.astro';
import FAQ from './FAQ.astro';
import { mindBudgetProduct } from '../data/products/mindbudget';
interface Props { lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans'; }
const { lang = 'zh-Hant' } = Astro.props;
const copy = {
  'zh-Hant': { title: 'MindBudget 支援', description: 'MindBudget 公測版的安裝、回饋與隱私協助。', heading: 'MindBudget 公測支援。', intro: '遇到安裝、資料、顯示或功能問題時，請寄信並註明 MindBudget、App 版本、iOS 版本與可重現步驟。', email: '寄送支援郵件', privacy: '隱私政策', product: '產品頁', cautions: ['請勿寄送真實帳目、原始 CSV、密碼或其他敏感資料。', '介面問題可附經過遮蔽的截圖。', '崩潰與 TestFlight 意見也可以直接透過 TestFlight 回報。'], faq: [['資料會同步到雲端嗎？', '不會。現在的公測版沒有帳號或雲端同步，財務記錄保存在 App 容器內。'], ['換手機後資料會自動回來嗎？', '不會。請先匯出 CSV 作為帳本記錄；目前 CSV 不是完整資料庫備份。'], ['如何完全刪除資料？', '在設定的隱私頁使用「刪除全部」，依照兩次確認完成清除。']] },
  'zh-Hans': { title: '花有数支持', description: '花有数公测版的安装、反馈与隐私帮助。', heading: '花有数公测支持。', intro: '遇到安装、数据、显示或功能问题时，请发邮件并注明花有数、应用版本、iOS 版本与复现步骤。', email: '发送支持邮件', privacy: '隐私政策', product: '产品页', cautions: ['请勿发送真实账目、原始 CSV、密码或其他敏感数据。', '界面问题可附经过遮挡的截图。', '崩溃与 TestFlight 意见也可以直接通过 TestFlight 反馈。'], faq: [['数据会同步到云端吗？', '不会。当前公测版没有账号或云同步，财务记录保存在应用容器内。'], ['换手机后数据会自动回来吗？', '不会。请先导出 CSV 作为账本记录；当前 CSV 不是完整数据库备份。'], ['如何完全删除数据？', '在设置的隐私页面使用“删除全部”，按照两次确认完成清除。']] },
  en: { title: 'MindBudget Support', description: 'Installation, feedback, and privacy help for the MindBudget public beta.', heading: 'MindBudget public beta support.', intro: 'For installation, data, display, or feature problems, email us with MindBudget, the app version, your iOS version, and reproducible steps.', email: 'Email support', privacy: 'Privacy policy', product: 'Product page', cautions: ['Do not send real financial records, raw CSV files, passwords, or other sensitive data.', 'A redacted screenshot is useful for interface issues.', 'Crashes and TestFlight feedback can also be submitted directly through TestFlight.'], faq: [['Does MindBudget sync to the cloud?', 'No. The current beta has no account or cloud sync. Financial records stay in the app container.'], ['Will data return on a new phone?', 'No. Export CSV first as a ledger record. The CSV is not a full database backup.'], ['How do I remove all data?', 'Open Privacy in Settings and use Delete All, then complete both confirmations.']] },
  ja: { title: 'MindBudget サポート', description: 'MindBudget 公開テスト版のインストール、フィードバック、プライバシー支援。', heading: 'MindBudget 公開テスト版サポート。', intro: 'インストール、データ、表示、機能の問題は、MindBudget、アプリ版、iOS 版、再現手順を記載してメールしてください。', email: 'サポートへメール', privacy: 'プライバシー', product: '製品ページ', cautions: ['実際の金融記録、元の CSV、パスワード、機密情報を送らないでください。', '画面の問題には情報を隠したスクリーンショットが役立ちます。', 'クラッシュと TestFlight の意見は TestFlight からも送信できます。'], faq: [['クラウド同期しますか？', 'いいえ。現在の版にアカウントやクラウド同期はなく、記録はアプリコンテナ内に残ります。'], ['新しい iPhone でデータは戻りますか？', '自動では戻りません。先に CSV を書き出してください。CSV は完全なデータベースバックアップではありません。'], ['すべて削除するには？', '設定のプライバシーから「すべて削除」を選び、2段階の確認を完了します。']] }
}[lang];
const localeKey = lang === 'zh-Hant' ? 'zhHant' : lang === 'zh-Hans' ? 'zhHans' : lang;
const productPath = lang === 'zh-Hant' ? mindBudgetProduct.zhHantProductPath : lang === 'zh-Hans' ? mindBudgetProduct.zhHansProductPath : lang === 'ja' ? mindBudgetProduct.jaProductPath : mindBudgetProduct.productPath;
---
<ProductLayout title={copy.title} description={copy.description} lang={lang} canonicalPath={mindBudgetProduct.supportPaths[localeKey]} ogImage={mindBudgetProduct.assets.icon} bodyClass="station-paper-page" alternates={[
  { hrefLang: 'zh-Hant', href: mindBudgetProduct.supportPaths.zhHant }, { hrefLang: 'zh-Hans', href: mindBudgetProduct.supportPaths.zhHans }, { hrefLang: 'en', href: mindBudgetProduct.supportPaths.en }, { hrefLang: 'ja', href: mindBudgetProduct.supportPaths.ja }, { hrefLang: 'x-default', href: mindBudgetProduct.supportPaths.zhHant }
]}><section class="page-shell"><p class="section-kicker">Support</p><h1>{copy.heading}</h1><p>{copy.intro}</p><ul class="check-list">{copy.cautions.map((item) => <li>{item}</li>)}</ul><div class="button-row"><a class="button button-primary" href={`mailto:${mindBudgetProduct.supportEmail}?subject=MindBudget%20Support`}>{copy.email}</a><a class="button button-secondary" href={mindBudgetProduct.privacyPaths[localeKey]}>{copy.privacy}</a><a class="button button-secondary" href={productPath}>{copy.product}</a></div></section><FAQ title="FAQ" items={copy.faq.map(([question, answer]) => ({ question, answer }))} /></ProductLayout>
