---
interface Props {
  copy: {
    eyebrow: string;
    productName?: string;
    title: string;
    subtitle: string;
    primaryCta: string;
    secondaryCta: string;
  };
  image?: string;
  imageAlt: string;
  primaryHref: string;
  secondaryHref: string;
  visual?: {
    detected: string;
    captions: string[];
    chips: string[];
  };
}

const { copy, image, imageAlt, primaryHref, secondaryHref, visual } = Astro.props;
---

<section class="hero product-hero">
  <div class="hero-copy">
    <p class="eyebrow">{copy.eyebrow}</p>
    {copy.productName && <p class="product-name">{copy.productName}</p>}
    <h1>{copy.title}</h1>
    <p class="hero-subtitle">{copy.subtitle}</p>
    <div class="button-row">
      <a class="button button-primary" href={primaryHref}>{copy.primaryCta}</a>
      <a class="button button-secondary" href={secondaryHref}>{copy.secondaryCta}</a>
    </div>
  </div>
  <div class="phone-visual">
    {visual ? (
      <div class="caption-phone" role="img" aria-label={imageAlt}>
        <div class="caption-phone__screen">
          <div class="caption-photo">
            <span class="caption-photo__sun"></span>
            <span class="caption-photo__cup"></span>
            <span class="caption-photo__table"></span>
          </div>
          <div class="caption-detected">{visual.detected}</div>
          <div class="caption-output-list">
            {visual.captions.map((caption, index) => (
              <div class="caption-output-card">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{caption}</p>
              </div>
            ))}
          </div>
          <div class="caption-chip-row">
            {visual.chips.map((chip) => <span>{chip}</span>)}
          </div>
        </div>
      </div>
    ) : image ? (
      <img src={image} alt={imageAlt} width="420" height="640" />
    ) : null}
  </div>
</section>
