---
interface Props {
  copy: {
    eyebrow: string;
    productName?: string;
    title: string;
    subtitle: string;
    primaryCta: string;
    secondaryCta: string;
  };
  image?: string;
  imageAlt: string;
  primaryHref: string;
  secondaryHref: string;
  visual?: {
    detected: string;
    captions: string[];
    chips: string[];
  };
}

const { copy, image, imageAlt, primaryHref, secondaryHref, visual } = Astro.props;
const appIcon = '/images/apps/snapcopy-app-icon.png';
const displayName = copy.productName ?? copy.eyebrow;
---

<section class="hero product-hero">
  <div class="hero-copy">
    <div class="product-lockup">
      <img class="product-lockup__icon" src={appIcon} alt="" width="512" height="512" />
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        {copy.productName && <p class="product-name">{copy.productName}</p>}
      </div>
    </div>
    <h1>{copy.title}</h1>
    <p class="hero-subtitle">{copy.subtitle}</p>
    {visual && (
      <div class="caption-hero-chips">
        {visual.chips.map((chip) => <span>{chip}</span>)}
      </div>
    )}
    <div class="button-row">
      <a class="button button-primary" href={primaryHref}>{copy.primaryCta}</a>
      <a class="button button-secondary" href={secondaryHref}>{copy.secondaryCta}</a>
    </div>
  </div>
  <div class="phone-visual">
    {visual ? (
      <div class="caption-phone" role="img" aria-label={imageAlt}>
        <div class="caption-phone__screen">
          <div class="caption-app-topbar">
            <img src={appIcon} alt="" width="512" height="512" />
            <div>
              <strong>{displayName}</strong>
              <span>{visual.detected}</span>
            </div>
          </div>
          <div class="caption-photo">
            <span class="caption-photo__sun"></span>
            <span class="caption-photo__cup"></span>
            <span class="caption-photo__table"></span>
            <span class="caption-photo__label">{visual.chips[1] ?? visual.chips[0]}</span>
          </div>
          <div class="caption-output-list">
            {visual.captions.map((caption, index) => (
              <div class="caption-output-card">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{caption}</p>
              </div>
            ))}
          </div>
          <div class="caption-chip-row">
            {visual.chips.map((chip) => <span>{chip}</span>)}
          </div>
        </div>
      </div>
    ) : image ? (
      <img src={image} alt={imageAlt} width="420" height="640" />
    ) : null}
  </div>
</section>
