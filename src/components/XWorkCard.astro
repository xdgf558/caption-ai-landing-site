---
import XPostEmbed from './XPostEmbed.astro';

interface Props {
  title: string;
  description?: string;
  xUrl: string;
  type: 'video' | 'post' | 'image' | 'thread';
  tags: string[];
  publishedAt?: string;
  compact?: boolean;
  watchLabel?: string;
  embedFallbackLabel?: string;
  invalidLabel?: string;
  dateLocale?: string;
}

const {
  title,
  description,
  xUrl,
  type,
  tags,
  publishedAt,
  compact = false,
  watchLabel = 'Watch on X',
  embedFallbackLabel = 'View this post on X',
  invalidLabel = 'Invalid X post URL.',
  dateLocale = 'en'
} = Astro.props;
const formattedDate = publishedAt
  ? new Intl.DateTimeFormat(dateLocale, { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(publishedAt))
  : '';
---

<article class:list={['x-work-card', compact && 'x-work-card--compact']}>
  <div class="x-work-card__header">
    <div>
      <p class="station-kicker">{type}</p>
      <h3>{title}</h3>
    </div>
    {formattedDate && <time datetime={publishedAt}>{formattedDate}</time>}
  </div>
  {description && <p>{description}</p>}
  {tags.length > 0 && (
    <div class="x-work-tags">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>
  )}
  <XPostEmbed xUrl={xUrl} fallbackLabel={embedFallbackLabel} invalidLabel={invalidLabel} />
  <a class="button button-secondary" href={xUrl} target="_blank" rel="noopener noreferrer">
    {watchLabel}
  </a>
</article>
