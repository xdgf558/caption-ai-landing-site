---
interface PlatformConfig {
  status: string;
  appStoreUrl?: string;
  googlePlayUrl?: string;
}

interface Props {
  ios: PlatformConfig;
  android: PlatformConfig;
  locale: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
  iosWaitlistHref: string;
  androidWaitlistHref: string;
}

const { ios, android, locale, iosWaitlistHref, androidWaitlistHref } = Astro.props;
const isJa = locale === 'ja';
const isZh = locale === 'zh-Hant' || locale === 'zh-Hans';
const iosAvailable = ios.status === 'available' && Boolean(ios.appStoreUrl);
const androidAvailable = android.status === 'available' && Boolean(android.googlePlayUrl);
---

<div class="download-box">
  <h2>{isJa ? 'ダウンロード' : isZh ? '下載' : 'Download'}</h2>
  <p>
    {isJa
      ? 'SnapCopy は第1回クローズドテスト中です。テスト枠が必要な方は、下の「テストに参加」をクリックしてください。'
      : isZh
        ? locale === 'zh-Hans'
          ? 'SnapCopy 已经进入第一轮封闭测试。需要测试名额的用户，请点击下面的「参与测试」。'
          : 'SnapCopy 已經進入第一輪封閉測試。需要測試名額的使用者，請點擊下面的「參與測試」。'
      : 'SnapCopy is in its first closed testing round. If you need access, click Join the Test below.'}
  </p>
  <div class="button-row">
    {iosAvailable ? (
      <a class="button button-primary" href={ios.appStoreUrl}>{isJa ? 'App Store を開く' : isZh ? '開啟 App Store' : 'Open App Store'}</a>
    ) : (
      <a class="button button-primary" href={iosWaitlistHref}>{isJa ? 'テストに参加' : isZh ? locale === 'zh-Hans' ? '参与测试' : '參與測試' : 'Join the Test'}</a>
    )}
    {androidAvailable ? (
      <a class="button button-secondary" href={android.googlePlayUrl}>{isJa ? 'Google Play を開く' : isZh ? '開啟 Google Play' : 'Open Google Play'}</a>
    ) : (
      <a class="button button-secondary" href={androidWaitlistHref}>{isJa ? 'Android のお知らせ' : isZh ? '取得 Android 通知' : 'Get Android updates'}</a>
    )}
  </div>
  <p class="fine-print">
    {isJa
      ? '正式公開後は、公式ストア素材と実リンクを設定ファイルに追加します。'
      : isZh
        ? locale === 'zh-Hans'
          ? '正式上架后，再按官方规范加入正式商店素材与真实 campaign 链接。'
          : '正式上架後，再依官方規範加入正式商店素材與真實 campaign 連結。'
      : 'After launch, add official store badges and real campaign links in the product config.'}
  </p>
</div>
