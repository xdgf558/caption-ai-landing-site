---
import XWidgetsScript from './XWidgetsScript.astro';

interface Props {
  xUrl: string;
  fallbackLabel?: string;
  invalidLabel?: string;
}

const { xUrl, fallbackLabel = 'View this post on X', invalidLabel = 'Invalid X post URL.' } = Astro.props;

const isValidXPostUrl = (input: string) => {
  try {
    const url = new URL(input.trim());
    const hostname = url.hostname.replace(/^www\./, '');
    const allowedHosts = ['x.com', 'twitter.com'];
    const parts = url.pathname.split('/').filter(Boolean);

    return allowedHosts.includes(hostname) && parts.length >= 3 && parts[1] === 'status' && /^\d+$/.test(parts[2]);
  } catch {
    return false;
  }
};

const safeXUrl = isValidXPostUrl(xUrl) ? xUrl : '';
---

<div class="x-embed-wrapper">
  {safeXUrl ? (
    <>
      <blockquote class="twitter-tweet" data-theme="dark">
        <a href={safeXUrl}></a>
      </blockquote>
      <a class="x-fallback-link" href={safeXUrl} target="_blank" rel="noopener noreferrer">
        {fallbackLabel}
      </a>
      <XWidgetsScript />
    </>
  ) : (
    <p class="x-embed-error">{invalidLabel}</p>
  )}
</div>
