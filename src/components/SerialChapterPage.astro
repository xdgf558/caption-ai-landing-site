---
import type { SerialChapterEntry, SerialEntry, SiteLocale } from '../data/serials';
import { formatReadingMinutes, getChapterAccessLabel, getChapterHref, getSeriesHref } from '../data/serials';

interface CopyShape {
  accessLabel: string;
  chapterBack: string;
  chapterLabel: string;
  chapterWordCount: string;
  nextChapter: string;
  previousChapter: string;
  readLatest: string;
  volumeLabel: string;
}

interface Props {
  basePath: string;
  chapter: SerialChapterEntry;
  chapterList: SerialChapterEntry[];
  copy: CopyShape;
  locale: SiteLocale;
  nextChapter?: SerialChapterEntry;
  previousChapter?: SerialChapterEntry;
  serial: SerialEntry;
  Content: any;
}

const { basePath, chapter, chapterList, copy, locale, nextChapter, previousChapter, serial, Content } = Astro.props;
const seriesHref = getSeriesHref(basePath, serial.data.seriesSlug);
const chapterHref = getChapterHref(basePath, serial.data.seriesSlug, chapter.data.chapterSlug);
const isProtectedChapter = chapter.data.access !== 'free';
const unlockOrderType = chapter.data.access === 'supporter' ? 'supporter' : 'chapter';
const bookmarkCopy = {
  en: {
    save: 'Save bookmark',
    saving: 'Saving bookmark...',
    saved: 'Bookmark saved. You can continue from Member Center next time.',
    signInRequired: 'Please sign in before saving a bookmark.',
    failed: 'Could not save bookmark.'
  },
  ja: {
    save: 'しおりを保存',
    saving: 'しおりを保存しています...',
    saved: 'しおりを保存しました。次回は本棚から続きが読めます。',
    signInRequired: 'しおりを保存する前にログインしてください。',
    failed: 'しおりを保存できませんでした。'
  },
  'zh-Hant': {
    save: '保存書籤',
    saving: '正在保存書籤...',
    saved: '書籤已保存，下次可以從會員中心繼續閱讀。',
    signInRequired: '請先登入，再保存書籤。',
    failed: '書籤保存失敗。'
  },
  'zh-Hans': {
    save: '保存书签',
    saving: '正在保存书签...',
    saved: '书签已保存，下次可以从会员中心继续阅读。',
    signInRequired: '请先登录，再保存书签。',
    failed: '书签保存失败。'
  }
}[locale];
const accessGateCopy = {
  en: {
    title: 'This chapter is reserved for unlocked readers.',
    body: 'Sign in to check this account, use reading credits to unlock this chapter, or redeem a membership from Member Center.',
    checking: 'Checking access...',
    allowed: 'Access confirmed. Loading the chapter...',
    denied: 'This account has not unlocked this chapter yet.',
    signIn: 'Sign in to Member Center',
    library: 'Open Member Center',
    unlock: 'Unlock',
    bundle: 'Unlock',
    bundleUnit: ' chapters',
    bundleOff: 'off',
    creditUnlock: 'Use reading credits',
    creditTopUp: 'Top up credits',
    creditLoading: 'Checking reading credits...',
    creditReady: 'Reading credits are ready.',
    creditUnlocked: 'Unlocked with reading credits. Access has been saved to your library.',
    creditInsufficient: 'Not enough reading credits. Top up in the library first.',
    contentReady: 'Chapter loaded.',
    contentFailed: 'Could not load the protected chapter. Please refresh or open your library again.',
    paymentReturned: 'Payment returned to the site. Checking the order...',
    paymentPending: 'Waiting for NOWPayments confirmation. This page will refresh access automatically.',
    paymentConfirmed: 'Payment confirmed. Updating access...',
    paymentNeedsReview: 'Payment is confirmed, but access has not been granted yet. Please keep this order for support.',
    paymentFailed: 'The payment is not complete. Please try again or open your library.',
    creating: 'Creating checkout...',
    opening: 'Opening NOWPayments...',
    signInRequired: 'Please sign in before unlocking paid reading.',
    disabled: 'Checkout is not configured yet.',
    failed: 'Could not create checkout.'
  },
  ja: {
    title: 'この章は解放済み読者向けです。',
    body: 'ログインして権限を確認するか、読書ポイントでこの章を解放します。会員は本棚から交換できます。',
    checking: '権限を確認しています...',
    allowed: '権限を確認しました。本文を読み込んでいます...',
    denied: 'このアカウントではまだこの章が解放されていません。',
    signIn: '本棚にログイン',
    library: '本棚を開く',
    unlock: '解放する',
    bundle: '解放',
    bundleUnit: '章',
    bundleOff: 'OFF',
    creditUnlock: '読書ポイントで解放',
    creditTopUp: 'ポイントを追加',
    creditLoading: '読書ポイントを確認しています...',
    creditReady: '読書ポイントを確認しました。',
    creditUnlocked: '読書ポイントで解放しました。本棚に権限を保存しました。',
    creditInsufficient: '読書ポイントが足りません。先に本棚で追加してください。',
    contentReady: '本文を読み込みました。',
    contentFailed: '保護された本文を読み込めませんでした。本棚から開き直すか、ページを更新してください。',
    paymentReturned: '支払いがサイトに戻りました。注文を確認しています...',
    paymentPending: 'NOWPayments の確認を待っています。権限は自動で再確認されます。',
    paymentConfirmed: '支払いを確認しました。権限を更新しています...',
    paymentNeedsReview: '支払いは確認済みですが、権限がまだ反映されていません。注文情報を保管してください。',
    paymentFailed: '支払いは完了していません。もう一度試すか、本棚を開いてください。',
    creating: 'チェックアウトを作成しています...',
    opening: 'NOWPayments を開いています...',
    signInRequired: '有料閲覧を解放する前にログインしてください。',
    disabled: '支払い設定はまだ有効ではありません。',
    failed: 'チェックアウトを作成できませんでした。'
  },
  'zh-Hant': {
    title: '這一章保留給已解鎖讀者。',
    body: '可以先登入確認帳戶是否已有權限，也可以用閱讀點解鎖本章，或到會員中心兌換會員。',
    checking: '正在確認閱讀權限...',
    allowed: '權限已確認，正在載入正文...',
    denied: '這個帳戶尚未解鎖本章。',
    signIn: '登入會員中心',
    library: '打開會員中心',
    unlock: '解鎖',
    bundle: '解鎖',
    bundleUnit: ' 章',
    bundleOff: '折扣',
    creditUnlock: '用閱讀點解鎖',
    creditTopUp: '充值閱讀點',
    creditLoading: '正在確認閱讀點數...',
    creditReady: '閱讀點數已就緒。',
    creditUnlocked: '已用閱讀點解鎖，權限已保存到會員中心。',
    creditInsufficient: '閱讀點數不足，請先到會員中心充值。',
    contentReady: '正文已載入。',
    contentFailed: '受保護正文載入失敗，請重新整理，或從會員中心再打開一次。',
    paymentReturned: '支付已返回網站，正在核對訂單狀態...',
    paymentPending: '正在等待 NOWPayments 確認，確認後會自動重新檢查閱讀權限。',
    paymentConfirmed: '支付已確認，正在更新閱讀權限...',
    paymentNeedsReview: '支付已確認，但閱讀權限尚未寫入，請保留這筆訂單供後台排查。',
    paymentFailed: '支付尚未完成，請重新嘗試，或打開會員中心查看訂單狀態。',
    creating: '正在建立支付訂單...',
    opening: '正在打開 NOWPayments...',
    signInRequired: '請先登入，再解鎖付費閱讀。',
    disabled: '支付通道尚未配置完成。',
    failed: '支付訂單建立失敗。'
  },
  'zh-Hans': {
    title: '这一章保留给已解锁读者。',
    body: '可以先登录确认账户是否已有权限，也可以用阅读点解锁本章，或到会员中心兑换会员。',
    checking: '正在确认阅读权限...',
    allowed: '权限已确认，正在加载正文...',
    denied: '这个账户尚未解锁本章。',
    signIn: '登录会员中心',
    library: '打开会员中心',
    unlock: '解锁',
    bundle: '解锁',
    bundleUnit: ' 章',
    bundleOff: '折扣',
    creditUnlock: '用阅读点解锁',
    creditTopUp: '充值阅读点',
    creditLoading: '正在确认阅读点数...',
    creditReady: '阅读点数已就绪。',
    creditUnlocked: '已用阅读点解锁，权限已保存到会员中心。',
    creditInsufficient: '阅读点数不足，请先到会员中心充值。',
    contentReady: '正文已加载。',
    contentFailed: '受保护正文加载失败，请刷新，或从会员中心再打开一次。',
    paymentReturned: '支付已返回网站，正在核对订单状态...',
    paymentPending: '正在等待 NOWPayments 确认，确认后会自动重新检查阅读权限。',
    paymentConfirmed: '支付已确认，正在更新阅读权限...',
    paymentNeedsReview: '支付已确认，但阅读权限尚未写入，请保留这笔订单供后台排查。',
    paymentFailed: '支付尚未完成，请重新尝试，或打开会员中心查看订单状态。',
    creating: '正在建立支付订单...',
    opening: '正在打开 NOWPayments...',
    signInRequired: '请先登录，再解锁付费阅读。',
    disabled: '支付通道尚未配置完成。',
    failed: '支付订单建立失败。'
  }
}[locale];
---

<div class="page-shell serial-reader-shell">
  <div class="serial-reader-shell__crumbs">
    <a class="text-link" href={seriesHref}>{copy.chapterBack}</a>
    <span>/</span>
    <span>{serial.data.title}</span>
  </div>

  <header class="serial-reader-shell__header">
    <h1>{chapter.data.title}</h1>
    <div class="serial-reader-shell__meta">
      {chapter.data.publishedAt && (
        <time datetime={chapter.data.publishedAt.toISOString()}>
          {chapter.data.publishedAt.toLocaleDateString(locale)}
        </time>
      )}
      {chapter.data.volume && <span>{copy.volumeLabel}: {chapter.data.volume}</span>}
      <span>{copy.accessLabel}: {getChapterAccessLabel(chapter.data.access, locale)}</span>
      {chapter.data.readingMinutes && <span>{formatReadingMinutes(chapter.data.readingMinutes, locale)}</span>}
      {chapter.data.wordCount && <span>{`${chapter.data.wordCount} ${copy.chapterWordCount}`}</span>}
    </div>
  </header>

  {isProtectedChapter ? (
    <section
      class="serial-access-gate"
      data-serial-access-gate
      data-series-slug={serial.data.seriesSlug}
      data-chapter-slug={chapter.data.chapterSlug}
      data-access={chapter.data.access}
      data-order-type={unlockOrderType}
      data-locale={locale}
      data-return-path={getChapterHref(basePath, serial.data.seriesSlug, chapter.data.chapterSlug)}
    >
      <p class="station-kicker">{getChapterAccessLabel(chapter.data.access, locale)}</p>
      <h2>{accessGateCopy.title}</h2>
      <p>{accessGateCopy.body}</p>
      <div class="reader-status" data-serial-access-status role="status" aria-live="polite">
        {accessGateCopy.checking}
      </div>
      {unlockOrderType === 'chapter' && (
        <div class="reader-status" data-serial-credit-status role="status" aria-live="polite"></div>
      )}
      <div class="button-row">
        <a class="button button-primary" href="/library/">{accessGateCopy.signIn}</a>
        {unlockOrderType === 'chapter' && (
          <button class="button button-secondary" type="button" data-serial-credit-unlock>
            {accessGateCopy.creditUnlock}
          </button>
        )}
        {unlockOrderType === 'chapter' && <a class="button button-secondary" href="/library/">{accessGateCopy.creditTopUp}</a>}
        <a class="button button-secondary" href={seriesHref}>{copy.chapterBack}</a>
      </div>
    </section>
    <article class="serial-prose serial-reader-shell__body protected-chapter-body" data-protected-chapter-body hidden></article>
  ) : (
    <article class="serial-prose serial-reader-shell__body">
      <Content />
    </article>
  )}

  <footer class="serial-reader-shell__footer">
    <div class="button-row">
      {previousChapter ? (
        <a class="button button-secondary" href={getChapterHref(basePath, serial.data.seriesSlug, previousChapter.data.chapterSlug)}>{copy.previousChapter}</a>
      ) : (
        <a class="button button-secondary" href={seriesHref}>{copy.chapterBack}</a>
      )}
      {nextChapter ? (
        <a class="button button-primary" href={getChapterHref(basePath, serial.data.seriesSlug, nextChapter.data.chapterSlug)}>{copy.nextChapter}</a>
      ) : previousChapter ? (
        <a class="button button-primary" href={seriesHref}>{copy.chapterBack}</a>
      ) : (
        null
      )}
      <button class="button button-secondary" type="button" data-reader-bookmark-save>{bookmarkCopy.save}</button>
    </div>
    <div class="reader-status serial-bookmark-status" data-reader-bookmark-status role="status" aria-live="polite"></div>
  </footer>
</div>

<script define:vars={{ bookmarkCopy, bookmarkData: {
  chapterSlug: chapter.data.chapterSlug,
  chapterTitle: chapter.data.title,
  locale,
  seriesSlug: serial.data.seriesSlug,
  seriesTitle: serial.data.title,
  sourcePath: chapterHref
} }}>
  const bookmarkButton = document.querySelector('[data-reader-bookmark-save]');
  const bookmarkStatus = document.querySelector('[data-reader-bookmark-status]');

  const setBookmarkStatus = (message, tone = 'neutral') => {
    if (!bookmarkStatus) return;
    bookmarkStatus.textContent = message;
    bookmarkStatus.dataset.tone = tone;
  };

  const currentProgressPercent = () => {
    const documentElement = document.documentElement;
    const scrollTop = window.scrollY || documentElement.scrollTop || 0;
    const scrollable = Math.max(1, documentElement.scrollHeight - window.innerHeight);
    return Math.max(0, Math.min(100, Math.round((scrollTop / scrollable) * 100)));
  };

  bookmarkButton?.addEventListener('click', async () => {
    bookmarkButton.disabled = true;
    setBookmarkStatus(bookmarkCopy.saving, 'neutral');
    const progressPercent = currentProgressPercent();

    try {
      const response = await fetch('/api/readers/bookmarks', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          ...bookmarkData,
          progressPercent,
          positionLabel: `${progressPercent}%`
        })
      });
      const data = await response.json();
      if (!response.ok || !data.ok) {
        if (data.code === 'SIGN_IN_REQUIRED') {
          setBookmarkStatus(bookmarkCopy.signInRequired, 'error');
          window.location.href = `/library/?returnTo=${encodeURIComponent(window.location.pathname)}`;
          return;
        }
        throw new Error(data.message || bookmarkCopy.failed);
      }
      setBookmarkStatus(bookmarkCopy.saved, 'success');
    } catch (error) {
      setBookmarkStatus(error.message || bookmarkCopy.failed, 'error');
    } finally {
      bookmarkButton.disabled = false;
    }
  });
</script>

{isProtectedChapter && (
  <script define:vars={{ accessGateCopy }}>
    const gate = document.querySelector('[data-serial-access-gate]');
    const status = gate?.querySelector('[data-serial-access-status]');
    const creditStatus = gate?.querySelector('[data-serial-credit-status]');
    const unlockButtons = gate ? Array.from(gate.querySelectorAll('[data-serial-unlock]')) : [];
    const creditUnlockButton = gate?.querySelector('[data-serial-credit-unlock]');
    const protectedBody = document.querySelector('[data-protected-chapter-body]');

    const setGateStatus = (message, tone = 'neutral') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.tone = tone;
    };

    const setCreditStatus = (message, tone = 'neutral') => {
      if (!creditStatus) return;
      creditStatus.textContent = message;
      creditStatus.dataset.tone = tone;
    };

    const setUnlockButtonsDisabled = (disabled) => {
      unlockButtons.forEach((button) => {
        button.disabled = disabled;
      });
      if (creditUnlockButton) creditUnlockButton.disabled = disabled;
    };

    const formatPaymentAmount = (amount, currency) => {
      const parsedAmount = Number.parseFloat(String(amount || ''));
      if (!Number.isFinite(parsedAmount)) return '';
      try {
        return new Intl.NumberFormat(gate?.dataset.locale || 'zh-Hant', { style: 'currency', currency }).format(parsedAmount);
      } catch {
        return `${parsedAmount.toFixed(2)} ${currency}`;
      }
    };

    const refreshPricing = async () => {
      if (!gate) return;
      const query = new URLSearchParams({
        series: gate.dataset.seriesSlug,
        chapter: gate.dataset.chapterSlug,
        locale: gate.dataset.locale
      });
      const response = await fetch(`/api/novels/pricing?${query.toString()}`);
      const data = await response.json();
      if (!response.ok || !data.ok || !data.pricing) return;

      const pricing = data.pricing;
      const bundleOptions = Array.isArray(pricing.bundleOptions) ? pricing.bundleOptions : [];
      const bundleByCount = new Map(bundleOptions.map((option) => [String(option.chapterCount), option]));
      unlockButtons.forEach((button) => {
        const orderType = button.dataset.orderType || gate.dataset.orderType;
        if (orderType === 'chapter') {
          button.textContent = `${accessGateCopy.unlock} ${formatPaymentAmount(pricing.chapterPriceAmount, pricing.chapterPriceCurrency)}`;
        } else if (orderType === 'supporter') {
          button.textContent = `${accessGateCopy.unlock} ${formatPaymentAmount(pricing.supporterPriceAmount, pricing.supporterPriceCurrency)}`;
        } else if (orderType === 'chapter-bundle') {
          const option = bundleByCount.get(String(button.dataset.bundleChapters || ''));
          if (option) {
            button.dataset.chapterSlugs = (option.chapterSlugs || []).join(',');
            button.textContent = `${accessGateCopy.bundle} ${option.chapterCount}${accessGateCopy.bundleUnit} · ${formatPaymentAmount(option.priceAmount, option.priceCurrency)} · ${option.discountPercent}% ${accessGateCopy.bundleOff}`;
            button.hidden = false;
          } else {
            button.hidden = true;
          }
        }
      });

      if (creditUnlockButton && pricing.chapterCredits) {
        creditUnlockButton.textContent = `${accessGateCopy.creditUnlock} · ${pricing.chapterCredits}`;
      }
    };

    const loadCreditSummary = async () => {
      if (!creditStatus) return;
      setCreditStatus(accessGateCopy.creditLoading, 'neutral');
      const response = await fetch('/api/readers/credits');
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error(data.message || accessGateCopy.failed);
      if (!data.authenticated) {
        setCreditStatus('', 'neutral');
        return;
      }
      const unitLabel = data.account?.unitLabel || 'SC Credits';
      const balance = data.account?.balanceCredits || 0;
      const cost = data.chapterCostCredits || 1;
      setCreditStatus(`${accessGateCopy.creditReady} ${balance} ${unitLabel} · ${cost} / chapter`, 'success');
    };

    const loadProtectedContent = async () => {
      if (!gate || !protectedBody) return;
      setGateStatus(accessGateCopy.allowed, 'success');
      const query = new URLSearchParams({
        series: gate.dataset.seriesSlug,
        chapter: gate.dataset.chapterSlug
      });
      const response = await fetch(`/api/novels/chapters/protected-content?${query.toString()}`, {
        headers: { accept: 'application/json' }
      });
      const data = await response.json();
      if (!response.ok || !data.ok || !data.content?.html) {
        throw new Error(data.message || accessGateCopy.contentFailed);
      }

      protectedBody.innerHTML = data.content.html;
      protectedBody.hidden = false;
      requestAnimationFrame(() => protectedBody.classList.add('protected-chapter-body--ready'));
      gate.hidden = true;
      setCreditStatus(accessGateCopy.contentReady, 'success');
    };

    const wait = (milliseconds) => new Promise((resolve) => {
      window.setTimeout(resolve, milliseconds);
    });

    const checkAccess = async () => {
      if (!gate) return;
      const query = new URLSearchParams({
        series: gate.dataset.seriesSlug,
        chapter: gate.dataset.chapterSlug,
        access: gate.dataset.access
      });
      const response = await fetch(`/api/novels/access?${query.toString()}`);
      const data = await response.json();
      if (!response.ok || !data.ok) throw new Error(data.message || accessGateCopy.denied);

      if (data.allowed) {
        setUnlockButtonsDisabled(true);
        await loadProtectedContent();
      } else if (data.reason === 'sign_in_required') {
        setGateStatus(accessGateCopy.body, 'neutral');
        setCreditStatus('', 'neutral');
      } else {
        setGateStatus(accessGateCopy.denied, 'error');
        await loadCreditSummary();
      }
    };

    const refreshReturnedPaymentOrder = async () => {
      const query = new URLSearchParams(window.location.search);
      const orderToken = query.get('order') || '';
      if (query.get('payment') !== 'success' || !orderToken) return false;

      setUnlockButtonsDisabled(true);
      setGateStatus(accessGateCopy.paymentReturned, 'neutral');

      for (let attempt = 0; attempt < 12; attempt += 1) {
        const response = await fetch(`/api/novels/payments/order?order=${encodeURIComponent(orderToken)}`);
        const data = await response.json();
        if (!response.ok || !data.ok) throw new Error(data.message || accessGateCopy.failed);

        const fulfillment = data.fulfillment || {};
        const orderStatus = data.order?.status || '';
        if (fulfillment.complete) {
          setGateStatus(accessGateCopy.paymentConfirmed, 'success');
          await checkAccess();
          return true;
        }

        if (fulfillment.needsReview) {
          setGateStatus(accessGateCopy.paymentNeedsReview, 'error');
          setUnlockButtonsDisabled(false);
          return true;
        }

        if (['failed', 'expired', 'refunded'].includes(orderStatus)) {
          setGateStatus(accessGateCopy.paymentFailed, 'error');
          setUnlockButtonsDisabled(false);
          return true;
        }

        setGateStatus(accessGateCopy.paymentPending, 'neutral');
        if (!fulfillment.nextCheckSeconds) break;
        await wait(fulfillment.nextCheckSeconds * 1000);
      }

      setGateStatus(accessGateCopy.paymentPending, 'neutral');
      setUnlockButtonsDisabled(false);
      await loadCreditSummary();
      return true;
    };

    if (creditUnlockButton) {
      creditUnlockButton.addEventListener('click', async () => {
        if (!gate) return;
        setUnlockButtonsDisabled(true);
        setCreditStatus(accessGateCopy.creditLoading, 'neutral');

        try {
          const response = await fetch('/api/novels/credits/unlock', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              seriesSlug: gate.dataset.seriesSlug,
              chapterSlug: gate.dataset.chapterSlug,
              access: gate.dataset.access,
              locale: gate.dataset.locale
            })
          });
          const data = await response.json();
          if (!response.ok || !data.ok) {
            if (data.code === 'SIGN_IN_REQUIRED') {
              setGateStatus(accessGateCopy.signInRequired, 'error');
              window.location.href = `/library/?returnTo=${encodeURIComponent(window.location.pathname)}`;
              return;
            }
            if (data.code === 'INSUFFICIENT_CREDITS') throw new Error(accessGateCopy.creditInsufficient);
            throw new Error(data.message || accessGateCopy.failed);
          }

          setCreditStatus(accessGateCopy.creditUnlocked, 'success');
          await loadProtectedContent();
        } catch (error) {
          setCreditStatus(error.message || accessGateCopy.failed, 'error');
          setUnlockButtonsDisabled(false);
        }
      });
    }

    unlockButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        if (!gate) return;
        setUnlockButtonsDisabled(true);
        setGateStatus(accessGateCopy.creating, 'neutral');

        const orderType = button.dataset.orderType || gate.dataset.orderType;
        const payload = {
          orderType,
          seriesSlug: gate.dataset.seriesSlug,
          chapterSlug: gate.dataset.chapterSlug,
          locale: gate.dataset.locale,
          returnPath: gate.dataset.returnPath
        };
        if (orderType === 'chapter-bundle') {
          payload.bundleChapters = button.dataset.bundleChapters;
          payload.chapterSlugs = String(button.dataset.chapterSlugs || '')
            .split(',')
            .map((slug) => slug.trim())
            .filter(Boolean);
        }

        try {
          const response = await fetch('/api/novels/payments/checkout', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await response.json();
          if (!response.ok || !data.ok) {
            if (data.code === 'SIGN_IN_REQUIRED') {
              setGateStatus(accessGateCopy.signInRequired, 'error');
              window.location.href = `/library/?returnTo=${encodeURIComponent(window.location.pathname)}`;
              return;
            }
            if (data.code === 'PAYMENT_PROVIDER_NOT_CONFIGURED') throw new Error(accessGateCopy.disabled);
            throw new Error(data.message || accessGateCopy.failed);
          }
          if (!data.paymentUrl) throw new Error(accessGateCopy.failed);
          setGateStatus(accessGateCopy.opening, 'success');
          window.location.href = data.paymentUrl;
        } catch (error) {
          setGateStatus(error.message || accessGateCopy.failed, 'error');
          setUnlockButtonsDisabled(false);
        }
      });
    });

    refreshPricing()
      .catch(() => null)
      .then(refreshReturnedPaymentOrder)
      .then((handled) => {
        if (!handled) return checkAccess();
        return null;
      })
      .catch((error) => {
        setGateStatus(error.message || accessGateCopy.denied, 'error');
        setCreditStatus(accessGateCopy.contentFailed, 'error');
      });
  </script>
)}
