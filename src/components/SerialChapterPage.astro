---
import type { SerialChapterEntry, SerialEntry, SiteLocale } from '../data/serials';
import { formatReadingMinutes, getChapterAccessLabel, getChapterHref, getSeriesHref } from '../data/serials';

interface CopyShape {
  accessLabel: string;
  chapterBack: string;
  chapterLabel: string;
  chapterWordCount: string;
  nextChapter: string;
  previousChapter: string;
  readLatest: string;
  volumeLabel: string;
}

interface Props {
  basePath: string;
  chapter: SerialChapterEntry;
  chapterList: SerialChapterEntry[];
  copy: CopyShape;
  locale: SiteLocale;
  nextChapter?: SerialChapterEntry;
  previousChapter?: SerialChapterEntry;
  serial: SerialEntry;
  Content: any;
}

const { basePath, chapter, chapterList, copy, locale, nextChapter, previousChapter, serial, Content } = Astro.props;
const seriesHref = getSeriesHref(basePath, serial.data.seriesSlug);
const chapterHref = getChapterHref(basePath, serial.data.seriesSlug, chapter.data.chapterSlug);
const isProtectedChapter = chapter.data.access !== 'free';
const isNovelV2Reader = basePath === '/novel/';
const unlockOrderType = chapter.data.access === 'supporter' ? 'supporter' : 'chapter';
