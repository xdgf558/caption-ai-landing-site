---
import SceneCard from './SceneCard.astro';

interface Scene {
  title: string;
  description: string;
  image: string;
}

interface Props {
  title: string;
  description?: string;
  scenes: Scene[];
}

const { title, description, scenes } = Astro.props;
---

<section class="page-section">
  <div class="section-heading">
    <p class="section-kicker">Use cases</p>
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
  <div class="scene-grid">
    {scenes.map((scene) => (
      <SceneCard {...scene} />
    ))}
  </div>
</section>
