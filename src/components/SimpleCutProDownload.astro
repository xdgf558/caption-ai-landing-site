---
import BaseLayout from '../layouts/BaseLayout.astro';
import { simpleCutProProduct } from '../data/products/simplecut-pro';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;

const copy = {
  'zh-Hant': {
    title: '下載 SimpleCut Pro',
    description: '下載 SimpleCut Pro 0.1.18 macOS Apple Silicon 和 Windows x64 版本。',
    kicker: 'Download',
    headline: '下載 SimpleCut Pro 0.1.18。',
    intro:
      '目前提供 macOS Apple Silicon DMG 和 Windows x64 安裝包。這個目錄也會提供後續自動更新需要的 latest metadata 和 blockmap。',
    back: '返回產品頁',
    backHref: simpleCutProProduct.zhHantProductPath,
    metaTitle: '選擇下載版本',
    updateTitle: '自動更新檔案',
    updateIntro: '這些檔案會放在同一個公開目錄，供 SimpleCut Pro 後續檢查和下載更新。',
    checksum: 'SHA-256',
    feedLabel: '更新目錄',
    warning:
      '請只從 Station Cat 官方網站下載。macOS 安裝時請以系統安全提示為準；Windows 版首次安裝時仍可能顯示系統安全確認。',
    buttons: {
      'mac-arm64-dmg': '下載 macOS DMG',
      'windows-x64-exe': '下載 Windows 安裝包'
    }
  },
  'zh-Hans': {
    title: '下载 SimpleCut Pro',
    description: '下载 SimpleCut Pro 0.1.18 macOS Apple Silicon 和 Windows x64 版本。',
    kicker: 'Download',
    headline: '下载 SimpleCut Pro 0.1.18。',
    intro:
      '目前提供 macOS Apple Silicon DMG 和 Windows x64 安装包。这个目录也会提供后续自动更新需要的 latest metadata 和 blockmap。',
    back: '返回产品页',
    backHref: simpleCutProProduct.zhHansProductPath,
    metaTitle: '选择下载版本',
    updateTitle: '自动更新文件',
    updateIntro: '这些文件会放在同一个公开目录，供 SimpleCut Pro 后续检查和下载更新。',
    checksum: 'SHA-256',
    feedLabel: '更新目录',
    warning:
      '请只从 Station Cat 官方网站下载。macOS 安装时请以系统安全提示为准；Windows 版首次安装时仍可能显示系统安全确认。',
    buttons: {
      'mac-arm64-dmg': '下载 macOS DMG',
      'windows-x64-exe': '下载 Windows 安装包'
    }
  },
  en: {
    title: 'Download SimpleCut Pro',
    description: 'Download SimpleCut Pro 0.1.18 for macOS Apple Silicon and Windows x64.',
    kicker: 'Download',
    headline: 'Download SimpleCut Pro 0.1.18.',
    intro:
      'The current release includes a macOS Apple Silicon DMG and a Windows x64 installer. This folder also hosts the latest metadata and blockmaps needed by future auto updates.',
    back: 'Back to product page',
    backHref: simpleCutProProduct.productPath,
    metaTitle: 'Choose a download',
    updateTitle: 'Auto-update files',
    updateIntro: 'These files live in the same public folder so SimpleCut Pro can check and download future updates.',
    checksum: 'SHA-256',
    feedLabel: 'Update feed',
    warning:
      'Download only from the official Station Cat site. On macOS, follow the current system security prompts for this build; Windows may still show a first-run security confirmation.',
    buttons: {
      'mac-arm64-dmg': 'Download macOS DMG',
      'windows-x64-exe': 'Download Windows installer'
    }
  },
  ja: {
    title: 'SimpleCut Pro をダウンロード',
    description: 'SimpleCut Pro 0.1.18 の macOS Apple Silicon 版と Windows x64 版をダウンロードできます。',
    kicker: 'Download',
    headline: 'SimpleCut Pro 0.1.18 をダウンロード。',
    intro:
      '現在は macOS Apple Silicon DMG と Windows x64 インストーラーを用意しています。このフォルダには今後の自動更新に必要な latest metadata と blockmap も置きます。',
    back: '製品ページへ戻る',
    backHref: simpleCutProProduct.jaProductPath,
    metaTitle: 'ダウンロードを選択',
    updateTitle: '自動更新ファイル',
    updateIntro: 'SimpleCut Pro が今後の更新確認とダウンロードに使うファイルです。',
    checksum: 'SHA-256',
    feedLabel: '更新フィード',
    warning:
      'Station Cat 公式サイトからのみダウンロードしてください。macOS ではシステムの安全確認に従ってください。Windows では初回インストール時に確認が表示される場合があります。',
    buttons: {
      'mac-arm64-dmg': 'macOS DMG をダウンロード',
      'windows-x64-exe': 'Windows インストーラーをダウンロード'
    }
  }
}[lang];

const canonicalPath =
  lang === 'zh-Hant'
    ? simpleCutProProduct.zhHantDownloadPagePath
    : lang === 'zh-Hans'
      ? simpleCutProProduct.zhHansDownloadPagePath
      : lang === 'ja'
        ? simpleCutProProduct.jaDownloadPagePath
        : simpleCutProProduct.downloadPagePath;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={canonicalPath}
  ogImage={simpleCutProProduct.assets.icon}
  bodyClass="station-paper-page radar-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: simpleCutProProduct.zhHantDownloadPagePath },
    { hrefLang: 'zh-Hans', href: simpleCutProProduct.zhHansDownloadPagePath },
    { hrefLang: 'en', href: simpleCutProProduct.downloadPagePath },
    { hrefLang: 'ja', href: simpleCutProProduct.jaDownloadPagePath },
    { hrefLang: 'x-default', href: simpleCutProProduct.zhHantDownloadPagePath }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">{copy.kicker}</p>
    <h1>{copy.headline}</h1>
    <p>{copy.intro}</p>
    <div class="button-row">
      {simpleCutProProduct.downloads.map((download) => (
        <a class="button button-primary" href={download.downloadPath}>{copy.buttons[download.id]}</a>
      ))}
      <a class="button button-secondary" href={copy.backHref}>{copy.back}</a>
    </div>
  </section>

  <section class="download-box radar-download-box">
    <h2>{copy.metaTitle}</h2>
    <div class="anytls-download-grid">
      {simpleCutProProduct.downloads.map((download) => (
        <article class="anytls-download-card">
          <div>
            <p class="section-kicker">{download.label}</p>
            <h3>{download.platform} {download.architecture}</h3>
          </div>
          <dl class="radar-meta-list">
            <div>
              <dt>Version</dt>
              <dd>{download.version}</dd>
            </div>
            <div>
              <dt>Minimum system</dt>
              <dd>{download.minimumSystem}</dd>
            </div>
            <div>
              <dt>File size</dt>
              <dd>{download.fileSize}</dd>
            </div>
          </dl>
          <div class="checksum-block">
            <strong>{copy.checksum}</strong>
            <code>{download.sha256}</code>
          </div>
          <a class="button button-primary" href={download.downloadPath}>{copy.buttons[download.id]}</a>
        </article>
      ))}
    </div>
    <p>{copy.warning}</p>
  </section>

  <section class="download-box radar-download-box">
    <h2>{copy.updateTitle}</h2>
    <p>{copy.updateIntro}</p>
    <div class="checksum-block">
      <strong>{copy.feedLabel}</strong>
      <code>{simpleCutProProduct.updateFeedUrl}</code>
    </div>
    <div class="anytls-download-grid">
      {simpleCutProProduct.updateFiles.map((file) => (
        <article class="anytls-download-card">
          <div>
            <p class="section-kicker">{file.label}</p>
            <h3>{file.filename}</h3>
          </div>
          <dl class="radar-meta-list">
            <div>
              <dt>File size</dt>
              <dd>{file.fileSize}</dd>
            </div>
          </dl>
          <div class="checksum-block">
            <strong>{copy.checksum}</strong>
            <code>{file.sha256}</code>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
