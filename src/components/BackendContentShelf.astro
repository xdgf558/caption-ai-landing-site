---
import type { SiteLocale } from '../data/serials';

type EntryType = 'blog_post' | 'novel_series';

interface Props {
  basePath: string;
  copy: {
    empty?: string;
    eyebrow: string;
    readLabel: string;
    sourceLabel: string;
    title: string;
  };
  entryType: EntryType;
  existingSlugs?: string[];
  locale: SiteLocale;
}

const { basePath, copy, entryType, existingSlugs = [], locale } = Astro.props;
const config = {
  basePath,
  copy,
  entryType,
  existingSlugs,
  locale
};
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');
---

<section class={`backend-content-shelf backend-content-shelf--${entryType}`} data-backend-content-shelf hidden>
  <div class="station-section__heading">
    <p class="station-kicker">{copy.eyebrow}</p>
    <h2>{copy.title}</h2>
  </div>
  <div class="backend-content-shelf__grid" data-backend-content-list></div>
  {copy.empty && <p class="empty-state" data-backend-content-empty hidden>{copy.empty}</p>}
  <script type="application/json" data-backend-content-config set:html={configJson} />
</section>

<script is:inline>
  (() => {
    const shelves = document.querySelectorAll('[data-backend-content-shelf]');
    const escapeHtml = (value) =>
      String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    const formatDate = (value, locale) => {
      if (!value) return '';
      const date = new Date(String(value).replace(' ', 'T'));
      if (Number.isNaN(date.getTime())) return '';
      return new Intl.DateTimeFormat(locale, {
        day: 'numeric',
        month: 'short',
        year: 'numeric'
      }).format(date);
    };

    const accessLabels = {
      en: { free: 'Free', member: 'Members', paid: 'Paid', supporter: 'Supporters' },
      ja: { free: '無料', member: 'メンバー', paid: '有料', supporter: '支援者向け' },
      'zh-Hant': { free: '免費', member: '會員', paid: '付費', supporter: '支持者' },
      'zh-Hans': { free: '免费', member: '会员', paid: '付费', supporter: '支持者' }
    };

    const formatAccess = (value, locale) => accessLabels[locale]?.[value] || value;

    const cardHref = (config, entry) => `${config.basePath}${entry.slug}/`;

    const renderCard = (config, entry) => {
      const copy = config.copy;
      const date = formatDate(entry.publishedAt || entry.updatedAt, config.locale);
      const meta = [date, entry.authorName, formatAccess(entry.accessLevel, config.locale)].filter(Boolean);
      const href = cardHref(config, entry);
      const isNovel = config.entryType === 'novel_series';
      const cover = entry.coverUrl
        ? `<a class="backend-content-card__cover${isNovel ? ' backend-content-card__cover--book' : ''}" href="${escapeHtml(href)}">
            <img src="${escapeHtml(entry.coverUrl)}" alt="${escapeHtml(entry.coverAlt || `${entry.title} cover`)}" loading="lazy" />
          </a>`
        : '';
      return `<article class="backend-content-card${isNovel ? ' backend-content-card--novel' : ''}">
        ${cover}
        <div class="backend-content-card__body">
          <div class="backend-content-card__meta">
            <span>${escapeHtml(copy.sourceLabel)}</span>
            ${meta.map((item) => `<span>${escapeHtml(item)}</span>`).join('')}
          </div>
          <h3><a href="${escapeHtml(href)}">${escapeHtml(entry.title)}</a></h3>
          <p>${escapeHtml(entry.description || entry.excerpt || '')}</p>
          <a class="paper-link" href="${escapeHtml(href)}">${escapeHtml(copy.readLabel)}</a>
        </div>
      </article>`;
    };

    const hydrateShelf = async (shelf) => {
      const configNode = shelf.querySelector('[data-backend-content-config]');
      const list = shelf.querySelector('[data-backend-content-list]');
      const empty = shelf.querySelector('[data-backend-content-empty]');
      if (!configNode || !list) return;

      let config;
      try {
        config = JSON.parse(configNode.textContent || '{}');
      } catch {
        return;
      }

      const existing = new Set(config.existingSlugs || []);
      const params = new URLSearchParams({
        entryType: config.entryType,
        locale: config.locale,
        limit: '20'
      });

      try {
        const response = await fetch(`/api/content/entries?${params.toString()}`);
        const payload = await response.json();
        if (!response.ok || !payload.ok) return;

        const entries = (payload.entries || []).filter((entry) => !existing.has(entry.slug));
        if (!entries.length) {
          if (empty) empty.hidden = false;
          return;
        }

        list.innerHTML = entries.map((entry) => renderCard(config, entry)).join('');
        shelf.hidden = false;
      } catch {
        shelf.hidden = true;
      }
    };

    shelves.forEach((shelf) => {
      hydrateShelf(shelf);
    });
  })();
</script>

<style is:global>
  .backend-content-shelf {
    margin-top: 42px;
  }

  .backend-content-shelf__grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .backend-content-card {
    background: rgba(255, 252, 247, 0.92);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 18px 48px rgba(68, 55, 41, 0.08);
    display: grid;
    gap: 12px;
    padding: 20px;
  }

  .backend-content-card--novel {
    align-items: start;
    grid-template-columns: minmax(130px, 180px) minmax(0, 1fr);
  }

  .backend-content-card__body {
    align-content: start;
    display: grid;
    gap: 12px;
  }

  .backend-content-card h3 {
    font-size: clamp(1.2rem, 2.5vw, 1.55rem);
    margin: 0;
  }

  .backend-content-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .backend-content-card__cover {
    aspect-ratio: 16 / 10;
    background: rgba(240, 232, 219, 0.72);
    border-radius: 6px;
    display: block;
    margin: -6px -6px 2px;
    overflow: hidden;
  }

  .backend-content-card__cover--book {
    aspect-ratio: 2 / 3;
    margin: 0;
  }

  .backend-content-card__cover img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .backend-content-card p {
    margin: 0;
  }

  .backend-content-card__meta {
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.84rem;
    font-weight: 800;
    gap: 8px;
  }

  .backend-content-card__meta span:first-child {
    color: var(--teal);
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .backend-content-shelf__grid {
      grid-template-columns: 1fr;
    }

    .backend-content-card--novel {
      grid-template-columns: 1fr;
    }

    .backend-content-card__cover--book {
      justify-self: center;
      max-width: 220px;
      width: min(70vw, 220px);
    }
  }
</style>
