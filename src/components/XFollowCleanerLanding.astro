---
import BaseLayout from '../layouts/BaseLayout.astro';
import { xFollowCleanerProduct } from '../data/products/x-follow-cleaner';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;

const copy = {
  'zh-Hant': {
    title: 'X Follow Cleaner',
    description: 'X Follow Cleaner 是一個用來低頻檢查 X 關注列表、匯出結果並保留本地記錄的 Chrome 擴充功能。',
    eyebrow: 'Chrome Extension',
    headline: '把 X 關注列表整理成更安心的本地檢查清單。',
    intro:
      'X Follow Cleaner 是一個保守節奏的 Chrome 擴充功能，協助你低頻檢查關注帳號，標記可能需要回頭確認的關注對象，並把結果匯出成 CSV 或 JSON。',
    primary: '下載 v0.2.1 ZIP',
    secondary: '查看 GitHub Release',
    appsHref: '/zh-hant/apps/',
    featuresTitle: '它適合做什麼',
    features: [
      ['低頻自動檢查', '用比較保守的掃描節奏整理關注列表，避免把工具做成激進操作器。'],
      ['本地保存結果', '掃描和標記結果保存在瀏覽器本地，方便你下一次接著看。'],
      ['CSV / JSON 匯出', '需要備份或二次整理時，可以把結果匯出成通用格式。'],
      ['只給建議，不替你操作', '工具不會自動取關、關注或改動你的 X 帳號。']
    ],
    installTitle: '安裝方式',
    installSteps: [
      '下載 x-follow-cleaner-v0.2.1.zip 並解壓縮。',
      '打開 Chrome 擴充功能管理頁。',
      '開啟 Developer Mode。',
      '點擊 Load unpacked，選擇解壓後的資料夾。'
    ],
    privacyTitle: '資料與安全邊界',
    privacyNotes: [
      '不讀取 Cookie、Token、密碼或私訊。',
      '不會自動取關，也不會自動關注新帳號。',
      '目前結果保存在本機瀏覽器中。',
      '這不是 X 官方工具，請依照自己的判斷使用。'
    ],
    releaseTitle: '版本資訊',
    back: '返回 Apps'
  },
  'zh-Hans': {
    title: 'X Follow Cleaner',
    description: 'X Follow Cleaner 是一个用来低频检查 X 关注列表、导出结果并保留本地记录的 Chrome 扩展。',
    eyebrow: 'Chrome Extension',
    headline: '把 X 关注列表整理成更安心的本地检查清单。',
    intro:
      'X Follow Cleaner 是一个保守节奏的 Chrome 扩展，帮助你低频检查关注账号，标记可能需要回头确认的关注对象，并把结果导出成 CSV 或 JSON。',
    primary: '下载 v0.2.1 ZIP',
    secondary: '查看 GitHub Release',
    appsHref: '/zh-hans/apps/',
    featuresTitle: '它适合做什么',
    features: [
      ['低频自动检查', '用比较保守的扫描节奏整理关注列表，避免把工具做成激进操作器。'],
      ['本地保存结果', '扫描和标记结果保存在浏览器本地，方便你下一次接着看。'],
      ['CSV / JSON 导出', '需要备份或二次整理时，可以把结果导出成通用格式。'],
      ['只给建议，不替你操作', '工具不会自动取关、关注或改动你的 X 账号。']
    ],
    installTitle: '安装方式',
    installSteps: [
      '下载 x-follow-cleaner-v0.2.1.zip 并解压缩。',
      '打开 Chrome 扩展管理页。',
      '开启 Developer Mode。',
      '点击 Load unpacked，选择解压后的文件夹。'
    ],
    privacyTitle: '数据与安全边界',
    privacyNotes: [
      '不读取 Cookie、Token、密码或私信。',
      '不会自动取关，也不会自动关注新账号。',
      '当前结果保存在本机浏览器中。',
      '这不是 X 官方工具，请按照自己的判断使用。'
    ],
    releaseTitle: '版本信息',
    back: '返回 Apps'
  },
  en: {
    title: 'X Follow Cleaner',
    description: 'X Follow Cleaner is a Chrome extension for low-frequency follow-list checks, local results, and CSV/JSON export.',
    eyebrow: 'Chrome Extension',
    headline: 'Turn your X following list into a calmer local review queue.',
    intro:
      'X Follow Cleaner is a conservative Chrome extension for reviewing who you follow on X. It keeps results locally, helps you revisit accounts later, and exports review data as CSV or JSON.',
    primary: 'Download v0.2.1 ZIP',
    secondary: 'View GitHub Release',
    appsHref: '/apps/',
    featuresTitle: 'What it helps with',
    features: [
      ['Low-frequency checks', 'Review your following list with a deliberately conservative scan rhythm.'],
      ['Local saved results', 'Keep scan and review results in your browser so you can return later.'],
      ['CSV / JSON export', 'Export the review list when you want a backup or another editing pass.'],
      ['Suggestions only', 'The extension does not automatically follow, unfollow, or change your X account.']
    ],
    installTitle: 'How to install',
    installSteps: [
      'Download and unzip x-follow-cleaner-v0.2.1.zip.',
      'Open the Chrome Extensions management page.',
      'Turn on Developer Mode.',
      'Choose Load unpacked, then select the unzipped folder.'
    ],
    privacyTitle: 'Data and safety boundaries',
    privacyNotes: [
      'It does not read cookies, tokens, passwords, or direct messages.',
      'It does not automatically follow or unfollow accounts.',
      'Current results are stored locally in your browser.',
      'This is not an official X tool, so use it with your own judgment.'
    ],
    releaseTitle: 'Release details',
    back: 'Back to Apps'
  },
  ja: {
    title: 'X Follow Cleaner',
    description: 'X Follow Cleaner は、X のフォロー一覧を低頻度で確認し、結果をローカル保存して CSV / JSON で書き出す Chrome 拡張です。',
    eyebrow: 'Chrome Extension',
    headline: 'X のフォロー一覧を、落ち着いて見直せるローカルリストへ。',
    intro:
      'X Follow Cleaner は、保守的なペースで X のフォロー一覧を確認する Chrome 拡張です。結果をブラウザ内に保存し、あとで見直したり CSV / JSON で書き出したりできます。',
    primary: 'v0.2.1 ZIP をダウンロード',
    secondary: 'GitHub Release を見る',
    appsHref: '/ja/apps/',
    featuresTitle: 'できること',
    features: [
      ['低頻度チェック', '攻めすぎないスキャンペースで、フォロー一覧を確認できます。'],
      ['ローカル保存', '確認結果はブラウザ内に保存され、あとから続きが見られます。'],
      ['CSV / JSON 書き出し', 'バックアップや再整理のために、結果を一般的な形式で書き出せます。'],
      ['提案だけを行う', '拡張機能が自動でフォロー解除、フォロー、アカウント変更を行うことはありません。']
    ],
    installTitle: 'インストール方法',
    installSteps: [
      'x-follow-cleaner-v0.2.1.zip をダウンロードして解凍します。',
      'Chrome の拡張機能管理ページを開きます。',
      'Developer Mode をオンにします。',
      'Load unpacked を選び、解凍したフォルダを指定します。'
    ],
    privacyTitle: 'データと安全性',
    privacyNotes: [
      'Cookie、Token、パスワード、DM は読み取りません。',
      '自動でフォロー解除やフォローを行いません。',
      '現在の結果はブラウザ内にローカル保存されます。',
      'X 公式ツールではないため、自分の判断で利用してください。'
    ],
    releaseTitle: 'リリース情報',
    back: 'Apps に戻る'
  }
}[lang];

const canonicalPath =
  lang === 'zh-Hant'
    ? xFollowCleanerProduct.zhHantProductPath
    : lang === 'zh-Hans'
      ? xFollowCleanerProduct.zhHansProductPath
      : lang === 'ja'
        ? xFollowCleanerProduct.jaProductPath
        : xFollowCleanerProduct.productPath;
---

<BaseLayout
  title={`${copy.title} | Station Cat`}
  description={copy.description}
  lang={lang}
  canonicalPath={canonicalPath}
  ogImage={xFollowCleanerProduct.assets.screenshot}
  bodyClass="follow-cleaner-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: xFollowCleanerProduct.zhHantProductPath },
    { hrefLang: 'zh-Hans', href: xFollowCleanerProduct.zhHansProductPath },
    { hrefLang: 'en', href: xFollowCleanerProduct.productPath },
    { hrefLang: 'ja', href: xFollowCleanerProduct.jaProductPath },
    { hrefLang: 'x-default', href: xFollowCleanerProduct.zhHantProductPath }
  ]}
>
  <section class="radar-hero follow-cleaner-hero">
    <div class="radar-hero__copy">
      <p class="section-kicker">{copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p>{copy.intro}</p>
      <div class="button-row">
        <a class="button button-primary" href={xFollowCleanerProduct.downloadUrl}>{copy.primary}</a>
        <a class="button button-secondary" href={xFollowCleanerProduct.releaseUrl} target="_blank" rel="noreferrer">{copy.secondary}</a>
      </div>
    </div>
    <div class="radar-preview-card follow-cleaner-preview" aria-label="X Follow Cleaner extension preview">
      <img src={xFollowCleanerProduct.assets.screenshot} alt="X Follow Cleaner extension preview" width="1040" height="720" />
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="section-kicker">Follow cleaner</p>
      <h2>{copy.featuresTitle}</h2>
    </div>
    <div class="radar-feature-grid">
      {copy.features.map(([title, text]) => (
        <article>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section follow-cleaner-panels">
    <div class="radar-note-panel">
      <div>
        <p class="section-kicker">Install</p>
        <h2>{copy.installTitle}</h2>
      </div>
      <ol>
        {copy.installSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
    <div class="radar-note-panel">
      <div>
        <p class="section-kicker">Local first</p>
        <h2>{copy.privacyTitle}</h2>
      </div>
      <ul>
        {copy.privacyNotes.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </section>

  <section class="download-box follow-cleaner-release">
    <h2>{copy.releaseTitle}</h2>
    <dl class="radar-meta-list">
      <div>
        <dt>Version</dt>
        <dd>{xFollowCleanerProduct.version}</dd>
      </div>
      <div>
        <dt>Platform</dt>
        <dd>{xFollowCleanerProduct.platform}</dd>
      </div>
      <div>
        <dt>Browser</dt>
        <dd>{xFollowCleanerProduct.minimumSystem}</dd>
      </div>
      <div>
        <dt>File size</dt>
        <dd>{xFollowCleanerProduct.fileSize}</dd>
      </div>
      <div>
        <dt>Published</dt>
        <dd>{xFollowCleanerProduct.releaseDate}</dd>
      </div>
    </dl>
    <div class="checksum-block">
      <strong>SHA-256</strong>
      <code>{xFollowCleanerProduct.sha256}</code>
    </div>
    <div class="button-row">
      <a class="button button-primary" href={xFollowCleanerProduct.downloadUrl}>{copy.primary}</a>
      <a class="button button-secondary" href={copy.appsHref}>{copy.back}</a>
    </div>
  </section>
</BaseLayout>
