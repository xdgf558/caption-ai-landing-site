---
import type { SerialChapterEntry, SerialEntry, SiteLocale } from '../data/serials';
import { formatChapterNumber, getChapterHref, getPriceModeLabel, getSeriesHref, getSerialStatusLabel } from '../data/serials';
import BackendContentShelf from './BackendContentShelf.astro';
import SerialCard from './SerialCard.astro';

interface CopyShape {
  accessLabel: string;
  authorLabel: string;
  description: string;
  eyebrow: string;
  featuredEmpty: string;
  featuredEyebrow: string;
  featuredTitle: string;
  freeLabel: string;
  heroDescription: string;
  heroNote: string;
  heroPrimary: string;
  heroSecondary: string;
  heroTitle: string;
  latestFallback: string;
  latestLabel: string;
  libraryLabel: string;
  openSeries: string;
  readFirst: string;
  readLatest: string;
  plannedLabel: string;
  scheduleLabel: string;
  shelfEmpty: string;
  shelfEyebrow: string;
  shelfTitle: string;
  statusLabel: string;
}

interface Props {
  basePath: string;
  copy: CopyShape;
  featuredLatestChapter?: SerialChapterEntry;
  featuredSerial?: SerialEntry;
  locale: SiteLocale;
  serials: SerialEntry[];
}

const { basePath, copy, featuredLatestChapter, featuredSerial, locale, serials } = Astro.props;
const featuredCoverText = featuredSerial?.data.coverLabel ?? featuredSerial?.data.title;
const staticSerialSlugs = serials.map((serial) => serial.data.seriesSlug);
const mediaUrlForKey = (key: string) => `/api/content/media?key=${encodeURIComponent(key)}`;
const backendSpotlightByLocale = {
  'zh-Hant': {
    accessLabel: '付費連載',
    author: 'Station Cat',
    coverAlt: '《离线未来》封面，1999 年舊房間、CRT 電腦和離線 AI 重啟。',
    coverUrl: mediaUrlForKey('content/media/covers/2026/06/cmqjfju1300008z3wyh66ynvw-offline-future-cover-v2.png'),
    description:
      '故事從 1999 年的一個夜晚開始：風扇、舊電腦、未連網的房間，和一個本不該在那個年代醒來的 AI。',
    firstChapterHref: getChapterHref(basePath, 'cmqjfju1300008z3wyh66ynvw', 'chap-offline-future-001'),
    freeChapters: '前 20 章',
    href: `${basePath}cmqjfju1300008z3wyh66ynvw/`,
    latest: '第 1 章 1999年的风扇声',
    schedule: '不定期連載，完成後會同步更新章節順序',
    seriesSlug: 'cmqjfju1300008z3wyh66ynvw',
    status: '連載中',
    subtitle: '1999 · Offline AI · Rebirth',
    tagline: '離線 AI、舊年代電腦、記憶和一次慢慢展開的重啟。',
    title: '离线未来'
  }
} as const;
const backendSpotlight = backendSpotlightByLocale[locale as keyof typeof backendSpotlightByLocale];
const bookshelfCopyByLocale = {
  en: {
    all: 'All',
    categories: ['Time travel', 'Sci-fi', 'Fantasy', 'Mystery', 'AI'],
    empty: 'No books in this category yet.',
    eyebrow: 'Serial fiction shelf',
    intro: 'Pick a category, then switch between long-form stories as the shelf grows.',
    openSeries: 'Open book',
    readFirst: 'Start reading',
    shelfLabel: 'Books on shelf',
    title: 'Station Cat long-form shelf'
  },
  ja: {
    all: 'すべて',
    categories: ['タイムトラベル', 'SF', 'ファンタジー', 'ミステリー', 'AI'],
    empty: 'この分類の作品はまだありません。',
    eyebrow: '連載棚',
    intro: '分類を選び、今後増える長編をこの棚から切り替えて読めます。',
    openSeries: '作品を開く',
    readFirst: '読み始める',
    shelfLabel: '本棚',
    title: 'Station Cat 長編棚'
  },
  'zh-Hant': {
    all: '全部',
    categories: ['穿越', '科幻', '奇幻', '悬疑', 'AI'],
    empty: '這個分類還在等下一本書上架。',
    eyebrow: '長篇書架',
    intro: '這是 Station Cat 的小說書架，會陸續上架各類小說。如果喜歡我的作品，歡迎訂閱觀看。',
    openSeries: '打開作品',
    readFirst: '開始閱讀',
    shelfLabel: '書架',
    title: 'Station Cat 長篇小說書架'
  },
  'zh-Hans': {
    all: '全部',
    categories: ['穿越', '科幻', '奇幻', '悬疑', 'AI'],
    empty: '这个分类还在等下一本书上架。',
    eyebrow: '长篇书架',
    intro: '这是 Station Cat 的小说书架，会陆续上架各类小说。如果喜欢我的作品，欢迎订阅观看。',
    openSeries: '打开作品',
    readFirst: '开始阅读',
    shelfLabel: '书架',
    title: 'Station Cat 长篇小说书架'
  }
} as const;
const bookshelfCopy = bookshelfCopyByLocale[locale];
const backendBookshelfItem = backendSpotlight && {
  accessLabel: backendSpotlight.accessLabel,
  category: '穿越',
  categories: ['穿越', '科幻', 'AI'],
  coverAlt: backendSpotlight.coverAlt,
  coverUrl: backendSpotlight.coverUrl,
  description: backendSpotlight.description,
  firstChapterHref: backendSpotlight.firstChapterHref,
  href: backendSpotlight.href,
  id: 'offline-future',
  isBackend: true,
  latest: backendSpotlight.latest,
  locale,
  seriesSlug: backendSpotlight.seriesSlug,
  status: backendSpotlight.status,
  subtitle: backendSpotlight.subtitle,
  title: backendSpotlight.title
};
const featuredBookshelfItem = featuredSerial && {
  accessLabel: getPriceModeLabel(featuredSerial.data.priceMode, locale),
  category: featuredSerial.data.tags?.[0] ?? copy.accessLabel,
  categories: featuredSerial.data.tags ?? [],
  coverAlt: featuredSerial.data.coverAlt ?? `${featuredSerial.data.title} cover`,
  coverUrl: featuredSerial.data.coverImage ?? '',
  description: featuredSerial.data.description,
  firstChapterHref: featuredLatestChapter
    ? getChapterHref(basePath, featuredSerial.data.seriesSlug, featuredLatestChapter.data.chapterSlug)
    : getSeriesHref(basePath, featuredSerial.data.seriesSlug),
  href: getSeriesHref(basePath, featuredSerial.data.seriesSlug),
  id: featuredSerial.data.seriesSlug,
  isBackend: false,
  latest: featuredLatestChapter
    ? `${formatChapterNumber(featuredLatestChapter.data.chapterNumber, locale)} ${featuredLatestChapter.data.title}`
    : copy.latestFallback,
  locale,
  seriesSlug: featuredSerial.data.seriesSlug,
  status: getSerialStatusLabel(featuredSerial.data.status, locale),
  subtitle: featuredSerial.data.subtitle ?? '',
  title: featuredSerial.data.title
};
const bookshelfItems = [backendBookshelfItem, featuredBookshelfItem].filter(Boolean);
const bookshelfJson = JSON.stringify({
  basePath,
  empty: bookshelfCopy.empty,
  existingSlugs: bookshelfItems.map((book) => book.seriesSlug).filter(Boolean),
  libraryLabel: copy.libraryLabel,
  locale,
  openSeries: bookshelfCopy.openSeries,
  readFirst: bookshelfCopy.readFirst
}).replace(/</g, '\\u003c');
const backendShelfCopy = {
  en: {
    empty: 'No backend-published serials are waiting outside the static shelf.',
    eyebrow: 'New from Admin',
    readLabel: copy.openSeries,
    sourceLabel: 'Admin 2.0',
    title: 'New backend-published serials.'
  },
  ja: {
    empty: '管理画面から追加された連載はまだありません。',
    eyebrow: '管理画面から追加',
    readLabel: copy.openSeries,
    sourceLabel: 'Admin 2.0',
    title: '新しく公開された連載。'
  },
  'zh-Hant': {
    empty: '目前沒有更多後台發布的連載。',
    eyebrow: '已上架',
    readLabel: copy.openSeries,
    sourceLabel: '連載中',
    title: '目前可以閱讀的作品。'
  },
  'zh-Hans': {
    empty: '目前没有额外从后台发布的连载。',
    eyebrow: '后台新发布',
    readLabel: copy.openSeries,
    sourceLabel: 'Admin 2.0',
    title: '从后台即时发布的连载。'
  }
};
---

{bookshelfItems.length > 0 ? (
  <section class="works-hero serials-bookshelf" data-serials-bookshelf>
    <div class="serials-bookshelf__intro">
      <p class="station-kicker">{bookshelfCopy.eyebrow}</p>
      <h1>{bookshelfCopy.title}</h1>
      <p>{bookshelfCopy.intro}</p>
      <div class="serials-bookshelf__filters" aria-label="小說分類">
        <button class="is-active" type="button" data-bookshelf-filter="all">{bookshelfCopy.all}</button>
        {bookshelfCopy.categories.map((category) => (
          <button type="button" data-bookshelf-filter={category}>{category}</button>
        ))}
      </div>
    </div>

    <div class="serials-bookshelf__body">
      <div class="serials-bookshelf__rail" aria-label={bookshelfCopy.shelfLabel}>
        {bookshelfItems.map((book, index) => (
          <button
            class={`serials-bookshelf__book${index === 0 ? ' is-active' : ''}`}
            type="button"
            data-bookshelf-book={book.id}
            data-bookshelf-categories={book.categories.join(',')}
          >
            <span>{book.category}</span>
            <strong>{book.title}</strong>
          </button>
        ))}
        <p class="serials-bookshelf__empty" data-bookshelf-empty hidden>{bookshelfCopy.empty}</p>
      </div>

      <div class="serials-bookshelf__previews">
        {bookshelfItems.map((book, index) => (
          <article class={`serials-bookshelf__preview${index === 0 ? ' is-active' : ''}`} data-bookshelf-preview={book.id} hidden={index !== 0}>
            <a class="serials-bookshelf__thumb" href={book.href} aria-label={book.title}>
              {book.coverUrl ? (
                <img src={book.coverUrl} alt={book.coverAlt} loading={index === 0 ? 'eager' : 'lazy'} />
              ) : (
                <strong>{book.title}</strong>
              )}
            </a>
            <div class="serials-bookshelf__copy">
              <div class="serials-bookshelf__meta">
                <span>{book.status}</span>
                <span>{book.accessLabel}</span>
                <span
                  data-backend-latest-series={book.isBackend ? book.seriesSlug : undefined}
                  data-backend-latest-locale={book.isBackend ? book.locale : undefined}
                  data-backend-base-path={book.isBackend ? basePath : undefined}
                >
                  {book.latest}
                </span>
              </div>
              <h2>{book.title}</h2>
              {book.subtitle && <p class="fine-print">{book.subtitle}</p>}
              <p>{book.description}</p>
              <div class="button-row">
                <a class="button button-primary" href={book.firstChapterHref}>{bookshelfCopy.readFirst}</a>
                <a class="button button-secondary" href={book.href}>{bookshelfCopy.openSeries}</a>
                <a class="button button-secondary" href="/library/">{copy.libraryLabel}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
    <script type="application/json" data-bookshelf-copy set:html={bookshelfJson} />
  </section>
) : (
  <section class="works-hero serials-hero">
    <div class="serials-hero__copy">
      <p class="station-kicker">{copy.eyebrow}</p>
      <h1>{copy.heroTitle}</h1>
      <p>{copy.heroDescription}</p>
      <p class="fine-print">{copy.heroNote}</p>
      <div class="button-row">
        <a class="button button-primary" href="#serial-shelf">{copy.heroSecondary}</a>
        <a class="button button-secondary" href="/library/">{copy.libraryLabel}</a>
      </div>
    </div>
  </section>
)}

<script is:inline>
  (() => {
    const shelves = document.querySelectorAll('[data-serials-bookshelf]');
    const escapeHtml = (value) =>
      String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    const chineseNumerals = ['零', '一', '二', '三', '四', '五', '六', '七', '八', '九'];
    const formatChineseChapterNumber = (value) => {
      const number = Math.max(0, Math.floor(Number(value) || 0));
      if (!number) return '';
      if (number < 10) return chineseNumerals[number];
      if (number < 20) return `十${number % 10 ? chineseNumerals[number % 10] : ''}`;
      if (number < 100) {
        const tens = Math.floor(number / 10);
        const ones = number % 10;
        return `${chineseNumerals[tens]}十${ones ? chineseNumerals[ones] : ''}`;
      }
      if (number < 1000) {
        const hundreds = Math.floor(number / 100);
        const remainder = number % 100;
        if (!remainder) return `${chineseNumerals[hundreds]}百`;
        return `${chineseNumerals[hundreds]}百${remainder < 10 ? '零' : ''}${formatChineseChapterNumber(remainder)}`;
      }
      return String(number);
    };
    const formatChapterNumber = (chapterNumber, locale) => {
      if (locale === 'zh-Hant' || locale === 'zh-Hans' || locale === 'ja') {
        return `第${formatChineseChapterNumber(chapterNumber)}章`;
      }
      return `Chapter ${Math.max(0, Math.floor(Number(chapterNumber) || 0))}`;
    };
    const chapterListCache = new Map();
    const getBackendChapters = async (seriesSlug, locale) => {
      const cacheKey = `${locale}:${seriesSlug}`;
      if (chapterListCache.has(cacheKey)) return chapterListCache.get(cacheKey);

      const params = new URLSearchParams({
        entryType: 'novel_chapter',
        locale,
        limit: '100',
        parentSlug: seriesSlug
      });
      const chaptersPromise = fetch(`/api/content/entries?${params.toString()}`)
        .then((response) => (response.ok ? response.json() : null))
        .then((payload) => {
          if (!payload?.ok || !Array.isArray(payload.entries)) return [];
          return payload.entries
            .slice()
            .sort((left, right) => {
              const leftNumber = Number(left.chapterNumber) || 0;
              const rightNumber = Number(right.chapterNumber) || 0;
              return leftNumber - rightNumber || String(left.slug || '').localeCompare(String(right.slug || ''));
            });
        })
        .catch(() => []);
      chapterListCache.set(cacheKey, chaptersPromise);
      return chaptersPromise;
    };
    const getLatestBackendChapter = async (seriesSlug, locale) => {
      const chapters = await getBackendChapters(seriesSlug, locale);
      return chapters.length ? chapters[chapters.length - 1] : null;
    };
    const getFirstBackendChapter = async (seriesSlug, locale) => {
      const chapters = await getBackendChapters(seriesSlug, locale);
      return chapters.length ? chapters[0] : null;
    };
    const getChapterHref = (basePath, seriesSlug, chapterSlug) =>
      `${basePath}${encodeURIComponent(seriesSlug)}/chapter/${encodeURIComponent(chapterSlug)}/`;
    const accessLabels = {
      en: { free: 'Free', member: 'Members', paid: 'Paid', supporter: 'Supporters' },
      ja: { free: '無料', member: 'メンバー', paid: '有料', supporter: '支援者向け' },
      'zh-Hant': { free: '免費', member: '會員', paid: '付費', supporter: '支持者' },
      'zh-Hans': { free: '免费', member: '会员', paid: '付费', supporter: '支持者' }
    };
    const formatAccess = (value, locale) => accessLabels[locale]?.[value] || value || '';
    const serialStatusLabels = {
      en: { planned: 'Preparing', serializing: 'Serializing', completed: 'Completed', paused: 'Paused' },
      ja: { planned: '準備中', serializing: '連載中', completed: '完結', paused: '一時停止' },
      'zh-Hant': { planned: '籌備中', serializing: '連載中', completed: '已完結', paused: '暫停更新' },
      'zh-Hans': { planned: '筹备中', serializing: '连载中', completed: '已完结', paused: '暂停更新' }
    };
    const formatSerialStatus = (entry, locale) => {
      const status = String(entry?.metadata?.serialStatus || '').trim().toLowerCase();
      const labels = serialStatusLabels[locale] || serialStatusLabels['zh-Hant'];
      return labels[status] || labels.serializing;
    };
    const categoryLabels = {
      en: { ai: 'AI', fantasy: 'Fantasy', mystery: 'Mystery', scifi: 'Sci-fi', time: 'Time travel' },
      ja: { ai: 'AI', fantasy: 'ファンタジー', mystery: 'ミステリー', scifi: 'SF', time: 'タイムトラベル' },
      'zh-Hant': { ai: 'AI', fantasy: '奇幻', mystery: '悬疑', scifi: '科幻', time: '穿越' },
      'zh-Hans': { ai: 'AI', fantasy: '奇幻', mystery: '悬疑', scifi: '科幻', time: '穿越' }
    };
    const inferBookshelfCategories = (entry, locale) => {
      const labels = categoryLabels[locale] || categoryLabels['zh-Hant'];
      const text = [entry.title, entry.subtitle, entry.description, entry.excerpt, ...(entry.tags || [])]
        .filter(Boolean)
        .join(' ')
        .toLowerCase();
      const categories = [];
      const add = (category) => {
        if (category && !categories.includes(category)) categories.push(category);
      };
      if (/穿越|重生|time travel|rebirth/.test(text)) add(labels.time);
      if (/科幻|sci[-\s]?fi|science fiction|未来|ai|人工智能|離線|离线|offline/.test(text)) add(labels.scifi);
      if (/ai|人工智能|離線 ai|离线 ai|offline ai/.test(text)) add(labels.ai);
      if (/奇幻|fantasy|玄幻|魔法/.test(text)) add(labels.fantasy);
      if (/悬疑|懸疑|探案|推理|命案|大理寺|旧案|舊案|mystery|detective|case/.test(text)) add(labels.mystery);
      return categories.length ? categories : [labels.fantasy];
    };
    const renderBackendBookshelfEntry = (entry, config) => {
      const categories = inferBookshelfCategories(entry, config.locale);
      const href = `${config.basePath}${encodeURIComponent(entry.slug)}/`;
      const cover = entry.coverUrl
        ? `<img src="${escapeHtml(entry.coverUrl)}" alt="${escapeHtml(entry.coverAlt || `${entry.title} cover`)}" loading="lazy" />`
        : `<strong>${escapeHtml(entry.title)}</strong>`;
      const status = formatSerialStatus(entry, config.locale);
      const accessLabel = formatAccess(entry.accessLevel, config.locale);
      const subtitle = entry.subtitle ? `<p class="fine-print">${escapeHtml(entry.subtitle)}</p>` : '';
      return {
        previewHtml: `<article class="serials-bookshelf__preview" data-bookshelf-preview="${escapeHtml(entry.slug)}" hidden>
            <a class="serials-bookshelf__thumb" href="${escapeHtml(href)}" aria-label="${escapeHtml(entry.title)}">${cover}</a>
            <div class="serials-bookshelf__copy">
              <div class="serials-bookshelf__meta">
                <span>${escapeHtml(status)}</span>
                <span>${escapeHtml(accessLabel)}</span>
                <span data-backend-latest-series="${escapeHtml(entry.slug)}" data-backend-latest-locale="${escapeHtml(config.locale)}" data-backend-base-path="${escapeHtml(config.basePath)}">${escapeHtml(entry.latestLabel || '')}</span>
              </div>
              <h2>${escapeHtml(entry.title)}</h2>
              ${subtitle}
              <p>${escapeHtml(entry.description || entry.excerpt || '')}</p>
              <div class="button-row">
                <a class="button button-primary" href="${escapeHtml(href)}" data-backend-first-chapter-link="${escapeHtml(entry.slug)}">${escapeHtml(config.readFirst)}</a>
                <a class="button button-secondary" href="${escapeHtml(href)}">${escapeHtml(config.openSeries)}</a>
                <a class="button button-secondary" href="/library/">${escapeHtml(config.libraryLabel)}</a>
              </div>
            </div>
          </article>`,
        railHtml: `<button class="serials-bookshelf__book" type="button" data-bookshelf-book="${escapeHtml(entry.slug)}" data-bookshelf-categories="${escapeHtml(categories.join(','))}">
            <span>${escapeHtml(categories[0])}</span>
            <strong>${escapeHtml(entry.title)}</strong>
          </button>`
      };
    };
    const hydrateBackendBookshelfEntries = async (shelf) => {
      const configNode = shelf.querySelector('[data-bookshelf-copy]');
      const rail = shelf.querySelector('.serials-bookshelf__rail');
      const previews = shelf.querySelector('.serials-bookshelf__previews');
      if (!configNode || !rail || !previews) return;
      let config;
      try {
        config = JSON.parse(configNode.textContent || '{}');
      } catch {
        return;
      }
      const existing = new Set(config.existingSlugs || []);
      const params = new URLSearchParams({
        entryType: 'novel_series',
        locale: config.locale || 'zh-Hant',
        limit: '30'
      });
      try {
        const response = await fetch(`/api/content/entries?${params.toString()}`);
        const payload = await response.json();
        if (!response.ok || !payload?.ok || !Array.isArray(payload.entries)) return;
        payload.entries
          .filter((entry) => {
            if (!entry?.slug || existing.has(entry.slug)) return false;
            return !Array.from(shelf.querySelectorAll('[data-bookshelf-book]')).some(
              (book) => book.dataset.bookshelfBook === entry.slug
            );
          })
          .forEach((entry) => {
            const html = renderBackendBookshelfEntry(entry, config);
            rail.insertAdjacentHTML('beforeend', html.railHtml);
            previews.insertAdjacentHTML('beforeend', html.previewHtml);
            existing.add(entry.slug);
          });
        const activeFilter = shelf.querySelector('[data-bookshelf-filter].is-active')?.dataset.bookshelfFilter || 'all';
        if (activeFilter !== 'all') {
          Array.from(shelf.querySelectorAll('[data-bookshelf-book]')).forEach((book) => {
            const categories = String(book.dataset.bookshelfCategories || '').split(',').map((item) => item.trim());
            book.hidden = !categories.includes(activeFilter);
          });
        }
        hydrateBackendLatestChapters();
      } catch {
        // The static shelf remains usable if the dynamic backend list cannot load.
      }
    };
    const hydrateBackendLatestChapters = () => {
      const targets = Array.from(document.querySelectorAll('[data-backend-latest-series]'));
      targets.forEach(async (target) => {
        const seriesSlug = target.dataset.backendLatestSeries || '';
        const locale = target.dataset.backendLatestLocale || 'zh-Hant';
        const basePath = target.dataset.backendBasePath || '/novel/';
        if (!seriesSlug) return;
        const latest = await getLatestBackendChapter(seriesSlug, locale);
        if (latest?.chapterNumber && latest.title) {
          target.textContent = `${formatChapterNumber(latest.chapterNumber, locale)} ${latest.title}`;
        }
        const first = await getFirstBackendChapter(seriesSlug, locale);
        const preview = target.closest('[data-bookshelf-preview]');
        const firstLink = preview?.querySelector('[data-backend-first-chapter-link]');
        if (first?.slug && firstLink) {
          firstLink.href = getChapterHref(basePath, seriesSlug, first.slug);
        }
      });
    };
    const runWhenDomReady = (callback) => {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', callback, { once: true });
        return;
      }
      callback();
    };

    runWhenDomReady(hydrateBackendLatestChapters);

    shelves.forEach((shelf) => {
      hydrateBackendBookshelfEntries(shelf);
      const getFilters = () => Array.from(shelf.querySelectorAll('[data-bookshelf-filter]'));
      const getBooks = () => Array.from(shelf.querySelectorAll('[data-bookshelf-book]'));
      const getPreviews = () => Array.from(shelf.querySelectorAll('[data-bookshelf-preview]'));
      const empty = shelf.querySelector('[data-bookshelf-empty]');

      const setActiveBook = (id) => {
        getBooks().forEach((book) => book.classList.toggle('is-active', book.dataset.bookshelfBook === id));
        getPreviews().forEach((preview) => {
          const active = preview.dataset.bookshelfPreview === id;
          preview.classList.toggle('is-active', active);
          preview.hidden = !active;
        });
      };

      const applyFilter = (category) => {
        getFilters().forEach((filter) => filter.classList.toggle('is-active', filter.dataset.bookshelfFilter === category));
        let firstVisible = '';
        getBooks().forEach((book) => {
          const categories = String(book.dataset.bookshelfCategories || '').split(',').map((item) => item.trim());
          const visible = category === 'all' || categories.includes(category);
          book.hidden = !visible;
          if (visible && !firstVisible) firstVisible = book.dataset.bookshelfBook || '';
        });
        if (empty) empty.hidden = Boolean(firstVisible);
        if (firstVisible) setActiveBook(firstVisible);
      };

      shelf.addEventListener('click', (event) => {
        const book = event.target.closest('[data-bookshelf-book]');
        if (book && shelf.contains(book)) {
          setActiveBook(book.dataset.bookshelfBook || '');
          return;
        }
        const filter = event.target.closest('[data-bookshelf-filter]');
        if (filter && shelf.contains(filter)) {
          applyFilter(filter.dataset.bookshelfFilter || 'all');
        }
      });
    });
  })();
</script>

<section class="station-section">
  <div class="station-section__heading">
    <p class="station-kicker">{copy.featuredEyebrow}</p>
    <h2>{copy.featuredTitle}</h2>
  </div>
  {featuredSerial ? (
    <article class="serial-feature-card">
      <div class="serial-feature-card__copy">
        <div class="serial-feature-card__meta">
          <span class="paper-stamp">{getSerialStatusLabel(featuredSerial.data.status, locale)}</span>
          <span>{copy.authorLabel}: {featuredSerial.data.author}</span>
          <span>{copy.accessLabel}: {getPriceModeLabel(featuredSerial.data.priceMode, locale)}</span>
        </div>
        <h2>{featuredSerial.data.title}</h2>
        {featuredSerial.data.subtitle && <p class="fine-print">{featuredSerial.data.subtitle}</p>}
        <p>{featuredSerial.data.description}</p>
        <div class="serial-feature-card__facts">
          <div>
            <span>{copy.scheduleLabel}</span>
            <strong>{featuredSerial.data.updateSchedule ?? '-'}</strong>
          </div>
          <div>
            <span>{copy.freeLabel}</span>
            <strong>{featuredSerial.data.freeChapters}</strong>
          </div>
          <div>
            <span>{copy.latestLabel}</span>
            <strong>
              {featuredLatestChapter
                ? `${formatChapterNumber(featuredLatestChapter.data.chapterNumber, locale)} ${featuredLatestChapter.data.title}`
                : copy.latestFallback}
            </strong>
          </div>
          {featuredSerial.data.totalPlannedChapters && (
            <div>
              <span>{copy.plannedLabel}</span>
              <strong>{featuredSerial.data.totalPlannedChapters}</strong>
            </div>
          )}
        </div>
        <div class="button-row">
          <a class="button button-primary" href={getSeriesHref(basePath, featuredSerial.data.seriesSlug)}>{copy.openSeries}</a>
          {featuredLatestChapter && (
            <a
              class="button button-secondary"
              href={getChapterHref(basePath, featuredSerial.data.seriesSlug, featuredLatestChapter.data.chapterSlug)}
            >
              {copy.readLatest}
            </a>
          )}
        </div>
      </div>
      <div class="serial-feature-card__aside">
        <div class="serial-cover serial-feature-card__cover">
          {featuredSerial.data.coverImage ? (
            <img src={featuredSerial.data.coverImage} alt={featuredSerial.data.coverAlt ?? `${featuredSerial.data.title} cover`} loading="lazy" />
          ) : (
            <>
              <span class="serial-cover__mark">SC</span>
              <strong>{featuredCoverText}</strong>
            </>
          )}
        </div>
        <p>{featuredSerial.data.tagline}</p>
      </div>
    </article>
  ) : backendSpotlight ? (
    <article class="serial-feature-card serial-feature-card--backend">
      <div class="serial-feature-card__copy">
        <div class="serial-feature-card__meta">
          <span class="paper-stamp">{backendSpotlight.status}</span>
          <span>{copy.authorLabel}: {backendSpotlight.author}</span>
          <span>{copy.accessLabel}: {backendSpotlight.accessLabel}</span>
        </div>
        <h2>{backendSpotlight.title}</h2>
        <p class="fine-print">{backendSpotlight.subtitle}</p>
        <p>{backendSpotlight.description}</p>
        <div class="serial-feature-card__facts">
          <div>
            <span>{copy.scheduleLabel}</span>
            <strong>{backendSpotlight.schedule}</strong>
          </div>
          <div>
            <span>{copy.freeLabel}</span>
            <strong>{backendSpotlight.freeChapters}</strong>
          </div>
          <div>
            <span>{copy.latestLabel}</span>
            <strong
              data-backend-latest-series={backendSpotlight.seriesSlug}
              data-backend-latest-locale={locale}
            >
              {backendSpotlight.latest}
            </strong>
          </div>
          <div>
            <span>{copy.accessLabel}</span>
            <strong>第 21 章起 0.1 USD / 1 閱讀點</strong>
          </div>
        </div>
        <div class="button-row">
          <a class="button button-primary" href={backendSpotlight.firstChapterHref}>{copy.readFirst}</a>
          <a class="button button-secondary" href={backendSpotlight.href}>{copy.openSeries}</a>
        </div>
      </div>
      <div class="serial-feature-card__aside">
        <a class="serial-cover serial-feature-card__cover" href={backendSpotlight.href} aria-label={backendSpotlight.title}>
          <img src={backendSpotlight.coverUrl} alt={backendSpotlight.coverAlt} loading="lazy" />
        </a>
        <p>{backendSpotlight.tagline}</p>
      </div>
    </article>
  ) : (
    <p class="empty-state">{copy.featuredEmpty}</p>
  )}
</section>

<section id="serial-shelf" class="station-section">
  <div class="station-section__heading">
    <p class="station-kicker">{copy.shelfEyebrow}</p>
    <h2>{copy.shelfTitle}</h2>
  </div>
  {serials.length > 0 ? (
    <div class="serial-card-grid">
      {serials.map((serial) => (
        <SerialCard serial={serial} locale={locale} basePath={basePath} copy={copy} />
      ))}
    </div>
  ) : !backendSpotlight ? (
    <p class="empty-state">{copy.shelfEmpty}</p>
  ) : null}
  <BackendContentShelf
    basePath={basePath}
    copy={backendShelfCopy[locale]}
    entryType="novel_series"
    existingSlugs={staticSerialSlugs}
    locale={locale}
  />
</section>
