---
import { Image } from 'astro:assets';
import vipBadge from '../assets/vip-badge.png';
---

<span class="vip-mark" aria-hidden="true">
  <Image src={vipBadge} alt="" width={64} height={64} widths={[64, 128, 192]} sizes="64px" format="webp" quality={86} />
</span>

<style>
  .vip-mark {
    width: 64px;
    height: 64px;
    flex: 0 0 64px;
    display: block;
  }
  .vip-mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
