---
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
  brandNavigation,
  jaBrandNavigation,
  jaProductNavigation,
  productNavigation,
  zhHansBrandNavigation,
  zhHansProductNavigation,
  zhBrandNavigation,
  zhProductNavigation
} from '../data/navigation';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const path = Astro.url.pathname;
const isProduct = path.includes('/apps/caption-ai');
const nav = isProduct
  ? lang === 'ja'
    ? jaProductNavigation
    : lang === 'zh-Hant'
      ? zhProductNavigation
      : lang === 'zh-Hans'
        ? zhHansProductNavigation
      : productNavigation
  : lang === 'zh-Hant'
    ? zhBrandNavigation
    : lang === 'zh-Hans'
      ? zhHansBrandNavigation
    : lang === 'ja'
      ? jaBrandNavigation
    : brandNavigation;
const homeHref = '/';
const ariaLabel =
  lang === 'ja'
    ? 'メインナビゲーション'
    : lang === 'zh-Hant'
      ? '主要導覽'
      : lang === 'zh-Hans'
        ? '主要导航'
      : 'Main navigation';
const brandLabel = 'Station Cat';
---

<header class="site-header">
  <nav class="nav-wrap" aria-label={ariaLabel}>
    <a class="brand-mark" href={homeHref} aria-label="Station Cat home">
      <span class="brand-icon" aria-hidden="true">SC</span>
      <span>{brandLabel}</span>
    </a>
    <div class="nav-links">
      {nav.map((item) => (
        <a
          class={item.mobileHidden ? 'mobile-hide' : ''}
          href={item.href}
          target={item.href.startsWith('http') ? '_blank' : undefined}
          rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>
    <LanguageSwitcher lang={lang} />
  </nav>
</header>
