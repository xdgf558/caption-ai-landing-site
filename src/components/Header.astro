---
import { Menu, X } from '@lucide/astro';
import { isMusicPagePath } from '../music/pagePaths.js';
import { musicText } from '../scripts/musicMessages.js';
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
  brandNavigation,
  jaBrandNavigation,
  jaProductNavigation,
  productNavigation,
  zhHansBrandNavigation,
  zhHansProductNavigation,
  zhBrandNavigation,
  zhProductNavigation
} from '../data/navigation';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const path = Astro.url.pathname;
const isMusic = isMusicPagePath(path), t = musicText(lang);
const isProduct = path.includes('/apps/caption-ai');
const nav = isProduct
  ? lang === 'ja'
    ? jaProductNavigation
    : lang === 'zh-Hant'
      ? zhProductNavigation
      : lang === 'zh-Hans'
        ? zhHansProductNavigation
      : productNavigation
  : lang === 'zh-Hant'
    ? zhBrandNavigation
    : lang === 'zh-Hans'
      ? zhHansBrandNavigation
    : lang === 'ja'
      ? jaBrandNavigation
    : brandNavigation;
const homeHref = lang === 'en' ? '/en/' : lang === 'ja' ? '/ja/' : lang === 'zh-Hans' ? '/zh-hans/' : '/';
const ariaLabel =
  lang === 'ja'
    ? 'メインナビゲーション'
    : lang === 'zh-Hant'
      ? '主要導覽'
      : lang === 'zh-Hans'
        ? '主要导航'
      : 'Main navigation';
const brandLabel = 'Station Cat';
---

<header class="site-header">
  <nav class="nav-wrap" aria-label={ariaLabel}>
    <a class="brand-mark" href={homeHref} aria-label="Station Cat home">
      <span class="brand-icon" aria-hidden="true">
        <img src="/images/optimized/station-cat-logo-1668c2e5-160.webp" alt="" width="34" height="34" />
      </span>
      <span>{brandLabel}</span>
    </a>
    {isMusic && <button class="station-music-menu-toggle" data-music-menu-toggle type="button" aria-controls="music-site-menu" aria-expanded="false" aria-label={t('打开菜单')}><Menu size={26} /></button>}
    <div class:list={{ 'station-music-nav-content': isMusic, 'nav-contents': !isMusic }} data-music-nav-content={isMusic || undefined}>
    <div class="nav-links">
      {nav.map((item) => (
        <a
          class={item.mobileHidden ? 'mobile-hide' : ''}
          href={item.href}
          target={item.href.startsWith('http') ? '_blank' : undefined}
          rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>
    <LanguageSwitcher lang={lang} />
    </div>
    {isMusic && <dialog class="station-music-menu-dialog" data-menu-dialog id="music-site-menu" aria-labelledby="music-menu-heading">
      <div class="station-music-sheet-heading"><h2 id="music-menu-heading">{t('菜单')}</h2><button data-panel-close="menu" type="button" aria-label={t('关闭菜单')} autofocus><X size={24} /></button></div>
      <div data-nav-target></div>
    </dialog>}
  </nav>
</header>

<style>.nav-contents { display: contents; }</style>
