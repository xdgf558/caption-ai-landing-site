---
import BaseLayout from '../layouts/BaseLayout.astro';
import { privatePinyinProduct } from '../data/products/privatepinyin';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const downloads = privatePinyinProduct.downloads;
const macDownload = downloads.find((item) => item.id === 'macos-pkg') ?? downloads[0];
const latestVersion = privatePinyinProduct.latestVersion;
const inputSourceName = '猫栈拼音';

const copy = {
  'zh-Hant': {
    title: '下載 猫栈拼音',
    description: `下載 猫栈拼音（PrivatePinyin）${latestVersion}，包含 macOS 升級包與 Windows 內測版。`,
    kicker: 'Input Method Download',
    headline: `下載 猫栈拼音 ${latestVersion}。`,
    intro:
      `macOS 版已更新到 ${latestVersion}；Windows 版目前是內測包，提供 MSI 安裝包和 ZIP 測試包。macOS 安裝後請在系統輸入法設定裡加入「${inputSourceName}」（PrivatePinyin）。`,
    primaryButton: '下載 macOS PKG',
    back: '返回產品頁',
    backHref: privatePinyinProduct.zhHantProductPath,
    metaTitle: '下載檔案',
    releaseNotesTitle: '版本說明',
    releaseNotes: [
      '0.1.10 升級本機候選學習，常選詞會逐漸排得更靠前。',
      '新增一步聯想和短句補全學習，重複選擇的詞組會在本機形成後續建議。',
      'macOS 安裝包刷新到 0.1.10，輸入源仍為「猫栈拼音」。',
      'Windows TSF 內測包首次提供 MSI 和 ZIP，適合願意協助測試的使用者。',
      'Windows 包目前未簽名，安裝時可能出現 SmartScreen 或信任提示。'
    ],
    publicBadge: '公開測試',
    internalBadge: '內測版',
    downloadAction: '下載',
    checksum: 'SHA-256',
    metaLabels: ['Version', 'System', 'Size'],
    warning:
      '請只從 Station Cat 官方網站下載。macOS 包目前只支援 Apple Silicon Mac，Intel Mac 暫不支援；Windows 版仍屬內測，請優先在願意測試的 Windows 10 / 11 裝置上使用。'
  },
  'zh-Hans': {
    title: '下载 猫栈拼音',
    description: `下载 猫栈拼音（PrivatePinyin）${latestVersion}，包含 macOS 升级包与 Windows 内测版。`,
    kicker: 'Input Method Download',
    headline: `下载 猫栈拼音 ${latestVersion}。`,
    intro:
      `macOS 版已更新到 ${latestVersion}；Windows 版目前是内测包，提供 MSI 安装包和 ZIP 测试包。macOS 安装后请在系统输入法设置里加入「${inputSourceName}」（PrivatePinyin）。`,
    primaryButton: '下载 macOS PKG',
    back: '返回产品页',
    backHref: privatePinyinProduct.zhHansProductPath,
    metaTitle: '下载文件',
    releaseNotesTitle: '版本说明',
    releaseNotes: [
      '0.1.10 升级本机候选学习，常选词会逐渐排得更靠前。',
      '新增一步联想和短句补全学习，重复选择的词组会在本机形成后续建议。',
      'macOS 安装包刷新到 0.1.10，输入源仍为「猫栈拼音」。',
      'Windows TSF 内测包首次提供 MSI 和 ZIP，适合愿意协助测试的用户。',
      'Windows 包目前未签名，安装时可能出现 SmartScreen 或信任提示。'
    ],
    publicBadge: '公开测试',
    internalBadge: '内测版',
    downloadAction: '下载',
    checksum: 'SHA-256',
    metaLabels: ['Version', 'System', 'Size'],
    warning:
      '请只从 Station Cat 官方网站下载。macOS 包目前只支持 Apple Silicon Mac，Intel Mac 暂不支持；Windows 版仍属内测，请优先在愿意测试的 Windows 10 / 11 设备上使用。'
  },
  en: {
    title: 'Download Maozhan Pinyin',
    description: `Download Maozhan Pinyin (PrivatePinyin) ${latestVersion}, including the macOS update and Windows internal test builds.`,
    kicker: 'Input Method Download',
    headline: `Download Maozhan Pinyin ${latestVersion}.`,
    intro:
      `The macOS build is now ${latestVersion}. Windows is currently an internal test build, provided as MSI and ZIP packages. After installing on macOS, add "${inputSourceName}" (PrivatePinyin) in System Settings > Keyboard > Input Sources.`,
    primaryButton: 'Download macOS PKG',
    back: 'Back to product page',
    backHref: privatePinyinProduct.productPath,
    metaTitle: 'Download files',
    releaseNotesTitle: 'Release notes',
    releaseNotes: [
      '0.1.10 improves local candidate learning so frequently selected words can move higher over time.',
      'Adds one-step association and short phrase completion learning for repeated phrase choices.',
      'Refreshes the macOS installer to 0.1.10. The input source remains "猫栈拼音".',
      'Adds the first Windows TSF internal test packages as MSI and ZIP files.',
      'The Windows builds are unsigned and may trigger SmartScreen or trust prompts during install.'
    ],
    publicBadge: 'Public test',
    internalBadge: 'Internal test',
    downloadAction: 'Download',
    checksum: 'SHA-256',
    metaLabels: ['Version', 'System', 'Size'],
    warning:
      'Download only from the official Station Cat site. The macOS package supports Apple Silicon Macs only; Intel Macs are not supported yet. The Windows build is still an internal test and is best used on Windows 10 / 11 devices you are comfortable testing on.'
  },
  ja: {
    title: '猫栈拼音 をダウンロード',
    description: `猫栈拼音（PrivatePinyin）${latestVersion} をダウンロードできます。macOS 更新版と Windows 内部テスト版を含みます。`,
    kicker: 'Input Method Download',
    headline: `猫栈拼音 ${latestVersion} をダウンロード。`,
    intro:
      `macOS 版は ${latestVersion} に更新しました。Windows 版は現在内部テストで、MSI と ZIP を提供しています。macOS ではインストール後、システムの入力メソッド設定で「${inputSourceName}」（PrivatePinyin）を追加してください。`,
    primaryButton: 'macOS PKG をダウンロード',
    back: '製品ページへ戻る',
    backHref: privatePinyinProduct.jaProductPath,
    metaTitle: 'ダウンロードファイル',
    releaseNotesTitle: 'バージョン情報',
    releaseNotes: [
      '0.1.10 ではローカル候補学習を改善し、よく選ぶ語が上位に出やすくなります。',
      '一歩先の連想と短いフレーズ補完学習を追加しました。',
      'macOS インストーラーを 0.1.10 に更新しました。入力ソース名は「猫栈拼音」のままです。',
      'Windows TSF 内部テスト版として MSI と ZIP を初めて提供します。',
      'Windows 版は未署名のため、インストール時に SmartScreen や信頼確認が表示される場合があります。'
    ],
    publicBadge: '公開テスト',
    internalBadge: '内部テスト',
    downloadAction: 'ダウンロード',
    checksum: 'SHA-256',
    metaLabels: ['Version', 'System', 'Size'],
    warning:
      'Station Cat 公式サイトからのみダウンロードしてください。macOS パッケージは Apple Silicon Mac のみ対応し、Intel Mac はまだ対応していません。Windows 版は内部テストのため、テスト可能な Windows 10 / 11 デバイスで使用してください。'
  }
}[lang];

const canonicalPath =
  lang === 'zh-Hant'
    ? privatePinyinProduct.zhHantDownloadPagePath
    : lang === 'zh-Hans'
      ? privatePinyinProduct.zhHansDownloadPagePath
      : lang === 'ja'
        ? privatePinyinProduct.jaDownloadPagePath
        : privatePinyinProduct.downloadPagePath;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={canonicalPath}
  ogImage={privatePinyinProduct.assets.icon}
  bodyClass="station-paper-page radar-page privatepinyin-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: privatePinyinProduct.zhHantDownloadPagePath },
    { hrefLang: 'zh-Hans', href: privatePinyinProduct.zhHansDownloadPagePath },
    { hrefLang: 'en', href: privatePinyinProduct.downloadPagePath },
    { hrefLang: 'ja', href: privatePinyinProduct.jaDownloadPagePath },
    { hrefLang: 'x-default', href: privatePinyinProduct.zhHantDownloadPagePath }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">{copy.kicker}</p>
    <h1>{copy.headline}</h1>
    <p>{copy.intro}</p>
    <div class="button-row">
      <a class="button button-primary" href={macDownload.downloadPath}>{copy.primaryButton}</a>
      <a class="button button-secondary" href={copy.backHref}>{copy.back}</a>
    </div>
  </section>

  <section class="download-box radar-download-box">
    <h2>{copy.releaseNotesTitle}</h2>
    <ul class="privatepinyin-release-list">
      {copy.releaseNotes.map((note) => <li>{note}</li>)}
    </ul>
  </section>

  <section class="download-box radar-download-box">
    <h2>{copy.metaTitle}</h2>
    <div class="anytls-download-grid">
      {downloads.map((download) => (
        <article class="anytls-download-card">
          <div>
            <p class="section-kicker">{download.channel === 'internal-test' ? copy.internalBadge : copy.publicBadge}</p>
            <h3>{download.label}</h3>
            <p>{download.platform} · {download.architecture}</p>
          </div>
          <dl class="radar-meta-list">
            <div>
              <dt>{copy.metaLabels[0]}</dt>
              <dd>{download.version}</dd>
            </div>
            <div>
              <dt>{copy.metaLabels[1]}</dt>
              <dd>{download.minimumSystem}</dd>
            </div>
            <div>
              <dt>{copy.metaLabels[2]}</dt>
              <dd>{download.fileSize}</dd>
            </div>
          </dl>
          <div class="checksum-block">
            <strong>{copy.checksum}</strong>
            <code>{download.sha256}</code>
          </div>
          <a class="button button-primary" href={download.downloadPath}>{copy.downloadAction} {download.platform}</a>
        </article>
      ))}
    </div>
    <p>{copy.warning}</p>
  </section>
</BaseLayout>
