---
import BaseLayout from '../layouts/BaseLayout.astro';
import { privatePinyinProduct } from '../data/products/privatepinyin';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const downloads = privatePinyinProduct.downloads;
const macDownload = downloads.find((item) => item.id === 'macos-pkg') ?? downloads[0];
const windowsDownload = downloads.find((item) => item.id === 'windows-exe');
const iosAppStore = privatePinyinProduct.iosAppStore;
const latestVersion = privatePinyinProduct.latestVersion;
const macVersion = macDownload.version;
const windowsVersion = windowsDownload?.version ?? latestVersion;
const inputSourceName = '猫栈拼音';

const copy = {
  'zh-Hant': {
    title: '下載 猫栈拼音',
    description: `下載 猫栈拼音（PrivatePinyin）：macOS ${macVersion}、Windows ${windowsVersion} 內測版，以及 App Store 上的 iOS ${iosAppStore.version} 正式版。`,
    kicker: 'Input Method Download',
    headline: '下載 猫栈拼音測試版。',
    intro:
      `macOS 版目前是 ${macVersion}；Windows 版是 ${windowsVersion} 內測包；iOS ${iosAppStore.version} 已正式上架 App Store。macOS 安裝後請在系統輸入法設定裡加入「${inputSourceName}」（PrivatePinyin）。`,
    primaryButton: '下載 macOS PKG',
    back: '返回產品頁',
    backHref: privatePinyinProduct.zhHantProductPath,
    metaTitle: '下載檔案',
    releaseNotesTitle: '版本說明',
    releaseNotes: [
      `Windows ${windowsVersion} 穩定預設候選：AI Lite 候選重排序不再移動首選詞，空格提交結果更可預期；退格重輸和翻頁也保持候選身分穩定。`,
      '新增預設關閉的「寬容拼音」，可按需相容 zh/z、ch/c、sh/s、n/l、an/ang、en/eng 和 in/ing 等常見模糊音；原始輸入與普通候選始終保留。',
      '使用者學習改為溫和生效：同一習慣經過約三次確認後才影響排序，並使用持久化滯回邊界，減少學習權重衰減時預設候選反覆跳動。',
      '統一盲打互動：空格、數字選詞、Enter、退格、翻頁和標點採用明確規則；僅顯示下一詞預測時，數字會直接輸入目前應用程式。',
      '修正 Windows 使用者目錄或設定路徑含空格時，白霜拼音匯入和設定檔開啟失敗的問題。',
      '改善白霜與 Writer 下載的 TLS 相容性和分階段錯誤提示；現代 Windows 繼續使用系統預設安全協定協商。',
      '繼續提供 0.1.24 的全鍵盤拼音智能糾錯、白霜拼音安全匯入、桌面詞庫擴充與本機異步 AI Lite 候選重排序。',
      `Windows ${windowsVersion} 包含 x64 / x86 TSF 元件，目前仍是未簽名內測包，安裝時可能出現 SmartScreen 提示。`,
      `macOS ${macVersion} 修正原生候選面板偶爾點擊無反應的問題，滑鼠選擇現在會按候選頁代次和精確位置驗證後提交。`,
      '重複文字候選會保留使用者實際點擊的條目，不再因文字相同而錯誤選擇列表中的第一項。',
      '遲到或無法驗證的舊候選回調只記錄診斷資訊，不會提交舊文字、清除剛輸入的新拼音或覆蓋目前有效高亮。',
      '繼續提供全鍵盤智能糾錯、寬容拼音、穩定空格首選、溫和學習、白霜拼音一鍵匯入、本機 Writer、AI Lite 與分層偏好設定。',
      'macOS 安裝包已完成 Developer ID 簽名、Apple 公證與 stapling。'
    ],
    publicBadge: '公開測試',
    internalBadge: '內測版',
    downloadAction: '下載',
    checksum: 'SHA-256',
    metaLabels: ['Version', 'System', 'Size'],
    warning:
      '請只從 Station Cat 官方網站下載桌面安裝包。macOS 包目前只支援 Apple Silicon Mac，Intel Mac 暫不支援；Windows 版仍屬內測；iOS 正式版請透過 Apple App Store 安裝。'
  },
  'zh-Hans': {
    title: '下载 猫栈拼音',
    description: `下载 猫栈拼音（PrivatePinyin）：macOS ${macVersion}、Windows ${windowsVersion} 内测版，以及 App Store 上的 iOS ${iosAppStore.version} 正式版。`,
    kicker: 'Input Method Download',
    headline: '下载 猫栈拼音测试版。',
    intro:
      `macOS 版目前是 ${macVersion}；Windows 版是 ${windowsVersion} 内测包；iOS ${iosAppStore.version} 已正式上架 App Store。macOS 安装后请在系统输入法设置里加入「${inputSourceName}」（PrivatePinyin）。`,
    primaryButton: '下载 macOS PKG',
    back: '返回产品页',
    backHref: privatePinyinProduct.zhHansProductPath,
    metaTitle: '下载文件',
    releaseNotesTitle: '版本说明',
    releaseNotes: [
      `Windows ${windowsVersion} 稳定默认候选：AI Lite 候选重排序不再移动首选词，空格提交结果更可预期；退格重输和翻页也保持候选身份稳定。`,
      '新增默认关闭的「宽容拼音」，可按需兼容 zh/z、ch/c、sh/s、n/l、an/ang、en/eng 和 in/ing 等常见模糊音；原始输入与普通候选始终保留。',
      '用户学习改为温和生效：同一习惯经过约三次确认后才影响排序，并使用持久化滞回边界，减少学习权重衰减时默认候选反复跳动。',
      '统一盲打交互：空格、数字选词、回车、退格、翻页和标点采用明确规则；仅显示下一词预测时，数字会直接输入当前应用。',
      '修复 Windows 用户目录或设置路径含空格时，白霜拼音导入和配置文件打开失败的问题。',
      '改善白霜与 Writer 下载的 TLS 兼容性和分阶段错误提示；现代 Windows 继续使用系统默认安全协议协商。',
      '继续提供 0.1.24 的全键盘拼音智能纠错、白霜拼音安全导入、桌面词库扩容与本地异步 AI Lite 候选重排序。',
      `Windows ${windowsVersion} 包含 x64 / x86 TSF 组件，目前仍是未签名内测包，安装时可能出现 SmartScreen 提示。`,
      `macOS ${macVersion} 修复原生候选面板偶尔点击无反应的问题，鼠标选择现在会按候选页代次和精确位置验证后提交。`,
      '重复文字候选会保留用户实际点击的条目，不再因为文本相同而错误选择列表中的第一项。',
      '迟到或无法验证的旧候选回调只记录诊断信息，不会提交旧文本、清除刚输入的新拼音或覆盖当前有效高亮。',
      '继续提供全键盘智能纠错、宽容拼音、稳定空格首选、温和学习、白霜拼音一键导入、本地 Writer、AI Lite 与分层偏好设置。',
      'macOS 安装包已完成 Developer ID 签名、Apple 公证与 stapling。'
    ],
    publicBadge: '公开测试',
    internalBadge: '内测版',
    downloadAction: '下载',
    checksum: 'SHA-256',
    metaLabels: ['Version', 'System', 'Size'],
    warning:
      '请只从 Station Cat 官方网站下载桌面安装包。macOS 包目前只支持 Apple Silicon Mac，Intel Mac 暂不支持；Windows 版仍属内测；iOS 正式版请通过 Apple App Store 安装。'
  },
  en: {
    title: 'Download Maozhan Pinyin',
    description: `Download Maozhan Pinyin (PrivatePinyin) for macOS ${macVersion} and Windows ${windowsVersion}, or get the official iOS ${iosAppStore.version} release from the App Store.`,
    kicker: 'Input Method Download',
    headline: 'Download Maozhan Pinyin test builds.',
    intro:
      `The macOS build is ${macVersion}, the Windows internal test build is ${windowsVersion}, and iOS ${iosAppStore.version} is officially available on the App Store. After installing on macOS, add "${inputSourceName}" (PrivatePinyin) in System Settings > Keyboard > Input Sources.`,
    primaryButton: 'Download macOS PKG',
    back: 'Back to product page',
    backHref: privatePinyinProduct.productPath,
    metaTitle: 'Download files',
    releaseNotesTitle: 'Release notes',
    releaseNotes: [
      `Windows ${windowsVersion} stabilizes the default candidate: AI Lite no longer moves the first choice, Space commits more predictably, and candidate identity remains stable after backspace, retyping, or paging.`,
      'Adds opt-in tolerant pinyin for common fuzzy pairs including zh/z, ch/c, sh/s, n/l, an/ang, en/eng, and in/ing. It remains off by default, and raw input plus normal candidates stay available.',
      'Makes user learning gentler. A habit affects ranking only after about three confirmations, with persistent activation and deactivation hysteresis to reduce default-candidate jumps as learning weights decay.',
      'Unifies blind typing across Space, number selection, Enter, backspace, paging, and punctuation. In prediction-only mode, digits pass through directly to the current app.',
      'Fixes Rime Frost import and settings-file opening when the Windows user directory or settings path contains spaces.',
      'Improves TLS compatibility and staged error reporting for Rime Frost and Writer downloads while continuing to use modern Windows system security defaults.',
      'Retains the 0.1.24 full-key typo correction, reviewed Rime Frost import, expanded desktop lexicon limits, and asynchronous local AI Lite reranking.',
      `Windows ${windowsVersion} includes x64 and x86 TSF components. It remains an unsigned internal-test package and may trigger SmartScreen prompts.`,
      `macOS ${macVersion} fixes intermittent no-op clicks in the native candidate panel. Mouse selections are validated against the candidate-page generation and exact position before commit.`,
      'Duplicate-text candidates preserve the item the user actually clicked instead of incorrectly selecting the first matching label.',
      'Late or unverifiable callbacks record diagnostics only. They cannot commit old text, clear newly typed pinyin, or replace the current verified highlight.',
      'Retains full-key typo correction, tolerant pinyin, a stable Space-key default, gentle learning, Rime Frost import, local Writer, AI Lite, and tiered preferences.',
      'The macOS installer is Developer ID signed, Apple notarized, and stapled.'
    ],
    publicBadge: 'Public test',
    internalBadge: 'Internal test',
    downloadAction: 'Download',
    checksum: 'SHA-256',
    metaLabels: ['Version', 'System', 'Size'],
    warning:
      'Download desktop installers only from the official Station Cat site. The macOS package supports Apple Silicon Macs only; Intel Macs are not supported yet. Windows remains an internal test, and the official iOS release is delivered through the Apple App Store.'
  },
  ja: {
    title: '猫栈拼音 をダウンロード',
    description: `猫栈拼音（PrivatePinyin）の macOS ${macVersion}、Windows ${windowsVersion} 内部テスト版をダウンロードし、iOS ${iosAppStore.version} 正式版を App Store から入手できます。`,
    kicker: 'Input Method Download',
    headline: '猫栈拼音 テスト版をダウンロード。',
    intro:
      `macOS 版は ${macVersion}、Windows 内部テスト版は ${windowsVersion} です。iOS ${iosAppStore.version} は App Store で正式公開しています。macOS ではインストール後、システムの入力メソッド設定で「${inputSourceName}」（PrivatePinyin）を追加してください。`,
    primaryButton: 'macOS PKG をダウンロード',
    back: '製品ページへ戻る',
    backHref: privatePinyinProduct.jaProductPath,
    metaTitle: 'ダウンロードファイル',
    releaseNotesTitle: 'バージョン情報',
    releaseNotes: [
      `Windows ${windowsVersion} は先頭候補を安定させました。AI Lite は先頭候補を移動せず、Space の確定結果が予測しやすくなり、削除後の再入力やページ切り替えでも候補の同一性を保ちます。`,
      '既定では無効の曖昧ピンインを追加し、zh/z、ch/c、sh/s、n/l、an/ang、en/eng、in/ing などを必要に応じて許容できます。元の入力と通常候補は常に残ります。',
      'ユーザー学習を穏やかにしました。同じ傾向を約 3 回確認してから順位に反映し、永続的な有効化／無効化のヒステリシスで学習減衰時の先頭候補の揺れを抑えます。',
      'Space、数字選択、Enter、Backspace、ページ切り替え、句読点のブラインド入力規則を統一しました。次語予測だけの状態では数字をアプリへそのまま入力します。',
      'Windows のユーザーディレクトリや設定パスに空白が含まれる場合に、白霜拼音の取り込みや設定ファイルの表示が失敗する問題を修正しました。',
      '白霜と Writer のダウンロードで TLS 互換性と段階別エラー表示を改善し、最新 Windows のシステム既定の安全なプロトコルを引き続き使用します。',
      '0.1.24 の全キーボード入力訂正、検証済み白霜拼音取り込み、デスクトップ辞書上限拡大、ローカル非同期 AI Lite 並べ替えも引き続き利用できます。',
      `Windows ${windowsVersion} は x64 / x86 TSF コンポーネントを収録した未署名の内部テスト版で、SmartScreen が表示される場合があります。`,
      `macOS ${macVersion} は、ネイティブ候補パネルでクリックが反応しないことがある問題を修正しました。マウス選択は候補ページの世代と正確な位置を検証してから確定します。`,
      '同じ文字列の候補でも、ユーザーが実際にクリックした項目を保持し、最初の一致項目を誤って選択しません。',
      '遅延した、または検証できない古いコールバックは診断だけを記録し、旧テキストの確定、新しく入力したピンインの消去、現在の有効なハイライトの上書きを行いません。',
      '全キーボード入力訂正、曖昧ピンイン、安定した Space キー候補、穏やかな学習、白霜拼音取り込み、ローカル Writer、AI Lite、階層型設定を引き続き利用できます。',
      'macOS インストーラーは Developer ID 署名、Apple 公証、stapling を完了しています。'
    ],
    publicBadge: '公開テスト',
    internalBadge: '内部テスト',
    downloadAction: 'ダウンロード',
    checksum: 'SHA-256',
    metaLabels: ['Version', 'System', 'Size'],
    warning:
      'デスクトップ版は Station Cat 公式サイトからのみダウンロードしてください。macOS は Apple Silicon Mac のみ対応し、Windows は内部テスト版です。iOS 正式版は Apple App Store からインストールしてください。'
  }
}[lang];

const iosCopy = {
  'zh-Hant': {
    badge: '正式上架',
    title: `iOS ${iosAppStore.version}`,
    description: '從 Apple App Store 在 iPhone 或 iPad 安裝猫栈拼音正式版。',
    labels: ['Version', 'Device', 'System'],
    values: [iosAppStore.version, iosAppStore.devices, iosAppStore.minimumSystem],
    action: '在 App Store 下載'
  },
  'zh-Hans': {
    badge: '正式上架',
    title: `iOS ${iosAppStore.version}`,
    description: '从 Apple App Store 在 iPhone 或 iPad 安装猫栈拼音正式版。',
    labels: ['Version', 'Device', 'System'],
    values: [iosAppStore.version, iosAppStore.devices, iosAppStore.minimumSystem],
    action: '从 App Store 下载'
  },
  en: {
    badge: 'App Store release',
    title: `iOS ${iosAppStore.version}`,
    description: 'Install the official Maozhan Pinyin release on iPhone or iPad from the Apple App Store.',
    labels: ['Version', 'Device', 'System'],
    values: [iosAppStore.version, iosAppStore.devices, iosAppStore.minimumSystem],
    action: 'Download on the App Store'
  },
  ja: {
    badge: 'App Store 正式公開',
    title: `iOS ${iosAppStore.version}`,
    description: 'Apple App Store から iPhone または iPad に猫栈拼音正式版をインストールできます。',
    labels: ['Version', 'Device', 'System'],
    values: [iosAppStore.version, iosAppStore.devices, iosAppStore.minimumSystem],
    action: 'App Store からダウンロード'
  }
}[lang];

const canonicalPath =
  lang === 'zh-Hant'
    ? privatePinyinProduct.zhHantDownloadPagePath
    : lang === 'zh-Hans'
      ? privatePinyinProduct.zhHansDownloadPagePath
      : lang === 'ja'
        ? privatePinyinProduct.jaDownloadPagePath
        : privatePinyinProduct.downloadPagePath;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={canonicalPath}
  ogImage={privatePinyinProduct.assets.icon}
  bodyClass="station-paper-page radar-page privatepinyin-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: privatePinyinProduct.zhHantDownloadPagePath },
    { hrefLang: 'zh-Hans', href: privatePinyinProduct.zhHansDownloadPagePath },
    { hrefLang: 'en', href: privatePinyinProduct.downloadPagePath },
    { hrefLang: 'ja', href: privatePinyinProduct.jaDownloadPagePath },
    { hrefLang: 'x-default', href: privatePinyinProduct.zhHantDownloadPagePath }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">{copy.kicker}</p>
    <h1>{copy.headline}</h1>
    <p>{copy.intro}</p>
    <div class="button-row">
      <a class="button button-primary" href={macDownload.downloadPath}>{copy.primaryButton}</a>
      <a class="button button-secondary" href={iosAppStore.url} target="_blank" rel="noreferrer">{iosCopy.action}</a>
      <a class="button button-secondary" href={copy.backHref}>{copy.back}</a>
    </div>
  </section>

  <section class="download-box radar-download-box">
    <h2>{copy.releaseNotesTitle}</h2>
    <ul class="privatepinyin-release-list">
      {copy.releaseNotes.map((note) => <li>{note}</li>)}
    </ul>
  </section>

  <section class="download-box radar-download-box">
    <h2>{copy.metaTitle}</h2>
    <div class="anytls-download-grid">
      {downloads.map((download) => (
        <article class="anytls-download-card">
          <div>
            <p class="section-kicker">{download.channel === 'internal-test' ? copy.internalBadge : copy.publicBadge}</p>
            <h3>{download.label}</h3>
            <p>{download.platform} · {download.architecture}</p>
          </div>
          <dl class="radar-meta-list">
            <div>
              <dt>{copy.metaLabels[0]}</dt>
              <dd>{download.version}</dd>
            </div>
            <div>
              <dt>{copy.metaLabels[1]}</dt>
              <dd>{download.minimumSystem}</dd>
            </div>
            <div>
              <dt>{copy.metaLabels[2]}</dt>
              <dd>{download.fileSize}</dd>
            </div>
          </dl>
          <div class="checksum-block">
            <strong>{copy.checksum}</strong>
            <code>{download.sha256}</code>
          </div>
          <a class="button button-primary" href={download.downloadPath}>{copy.downloadAction} {download.platform}</a>
        </article>
      ))}
      <article class="anytls-download-card privatepinyin-app-store-card">
        <div>
          <p class="section-kicker">{iosCopy.badge}</p>
          <h3>{iosCopy.title}</h3>
          <p>{iosCopy.description}</p>
        </div>
        <dl class="radar-meta-list">
          {iosCopy.labels.map((label, index) => (
            <div>
              <dt>{label}</dt>
              <dd>{iosCopy.values[index]}</dd>
            </div>
          ))}
        </dl>
        <a class="button button-primary" href={iosAppStore.url} target="_blank" rel="noreferrer">{iosCopy.action}</a>
      </article>
    </div>
    <p>{copy.warning}</p>
  </section>
</BaseLayout>
