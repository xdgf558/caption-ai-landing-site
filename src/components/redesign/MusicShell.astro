---
import { Play, Pause, Heart, ArrowRight, Music2, Headphones, Search, X } from '@lucide/astro';
import apple from '../../assets/redesign/icons/apple-logo-fill.svg?raw';
import youtube from '../../assets/redesign/icons/youtube-logo-fill.svg?raw';
import spotify from '../../assets/redesign/icons/spotify-logo-fill.svg?raw';
import StationBrandLayout from '../../layouts/StationBrandLayout.astro';
import ClipDialog from './ClipDialog.astro';
import StationPlayer from './StationPlayer.astro';
import { musicCopy } from '../../redesign/musicCopy.js';
import { stationHref } from '../../redesign/routes.js';
import '../../redesign/music.css';
import '../../redesign/platforms.css';
import '../../redesign/clips.css';
import { ClientRouter } from 'astro:transitions';
interface Props { lang: 'zh-Hant' | 'zh-Hans' | 'en' | 'ja' }
const { lang } = Astro.props;
const copy = musicCopy[lang];
const inner = (source: string) => source.slice(source.indexOf('>') + 1, source.lastIndexOf('</svg>'));
---
<StationBrandLayout lang={lang} title={copy.title} description={copy.intro} activeSection="music" persistentPlayer preview>
  <ClientRouter slot="head" fallback="swap" />
  <div data-sc-music-page></div>
  <p class="sc-container sc-music-feedback" data-sc-music-feedback role="status" hidden></p>
  <StationPlayer slot="player" lang={lang} />
  <Fragment slot="fixture-controls">
  <svg class="sc-music-symbols" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <symbol id="sc-icon-play" viewBox="0 0 24 24"><Play size={24} /></symbol>
      <symbol id="sc-icon-pause" viewBox="0 0 24 24"><Pause size={24} /></symbol>
      <symbol id="sc-icon-heart" viewBox="0 0 24 24"><Heart size={24} /></symbol>
      <symbol id="sc-icon-arrow" viewBox="0 0 24 24"><ArrowRight size={24} /></symbol>
      <symbol id="sc-icon-music" viewBox="0 0 24 24"><Music2 size={24} /></symbol>
      <symbol id="sc-icon-headphones" viewBox="0 0 24 24"><Headphones size={24} /></symbol>
      <symbol id="sc-icon-search" viewBox="0 0 24 24"><Search size={24} /></symbol>
      <symbol id="sc-icon-close" viewBox="0 0 24 24"><X size={24} /></symbol>
      <symbol id="sc-icon-apple" viewBox="0 0 256 256" set:html={inner(apple)} />
      <symbol id="sc-icon-youtube" viewBox="0 0 256 256" set:html={inner(youtube)} />
      <symbol id="sc-icon-spotify" viewBox="0 0 256 256" set:html={inner(spotify)} />
    </defs>
  </svg>
  <ClipDialog lang={lang} />
  </Fragment>
</StationBrandLayout>
<script>
  import { mountStationMusic } from '../../redesign/musicClient.js';
  import { disposeStationMusicSession } from '../../redesign/musicPlayerView.js';
  let dispose = () => {};
  function mountPage() {
    if (!document.querySelector('[data-sc-music-page]')?.hasAttribute('data-mounted')) dispose = mountStationMusic();
  }
  mountPage();
  document.addEventListener('astro:before-swap', event => {
    dispose(); dispose = () => {};
    if (!event.newDocument.querySelector('[data-sc-music-audio]')) disposeStationMusicSession();
  });
  document.addEventListener('astro:page-load', mountPage);
  document.addEventListener('astro:after-swap', mountPage);
</script>
