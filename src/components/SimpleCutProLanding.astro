---
import BaseLayout from '../layouts/BaseLayout.astro';
import { simpleCutProProduct } from '../data/products/simplecut-pro';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const [macDownload, windowsDownload] = simpleCutProProduct.downloads;
const currentVersion = simpleCutProProduct.latestVersion.replace(/^v/, '');

const copy = {
  'zh-Hant': {
    title: 'SimpleCut Pro｜本機桌面影片剪輯工具',
    eyebrow: 'Desktop Video Editor',
    headline: '用 SimpleCut Pro，在本機完成輕量影片剪輯。',
    intro:
      'SimpleCut Pro 是 Station Cat 正在打磨的桌面剪輯工具，適合把素材放到時間線上做剪切、音訊對齊、轉場預覽和本機匯出。目前提供 macOS Apple Silicon 和 Windows x64 版本。',
    primaryMac: '下載 macOS 版',
    primaryWindows: '下載 Windows 版',
    details: '下載與更新說明',
    detailsHref: simpleCutProProduct.zhHantDownloadPagePath,
    iconAlt: 'SimpleCut Pro 軟體圖標',
    featuresTitle: '目前能處理什麼',
    features: [
      ['時間線剪輯', '把影片與音訊素材放到時間線，做分段、刪除範圍和位置調整。'],
      ['音訊與轉場', '支援音訊拖拽對齊、淡入淡出、邊緣裁剪和常用畫面轉場。'],
      ['預覽與匯出', '可以在桌面端預覽片段、檢查轉場，再用本機 FFmpeg 流程匯出。'],
      ['線上更新準備', `${currentVersion} 已更新下載與更新 metadata，後續版本會透過同一下載目錄提供更新資訊。`]
    ],
    releaseTitle: `${currentVersion} 發布狀態`,
    releaseNotes: [
      'macOS 和 Windows 安裝包已更新；macOS 安裝時請以系統安全提示為準。',
      'Windows x64 安裝包已生成。',
      '自動更新 metadata 和 blockmap 會和安裝包一起放在公開下載目錄。'
    ]
  },
  'zh-Hans': {
    title: 'SimpleCut Pro｜本地桌面视频剪辑工具',
    eyebrow: 'Desktop Video Editor',
    headline: '用 SimpleCut Pro，在本机完成轻量视频剪辑。',
    intro:
      'SimpleCut Pro 是 Station Cat 正在打磨的桌面剪辑工具，适合把素材放到时间线上做剪切、音频对齐、转场预览和本机导出。目前提供 macOS Apple Silicon 和 Windows x64 版本。',
    primaryMac: '下载 macOS 版',
    primaryWindows: '下载 Windows 版',
    details: '下载与更新说明',
    detailsHref: simpleCutProProduct.zhHansDownloadPagePath,
    iconAlt: 'SimpleCut Pro 软件图标',
    featuresTitle: '目前能处理什么',
    features: [
      ['时间线剪辑', '把视频与音频素材放到时间线，做分段、删除范围和位置调整。'],
      ['音频与转场', '支持音频拖拽对齐、淡入淡出、边缘裁剪和常用画面转场。'],
      ['预览与导出', '可以在桌面端预览片段、检查转场，再用本机 FFmpeg 流程导出。'],
      ['在线更新准备', `${currentVersion} 已更新下载与更新 metadata，后续版本会通过同一下载目录提供更新信息。`]
    ],
    releaseTitle: `${currentVersion} 发布状态`,
    releaseNotes: [
      'macOS 和 Windows 安装包已更新；macOS 安装时请以系统安全提示为准。',
      'Windows x64 安装包已生成。',
      '自动更新 metadata 和 blockmap 会和安装包一起放在公开下载目录。'
    ]
  },
  en: {
    title: 'SimpleCut Pro | Local Desktop Video Editor',
    eyebrow: 'Desktop Video Editor',
    headline: 'A local desktop editor for lightweight video cuts.',
    intro:
      'SimpleCut Pro is a Station Cat desktop editing tool for arranging media on a timeline, cutting ranges, aligning audio, previewing transitions, and exporting locally. Current builds are available for macOS Apple Silicon and Windows x64.',
    primaryMac: 'Download macOS',
    primaryWindows: 'Download Windows',
    details: 'Download and update notes',
    detailsHref: simpleCutProProduct.downloadPagePath,
    iconAlt: 'SimpleCut Pro app icon',
    featuresTitle: 'What it handles now',
    features: [
      ['Timeline editing', 'Place video and audio clips on a timeline, split clips, delete ranges, and adjust positions.'],
      ['Audio and transitions', 'Use audio alignment, fade handles, edge trimming, and common visual transitions.'],
      ['Preview and export', 'Preview edits on desktop, check transitions, then export through a local FFmpeg workflow.'],
      ['Update feed ready', `Version ${currentVersion} refreshes the download and update metadata. Future releases will use the same public download folder.`]
    ],
    releaseTitle: `${currentVersion} release state`,
    releaseNotes: [
      'The macOS and Windows installers have been refreshed; follow macOS system security prompts for this build.',
      'The Windows x64 installer has been generated.',
      'Auto-update metadata and blockmaps are published beside the installers.'
    ]
  },
  ja: {
    title: 'SimpleCut Pro｜ローカルデスクトップ動画編集',
    eyebrow: 'Desktop Video Editor',
    headline: '軽い動画編集をローカルで進めるデスクトップツール。',
    intro:
      'SimpleCut Pro は Station Cat が作っているデスクトップ編集ツールです。素材をタイムラインに並べ、カット、音声位置合わせ、トランジションの確認、ローカル書き出しを行えます。現在は macOS Apple Silicon と Windows x64 版を用意しています。',
    primaryMac: 'macOS 版をダウンロード',
    primaryWindows: 'Windows 版をダウンロード',
    details: 'ダウンロードと更新情報',
    detailsHref: simpleCutProProduct.jaDownloadPagePath,
    iconAlt: 'SimpleCut Pro アプリアイコン',
    featuresTitle: '現在できること',
    features: [
      ['タイムライン編集', '動画と音声素材を並べ、分割、範囲削除、位置調整を行えます。'],
      ['音声とトランジション', '音声の位置合わせ、フェード、端のトリム、基本的な画面転換を扱えます。'],
      ['プレビューと書き出し', 'デスクトップ上で編集を確認し、ローカルの FFmpeg ワークフローで書き出します。'],
      ['更新フィード対応', `${currentVersion} ではダウンロードと更新 metadata を更新し、今後のリリースも同じ公開フォルダを使います。`]
    ],
    releaseTitle: `${currentVersion} の公開状態`,
    releaseNotes: [
      'macOS 版と Windows 版を更新しました。macOS のインストール時はシステムの安全確認に従ってください。',
      'Windows x64 インストーラーを生成済みです。',
      '自動更新用 metadata と blockmap もインストーラーと同じ場所に公開します。'
    ]
  }
}[lang];

const canonicalPath =
  lang === 'zh-Hant'
    ? simpleCutProProduct.zhHantProductPath
    : lang === 'zh-Hans'
      ? simpleCutProProduct.zhHansProductPath
      : lang === 'ja'
        ? simpleCutProProduct.jaProductPath
        : simpleCutProProduct.productPath;
---

<BaseLayout
  title={copy.title}
  description={copy.intro}
  lang={lang}
  canonicalPath={canonicalPath}
  ogImage={simpleCutProProduct.assets.icon}
  bodyClass="station-paper-page radar-page"
  alternates={[
    { hrefLang: 'zh-Hant', href: simpleCutProProduct.zhHantProductPath },
    { hrefLang: 'zh-Hans', href: simpleCutProProduct.zhHansProductPath },
    { hrefLang: 'en', href: simpleCutProProduct.productPath },
    { hrefLang: 'ja', href: simpleCutProProduct.jaProductPath },
    { hrefLang: 'x-default', href: simpleCutProProduct.zhHantProductPath }
  ]}
>
  <section class="radar-hero">
    <div class="radar-hero__copy">
      <p class="section-kicker">{copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p>{copy.intro}</p>
      <div class="button-row">
        <a class="button button-primary" href={macDownload.downloadPath}>{copy.primaryMac}</a>
        <a class="button button-secondary" href={windowsDownload.downloadPath}>{copy.primaryWindows}</a>
        <a class="button button-secondary" href={copy.detailsHref}>{copy.details}</a>
      </div>
    </div>
    <div class="radar-preview-card anytls-icon-preview" aria-label="SimpleCut Pro app icon">
      <img src={simpleCutProProduct.assets.icon} alt={copy.iconAlt} width="1024" height="1024" />
    </div>
  </section>

  <section class="page-section">
    <div class="section-heading">
      <p class="section-kicker">Editing workflow</p>
      <h2>{copy.featuresTitle}</h2>
    </div>
    <div class="radar-feature-grid">
      {copy.features.map(([title, text]) => (
        <article>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section">
    <div class="radar-note-panel">
      <div>
        <p class="section-kicker">Version {simpleCutProProduct.latestVersion}</p>
        <h2>{copy.releaseTitle}</h2>
      </div>
      <ul>
        {copy.releaseNotes.map((note) => <li>{note}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
