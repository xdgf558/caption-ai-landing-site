    storycatTest: `${storyCatProduct.productPath}${storyCatProduct.testFlightAnchor}`,
    simplecut: simpleCutProProduct.productPath,
    simplecutDownload: simpleCutProProduct.downloadPagePath,
    radar: stationCatRadarProduct.productPath,
    radarDownload: '/apps/stationcat-radar/download/',
    followCleaner: xFollowCleanerProduct.productPath,
    followCleanerDownload: xFollowCleanerProduct.downloadUrl,
    devlogPrefix: '/en/devlog/'
  },
  ja: {
    apps: '/ja/apps/',
    notes: '/ja/works/',
    snapcopy: snapCopyProduct.jaProductPath,
    snapcopyTest: '/ja/apps/caption-ai/download/',
    storycat: storyCatProduct.jaProductPath,
    storycatTest: `${storyCatProduct.jaProductPath}${storyCatProduct.testFlightAnchor}`,
    simplecut: simpleCutProProduct.jaProductPath,
    simplecutDownload: simpleCutProProduct.jaDownloadPagePath,
    radar: stationCatRadarProduct.jaProductPath,
    radarDownload: '/ja/apps/stationcat-radar/download/',
    followCleaner: xFollowCleanerProduct.jaProductPath,
    followCleanerDownload: xFollowCleanerProduct.downloadUrl,
    devlogPrefix: '/ja/devlog/'
  }
}[lang];

const workLanguage = lang === 'ja' ? 'ja' : lang === 'en' ? 'en' : 'zh-hant';
const devlogLanguage = lang;

const allWorks = await getCollection('xworks');
const recentWorks = allWorks
  .filter((work) => work.data.status === 'published' && work.data.featured && work.data.language === workLanguage)
  .sort((a, b) => new Date(b.data.publishedAt ?? 0).getTime() - new Date(a.data.publishedAt ?? 0).getTime())
  .slice(0, 3);

const allDevlog = await getCollection('devlog');
const recentDevlog = allDevlog
  .filter((post) => !post.data.draft && post.data.language === devlogLanguage)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const formatDate = (value?: string | Date) => {
  if (!value) return '';
  const date = value instanceof Date ? value : new Date(value);
  return new Intl.DateTimeFormat(copy.dateLocale, { year: 'numeric', month: 'short', day: 'numeric' }).format(date);
};

const devlogHref = (post: (typeof recentDevlog)[number]) => {
  const slug = post.data.postSlug ?? post.slug;
  return `${paths.devlogPrefix}${slug}/`;
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={canonicalPath}
  bodyClass="station-home station-home-v2"
  alternates={[
    { hrefLang: 'zh-Hant', href: '/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/' },
    { hrefLang: 'en', href: '/en/' },
    { hrefLang: 'ja', href: '/ja/' },
    { hrefLang: 'x-default', href: '/' }
  ]}
>
  <section class="paper-hero">
    <div class="paper-hero__copy">
      <div class="station-logo-lockup">
        <img src={stationLogoPath} alt={copy.logoAlt} width="998" height="970" />
        <div class="station-logo-lockup__text">
          <p class="paper-kicker">Station Cat</p>
          <p class="station-logo-lockup__caption">{copy.logoCaption}</p>
        </div>
      </div>
      <h1>{copy.heroTitle}</h1>
      <p class="paper-lede">{copy.heroText}</p>
      <div class="paper-actions" aria-label="Primary actions">
        <a class="ticket-button ticket-button--primary" href={paths.apps}>{copy.primaryCta}</a>
        <a class="ticket-button ticket-button--secondary" href="#recent-notes">{copy.secondaryCta}</a>
      </div>
    </div>

    <aside class="station-board-v2" aria-label={copy.boardLabel}>
      <div class="station-board-v2__rail">
        <span>SC</span>
        <span>{copy.boardLabel}</span>
      </div>
      <div class="station-board-v2__pinboard">
        {copy.boardItems.map((item) => (
          <article class={`station-scrap station-scrap--${item.type}`}>
            {item.type === 'polaroid' && (
              <img class="station-scrap__photo" src={stationLogoPath} alt={copy.logoAlt} width="998" height="970" loading="lazy" />
            )}
            <span class="paper-stamp">{item.stamp}</span>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </aside>
  </section>

  <section id="about" class="paper-section about-ticket">
    <p class="paper-kicker">{copy.aboutKicker}</p>
    <h2>{copy.aboutTitle}</h2>
    <p>{copy.aboutText}</p>
  </section>

  <section class="paper-section">
    <div class="paper-section__heading">
      <p class="paper-kicker">{copy.todayKicker}</p>
      <h2>{copy.todayTitle}</h2>
      <p>{copy.todayIntro}</p>
    </div>
    <div class="station-day-grid">
      {copy.stationCards.map((card, index) => (
        <article class={`station-day-card station-day-card--${index + 1}`}>
          <span class="line-icon" set:html={icons[card.icon as IconName]} />
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="apps" class="paper-section">
    <div class="paper-section__heading">
      <p class="paper-kicker">{copy.toolsKicker}</p>
      <h2>{copy.toolsTitle}</h2>
      <p>{copy.toolsIntro}</p>
    </div>
    <div class="bench-grid">
      <article class="bench-card">
        <div class="bench-card__icon bench-card__icon--snapcopy">
          <img src={snapCopyProduct.assets.icon} alt="SnapCopy app icon" width="512" height="512" loading="lazy" />
        </div>
        <div class="bench-card__copy">
          <span class="paper-stamp">{copy.snapcopyStatus}</span>
          <h3>SnapCopy</h3>
          <p>{copy.snapcopyDesc}</p>
          <div class="paper-actions">
            <a class="ticket-button ticket-button--primary" href={paths.snapcopy}>{copy.viewApp}</a>
            <a class="ticket-button ticket-button--secondary" href={paths.snapcopyTest}>{copy.joinTest}</a>
          </div>
        </div>
      </article>

      <article class="bench-card">
        <div class="bench-card__icon bench-card__icon--storycat">
          <img src={storyCatProduct.assets.icon} alt="StoryCat app icon" width="368" height="370" loading="lazy" />
        </div>
        <div class="bench-card__copy">
          <span class="paper-stamp">{copy.storycatStatus}</span>
          <h3>StoryCat</h3>
          <p>{copy.storycatDesc}</p>
          <div class="paper-actions">
            <a class="ticket-button ticket-button--primary" href={paths.storycat}>{copy.viewApp}</a>
            <a class="ticket-button ticket-button--secondary" href={paths.storycatTest}>{copy.joinTest}</a>
          </div>
        </div>
      </article>

      <article class="bench-card">
        <div class="bench-card__icon bench-card__icon--simplecut">
          <img src={simpleCutProProduct.assets.icon} alt="SimpleCut Pro app icon" width="1024" height="1024" loading="lazy" />
        </div>
        <div class="bench-card__copy">
          <span class="paper-stamp">{copy.simplecutStatus}</span>
          <h3>SimpleCut Pro</h3>
          <p>{copy.simplecutDesc}</p>
          <div class="paper-actions">
            <a class="ticket-button ticket-button--primary" href={paths.simplecut}>{copy.simplecutView}</a>
            <a class="ticket-button ticket-button--secondary" href={paths.simplecutDownload}>{copy.simplecutDownload}</a>
          </div>
        </div>
      </article>

      <article class="bench-card">
        <div class="bench-card__icon bench-card__icon--radar">
          <span class="line-icon line-icon--large" set:html={icons.radar} />
        </div>
        <div class="bench-card__copy">
          <span class="paper-stamp">{copy.radarStatus}</span>
          <h3>StationCat Radar</h3>
          <p>{copy.radarDesc}</p>
          <div class="paper-actions">
            <a class="ticket-button ticket-button--primary" href={paths.radar}>{copy.viewApp}</a>
            <a class="ticket-button ticket-button--secondary" href={paths.radarDownload}>{copy.downloadMac}</a>
          </div>
        </div>
      </article>

      <article class="bench-card">
        <div class="bench-card__icon">
          <span class="line-icon line-icon--large" set:html={icons.app} />
        </div>
        <div class="bench-card__copy">
          <span class="paper-stamp">{copy.followCleanerStatus}</span>
          <h3>X Follow Cleaner</h3>
          <p>{copy.followCleanerDesc}</p>
          <div class="paper-actions">
            <a class="ticket-button ticket-button--primary" href={paths.followCleaner}>{copy.viewApp}</a>
            <a class="ticket-button ticket-button--secondary" href={paths.followCleanerDownload}>{copy.downloadExtension}</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section id="recent-notes" class="paper-section">
    <div class="paper-section__heading">
      <p class="paper-kicker">{copy.notesKicker}</p>
      <h2>{copy.notesTitle}</h2>
      <p>{copy.notesIntro}</p>
    </div>
    {recentWorks.length > 0 ? (
      <div class="wall-note-grid">
        {recentWorks.map((work, index) => (
          <article class={`wall-note wall-note--${index + 1}`}>
            <div class="wall-note__meta">
              <span class="paper-stamp">{work.data.type}</span>
              {work.data.publishedAt && <time datetime={work.data.publishedAt}>{formatDate(work.data.publishedAt)}</time>}
            </div>
            <h3>{work.data.title}</h3>
            {work.data.description && <p>{work.data.description}</p>}
            <a class="paper-link" href={work.data.xUrl} target="_blank" rel="noopener noreferrer">{copy.viewOnX}</a>
          </article>
        ))}
      </div>
    ) : (
      <p class="paper-empty">{copy.emptyNotes}</p>
    )}
  </section>

  <section class="paper-section">
    <div class="paper-section__heading">
      <p class="paper-kicker">{copy.buildKicker}</p>
      <h2>{copy.buildTitle}</h2>
      <p>{copy.buildIntro}</p>
    </div>
    {recentDevlog.length > 0 ? (
      <div class="build-log-list">
        {recentDevlog.map((post) => (
          <article class="build-log-row">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span class="paper-stamp">{post.data.status}</span>
            <div>
              <h3><a href={devlogHref(post)}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="paper-empty">{copy.emptyBuild}</p>
    )}
  </section>

  <section class="paper-closing">
    <div>
      <p class="paper-kicker">Station Cat</p>
      <h2>{copy.closingTitle}</h2>
      <p>{copy.closingText}</p>
    </div>
    <div class="paper-actions">
      <a class="ticket-button ticket-button--primary" href={xUrl} target="_blank" rel="noopener noreferrer">{copy.follow}</a>
      <a class="ticket-button ticket-button--secondary" href={paths.snapcopy}>{copy.viewSnapCopy}</a>
      <a class="ticket-button ticket-button--secondary" href="/android/">{copy.android}</a>
    </div>
  </section>
</BaseLayout>
