    simplecutDesc: 'ローカルのタイムラインでカット、音声調整、転換確認、軽い動画書き出しを行えます。',
    nodePilotDesc: '管理権限のある AnyTLS 設定、接続情報、ローカルメモを整理します。',
    snapcopyStatus: 'App Store 公開中',
    mindBudgetStatus: `iPhone TestFlight ${mindBudgetProduct.latestVersion}`,
    mindBudgetDownload: '公開テストに参加',
    novelForgeStatus: `macOS public test ${novelForgeVersion}`,
    novelForgeDownload: 'Mac 版をダウンロード',
    privatePinyinStatus: `macOS ${privatePinyinMacVersion} · Windows ${privatePinyinWindowsVersion} · iOS App Store ${privatePinyinIosVersion}`,
    privatePinyinDownload: 'ダウンロード / App Store',
    simplecutStatus: `desktop release ${currentVersion}`,
    simplecutView: 'アプリを見る',
    simplecutDownload: 'ダウンロード',
    nodePilotStatus: `Windows / Mac test build ${nodePilotVersion}`,
    nodePilotDownload: 'Mac 版をダウンロード',
    notesKicker: 'Serial fiction',
    notesTitle: '連載中：Offline Future。',
    notesIntro: '最初の長編小説を公開しました。作品ページ、最新章、読書ステータスをここにまとめます。',
    viewOnX: '作品を見る',
    readFirstChapter: '第1章を読む',
    openSeries: '作品ページ',
    latestChapterLabel: '最新章',
    freeChaptersLabel: '無料・第10章からログインが必要',
    emptyNotes: '最初の連載はまもなくここに並びます。',
    closingTitle: 'この小さな場所は、まだ少しずつ育っています。',
    closingText: '猫、朝食、ツール、そして少し不思議なアイデアがプロダクトになる途中を見に来てください。',
    follow: 'Follow on X',
    viewSnapCopy: 'View SnapCopy',
    android: 'Join Android Waitlist',
  }
}[lang];

const paths = {
  'zh-Hant': {
    apps: '/zh-hant/apps/',
    notes: '/novel/',
    snapcopy: snapCopyProduct.zhHantProductPath,
    snapcopyTest: '/zh-hant/apps/caption-ai/download/',
    mindBudget: mindBudgetProduct.zhHantProductPath,
    mindBudgetDownload: mindBudgetProduct.zhHantDownloadPagePath,
    novelForge: novelForgeAiProduct.zhHantProductPath,
    novelForgeDownload: novelForgeDownload.downloadPath,
    privatePinyin: privatePinyinProduct.zhHantProductPath,
    privatePinyinDownload: versionedPrivatePinyinDownload(privatePinyinProduct.zhHantDownloadPagePath),
    simplecut: simpleCutProProduct.zhHantProductPath,
    simplecutDownload: simpleCutProProduct.zhHantDownloadPagePath,
    nodePilot: anyTlsDesktopManagerProduct.zhHantProductPath,
    nodePilotDownload: nodePilotMacDownload?.downloadPath ?? anyTlsDesktopManagerProduct.zhHantProductPath,
    signal: '/signal/'
  },
  'zh-Hans': {
    apps: '/zh-hans/apps/',
    notes: '/novel/',
    snapcopy: snapCopyProduct.zhHansProductPath,
    snapcopyTest: '/zh-hans/apps/caption-ai/download/',
    mindBudget: mindBudgetProduct.zhHansProductPath,
    mindBudgetDownload: mindBudgetProduct.zhHansDownloadPagePath,
    novelForge: novelForgeAiProduct.zhHansProductPath,
    novelForgeDownload: novelForgeDownload.downloadPath,
    privatePinyin: privatePinyinProduct.zhHansProductPath,
    privatePinyinDownload: versionedPrivatePinyinDownload(privatePinyinProduct.zhHansDownloadPagePath),
    simplecut: simpleCutProProduct.zhHansProductPath,
    simplecutDownload: simpleCutProProduct.zhHansDownloadPagePath,
    nodePilot: anyTlsDesktopManagerProduct.zhHansProductPath,
    nodePilotDownload: nodePilotMacDownload?.downloadPath ?? anyTlsDesktopManagerProduct.zhHansProductPath,
    signal: '/zh-hans/signal/'
  },
  en: {
    apps: '/en/apps/',
    notes: '/en/novel/',
    snapcopy: snapCopyProduct.productPath,
    snapcopyTest: '/en/apps/caption-ai/download/',
    mindBudget: mindBudgetProduct.productPath,
    mindBudgetDownload: mindBudgetProduct.downloadPagePath,
    novelForge: novelForgeAiProduct.productPath,
    novelForgeDownload: novelForgeDownload.downloadPath,
    privatePinyin: privatePinyinProduct.productPath,
    privatePinyinDownload: versionedPrivatePinyinDownload(privatePinyinProduct.downloadPagePath),
    simplecut: simpleCutProProduct.productPath,
    simplecutDownload: simpleCutProProduct.downloadPagePath,
    nodePilot: anyTlsDesktopManagerProduct.productPath,
    nodePilotDownload: nodePilotMacDownload?.downloadPath ?? anyTlsDesktopManagerProduct.productPath,
    signal: '/en/signal/'
  },
  ja: {
    apps: '/ja/apps/',
    notes: '/novel/',
    snapcopy: snapCopyProduct.jaProductPath,
    snapcopyTest: '/ja/apps/caption-ai/download/',
    mindBudget: mindBudgetProduct.jaProductPath,
    mindBudgetDownload: mindBudgetProduct.jaDownloadPagePath,
    novelForge: novelForgeAiProduct.jaProductPath,
    novelForgeDownload: novelForgeDownload.downloadPath,
    privatePinyin: privatePinyinProduct.jaProductPath,
    privatePinyinDownload: versionedPrivatePinyinDownload(privatePinyinProduct.jaDownloadPagePath),
    simplecut: simpleCutProProduct.jaProductPath,
    simplecutDownload: simpleCutProProduct.jaDownloadPagePath,
    nodePilot: anyTlsDesktopManagerProduct.jaProductPath,
    nodePilotDownload: nodePilotMacDownload?.downloadPath ?? anyTlsDesktopManagerProduct.jaProductPath,
    signal: '/ja/signal/'
  }
}[lang];

const homeSerial = {
  coverAlt: '《离线未来》封面，1999 年旧房间、CRT 电脑和离线 AI 重启。',
  coverUrl: optimizedHomeImages.cover.src,
  description:
    lang === 'en'
      ? 'A 1999 room, a CRT computer, a local AI that should not wake up yet, and a second chance that starts with the sound of an old fan.'
      : lang === 'ja'
        ? '1999年の部屋、CRTモニター、まだ目覚めるはずのないオフラインAI。古い扇風機の音から、もう一度やり直す物語が始まります。'
        : '故事從 1999 年的一個夜晚開始：風扇、舊電腦、未連網的房間，和一個本不該在那個年代醒來的 AI。',
  firstChapterHref: '/novel/cmqjfju1300008z3wyh66ynvw/chapter/chap-offline-future-001/',
  href: '/novel/cmqjfju1300008z3wyh66ynvw/',
  latest: lang === 'en' ? 'Chapter 1: 1999年的风扇声' : lang === 'ja' ? '第1章：1999年的风扇声' : '第 1 章：1999年的风扇声',
  status: lang === 'zh-Hans' ? '连载中' : lang === 'en' ? 'Serializing' : '連載中',
  subtitle: '1999 · Offline AI · Rebirth',
  title: '离线未来'
};
const labelSeparator = lang === 'en' ? ': ' : '：';
const organizationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteConfig.baseUrl}/#organization`,
  name: siteConfig.name,
  legalName: siteConfig.legalName,
  url: siteConfig.baseUrl,
  logo: `${siteConfig.baseUrl}/apple-touch-icon.png`,
  email: siteConfig.supportEmail,
  sameAs: [xUrl]
};
const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteConfig.baseUrl}/#website`,
  url: siteConfig.baseUrl,
  name: siteConfig.name,
  description: copy.description,
  inLanguage: ['zh-Hant', 'zh-Hans', 'en', 'ja'],
  publisher: { '@id': `${siteConfig.baseUrl}/#organization` }
};

---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={canonicalPath}
  bodyClass="station-home station-home-v2"
  structuredData={[organizationStructuredData, websiteStructuredData]}
  alternates={[
    { hrefLang: 'zh-Hant', href: '/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/' },
    { hrefLang: 'en', href: '/en/' },
    { hrefLang: 'ja', href: '/ja/' },
    { hrefLang: 'x-default', href: '/' }
  ]}
>
  <section class="paper-hero">
    <div class="paper-hero__copy">
      <div class="station-logo-lockup">
        <img
          src={optimizedHomeImages.logo.src}
          srcset={optimizedHomeImages.logo.srcset}
          sizes="88px"
          alt={copy.logoAlt}
          width="320"
          height="311"
          decoding="async"
          fetchpriority="high"
        />
        <div class="station-logo-lockup__text">
          <p class="paper-kicker">Station Cat</p>
          <p class="station-logo-lockup__caption">{copy.logoCaption}</p>
        </div>
      </div>
      <h1>{copy.heroTitle}</h1>
      <p class="paper-lede">{copy.heroText}</p>
      <div class="paper-actions" aria-label="Primary actions">
        <a class="ticket-button ticket-button--primary" href={paths.apps}>{copy.primaryCta}</a>
        <a class="ticket-button ticket-button--secondary" href="#recent-notes">{copy.secondaryCta}</a>
      </div>
    </div>

    <aside class="station-board-v2" aria-label={copy.boardLabel}>
      <div class="station-board-v2__rail">
        <span>SC</span>
        <span>{copy.boardLabel}</span>
      </div>
      <div class="station-board-v2__pinboard">
        {copy.boardItems.map((item) => (
          item.type === 'signal' ? (
            <a class={`station-scrap station-scrap--${item.type}`} href={paths.signal}>
              <span class="paper-stamp">{item.stamp}</span>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </a>
          ) : (
            <article class={`station-scrap station-scrap--${item.type}`}>
              {item.type === 'polaroid' && (
                <img
                  class="station-scrap__photo"
                  src={optimizedHomeImages.logo.src}
                  srcset={optimizedHomeImages.logo.srcset}
                  sizes="(max-width: 760px) calc(100vw - 72px), 220px"
                  alt={copy.logoAlt}
                  width="320"
                  height="311"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="paper-stamp">{item.stamp}</span>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </article>
          )
        ))}
      </div>
    </aside>
  </section>

  <section id="about" class="paper-section about-ticket">
    <p class="paper-kicker">{copy.aboutKicker}</p>
    <h2>{copy.aboutTitle}</h2>
    <p>{copy.aboutText}</p>
  </section>

  <section class="paper-section">
    <div class="paper-section__heading">
      <p class="paper-kicker">{copy.todayKicker}</p>
      <h2>{copy.todayTitle}</h2>
      {copy.todayIntro && <p>{copy.todayIntro}</p>}
    </div>
    <div class="station-day-grid">
      {copy.stationCards.map((card, index) => (
        <article class={`station-day-card station-day-card--${index + 1}`}>
          <span class="line-icon" set:html={icons[card.icon as IconName]} />
          <h3>{card.title}</h3>
          <p>{card.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="apps" class="paper-section">
    <div class="paper-section__heading">
      <p class="paper-kicker">{copy.toolsKicker}</p>
      <h2>{copy.toolsTitle}</h2>
      {copy.toolsIntro && <p>{copy.toolsIntro}</p>}
    </div>
    <div class="bench-grid">
      <article class="bench-card">
        <div class="bench-card__icon bench-card__icon--snapcopy">
          <img src={optimizedAppImage('snapcopy').src} srcset={optimizedAppImage('snapcopy').srcset} sizes="(max-width: 760px) 260px, 300px" alt="SnapCopy app icon" width="512" height="512" loading="lazy" decoding="async" />
        </div>
        <div class="bench-card__copy">
          <span class="paper-stamp">{copy.snapcopyStatus}</span>
          <h3>SnapCopy</h3>
          <p>{copy.snapcopyDesc}</p>
          <div class="paper-actions">
            <a class="ticket-button ticket-button--primary" href={paths.snapcopy}>{copy.viewApp}</a>
            <a class="ticket-button ticket-button--secondary" href={paths.snapcopyTest}>{copy.joinTest}</a>
          </div>
        </div>
      </article>

      <article class="bench-card">
        <div class="bench-card__icon bench-card__icon--mindbudget">
          <img src={optimizedAppImage('mindbudget').src} srcset={optimizedAppImage('mindbudget').srcset} sizes="(max-width: 760px) 260px, 300px" alt="MindBudget app icon" width="512" height="512" loading="lazy" decoding="async" />
        </div>
        <div class="bench-card__copy">
          <span class="paper-stamp">{copy.mindBudgetStatus}</span>
          <h3>{lang === 'zh-Hans' || lang === 'zh-Hant' ? '花有數' : 'MindBudget'}</h3>
          <p>{copy.mindBudgetDesc}</p>
          <div class="paper-actions">
            <a class="ticket-button ticket-button--primary" href={paths.mindBudget}>{copy.viewApp}</a>
            <a class="ticket-button ticket-button--secondary" href={paths.mindBudgetDownload}>{copy.mindBudgetDownload}</a>
          </div>
        </div>
      </article>

      <article class="bench-card">
        <div class="bench-card__icon bench-card__icon--novelforge">
          <img src={optimizedAppImage('novelforge').src} srcset={optimizedAppImage('novelforge').srcset} sizes="(max-width: 760px) 260px, 300px" alt="NovelForge AI app icon" width="512" height="512" loading="lazy" decoding="async" />
        </div>
        <div class="bench-card__copy">
          <span class="paper-stamp">{copy.novelForgeStatus}</span>
          <h3>NovelForge AI</h3>
          <p>{copy.novelForgeDesc}</p>
          <div class="paper-actions">
            <a class="ticket-button ticket-button--primary" href={paths.novelForge}>{copy.viewApp}</a>
            <a class="ticket-button ticket-button--secondary" href={paths.novelForgeDownload}>{copy.novelForgeDownload}</a>
          </div>
        </div>
      </article>

      <article class="bench-card">
        <div class="bench-card__icon bench-card__icon--privatepinyin">
          <img src={optimizedAppImage('privatepinyin').src} srcset={optimizedAppImage('privatepinyin').srcset} sizes="(max-width: 760px) 260px, 300px" alt="猫栈拼音 app icon" width="512" height="512" loading="lazy" decoding="async" />
        </div>
        <div class="bench-card__copy">
          <span class="paper-stamp">{copy.privatePinyinStatus}</span>
          <h3>猫栈拼音</h3>
          <p>{copy.privatePinyinDesc}</p>
          <div class="paper-actions">
            <a class="ticket-button ticket-button--primary" href={paths.privatePinyin}>{copy.viewApp}</a>
            <a class="ticket-button ticket-button--secondary" href={paths.privatePinyinDownload}>{copy.privatePinyinDownload}</a>
          </div>
        </div>
      </article>

      <article class="bench-card">
        <div class="bench-card__icon bench-card__icon--simplecut">
          <img src={optimizedAppImage('simplecut').src} srcset={optimizedAppImage('simplecut').srcset} sizes="(max-width: 760px) 260px, 300px" alt="SimpleCut Pro app icon" width="512" height="512" loading="lazy" decoding="async" />
        </div>
        <div class="bench-card__copy">
          <span class="paper-stamp">{copy.simplecutStatus}</span>
          <h3>SimpleCut Pro</h3>
          <p>{copy.simplecutDesc}</p>
          <div class="paper-actions">
            <a class="ticket-button ticket-button--primary" href={paths.simplecut}>{copy.simplecutView}</a>
            <a class="ticket-button ticket-button--secondary" href={paths.simplecutDownload}>{copy.simplecutDownload}</a>
          </div>
        </div>
      </article>

      <article class="bench-card">
        <div class="bench-card__icon bench-card__icon--nodepilot">
          <img src={optimizedAppImage('nodepilot').src} srcset={optimizedAppImage('nodepilot').srcset} sizes="(max-width: 760px) 260px, 300px" alt="NodePilot app icon" width="512" height="512" loading="lazy" decoding="async" />
        </div>
        <div class="bench-card__copy">
          <span class="paper-stamp">{copy.nodePilotStatus}</span>
          <h3>NodePilot</h3>
          <p>{copy.nodePilotDesc}</p>
          <div class="paper-actions">
            <a class="ticket-button ticket-button--primary" href={paths.nodePilot}>{copy.viewApp}</a>
            <a class="ticket-button ticket-button--secondary" href={paths.nodePilotDownload}>{copy.nodePilotDownload}</a>
          </div>
        </div>
      </article>

    </div>
  </section>

  <section id="recent-notes" class="paper-section">
    <div class="paper-section__heading">
      <p class="paper-kicker">{copy.notesKicker}</p>
      <h2>{copy.notesTitle}</h2>
      {copy.notesIntro && <p>{copy.notesIntro}</p>}
    </div>
    <article class="home-serial-card">
      <a class="home-serial-card__cover" href={homeSerial.href} aria-label={homeSerial.title}>
        <img
          src={homeSerial.coverUrl}
          srcset={optimizedHomeImages.cover.srcset}
          sizes="(max-width: 760px) 260px, 280px"
          alt={homeSerial.coverAlt}
          width="720"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class="home-serial-card__copy">
        <div class="wall-note__meta">
          <span class="paper-stamp">{homeSerial.status}</span>
          <span>{homeSerial.subtitle}</span>
        </div>
        <h3>{homeSerial.title}</h3>
        <p>{homeSerial.description}</p>
        <div class="home-serial-card__facts">
          <span>{copy.latestChapterLabel}{labelSeparator}{homeSerial.latest}</span>
          <span>{copy.freeChaptersLabel}</span>
        </div>
        <div class="paper-actions">
          <a class="ticket-button ticket-button--primary" href={homeSerial.firstChapterHref}>{copy.readFirstChapter}</a>
          <a class="ticket-button ticket-button--secondary" href={homeSerial.href}>{copy.openSeries}</a>
        </div>
      </div>
    </article>
  </section>

  <section class="paper-closing">
    <div>
      <p class="paper-kicker">Station Cat</p>
      <h2>{copy.closingTitle}</h2>
      <p>{copy.closingText}</p>
    </div>
    <div class="paper-actions">
      <a class="ticket-button ticket-button--primary" href={xUrl} target="_blank" rel="noopener noreferrer">{copy.follow}</a>
      <a class="ticket-button ticket-button--secondary" href={paths.snapcopy}>{copy.viewSnapCopy}</a>
      <a class="ticket-button ticket-button--secondary" href="/android/">{copy.android}</a>
    </div>
  </section>
</BaseLayout>
