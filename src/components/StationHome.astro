---
<BaseLayout title={copy.title} description={copy.description} lang={lang} canonicalPath={canonicalPath}
  bodyClass="station-home-night" homeChrome={true} structuredData={[organizationStructuredData, websiteStructuredData]}
  alternates={[{hrefLang:'zh-Hant',href:'/'},{hrefLang:'zh-Hans',href:'/zh-hans/'},{hrefLang:'en',href:'/en/'},{hrefLang:'ja',href:'/ja/'},{hrefLang:'x-default',href:'/'}]}>
  <section class="night-hero" aria-labelledby="home-title">
    <img class="night-hero__image" src="/images/home-night/hero.webp" srcset="/images/home-night/hero-1200.webp 1200w, /images/home-night/hero.webp 2172w" sizes="100vw" alt="" width="2172" height="724" fetchpriority="high" />
    <div class="night-hero__copy night-wrap">
      <p class="night-eyebrow">CATS, IDEAS, A KINDER TOMORROW</p>
      <h1 id="home-title">{copy.heroTitle}</h1>
      <p class="night-hero__intro">{night.intro}<br />{night.intro2}</p>
      <a class="night-button" href="#station-discover"><Play size={19} fill="currentColor" />{night.explore}</a>
    </div>
  </section>
  <div class="night-content" id="station-discover">
    <div class="night-wrap">
      {musicEntryEnabled && <section class="night-section" id="music" aria-labelledby="home-music-title">
        <div class="night-section__heading"><div><h2 id="home-music-title">{musicHome.title}</h2><p>{musicHome.description}</p></div><a class="night-more" href={musicHref}>{night.more}<ArrowRight size={18} /></a></div>
        <article class="night-music-card">
          <a class="night-music-cover" href={`${musicHref}?collection=wydgb`} aria-label="晚一点告白"><img src="/images/home-night/late-confession.webp" alt={lang === 'en' ? '晚一点告白 — album cover' : lang === 'ja' ? '晚一点告白 アルバムジャケット' : '晚一点告白'} width="640" height="640" loading="lazy" /></a>
          <div class="night-music-copy"><h3>晚一点告白</h3><p class="night-creator">Station Cat</p><p class="night-card-intro">{night.musicLine}</p><a class="night-button" href={`${musicHref}?collection=wydgb`}><Play size={18} fill="currentColor" />{night.listen}</a></div>
          <p class="night-handwriting" aria-hidden="true">Good Music<br />A Kinder You</p>
        </article>
      </section>}
      <section id="tools" class="night-section night-tools" aria-labelledby="home-tools-title">
        <div class="night-section__heading"><div><h2 id="home-tools-title">{night.tools}</h2><p>{night.toolsSub}</p></div><a class="night-more" href={paths.apps}>{night.more}<ArrowRight size={18} /></a></div>
        <div class="night-tool-grid">{featuredTools.map((tool, i) => <a class="night-tool-card" href={tool.href}><img class:list={{'bench-card__icon--cat-life':tool.pixel}} src={tool.image} width="80" height="80" alt="" loading="lazy" /><div><h3>{tool.title}</h3><p>{night.toolLines[i]}</p></div><span class="night-tool-arrow"><ArrowRight size={17} /></span></a>)}</div>
        <details class="night-more-tools"><summary>{night.otherTools}</summary><div class="night-extra-grid">
          <a href={paths.privatePinyin}><h3>猫栈拼音</h3><p>{copy.privatePinyinDesc}</p></a>
          <a href={paths.simplecut}><h3>SimpleCut Pro</h3><p>{copy.simplecutDesc}</p></a>
          <a href={paths.nodePilot}><h3>NodePilot</h3><p>{copy.nodePilotDesc}</p></a>
        </div></details>
      </section>
      <section id="recent-notes" class="night-section" aria-labelledby="home-novel-title">
        <div class="night-section__heading"><div><h2 id="home-novel-title">{night.novels}</h2><p>{night.novelsSub}</p></div><a class="night-more" href={paths.notes}>{night.more}<ArrowRight size={18} /></a></div>
        <article class="night-novel-card">
          <a class="night-novel-art" href={homeSerial.href} aria-label={homeSerial.title}><img src="/images/home-night/novel.webp" alt="" width="1983" height="793" loading="lazy" /></a>
          <div class="night-novel-copy"><div class="night-novel-title"><h3>《{homeSerial.title}》</h3><span>{homeSerial.status}</span></div><p>{night.novelLine}</p><a class="night-button" href={homeSerial.firstChapterHref}><BookOpen size={19} fill="currentColor" />{copy.readFirstChapter}</a></div>
          <p class="night-novel-note" aria-hidden="true">{night.note}</p>
        </article>
      </section>
    </div>
  </div>
</BaseLayout>
