  'zh-Hans': { intro: '关于猫、创作与更温柔的日常，', intro2: '在这里慢慢相遇。', explore: '探索这个小站', more: '探索更多', tools: '创作工具', toolsSub: '让灵感变得更简单。', novels: '连载小说', novelsSub: '用故事，去到更远的地方。', musicLine: '有些告白，晚了一个夏天；有些勇敢，练习了好多年。', listen: '立即聆听', toolLines: ['工作与生活，与猫一起慢慢过。', '一张照片，变成温柔的分享。', '记录收支，留意日常的余裕。', '让想象力，成为下一个故事。'], otherTools: '更多桌上的工具', novelLine: '1999 年的某个夜晚，一个不该醒来的 AI，悄悄改变了重来一次的人生。', note: '有些未来，从未真正离开。' },
  en: { intro: 'Cats, creative ideas and kinder everyday moments.', intro2: 'Find them here, at your own pace.', explore: 'Explore the station', more: 'Explore more', tools: 'Creative tools', toolsSub: 'A little help for your next idea.', novels: 'Serial fiction', novelsSub: 'Stories that take you somewhere new.', musicLine: 'Some confessions wait a summer. Some courage takes years.', listen: 'Listen now', toolLines: ['Make a little room for life with cats.', 'Turn a photo into a story worth sharing.', 'Mindful spending, a little more breathing room.', 'Let your imagination become your next story.'], otherTools: 'More on the workbench', novelLine: 'One night in 1999, an AI that should not be awake changes a life that has just begun again.', note: 'Some futures never really left.' },
  ja: { intro: '猫と創作、そしてやさしい日常。', intro2: 'ここで、ゆっくり出会いましょう。', explore: '小さな駅を探索', more: 'もっと見る', tools: '創作ツール', toolsSub: 'ひらめきを、もっと身近に。', novels: '連載小説', novelsSub: '物語と一緒に、遠くへ。', musicLine: 'ひと夏遅れた告白。何年もかけて育てた勇気。', listen: '今すぐ聴く', toolLines: ['仕事と暮らし、猫とのゆっくりした時間。', '一枚の写真を、やさしい言葉に。', '収支を記録し、日々の余裕を見つける。', '想像力を、次の物語に。'], otherTools: 'ほかの創作ツール', novelLine: '1999年のある夜、目覚めるはずのないAIが、やり直しの人生を静かに変えていく。', note: 'まだ、終わっていない未来がある。' }
