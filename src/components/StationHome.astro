  { title: catLifeCopy.title, href: paths.catLife, image: catLifeGameProduct.assets.icon, pixel: true },
  { title: 'SnapCopy', href: paths.snapcopy, image: optimizedAppImage('snapcopy').src },
  { title: lang.startsWith('zh') ? '花有數' : 'MindBudget', href: paths.mindBudget, image: optimizedAppImage('mindbudget').src },
