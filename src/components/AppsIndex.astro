import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, Mail, Rss } from '@lucide/astro';
import { siteConfig } from '../data/site';
import '../styles/apps-daylight.css';
import { captionAiProduct } from '../data/products/caption-ai';
import { anyTlsDesktopManagerProduct } from '../data/products/anytls-desktop-manager';
import { simpleCutProProduct } from '../data/products/simplecut-pro';
import { privatePinyinProduct } from '../data/products/privatepinyin';
import { novelForgeAiProduct } from '../data/products/novelforge-ai';
import { mindBudgetProduct } from '../data/products/mindbudget';
import { catLifeGameProduct } from '../data/products/cat-life-game';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const currentVersion = simpleCutProProduct.latestVersion.replace(/^v/, '');
const novelForgeVersion = novelForgeAiProduct.latestVersion;
const privatePinyinMacVersion =
  privatePinyinProduct.downloads.find((download) => download.id === 'macos-pkg')?.version ?? privatePinyinProduct.latestVersion;
const privatePinyinWindowsVersion =
  privatePinyinProduct.downloads.find((download) => download.id === 'windows-exe')?.version ?? privatePinyinProduct.latestVersion;
const privatePinyinIosVersion = privatePinyinProduct.iosAppStore.version;
const privatePinyinReleaseToken = `${privatePinyinMacVersion}-${privatePinyinWindowsVersion}`;
const versionedPrivatePinyinDownload = (path: string) => `${path}?release=${privatePinyinReleaseToken}`;

