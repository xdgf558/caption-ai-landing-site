    heading: '小而實用的創作工具。',
    intro: '這裡會放 Station Cat 正在開發、測試和發布的 App。現在有已上架的生活文案工具 SnapCopy、AI 互動故事 StoryCat、桌面影片剪輯工具 SimpleCut Pro、創作者資訊工具 StationCat Radar、Windows / Mac 配置管理小工具，也有整理 X 關注列表的 Chrome 擴充功能。',
    snapcopyKicker: 'Available on the App Store',
    snapcopyDescription: '把早餐、咖啡、散步、寵物、旅行和日常照片，變成更適合分享的文案。',
    snapcopyCta: '查看 SnapCopy',
    storycatKicker: 'AI playable novel',
    storycatDescription: '建立主角、選擇模板，進入一部會回應你的 AI 互動故事。',
    storycatCta: '查看 StoryCat',
    storycatTestCta: '參與測試',
    simplecutKicker: 'desktop video editor',
    simplecutDescription: '在本機時間線剪切影片、對齊音訊、預覽轉場，並匯出輕量成片。',
    simplecutCta: '查看 SimpleCut Pro',
    simplecutDownloadCta: `下載 ${currentVersion}`,
    radarKicker: 'Mac app download',
    radarDescription: '追蹤公開資訊、RSS、AI 研究和關鍵詞，整理更適合 X 創作的內容方向。',
    radarCta: '查看 Radar',
    anytlsKicker: 'Windows / Mac test build',
    anytlsDescription: '整理你擁有或被授權管理的 AnyTLS 配置、連線資訊和本機備註。',
    anytlsCta: '查看 NodePilot',
    followCleanerKicker: 'Chrome extension',
    followCleanerDescription: '低頻檢查 X 關注列表，本地保存結果，並支援 CSV / JSON 匯出。',
    followCleanerCta: '查看 X Follow Cleaner'
  },
  'zh-Hans': {
    title: 'Apps from Station Cat',
    description: 'Station Cat 正在开发和发布的小工具。',
    kicker: 'Station Cat Apps',
    heading: '小而实用的创作工具。',
    intro: '这里会放 Station Cat 正在开发、测试和发布的 App。现在有已上架的生活文案工具 SnapCopy、AI 互动故事 StoryCat、桌面视频剪辑工具 SimpleCut Pro、创作者资讯工具 StationCat Radar、Windows / Mac 配置管理小工具，也有整理 X 关注列表的 Chrome 扩展。',
    snapcopyKicker: 'Available on the App Store',
    snapcopyDescription: '把早餐、咖啡、散步、宠物、旅行和日常照片，变成更适合分享的文案。',
    snapcopyCta: '查看 SnapCopy',
    storycatKicker: 'AI playable novel',
    storycatDescription: '创建主角、选择模板，进入一部会回应你的 AI 互动故事。',
    storycatCta: '查看 StoryCat',
    storycatTestCta: '参与测试',
    simplecutKicker: 'desktop video editor',
    simplecutDescription: '在本机时间线剪切视频、对齐音频、预览转场，并导出轻量成片。',
    simplecutCta: '查看 SimpleCut Pro',
    simplecutDownloadCta: `下载 ${currentVersion}`,
    radarKicker: 'Mac app download',
    radarDescription: '追踪公开资讯、RSS、AI 研究和关键词，整理更适合 X 创作的内容方向。',
    radarCta: '查看 Radar',
    anytlsKicker: 'Windows / Mac test build',
    anytlsDescription: '整理你拥有或被授权管理的 AnyTLS 配置、连接信息和本机备注。',
    anytlsCta: '查看 NodePilot',
    followCleanerKicker: 'Chrome extension',
    followCleanerDescription: '低频检查 X 关注列表，本地保存结果，并支持 CSV / JSON 导出。',
    followCleanerCta: '查看 X Follow Cleaner'
  },
  en: {
    title: 'Apps from Station Cat',
    description: 'Small tools built and published by Station Cat.',
    kicker: 'Station Cat Apps',
    heading: 'Small tools for everyday creativity.',
    intro: 'This is where Station Cat collects apps in development, testing, and public release: SnapCopy for everyday captions, StoryCat for playable AI fiction, SimpleCut Pro for desktop video edits, StationCat Radar for creator research on Mac, a Windows / Mac configuration manager, and a Chrome extension for calmer X follow-list reviews.',
    snapcopyKicker: 'Available on the App Store',
    snapcopyDescription: 'Turn breakfast, coffee, walks, pets, travel, and daily photos into captions that are easier to share.',
    snapcopyCta: 'View SnapCopy',
    storycatKicker: 'AI playable novel',
    storycatDescription: 'Create a protagonist, choose a template, and enter an AI story that responds to your choices.',
    storycatCta: 'View StoryCat',
    storycatTestCta: 'Join Test',
    simplecutKicker: 'desktop video editor',
    simplecutDescription: 'Cut clips on a local timeline, align audio, preview transitions, and export lightweight edits.',
    simplecutCta: 'View SimpleCut Pro',
    simplecutDownloadCta: `Download ${currentVersion}`,
    radarKicker: 'Mac app download',
    radarDescription: 'Track public signals, RSS, AI research, and keywords to shape better X content ideas.',
    radarCta: 'View Radar',
    anytlsKicker: 'Windows / Mac test build',
    anytlsDescription: 'Organize AnyTLS configurations, connection details, and local notes for environments you are authorized to manage.',
    anytlsCta: 'View NodePilot',
    followCleanerKicker: 'Chrome extension',
    followCleanerDescription: 'Review your X following list at a low frequency, keep results locally, and export CSV / JSON files.',
    followCleanerCta: 'View X Follow Cleaner'
  },
  ja: {
    title: 'Apps from Station Cat',
    description: 'Station Cat が作っている小さなツール。',
    kicker: 'Station Cat Apps',
    heading: '日常の創作を少し軽くするツール。',
    intro: 'Station Cat が開発・テスト・公開しているアプリをまとめています。App Store で公開中の日常写真向け SnapCopy、AI で遊べる物語 StoryCat、デスクトップ動画編集の SimpleCut Pro、Mac 向けの StationCat Radar、Windows / Mac 向け設定管理ツール、X のフォロー一覧を見直す Chrome 拡張があります。',
    snapcopyKicker: 'Available on the App Store',
    snapcopyDescription: '朝食、コーヒー、散歩、ペット、旅行、日常写真を、共有しやすいキャプションにします。',
    snapcopyCta: 'SnapCopy を見る',
    storycatKicker: 'AI playable novel',
    storycatDescription: '主人公を作り、テンプレートを選び、選択に反応する AI 物語に入ります。',
    storycatCta: 'StoryCat を見る',
    storycatTestCta: 'テストに参加',
    simplecutKicker: 'desktop video editor',
    simplecutDescription: 'ローカルのタイムラインでカット、音声調整、転換確認、軽い動画書き出しを行えます。',
    simplecutCta: 'SimpleCut Pro を見る',
    simplecutDownloadCta: `${currentVersion} をダウンロード`,
    radarKicker: 'Mac app download',
    radarDescription: '公開情報、RSS、AI リサーチ、キーワードを追い、X 向けの投稿アイデアに整理します。',
    radarCta: 'Radar を見る',
    anytlsKicker: 'Windows / Mac test build',
    anytlsDescription: '管理権限のある AnyTLS 設定、接続情報、ローカルメモを整理します。',
    anytlsCta: 'NodePilot を見る',
    followCleanerKicker: 'Chrome extension',
    followCleanerDescription: 'X のフォロー一覧を低頻度で確認し、結果をローカル保存して CSV / JSON で書き出します。',
    followCleanerCta: 'X Follow Cleaner を見る'
  }
}[lang];

const paths = {
  'zh-Hant': {
    canonical: '/zh-hant/apps/',
    snapcopy: captionAiProduct.zhHantProductPath,
    storycat: storyCatProduct.zhHantProductPath,
    simplecut: simpleCutProProduct.zhHantProductPath,
    simplecutDownload: simpleCutProProduct.zhHantDownloadPagePath,
    radar: stationCatRadarProduct.zhHantProductPath,
    anytls: anyTlsDesktopManagerProduct.zhHantProductPath,
    followCleaner: xFollowCleanerProduct.zhHantProductPath
  },
  'zh-Hans': {
    canonical: '/zh-hans/apps/',
    snapcopy: captionAiProduct.zhHansProductPath,
    storycat: storyCatProduct.zhHansProductPath,
    simplecut: simpleCutProProduct.zhHansProductPath,
    simplecutDownload: simpleCutProProduct.zhHansDownloadPagePath,
    radar: stationCatRadarProduct.zhHansProductPath,
    anytls: anyTlsDesktopManagerProduct.zhHansProductPath,
    followCleaner: xFollowCleanerProduct.zhHansProductPath
  },
  en: {
    canonical: '/apps/',
    snapcopy: captionAiProduct.productPath,
    storycat: storyCatProduct.productPath,
    simplecut: simpleCutProProduct.productPath,
    simplecutDownload: simpleCutProProduct.downloadPagePath,
    radar: stationCatRadarProduct.productPath,
    anytls: anyTlsDesktopManagerProduct.productPath,
    followCleaner: xFollowCleanerProduct.productPath
  },
  ja: {
    canonical: '/ja/apps/',
    snapcopy: captionAiProduct.jaProductPath,
    storycat: storyCatProduct.jaProductPath,
    simplecut: simpleCutProProduct.jaProductPath,
    simplecutDownload: simpleCutProProduct.jaDownloadPagePath,
    radar: stationCatRadarProduct.jaProductPath,
    anytls: anyTlsDesktopManagerProduct.jaProductPath,
    followCleaner: xFollowCleanerProduct.jaProductPath
  }
}[lang];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={paths.canonical}
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/' },
    { hrefLang: 'en', href: '/apps/' },
    { hrefLang: 'ja', href: '/ja/apps/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/' }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">{copy.kicker}</p>
    <h1>{copy.heading}</h1>
    <p>{copy.intro}</p>
  </section>
  <section class="page-section product-list">
    <ProductCard
      title="SnapCopy"
      description={copy.snapcopyDescription}
      href={paths.snapcopy}
      image={captionAiProduct.assets.icon}
      imageAlt="SnapCopy app icon"
      imageVariant="icon"
      cta={copy.snapcopyCta}
      kicker={copy.snapcopyKicker}
    />
    <ProductCard
      title="StoryCat"
      description={copy.storycatDescription}
      href={paths.storycat}
      image={storyCatProduct.assets.preview}
      imageAlt="StoryCat app icon"
      imageVariant="icon"
      cta={copy.storycatCta}
      secondaryHref={`${paths.storycat}${storyCatProduct.testFlightAnchor}`}
      secondaryCta={copy.storycatTestCta}
      kicker={copy.storycatKicker}
    />
    <ProductCard
      title="SimpleCut Pro"
      description={copy.simplecutDescription}
      href={paths.simplecut}
      image={simpleCutProProduct.assets.icon}
      imageAlt="SimpleCut Pro app icon"
      imageVariant="icon"
      cta={copy.simplecutCta}
      secondaryHref={paths.simplecutDownload}
      secondaryCta={copy.simplecutDownloadCta}
      kicker={copy.simplecutKicker}
    />
    <ProductCard
      title="StationCat Radar"
      description={copy.radarDescription}
      href={paths.radar}
      image={stationCatRadarProduct.assets.screenshot}
      cta={copy.radarCta}
      kicker={copy.radarKicker}
    />
    <ProductCard
      title="NodePilot"
      description={copy.anytlsDescription}
      href={paths.anytls}
      image={anyTlsDesktopManagerProduct.assets.icon}
      imageAlt="NodePilot app icon"
      imageVariant="icon"
      cta={copy.anytlsCta}
      kicker={copy.anytlsKicker}
    />
    <ProductCard
      title="X Follow Cleaner"
      description={copy.followCleanerDescription}
      href={paths.followCleaner}
      image={xFollowCleanerProduct.assets.screenshot}
      cta={copy.followCleanerCta}
      kicker={copy.followCleanerKicker}
    />
  </section>
</BaseLayout>
