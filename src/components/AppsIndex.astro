---
<BaseLayout title={copy.title} description={copy.description} lang={lang} canonicalPath={paths.canonical} bodyClass="station-apps-daylight" appsChrome={true} alternates={[
 {hrefLang:'zh-Hant',href:'/zh-hant/apps/'},{hrefLang:'zh-Hans',href:'/zh-hans/apps/'},{hrefLang:'en',href:'/en/apps/'},{hrefLang:'ja',href:'/ja/apps/'},{hrefLang:'x-default',href:'/zh-hant/apps/'}
]}>
 <section class="apps-hero" aria-labelledby="apps-title">
  <img class="apps-hero-art" src="/images/apps-daylight/hero.webp" width="1536" height="600" alt="" fetchpriority="high" />
  <div class="apps-wrap apps-hero-copy"><p class="apps-eyebrow">SMALL APPS. A BRIGHTER DAY.</p><h1 id="apps-title">{ui.heading[0]}<br/>{ui.heading[1]}</h1><p class="apps-intro">{ui.intro[0]}<br/>{ui.intro[1]}</p><a href="#all-apps" class="apps-button"><ArrowRight size={19}/>{ui.explore}</a></div>
 </section>
 <div class="apps-wrap apps-content" id="all-apps">
  <section aria-labelledby="apps-featured"><div class="apps-section-heading"><div><h2 id="apps-featured">{ui.featured}</h2><p>{ui.featuredIntro}</p></div><a href="#more-apps">{ui.all}<ArrowRight size={17}/></a></div>
   <div class="apps-featured-grid">{featured.map(app => <article class="apps-featured-card">
    <a class="apps-card-main" href={app.href}><div class="apps-card-heading"><img src={app.icon} width="78" height="78" alt=""/><div><h3>{app.title}</h3><p>{app.description}</p></div></div><div class="apps-card-art"><img src={`/images/apps-daylight/${app.id}.webp`} width="650" height="520" alt={`${app.title} · ${ui.art}`} loading="lazy"/></div><div class="apps-card-bottom"><div class="apps-tags">{app.tags.map(tag=><span>{tag}</span>)}</div><span class="apps-arrow"><ArrowRight size={19}/></span></div></a>
    <div class="apps-release"><span>{app.status}</span><a href={app.secondaryHref}>{app.secondaryCta}<ArrowRight size={13}/></a></div>
   </article>)}</div>
  </section>
  <section id="more-apps" aria-labelledby="apps-more"><div class="apps-section-heading"><div><h2 id="apps-more">{ui.more}</h2><p>{ui.moreIntro}</p></div></div>
   <div class="apps-more-grid">{moreApps.map(app => <article class="apps-small-card"><a class="apps-small-main" href={app.href}><img src={app.icon} width="72" height="72" alt="" loading="lazy"/><div><h3>{app.title}</h3><p>{app.description}</p><div class="apps-tags">{app.tags.map(tag=><span>{tag}</span>)}</div></div><span class="apps-arrow"><ArrowRight size={16}/></span></a><div class="apps-release"><span>{app.status}</span><a href={app.secondaryHref}>{app.secondaryCta}<ArrowRight size={13}/></a></div></article>)}</div>
  </section>
  <section class="apps-contact" aria-labelledby="apps-contact-title"><img src="/images/apps-daylight/banner.webp" width="1536" height="370" alt="" loading="lazy"/><div><p class="apps-eyebrow">SMALL TOOLS. BIGGER POSSIBILITIES.</p><h2 id="apps-contact-title">{ui.contactHeading}</h2><p>{ui.contactIntro}</p><div class="apps-contact-actions"><a href={`mailto:${siteConfig.supportEmail}`} class="apps-button"><Mail size={17}/>{ui.contact}</a><a href={siteConfig.xUrl} target="_blank" rel="noopener noreferrer" class="apps-button apps-button-light"><Rss size={17}/>{ui.follow}</a></div></div></section>
 </div>
</BaseLayout>
