---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from './ProductCard.astro';
import { captionAiProduct } from '../data/products/caption-ai';
import { anyTlsDesktopManagerProduct } from '../data/products/anytls-desktop-manager';
import { simpleCutProProduct } from '../data/products/simplecut-pro';
import { privatePinyinProduct } from '../data/products/privatepinyin';
import { novelForgeAiProduct } from '../data/products/novelforge-ai';
import { mindBudgetProduct } from '../data/products/mindbudget';
import { catLifeGameProduct } from '../data/products/cat-life-game';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const currentVersion = simpleCutProProduct.latestVersion.replace(/^v/, '');
const novelForgeVersion = novelForgeAiProduct.latestVersion;
const privatePinyinMacVersion =
  privatePinyinProduct.downloads.find((download) => download.id === 'macos-pkg')?.version ?? privatePinyinProduct.latestVersion;
const privatePinyinWindowsVersion =
  privatePinyinProduct.downloads.find((download) => download.id === 'windows-exe')?.version ?? privatePinyinProduct.latestVersion;
const privatePinyinIosVersion = privatePinyinProduct.iosAppStore.version;
const privatePinyinReleaseToken = `${privatePinyinMacVersion}-${privatePinyinWindowsVersion}`;
const versionedPrivatePinyinDownload = (path: string) => `${path}?release=${privatePinyinReleaseToken}`;

const copy = {
  'zh-Hant': {
    title: 'Station Cat Apps｜獨立創作工具',
    description: 'Station Cat 正在開發和發布的小工具。',
    kicker: 'Station Cat Apps',
    heading: '小而實用的創作工具。',
    intro: '這裡會放 Station Cat 正在開發、測試和發布的 App 與網頁作品。除了桌面和行動工具，現在也可以直接遊玩《打工養貓日記》。',
    catLifeKicker: 'Free browser game',
    catLifeDescription: '在瀏覽器裡安排工作與休息、照顧貓咪、佈置房間，再慢慢探索猫咪鎮。',
    catLifeCta: '查看遊戲',
    catLifePlayCta: '立即遊玩',
    snapcopyKicker: 'Available on the App Store',
    snapcopyDescription: '把早餐、咖啡、散步、寵物、旅行和日常照片，變成更適合分享的文案。',
    snapcopyCta: '查看 SnapCopy',
    mindBudgetKicker: 'iPhone TestFlight public beta',
    mindBudgetDescription: '不連銀行、不要求帳號，在 iPhone 本機記錄收支、控制週期預算，並用每日可花金額掌握節奏。',
    mindBudgetCta: '查看花有數',
    mindBudgetDownloadCta: '加入 TestFlight',
    novelForgeKicker: 'macOS public test',
    novelForgeDescription: '本機優先、作者主導的 AI 小說創作工作台，管理長篇、短篇、結構化故事記憶與待審 AI 草稿。',
    novelForgeCta: '查看 NovelForge AI',
    novelForgeDownloadCta: `下載 ${novelForgeVersion}`,
    privatePinyinKicker: 'macOS / Windows / iOS input method',
    privatePinyinDescription: `本機中文輸入法，提供 macOS、Windows TSF 測試包；iOS ${privatePinyinIosVersion} 正式版已上架 App Store。`,
    privatePinyinCta: '查看猫栈拼音',
    privatePinyinDownloadCta: '下載與 App Store',
    simplecutKicker: 'desktop video editor',
    simplecutDescription: '在本機時間線剪切影片、對齊音訊、預覽轉場，並匯出輕量成片。',
    simplecutCta: '查看 SimpleCut Pro',
    simplecutDownloadCta: `下載 ${currentVersion}`,
    anytlsKicker: 'Windows / Mac test build',
    anytlsDescription: '整理你擁有或被授權管理的 AnyTLS 配置、連線資訊和本機備註。',
    anytlsCta: '查看 NodePilot'
  },
  'zh-Hans': {
    title: 'Station Cat Apps｜独立创作工具',
    description: 'Station Cat 正在开发和发布的小工具。',
    kicker: 'Station Cat Apps',
    heading: '小而实用的创作工具。',
    intro: '这里会放 Station Cat 正在开发、测试和发布的 App 与网页作品。除了桌面和移动工具，现在也可以直接游玩《打工养猫日记》。',
    catLifeKicker: 'Free browser game',
    catLifeDescription: '在浏览器里安排工作与休息、照顾猫咪、布置房间，再慢慢探索猫咪镇。',
    catLifeCta: '查看游戏',
    catLifePlayCta: '立即游玩',
    snapcopyKicker: 'Available on the App Store',
    snapcopyDescription: '把早餐、咖啡、散步、宠物、旅行和日常照片，变成更适合分享的文案。',
    snapcopyCta: '查看 SnapCopy',
    mindBudgetKicker: 'iPhone TestFlight 公开测试',
    mindBudgetDescription: '不连接银行、不要求账号，在 iPhone 本地记录收支、控制周期预算，并用每日可花金额掌握节奏。',
    mindBudgetCta: '查看花有数',
    mindBudgetDownloadCta: '加入 TestFlight',
    novelForgeKicker: 'macOS public test',
    novelForgeDescription: '本地优先、作者主导的 AI 小说创作工作台，管理长篇、短篇、结构化故事记忆与待审 AI 草稿。',
    novelForgeCta: '查看 NovelForge AI',
    novelForgeDownloadCta: `下载 ${novelForgeVersion}`,
    privatePinyinKicker: 'macOS / Windows / iOS input method',
    privatePinyinDescription: `本机中文输入法，提供 macOS、Windows TSF 测试包；iOS ${privatePinyinIosVersion} 正式版已上架 App Store。`,
    privatePinyinCta: '查看猫栈拼音',
    privatePinyinDownloadCta: '下载与 App Store',
    simplecutKicker: 'desktop video editor',
    simplecutDescription: '在本机时间线剪切视频、对齐音频、预览转场，并导出轻量成片。',
    simplecutCta: '查看 SimpleCut Pro',
    simplecutDownloadCta: `下载 ${currentVersion}`,
    anytlsKicker: 'Windows / Mac test build',
    anytlsDescription: '整理你拥有或被授权管理的 AnyTLS 配置、连接信息和本机备注。',
    anytlsCta: '查看 NodePilot'
  },
  en: {
    title: 'Station Cat Apps | Independent Creative Tools',
    description: 'Small tools built and published by Station Cat.',
    kicker: 'Station Cat Apps',
    heading: 'Small tools for everyday creativity.',
    intro: 'Station Cat collects apps and small web projects in development, testing, and public release. Alongside the desktop and mobile tools, Cat Life Game is now ready to play in the browser.',
    catLifeKicker: 'Free browser game',
    catLifeDescription: 'Balance work and rest, care for cats, furnish your room, and gradually explore Cat Town.',
    catLifeCta: 'View the game',
    catLifePlayCta: 'Play now',
    snapcopyKicker: 'Available on the App Store',
    snapcopyDescription: 'Turn breakfast, coffee, walks, pets, travel, and daily photos into captions that are easier to share.',
    snapcopyCta: 'View SnapCopy',
    mindBudgetKicker: 'iPhone TestFlight public beta',
    mindBudgetDescription: 'Track income and expenses, set cycle budgets, and follow a daily spending pace on your iPhone without an account or bank connection.',
    mindBudgetCta: 'View MindBudget',
    mindBudgetDownloadCta: 'Join TestFlight',
    novelForgeKicker: 'macOS public test',
    novelForgeDescription: 'A local-first, author-controlled AI fiction workbench for long-form projects, short stories, structured memory, and reviewable drafts.',
    novelForgeCta: 'View NovelForge AI',
    novelForgeDownloadCta: `Download ${novelForgeVersion}`,
    privatePinyinKicker: 'macOS / Windows / iOS input method',
    privatePinyinDescription: `A local Chinese input method with macOS and Windows test builds, plus the official iOS ${privatePinyinIosVersion} release on the App Store.`,
    privatePinyinCta: 'View Maozhan Pinyin',
    privatePinyinDownloadCta: 'Downloads & App Store',
    simplecutKicker: 'desktop video editor',
    simplecutDescription: 'Cut clips on a local timeline, align audio, preview transitions, and export lightweight edits.',
    simplecutCta: 'View SimpleCut Pro',
    simplecutDownloadCta: `Download ${currentVersion}`,
    anytlsKicker: 'Windows / Mac test build',
    anytlsDescription: 'Organize AnyTLS configurations, connection details, and local notes for environments you are authorized to manage.',
    anytlsCta: 'View NodePilot'
  },
  ja: {
    title: 'Station Cat Apps｜個人開発ツール',
    description: 'Station Cat が作っている小さなツール。',
    kicker: 'Station Cat Apps',
    heading: '日常の創作を少し軽くするツール。',
    intro: 'Station Cat が開発・テスト・公開しているアプリとウェブ作品をまとめています。デスクトップ・モバイルツールに加えて、Cat Life Game をブラウザですぐ遊べるようになりました。',
    catLifeKicker: 'Free browser game',
    catLifeDescription: '仕事と休息を調整し、猫を世話し、部屋を整えながら猫の町を探索します。',
    catLifeCta: 'ゲームを見る',
    catLifePlayCta: '今すぐ遊ぶ',
    snapcopyKicker: 'Available on the App Store',
    snapcopyDescription: '朝食、コーヒー、散歩、ペット、旅行、日常写真を、共有しやすいキャプションにします。',
    snapcopyCta: 'SnapCopy を見る',
    mindBudgetKicker: 'iPhone TestFlight public beta',
    mindBudgetDescription: 'アカウントや銀行連携なしで、収支、予算サイクル、1日に使える金額を iPhone 内に記録します。',
    mindBudgetCta: 'MindBudget を見る',
    mindBudgetDownloadCta: 'TestFlight に参加',
    novelForgeKicker: 'macOS public test',
    novelForgeDescription: '長編、短編、構造化された物語記憶、確認待ち AI ドラフトを扱う、ローカル優先・作者主導の小説ワークベンチです。',
    novelForgeCta: 'NovelForge AI を見る',
    novelForgeDownloadCta: `${novelForgeVersion} をダウンロード`,
    privatePinyinKicker: 'macOS / Windows / iOS input method',
    privatePinyinDescription: `ローカル中国語入力メソッドです。macOS、Windows テスト版と App Store 公開中の iOS ${privatePinyinIosVersion} 正式版を提供しています。`,
    privatePinyinCta: '猫栈拼音 を見る',
    privatePinyinDownloadCta: 'ダウンロード / App Store',
    simplecutKicker: 'desktop video editor',
    simplecutDescription: 'ローカルのタイムラインでカット、音声調整、転換確認、軽い動画書き出しを行えます。',
    simplecutCta: 'SimpleCut Pro を見る',
    simplecutDownloadCta: `${currentVersion} をダウンロード`,
    anytlsKicker: 'Windows / Mac test build',
    anytlsDescription: '管理権限のある AnyTLS 設定、接続情報、ローカルメモを整理します。',
    anytlsCta: 'NodePilot を見る'
  }
}[lang];

const paths = {
  'zh-Hant': {
    canonical: '/zh-hant/apps/',
    snapcopy: captionAiProduct.zhHantProductPath,
    mindBudget: mindBudgetProduct.zhHantProductPath,
    mindBudgetDownload: mindBudgetProduct.zhHantDownloadPagePath,
    novelForge: novelForgeAiProduct.zhHantProductPath,
    novelForgeDownload: novelForgeAiProduct.zhHantDownloadPagePath,
    privatePinyin: privatePinyinProduct.zhHantProductPath,
    privatePinyinDownload: versionedPrivatePinyinDownload(privatePinyinProduct.zhHantDownloadPagePath),
    simplecut: simpleCutProProduct.zhHantProductPath,
    simplecutDownload: simpleCutProProduct.zhHantDownloadPagePath,
    anytls: anyTlsDesktopManagerProduct.zhHantProductPath,
    catLife: catLifeGameProduct.zhHantProductPath
  },
  'zh-Hans': {
    canonical: '/zh-hans/apps/',
    snapcopy: captionAiProduct.zhHansProductPath,
    mindBudget: mindBudgetProduct.zhHansProductPath,
    mindBudgetDownload: mindBudgetProduct.zhHansDownloadPagePath,
    novelForge: novelForgeAiProduct.zhHansProductPath,
    novelForgeDownload: novelForgeAiProduct.zhHansDownloadPagePath,
    privatePinyin: privatePinyinProduct.zhHansProductPath,
    privatePinyinDownload: versionedPrivatePinyinDownload(privatePinyinProduct.zhHansDownloadPagePath),
    simplecut: simpleCutProProduct.zhHansProductPath,
    simplecutDownload: simpleCutProProduct.zhHansDownloadPagePath,
    anytls: anyTlsDesktopManagerProduct.zhHansProductPath,
    catLife: catLifeGameProduct.zhHansProductPath
  },
  en: {
    canonical: '/en/apps/',
    snapcopy: captionAiProduct.productPath,
    mindBudget: mindBudgetProduct.productPath,
    mindBudgetDownload: mindBudgetProduct.downloadPagePath,
    novelForge: novelForgeAiProduct.productPath,
    novelForgeDownload: novelForgeAiProduct.downloadPagePath,
    privatePinyin: privatePinyinProduct.productPath,
    privatePinyinDownload: versionedPrivatePinyinDownload(privatePinyinProduct.downloadPagePath),
    simplecut: simpleCutProProduct.productPath,
    simplecutDownload: simpleCutProProduct.downloadPagePath,
    anytls: anyTlsDesktopManagerProduct.productPath,
    catLife: catLifeGameProduct.productPath
  },
  ja: {
    canonical: '/ja/apps/',
    snapcopy: captionAiProduct.jaProductPath,
    mindBudget: mindBudgetProduct.jaProductPath,
    mindBudgetDownload: mindBudgetProduct.jaDownloadPagePath,
    novelForge: novelForgeAiProduct.jaProductPath,
    novelForgeDownload: novelForgeAiProduct.jaDownloadPagePath,
    privatePinyin: privatePinyinProduct.jaProductPath,
    privatePinyinDownload: versionedPrivatePinyinDownload(privatePinyinProduct.jaDownloadPagePath),
    simplecut: simpleCutProProduct.jaProductPath,
    simplecutDownload: simpleCutProProduct.jaDownloadPagePath,
    anytls: anyTlsDesktopManagerProduct.jaProductPath,
    catLife: catLifeGameProduct.jaProductPath
  }
}[lang];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  canonicalPath={paths.canonical}
  alternates={[
    { hrefLang: 'zh-Hant', href: '/zh-hant/apps/' },
    { hrefLang: 'zh-Hans', href: '/zh-hans/apps/' },
    { hrefLang: 'en', href: '/en/apps/' },
    { hrefLang: 'ja', href: '/ja/apps/' },
    { hrefLang: 'x-default', href: '/zh-hant/apps/' }
  ]}
>
  <section class="page-shell">
    <p class="section-kicker">{copy.kicker}</p>
    <h1>{copy.heading}</h1>
    <p>{copy.intro}</p>
  </section>
  <section class="page-section product-list">
    <ProductCard
      title={lang === 'zh-Hant' ? '打工養貓日記' : lang === 'zh-Hans' ? '打工养猫日记' : lang === 'ja' ? '働いて猫を育てる日記' : 'Cat Life Game'}
      description={copy.catLifeDescription}
      href={paths.catLife}
      image={catLifeGameProduct.assets.icon}
      imageAlt="Cat Life Game orange cat"
      imageVariant="icon"
      cta={copy.catLifeCta}
      secondaryHref={`${catLifeGameProduct.gamePath}?lang=${encodeURIComponent(lang === 'zh-Hant' ? 'zh-Hant' : lang === 'zh-Hans' ? 'zh-CN' : lang)}`}
      secondaryCta={copy.catLifePlayCta}
      kicker={copy.catLifeKicker}
    />
    <ProductCard
      title="SnapCopy"
      description={copy.snapcopyDescription}
      href={paths.snapcopy}
      image={captionAiProduct.assets.icon}
      imageAlt="SnapCopy app icon"
      imageVariant="icon"
      cta={copy.snapcopyCta}
      kicker={copy.snapcopyKicker}
    />
    <ProductCard
      title={lang === 'zh-Hans' || lang === 'zh-Hant' ? '花有數' : 'MindBudget'}
      description={copy.mindBudgetDescription}
      href={paths.mindBudget}
      image={mindBudgetProduct.assets.icon}
      imageAlt="MindBudget app icon"
      imageVariant="icon"
      cta={copy.mindBudgetCta}
      secondaryHref={paths.mindBudgetDownload}
      secondaryCta={copy.mindBudgetDownloadCta}
      kicker={copy.mindBudgetKicker}
    />
    <ProductCard
      title="NovelForge AI"
      description={copy.novelForgeDescription}
      href={paths.novelForge}
      image={novelForgeAiProduct.assets.icon}
      imageAlt="NovelForge AI app icon"
      imageVariant="icon"
      cta={copy.novelForgeCta}
      secondaryHref={paths.novelForgeDownload}
      secondaryCta={copy.novelForgeDownloadCta}
      kicker={copy.novelForgeKicker}
    />
    <ProductCard
      title="猫栈拼音"
      description={copy.privatePinyinDescription}
      href={paths.privatePinyin}
      image={privatePinyinProduct.assets.icon}
      imageAlt="猫栈拼音 app icon"
      imageVariant="icon"
      cta={copy.privatePinyinCta}
      secondaryHref={paths.privatePinyinDownload}
      secondaryCta={copy.privatePinyinDownloadCta}
      kicker={copy.privatePinyinKicker}
    />
    <ProductCard
      title="SimpleCut Pro"
      description={copy.simplecutDescription}
      href={paths.simplecut}
      image={simpleCutProProduct.assets.icon}
      imageAlt="SimpleCut Pro app icon"
      imageVariant="icon"
      cta={copy.simplecutCta}
      secondaryHref={paths.simplecutDownload}
      secondaryCta={copy.simplecutDownloadCta}
      kicker={copy.simplecutKicker}
    />
    <ProductCard
      title="NodePilot"
      description={copy.anytlsDescription}
      href={paths.anytls}
      image={anyTlsDesktopManagerProduct.assets.icon}
      imageAlt="NodePilot app icon"
      imageVariant="icon"
      cta={copy.anytlsCta}
      kicker={copy.anytlsKicker}
    />
  </section>
</BaseLayout>
