---
import type { SerialEntry, SiteLocale } from '../data/serials';
import { formatChapterNumber, getPriceModeLabel, getSeriesHref, getSerialStatusLabel } from '../data/serials';

interface CopyShape {
  accessLabel: string;
  authorLabel: string;
  chapterLabel: string;
  freeLabel: string;
  latestLabel: string;
  openSeries: string;
  plannedLabel: string;
  scheduleLabel: string;
}

interface Props {
  serial: SerialEntry;
  locale: SiteLocale;
  basePath: string;
  copy: CopyShape;
}

const { serial, locale, basePath, copy } = Astro.props;
const href = getSeriesHref(basePath, serial.data.seriesSlug);
const latestLabel = serial.data.latestChapterNumber
  ? `${copy.latestLabel}: ${formatChapterNumber(serial.data.latestChapterNumber, locale)}`
  : serial.data.availabilityNote;
const coverText = serial.data.coverLabel ?? serial.data.title;
---

<article class="serial-card">
  <a class="serial-cover serial-card__cover" href={href} aria-label={serial.data.title}>
    {serial.data.coverImage ? (
      <img src={serial.data.coverImage} alt={serial.data.coverAlt ?? `${serial.data.title} cover`} loading="lazy" />
    ) : (
      <>
        <span class="serial-cover__mark">SC</span>
        <strong>{coverText}</strong>
      </>
    )}
  </a>

  <div class="serial-card__header">
    <span class="paper-stamp">{getSerialStatusLabel(serial.data.status, locale)}</span>
    <span>{copy.authorLabel}: {serial.data.author}</span>
  </div>

  <div class="serial-card__copy">
    <h3><a href={href}>{serial.data.title}</a></h3>
    {serial.data.subtitle && <p class="fine-print">{serial.data.subtitle}</p>}
    <p>{serial.data.tagline}</p>
  </div>

  <dl class="serial-card__meta">
    <div>
      <dt>{copy.accessLabel}</dt>
      <dd>{getPriceModeLabel(serial.data.priceMode, locale)}</dd>
    </div>
    <div>
      <dt>{copy.freeLabel}</dt>
      <dd>{serial.data.freeChapters}</dd>
    </div>
    <div>
      <dt>{copy.scheduleLabel}</dt>
      <dd>{serial.data.updateSchedule ?? '-'}</dd>
    </div>
    <div>
      <dt>{copy.latestLabel}</dt>
      <dd>{latestLabel ?? '-'}</dd>
    </div>
    {serial.data.totalPlannedChapters && (
      <div>
        <dt>{copy.plannedLabel}</dt>
        <dd>{serial.data.totalPlannedChapters}</dd>
      </div>
    )}
  </dl>

  {serial.data.tags.length > 0 && (
    <div class="station-tag-row">
      {serial.data.tags.map((tag) => <span>{tag}</span>)}
    </div>
  )}

  <div class="button-row">
    <a class="button button-secondary" href={href}>{copy.openSeries}</a>
  </div>
</article>
