    heading: ['働いて、暮らして、','猫たちを大切に。'], devices: 'PC / スマートフォン', intro: copy.intro,
    rhythm: '好きな日常を、少しずつ自分のものに。',
    shop: ['用品を買う','家具を集める','飾りを楽しむ','心地よい家に'], town: ['町を探索','タスクを受ける','猫の病院','アーケード','コレクション'],
    illustration: '猫との夜の暮らしを描いたイラスト。ゲーム画面ではありません', shopAlt: '暖かな猫のお店のイラスト', townAlt: '月夜の猫の町のイラスト',
    accountIntro: '少しだけ遊ぶ日も、じっくり過ごす日も。進行を大切に保存します。',
    saves: [['ゲストの自動保存','進行はこのブラウザに保存されます。'],['会員クラウドセーブ','ログインして同期。異なる版は自分で選べます。'],['JSON 書き出し / 読み込み','自分のセーブをバックアップ。'],['最近 5 件から復元','過去のクラウドセーブを取り戻せます。'],['多言語に対応','簡体字中国語・英語・日本語で遊べます。']],
    saveDetails: '保存と言語について', looks: 'ポイントで好きな見た目を、自分らしい世界に。',
    moon: '月夜のキジトラ', moonDesc: '最初の茶トラ猫専用の見た目', room: '駅の部屋', roomDesc: '温かな4つの部屋テーマ', scope: 'セット内容と使い方',
  }
}[lang];
const featureIcons = ['calendar-dots','cat','house','floppy-disk'];
const shopIcons = [ShoppingBag, Armchair, Sparkles, House];
const townIcons = [MapPin, ClipboardCheck, Cross, Gamepad2, BookOpen];
const saveIcons = [Monitor, Cloud, FileJson, History, Languages];
const ruleIcons = ['heart','star','gift'];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: catLifeGameProduct.name,
  alternateName: [catLifeGameProduct.zhHantName, catLifeGameProduct.jaName],
  applicationCategory: 'GameApplication',
  operatingSystem: 'Any modern web browser',
  softwareVersion: catLifeGameProduct.latestVersion,
  url: new URL(paths.canonical, siteConfig.baseUrl).toString(),
  image: new URL(catLifeGameProduct.assets.icon, siteConfig.baseUrl).toString(),
  inLanguage: ['zh-Hant', 'zh-Hans', 'en', 'ja'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.baseUrl }
};
---

<BaseLayout
  title={copy.title} description={copy.description} lang={lang}
  canonicalPath={paths.canonical} ogImage="/images/cat-life-night/hero.webp"
  bodyClass="cat-life-night" homeChrome={true} structuredData={structuredData}
  alternates={[
    { hrefLang: 'zh-Hant', href: catLifeGameProduct.zhHantProductPath },
    { hrefLang: 'zh-Hans', href: catLifeGameProduct.zhHansProductPath },
    { hrefLang: 'en', href: catLifeGameProduct.productPath },
    { hrefLang: 'ja', href: catLifeGameProduct.jaProductPath },
    { hrefLang: 'x-default', href: catLifeGameProduct.zhHantProductPath }
  ]}
>
  <section class="game-hero" aria-labelledby="game-title">
    <picture class="game-hero-art"><source media="(max-width: 600px)" srcset="/images/cat-life-night/hero-960.webp" /><img src="/images/cat-life-night/hero.webp" alt={details.illustration} width="1792" height="640" fetchpriority="high" decoding="async" /></picture>
    <div class="game-wrap game-hero-inner"><div class="game-hero-copy">
      <p class="game-eyebrow">STATION CAT GAME</p>
      <h1 id="game-title">{details.heading.map(line=><span>{line}</span>)}</h1>
      <p class="game-intro">{details.intro}</p>
      <ul class="game-badges" aria-label={copy.status}>
        <li><Gamepad2 size={13}/>{copy.status.split(' · ')[0]}</li>
        <li><Monitor size={13}/>{copy.status.split(' · ')[1]}</li>
        <li><Smartphone size={13}/>{details.devices}</li><li>Version {catLifeGameProduct.latestVersion}</li>
      </ul>
      <div class="game-actions"><a class="game-button" href={playUrl}>{copy.play}<ArrowRight size={17}/></a><a class="game-button game-button-outline" href={paths.apps}>{copy.apps}</a></div>
    </div></div>
  </section>

  <div class="game-wrap game-content">
    <section class="game-features" aria-labelledby="game-features-title">
      <div class="game-heading"><h2 id="game-features-title">{copy.nowTitle}</h2><p>{details.rhythm}</p></div>
      <div class="game-feature-grid">{copy.features.map(([title,text],i)=>{const Icon=featureIcons[i];return <article class="game-feature"><span class="game-feature-icon"><img src={`/images/cat-life-night/icons/${Icon}.svg`} width="32" height="32" alt=""/></span><div><h3>{title}</h3><p>{text}</p></div></article>})}</div>
    </section>

    <section class="game-world" aria-labelledby="game-world-title">
      <div class="game-heading game-heading-stack"><h2 id="game-world-title">{copy.shopTitle}</h2><p>{copy.shopText}</p></div>
      <div class="game-world-grid">
        <article class="game-scene"><img src="/images/cat-life-night/shop.webp" width="960" height="480" loading="lazy" decoding="async" alt={details.shopAlt}/><ul>{details.shop.map((item,i)=>{const Icon=shopIcons[i];return <li><Icon size={18}/><span>{item}</span></li>})}</ul></article>
        <article class="game-scene"><img src="/images/cat-life-night/town.webp" width="960" height="480" loading="lazy" decoding="async" alt={details.townAlt}/><ul>{details.town.map((item,i)=>{const Icon=townIcons[i];return <li><Icon size={18}/><span>{item}</span></li>})}</ul></article>
      </div>
    </section>

    <section class="game-account" aria-labelledby="game-account-title">
      <div class="game-account-grid">
        <div class="game-account-intro"><h2 id="game-account-title">{copy.accountTitle}</h2><p>{details.accountIntro}</p><img src="/images/cat-life-night/account.webp" alt="" width="768" height="256" loading="lazy" decoding="async"/></div>
        <div class="game-save-list">{details.saves.slice(0,2).map(([title,text],i)=>{const Icon=saveIcons[i];return <div><Icon size={22}/><div><h3>{title}</h3><p>{text}</p></div></div>})}</div>
        <div class="game-save-list">{details.saves.slice(2).map(([title,text],i)=>{const Icon=saveIcons[i+2];return <div><Icon size={20}/><div><h3>{title}</h3><p>{text}</p></div></div>})}</div>
      </div>
      <details class="game-details"><summary>{details.saveDetails}<ChevronDown size={15}/></summary><div><p>{copy.accountText}</p><p>{copy.languages}</p></div></details>
    </section>

    <section class="game-commerce" aria-labelledby="game-commerce-title">
      <div class="game-commerce-layout"><div>
        <div class="game-heading game-heading-stack"><h2 id="game-commerce-title">{copy.commerceTitle}</h2><p>{details.looks}</p></div>
        <div class="game-looks">
          <article><img src={catLifeGameProduct.assets.moonlitTabby} width="480" height="480" loading="lazy" alt={details.moon}/><div><h3>{details.moon}</h3><p>{details.moonDesc}</p></div></article>
          <article><img src={catLifeGameProduct.assets.stationRoom} width="759" height="428" loading="lazy" alt={copy.commercePreview}/><div><h3>{details.room}</h3><p>{details.roomDesc}</p></div></article>
        </div>
      </div><ul class="game-commerce-rules">{copy.commerceNotes.map((note,i)=>{const Icon=ruleIcons[i];return <li><img src={`/images/cat-life-night/icons/${Icon}.svg`} width="21" height="21" alt=""/><span>{note}</span></li>})}</ul></div>
      <details class="game-details game-commerce-details"><summary>{details.scope}<ChevronDown size={15}/></summary><div><p>{copy.commerceText}</p><p>{copy.commerceScope}</p><figure><img src={catLifeGameProduct.assets.stationRoom} alt="" width="759" height="428" loading="lazy"/><figcaption>{copy.commercePreview}</figcaption></figure><p class="game-help-links"><a href={`/${lang.toLowerCase()}/points/`}>{copy.commerceRules}<ArrowRight size={15}/></a><a href={`mailto:${siteConfig.supportEmail}`}>{copy.commerceSupport}</a></p></div></details>
    </section>
  </div>
  <section class="game-final"><img class="game-final-art" src="/images/cat-life-night/cta.webp" alt="" width="1200" height="400" loading="lazy" decoding="async"/><div><h2>{copy.finalTitle}</h2><p>{copy.finalText}</p></div><a class="game-button" href={playUrl}>{copy.play}<ArrowRight size={17}/></a></section>
</BaseLayout>
