---
interface Props {
  title: string;
  items: string[];
  kicker?: string;
}

const { title, items, kicker = 'Built for' } = Astro.props;
---

<section class="page-section">
  <div class="section-heading">
    <p class="section-kicker">{kicker}</p>
    <h2>{title}</h2>
  </div>
  <div class="feature-grid">
    {items.map((item) => (
      <div class="feature-tile">
        <span aria-hidden="true"></span>
        <p>{item}</p>
      </div>
    ))}
  </div>
</section>
