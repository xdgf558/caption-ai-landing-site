---
import { siteConfig } from '../data/site';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant' | 'zh-Hans';
}

const { lang = 'zh-Hant' } = Astro.props;
const year = new Date().getFullYear();
const links =
  lang === 'ja'
    ? [
        { label: 'SnapCopy', href: '/ja/apps/caption-ai/' },
        { label: 'PrivatePinyin', href: '/ja/apps/privatepinyin/' },
        { label: 'StationCat Radar', href: '/ja/apps/stationcat-radar/' },
        { label: 'NodePilot', href: '/ja/apps/nodepilot/' },
        { label: 'X Follow Cleaner', href: '/ja/apps/x-follow-cleaner/' },
        { label: '連載小説', href: '/novel/' },
        { label: 'Signal', href: '/ja/signal/' },
        { label: '会員ログイン', href: '/library/' },
        { label: '開発ログ', href: '/ja/devlog/' },
        { label: 'プライバシー', href: '/ja/apps/caption-ai/privacy/' },
        { label: 'サポート', href: '/ja/apps/caption-ai/support/' },
        { label: '利用規約', href: '/ja/apps/caption-ai/terms/' },
        { label: 'Android Waitlist', href: '/android/' },
        { label: 'X', href: 'https://x.com/bketck' }
      ]
    : lang === 'zh-Hant'
      ? [
          { label: 'SnapCopy', href: '/zh-hant/apps/caption-ai/' },
          { label: 'PrivatePinyin', href: '/zh-hant/apps/privatepinyin/' },
          { label: 'StationCat Radar', href: '/zh-hant/apps/stationcat-radar/' },
          { label: 'NodePilot', href: '/zh-hant/apps/nodepilot/' },
          { label: 'X Follow Cleaner', href: '/zh-hant/apps/x-follow-cleaner/' },
          { label: '連載小說', href: '/novel/' },
          { label: '信號簡報', href: '/signal/' },
          { label: '會員中心', href: '/library/' },
          { label: '開發博客', href: '/devlog/' },
          { label: '隱私政策', href: '/zh-hant/apps/caption-ai/privacy/' },
          { label: '支援', href: '/zh-hant/apps/caption-ai/support/' },
          { label: '服務條款', href: '/zh-hant/apps/caption-ai/terms/' },
          { label: 'Android Waitlist', href: '/android/' },
          { label: 'X', href: 'https://x.com/bketck' }
        ]
    : lang === 'zh-Hans'
      ? [
          { label: 'SnapCopy', href: '/zh-hans/apps/caption-ai/' },
          { label: 'PrivatePinyin', href: '/zh-hans/apps/privatepinyin/' },
          { label: 'StationCat Radar', href: '/zh-hans/apps/stationcat-radar/' },
          { label: 'NodePilot', href: '/zh-hans/apps/nodepilot/' },
          { label: 'X Follow Cleaner', href: '/zh-hans/apps/x-follow-cleaner/' },
          { label: '连载小说', href: '/novel/' },
          { label: '信号简报', href: '/zh-hans/signal/' },
          { label: '会员中心', href: '/library/' },
          { label: '开发博客', href: '/zh-hans/devlog/' },
          { label: '隐私政策', href: '/zh-hans/apps/caption-ai/privacy/' },
          { label: '支持', href: '/zh-hans/apps/caption-ai/support/' },
          { label: '服务条款', href: '/zh-hans/apps/caption-ai/terms/' },
          { label: 'Android Waitlist', href: '/android/' },
          { label: 'X', href: 'https://x.com/bketck' }
        ]
    : [
        { label: 'SnapCopy', href: '/apps/caption-ai/' },
        { label: 'PrivatePinyin', href: '/apps/privatepinyin/' },
        { label: 'StationCat Radar', href: '/apps/stationcat-radar/' },
        { label: 'NodePilot', href: '/apps/nodepilot/' },
        { label: 'X Follow Cleaner', href: '/apps/x-follow-cleaner/' },
        { label: 'Serials', href: '/novel/' },
        { label: 'Signal', href: '/en/signal/' },
        { label: 'Member Center', href: '/library/' },
        { label: 'Dev Blog', href: '/en/devlog/' },
        { label: 'Privacy', href: '/apps/caption-ai/privacy/' },
        { label: 'Support', href: '/apps/caption-ai/support/' },
        { label: 'Terms', href: '/apps/caption-ai/terms/' },
        { label: 'Android Waitlist', href: '/android/' },
        { label: 'X', href: 'https://x.com/bketck' }
      ];
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <a class="brand-mark footer-brand" href="/">
        <span class="brand-icon" aria-hidden="true">SC</span>
        <span>{siteConfig.name}</span>
      </a>
      <p>
        {lang === 'ja'
          ? 'Cats, meals, AI tools, and strange ideas.'
          : lang === 'zh-Hant'
            ? 'Cats, meals, AI tools, and strange ideas.'
          : 'Cats, meals, AI tools, and strange ideas.'}
      </p>
    </div>
    <div class="footer-links">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
    </div>
  </div>
  <p class="fine-print">&copy; {year} {siteConfig.legalName}. Built by an independent creator.</p>
</footer>
