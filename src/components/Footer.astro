---
import { siteConfig } from '../data/site';

interface Props {
  lang?: 'en' | 'ja' | 'zh-Hant';
}

const { lang = 'zh-Hant' } = Astro.props;
const year = new Date().getFullYear();
const links =
  lang === 'ja'
    ? [
        { label: 'プライバシー', href: '/ja/apps/caption-ai/privacy/' },
        { label: 'サポート', href: '/ja/apps/caption-ai/support/' },
        { label: '利用規約', href: '/ja/apps/caption-ai/terms/' }
      ]
    : lang === 'zh-Hant'
      ? [
          { label: '隱私政策', href: '/zh-hant/apps/caption-ai/privacy/' },
          { label: '支援', href: '/zh-hant/apps/caption-ai/support/' },
          { label: '服務條款', href: '/zh-hant/apps/caption-ai/terms/' }
        ]
    : [
        { label: 'Privacy', href: '/privacy/' },
        { label: 'Support', href: '/support/' },
        { label: 'Terms', href: '/terms/' }
      ];
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <a class="brand-mark footer-brand" href={lang === 'ja' ? '/ja/' : lang === 'en' ? '/en/' : '/'}>
        <span class="brand-icon" aria-hidden="true">EA</span>
        <span>{siteConfig.name}</span>
      </a>
      <p>
        {lang === 'ja'
          ? '日常の創作と共有を助ける、軽くて信頼できる AI アプリを開発しています。'
          : lang === 'zh-Hant'
            ? '我們開發輕量、可信任的 AI 生活與創作應用，幫助日常照片與想法更容易分享。'
          : 'Simple AI lifestyle apps for everyday creativity, sharing, and personal expression.'}
      </p>
    </div>
    <div class="footer-links">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
    </div>
  </div>
  <p class="fine-print">&copy; {year} {siteConfig.legalName}. {lang === 'ja' ? 'All rights reserved.' : 'All rights reserved.'}</p>
</footer>
