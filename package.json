{
  "name": "landing-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:novel-payment-config": "node scripts/build-novel-payment-config.mjs",
    "build:legacy-content-manifest": "node scripts/build-legacy-content-manifest.mjs",
    "upload:protected-serial-content": "node scripts/upload-protected-serial-content.mjs",
    "dev": "astro dev --host 0.0.0.0",
    "build": "npm run build:novel-payment-config && npm run build:legacy-content-manifest && astro build",
    "preview": "astro preview --host 0.0.0.0"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "js-yaml": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
