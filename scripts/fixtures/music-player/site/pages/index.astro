---
import MusicPlayer from '../../../../../src/components/MusicPlayer.astro';
---
<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>音乐小站 · 本地设计预览 | Station Cat</title>
    <link rel="icon" href="/brand.webp" />
  </head>
  <body>
    <a href="#main" class="skip">跳到主要内容</a>
    <header>
      <a class="brand" href="https://wwwstationcat.org/zh-hans/"><img src="/brand.webp" alt="" width="42" height="42" /><strong>Station Cat</strong></a>
      <nav aria-label="小站导航">
        <a href="https://wwwstationcat.org/zh-hans/apps/">Apps</a>
        <a href="https://wwwstationcat.org/zh-hans/apps/cat-life-game/">游戏</a>
        <a href="https://wwwstationcat.org/novel/">连载小说</a>
        <a href="https://wwwstationcat.org/signal/">文章与观察</a>
        <a href="https://wwwstationcat.org/about/">About</a>
      </nav>
      <span class="locale" lang="zh-Hans">简中</span>
    </header>
    <main id="main"><MusicPlayer previewLabel="设计预览 · 示例内容" /></main>
    <footer>本地合成演示音频与示例封面，仅用于播放器交互预览。</footer>
  </body>
</html>
<style is:global>
  :root { --bg: #fffaf4; --ink: #1f2d29; --muted: #64736d; --line: #e4dbd0; --teal: #08796d; --max: 1120px; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif; }
  header { padding: 18px max(24px, calc((100vw - 1120px) / 2)); border-bottom: 1px solid var(--line); min-height: 88px; display: flex; justify-content: space-between; gap: 20px; align-items: center; }
  header a { color: inherit; text-decoration: none; }
  .brand { display: flex; align-items: center; gap: 14px; white-space: nowrap; }
  .brand strong { font-family: Georgia, serif; font-size: 25px; }
  .brand img { border-radius: 10px; }
  nav { display: flex; gap: 26px; align-items: center; font-size: 15px; font-weight: 600; }
  nav a { padding-block: 12px; }
  nav a:hover { text-decoration: underline; text-underline-offset: 6px; }
  .locale { padding: 9px 22px; border: 1px solid var(--line); border-radius: 24px; color: #564f48; font-size: 14px; }
  footer { text-align: center; font-size: 12px; color: var(--muted); padding: 0 24px 184px; }
  .skip { position: absolute; left: 20px; top: -100px; padding: 10px; background: white; z-index: 90; }
  .skip:focus { top: 10px; }
  @media(min-width: 1001px) and (max-width: 1280px) { header { min-height: 72px; padding: 12px 52px; } .brand img { width: 36px; height: 36px; } }
  @media(max-width: 1000px) { header { padding-inline: 24px; } nav { gap: 16px; font-size: 14px; } .brand strong { font-size: 21px; } }
  @media(max-width: 760px) { nav { display: none; } header { min-height: 72px; padding: 14px 20px; } .brand img { width: 34px; height: 34px; } .locale { padding: 7px 16px; } }
</style>
