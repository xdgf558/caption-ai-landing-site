{
  "version": "draft-1",
  "approved": false,
  "executionEnabled": false,
  "actions": {
    "identity_tombstone": "拟先停止账号并去除登录身份；最小财务关联 ID 仅在批准保留期内保留，不能称为匿名；无保留义务后再物理删除。",
    "credentials_purge": "撤销后清除密码、TOTP、登录 token、会话及刷新密文；按依赖顺序清理，不等待普通会话期限。",
    "private_data_purge": "删除个人书签、阅读原始事件、云存档与备份；只处理已证实属于该账号的记录。",
    "comments_decision": "待用户确认；拟删除评论正文与作者关联。",
    "financial_review": "停止可用权益，余额不自动清零/退款；订单、账本、退款和游戏兑换凭据按批准的最小字段与期限隔离保留。",
    "receipt_minimal": "删除任务/只读回执与 outbox 最小状态独立保留；期限结束后按批准规则清理，不保留凭据或原始账号信息。",
    "soft_link_review": "不能靠 reader_accounts 外键找到；按确认的账号/订单/邮箱所有权和字段映射处理，禁止全库字符串匹配删除。",
    "short_ttl": "无可靠账号关联的安全计数/未认证 flow 沿既有短期清理；有账号作用域的计数要单独清除。",
    "publisher_content_keep": "站点公开内容、运维设置和发布者资产不是普通读者资产；不随读者销户删除。管理员主体另行核验。",
    "anonymous_analytics_ttl": "音乐随机会话统计不伪造账号关联；遵循现有 30/365 天规则；归因当前不采集，若启用须先定义软关联清理。",
    "admin_audit_review": "保留所需审计事件但最小化其中读者邮箱/ID/自由文本；管理员标识与普通会员主体不可混同。"
  },
